#!/usr/bin/env bash
# Bluetooth. Same adapter blueman uses; blueman-applet stays the pairing agent.
#
# The chevron opens bin/bt-menu, the popup the bar icon opens — the paired
# devices and what is connected — rather than blueman-manager, which is a
# window. Its footer still has Bluetooth Settings… for the pairing wizard, the
# per-profile audio routing and the file transfer. Falls back to blueman when
# the menu is not installed, the same way bin/panel-bt does.
MENU="$HOME/.local/bin/bt-menu"
[ -x "$MENU" ] || MENU=blueman-manager

case "${1:-read}" in
  set) case "$2" in on|true|1) bluetoothctl power on ;; *) bluetoothctl power off ;; esac \
         >/dev/null 2>&1; exit 0 ;;
esac

shopt -s nullglob
adapters=(/sys/class/bluetooth/hci*)
shopt -u nullglob
if [ ${#adapters[@]} -eq 0 ]; then
  # The SSDC regression eats hci0 outright; say so instead of showing a dead switch.
  printf 'kind = toggle\nglyph = bluetooth\ntitle = Bluetooth\nvalue = off\nsubtitle = No adapter\n'
  exit 0
fi

hci=$(basename "${adapters[0]}")
p=$(busctl --system get-property org.bluez "/org/bluez/$hci" org.bluez.Adapter1 \
      Powered 2>/dev/null)
[ "$p" = 'b true' ] && on=on || on=off

sub='Off'
if [ "$on" = on ]; then
  names=$(timeout 3 bluetoothctl devices Connected 2>/dev/null | cut -d' ' -f3-)
  n=$(printf '%s' "$names" | grep -c . || true)
  case "$n" in
    0) sub='On' ;;
    1) sub=$names ;;
    *) sub="$n devices" ;;
  esac
fi
cat <<EOF
kind = toggle
glyph = bluetooth
title = Bluetooth
value = $on
subtitle = $sub
detail = $MENU
EOF
