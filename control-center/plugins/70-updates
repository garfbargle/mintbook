#!/usr/bin/env bash
# Software updates. A reading, and a chevron that opens the popup.
#
# The bar indicator hides itself when there is nothing waiting, which is right
# for a bar and wrong for a panel — this tile is the door that is always
# there. It reads the file bin/updates-check leaves behind and never touches
# APT itself: the check is 2.5 s and a tile has about 20 ms.
STATE="$HOME/.cache/mintbook/updates.state"
MENU="$HOME/.local/bin/updates-menu"
[ -x "$MENU" ] || MENU=mintupdate

count=0 security=0 kernel=0 flatpak=0 checked=0 error=''
while read -r line; do
  case "$line" in
    'count = '*)    count=${line#count = } ;;
    'security = '*) security=${line#security = } ;;
    'kernel = '*)   kernel=${line#kernel = } ;;
    'flatpak = '*)  flatpak=${line#flatpak = } ;;
    'checked = '*)  checked=${line#checked = } ;;
    'error = '*)    error=${line#error = } ;;
  esac
done < "$STATE" 2>/dev/null

if [ -n "$error" ]; then
  value='!'
  sub='Could not check'
elif [ "$count" -gt 0 ] 2>/dev/null; then
  value=$count
  parts=''
  [ "$security" -gt 0 ] && parts="$security security"
  [ "$kernel" -gt 0 ] && parts="${parts:+$parts, }$kernel kernel"
  [ "$flatpak" -gt 0 ] && parts="${parts:+$parts, }$flatpak flatpak"
  sub=${parts:-Ready to install}
elif [ "$checked" -gt 0 ] 2>/dev/null; then
  printf -v now '%(%s)T' -1
  age=$(( (now - checked) / 3600 ))
  value='✓'
  if [ "$age" -lt 2 ]; then sub='Up to date'
  elif [ "$age" -lt 48 ]; then sub="Up to date · ${age}h ago"
  else sub="Checked $(( age / 24 )) days ago"; fi
else
  value='—'
  sub='Not checked yet'
fi

cat <<EOF
kind = meter
glyph = box
title = Updates
value = $value
subtitle = $sub
detail = $MENU
EOF
