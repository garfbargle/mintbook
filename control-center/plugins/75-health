#!/usr/bin/env python3
import json
from pathlib import Path

helper = Path.home() / '.local/bin/mintbook-health'
if not helper.exists():
    print('skip = on')
    raise SystemExit
try:
    state = json.loads((Path.home() / '.cache/mintbook/health.json').read_text())
    failures = sum(r['status'] == 'fail' for r in state['rows'])
    notes = sum(r['status'] == 'warn' for r in state['rows'])
    value = str(failures) if failures else '✓'
    subtitle = 'Needs attention' if failures else (f'{notes} notes' if notes else 'Checks passed')
except (OSError, ValueError, KeyError):
    value, subtitle = '—', 'Not checked yet'
print(f'kind = meter\nglyph = check\ntitle = System Health\nspan = 12\nvalue = {value}\nsubtitle = {subtitle}\ndetail = {helper}\nlive = 10')
