#!/usr/bin/env bash
# Playback destination.  The volume slider is deliberately a separate tile:
# this chooser makes its selection the PipeWire/PulseAudio default, so both the
# slider and the media keys then adjust the output the user just chose.
#
# pactl's default sink alone only affects *new* playback streams.  Move the
# real streams as well, otherwise a browser that was already playing stays on
# the old speakers until it is restarted.  The 4-channel EQ loopback has no
# Pulse client (field three is "-") and must remain where it is.
#
# A `menu`, not a `segment`.  A segment holds four options and this list is
# whatever is plugged in and paired, so it used to be capped at four and had
# to hoist the current default to the front to stop a fifth device pushing the
# active destination off the tile.  Both are gone: this prints every sink, in
# the order pactl reports them, and the panel opens it as a dropdown.
set -u

list_sinks() {
  # `pactl list short sinks` does not include a human-readable description.
  # Keep the names as opaque IDs for `set`, but display descriptions in the
  # panel.  C locale makes these headings stable across desktop languages.
  LC_ALL=C pactl list sinks 2>/dev/null | awk '
    /^[[:space:]]*Name: / { name=$2; next }
    /^[[:space:]]*Description: / {
      sub(/^[[:space:]]*Description: /, "")
      if (name != "") print name "\t" $0
    }
  ' | while IFS=$'\t' read -r name description; do
    # Raw is the input to the MacBook speaker EQ filter, not an output users
    # should select.  Sending an app there bypasses the tuned speaker path.
    [ "$name" = MacBook_Speaker_Raw ] && continue
    printf '%s\t%s\n' "$name" "$description"
  done
}

move_clients() {
  local sink="$1" input
  while read -r input; do
    [ -n "${input:-}" ] || continue
    pactl move-sink-input "$input" "$sink" >/dev/null 2>&1 || true
  done < <(pactl list short sink-inputs 2>/dev/null | awk '$3 != "-" { print $1 }')
}

case "${1:-read}" in
  set)
    sink="${2:-}"
    # Do not let a stale row (a Bluetooth device that disconnected while the
    # list was open) replace a valid default with an arbitrary string.
    if list_sinks | awk -F '\t' -v wanted="$sink" '$1 == wanted { found=1 } END { exit !found }'; then
      pactl set-default-sink "$sink" >/dev/null 2>&1 && move_clients "$sink"
    fi
    exit 0
    ;;
esac

# `subtitle` is what the row reads when `value` matches no option, which is
# the no-sinks case and nothing else.
default=$(pactl get-default-sink 2>/dev/null || true)
printf 'kind = menu\nglyph = speaker\ntitle = Output\nvalue = %s\nsubtitle = No playback device\nlive = 2\n' \
  "$default"
while IFS=$'\t' read -r name description; do
  [ -n "$name" ] || continue
  printf 'option = %s|%s\n' "$name" "$description"
done < <(list_sinks)
