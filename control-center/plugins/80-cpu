#!/usr/bin/env python3
"""CPU load, as a live sparkline. Only samples while the panel is open.

This is the bar's old sparkline (bin/panel-cpu) moved behind a click. The
history is this plugin's own, so it starts flat and fills in over ~45 s of
panel time; the trade is that a closed panel costs nothing at all, where the
bar version spent a Python interpreter every 2 s all day.
"""
import os
import sys
import time

STATE = os.path.expanduser('~/.cache/mintbook/cc-cpu.state')
HIST, PROC_EVERY, NCPU = 46, 3, os.cpu_count() or 1


def totals():
    with open('/proc/stat') as f:
        v = [int(x) for x in f.readline().split()[1:]]
    return sum(v), v[3] + (v[4] if len(v) > 4 else 0)


def proc_times():
    out = {}
    for pid in os.listdir('/proc'):
        if not pid.isdigit():
            continue
        try:
            with open(f'/proc/{pid}/stat') as f:
                s = f.read()
            rest = s[s.rindex(')') + 2:].split()
            out[pid] = (int(rest[11]) + int(rest[12]), s[s.index('(') + 1:s.rindex(')')])
        except Exception:
            continue
    return out


def load():
    try:
        p = open(STATE).read().split('\n')
        return (int(p[0]), int(p[1]),
                [float(x) for x in p[2].split(',') if x], int(p[3]), p[4],
                float(p[5]), int(p[6]),
                dict(l.split(' ', 1) for l in p[7:] if l))
    except Exception:
        return None, None, [], -1, '', 0.0, None, {}


def main():
    ptotal, pidle, hist, tick, top, stamp, proc_total, procs = load()
    total, idle = totals()
    # A stale file is a previous panel session; do not draw a gap as history.
    if time.time() - stamp > 12:
        ptotal = pidle = None
        hist, tick, procs, proc_total = [], -1, {}, None
    pct = 0.0
    if ptotal and total > ptotal:
        dt = total - ptotal
        pct = max(0.0, min(100.0, 100.0 * (dt - (idle - pidle)) / dt))
    hist = (hist + [pct])[-HIST:]

    tick += 1
    now = proc_times() if tick % PROC_EVERY == 0 else None
    if now is not None:
        if proc_total and total > proc_total:
            dtp = total - proc_total
            best = max(((now[p][0] - procs[p][0], now[p][1]) for p in now
                        if p in procs and now[p][0] > procs[p][0]), default=None)
            if best and best[0] * NCPU * 100.0 / dtp >= 1.0:
                top = f'{best[1][:14]} {best[0] * NCPU * 100.0 / dtp:.0f}%'
            else:
                top = ''
        proc_total, procs = total, {p: (v[0], v[1]) for p, v in now.items()}

    tmp = STATE + '.tmp'
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    with open(tmp, 'w') as f:
        f.write('\n'.join([
            str(total), str(idle), ','.join(f'{v:.1f}' for v in hist), str(tick),
            top, f'{time.time():.0f}', str(proc_total or 0)]
            + [f'{p} {v[0]} {v[1]}' for p, v in procs.items()]))
    os.replace(tmp, STATE)

    print('kind = meter')
    print('glyph = cpu')
    print('title = CPU')
    print('live = 1')
    print(f'value = {pct:.0f}%')
    print(f'subtitle = {top}')
    print('graph = ' + ','.join(f'{v:.1f}' for v in hist))
    print('detail = gnome-system-monitor')


if __name__ == '__main__':
    main()
    sys.exit(0)
