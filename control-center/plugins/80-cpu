#!/usr/bin/env bash
# CPU. Reads the sparkline bin/panel-cpu already keeps in ~/.cache/mintbook,
# so the tile shows the same history the bar is drawing rather than a second
# one that starts empty every time the panel opens — and costs a `sed`, not a
# walk of /proc. If nothing has refreshed that state recently (the sparkline
# is off the bar), this runs panel-cpu itself to tick it.
STATE="$HOME/.cache/mintbook/cpu.state"
PANEL="$HOME/.local/bin/panel-cpu"

printf -v now '%(%s)T' -1
mt=$(stat -c %Y "$STATE" 2>/dev/null || echo 0)
[ $(( now - mt )) -gt 4 ] && [ -x "$PANEL" ] && "$PANEL" >/dev/null 2>&1

hist=$(sed -n 3p "$STATE" 2>/dev/null)
last=${hist##*,}
[ -n "$hist" ] || { echo 'skip = on'; exit 0; }

# Line 5 is the cached top-5: value\x1fname records joined by \x1e. Only the
# name fits beside the reading; the bar's tooltip is where the numbers are.
top=$(sed -n 5p "$STATE" 2>/dev/null \
       | awk -F'\036' '{ print $1 }' \
       | awk -F'\037' 'NF == 2 { print substr($2, 1, 15) }')

cat <<EOF
kind = meter
glyph = cpu
title = CPU
live = 2
value = ${last%.*}%
subtitle = $top
graph = $hist
detail = gnome-system-monitor
EOF
