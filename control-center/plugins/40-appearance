#!/usr/bin/env bash
# System chrome. Auto follows Redshift's period, so the bar turns at the same
# sunset boundary as Night Light. See bin/appearance-mode.
APPLY="$HOME/.local/bin/appearance-mode"
case "${1:-read}" in
  set) "$APPLY" "${2:-auto}" >/dev/null 2>&1; exit 0 ;;
esac
mode=$(cat "$HOME/.config/mintbook/appearance.mode" 2>/dev/null || echo auto)
now=$(cat "$HOME/.config/mintbook/appearance.applied" 2>/dev/null || echo light)
cat <<EOF
kind = segment
glyph = display
title = Appearance
subtitle = Now ${now^}
value = $mode
option = auto|Auto
option = light|Light
option = dark|Dark
EOF
