          1
        ]
      ],
      "/panels/panel-1/position": [
        "s",
        "p=6;x=0;y=0"
      ],
      "/panels/panel-1/position-locked": [
        "b",
        true
      ],
      "/panels/panel-1/length": [
        "u",
        100
      ],
      "/panels/panel-1/size": [
        "u",
        52
      ],
      "/panels/panel-1/icon-size": [
        "u",
        36
      ],
      "/panels/panel-1/enable-struts": [
        "b",
        true
      ],
      "/panels/panel-1/background-style": [
        "u",
        1
      ],
      "/panels/panel-1/background-rgba": [
        "ad",
        [
          0.8431372549,
          0.8549019608,
          0.8705882353,
          0.8588235294
        ]
      ],
      "/panels/panel-1/plugin-ids": [
        "ai",
        [
          1,
          7,
          8,
          10,
          19,
          17,
          18,
          21,
          12,
          11,
          13
        ]
      ],
      "/plugins/plugin-1": [
        "s",
        "launcher"
      ],
      "/plugins/plugin-7": [
        "s",
        "separator"
      ],
      "/plugins/plugin-7/expand": [
        "b",
        true
      ],
      "/plugins/plugin-7/style": [
        "u",
        0
      ],
      "/plugins/plugin-8": [
        "s",
        "systray"
      ],
      "/plugins/plugin-10": [
        "s",
        "xapp-status-plugin"
      ],
      "/plugins/plugin-11": [
        "s",
        "power-manager-plugin"
      ],
      "/plugins/plugin-12": [
        "s",
        "pulseaudio"
      ],
      "/plugins/plugin-13": [
        "s",
        "clock"
      ],
      "/plugins/plugin-13/digital-time-font": [
        "s",
        "Inter 11"
      ],
      "/plugins/plugin-13/digital-time-format": [
        "s",
        "%a %-d %b  %H:%M  "
      ],
      "/plugins/plugin-17": [
        "s",
        "genmon"
      ],
      "/plugins/plugin-18": [
        "s",
        "genmon"
      ],
      "/plugins/plugin-19": [
        "s",
        "genmon"
      ],
      "/plugins/plugin-21": [
        "s",
        "genmon"
      ],
      "/plugins/plugin-13/digital-layout": [
        "u",
        3
      ],
      "/plugins/plugin-13/digital-date-font": [
        "s",
        "Inter 8"
      ]
    },
    "xfce4-keyboard-shortcuts": {
      "/commands/custom/<Shift><Super>numbersign": [
        "s",
        "@HOME@/.local/bin/screenshot -f"
      ],
      "/commands/custom/<Shift><Super>dollar": [
        "s",
        "@HOME@/.local/bin/screenshot -r"
      ],
      "/commands/custom/<Shift><Super>percent": [
        "s",
        "@HOME@/.local/bin/screenshot -w"
      ],
      "/commands/custom/Super_L": [
        "s",
        "/bin/true"
      ]
    }
