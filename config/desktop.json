    "xfce4-genmon-plugin",
    "xfce4-xapp-status-plugin",
    "xfce4-screenshooter",
    "pulseaudio-utils",
    "redshift",
    "brightnessctl",
    "sassc",
    "libglib2.0-dev-bin",
    "libxml2-utils",
    "fonts-inter",
    "fonts-noto-core",
    "gnome-system-monitor",
    "btop",
    "lm-sensors",
    "mint-backgrounds-wallpapers",
    "python3-apt",
    "python3-dbus",
    "blueman",
    "network-manager-gnome"
  ],
  "themes": [
    {
      "name": "WhiteSur-gtk-theme",
      "url": "https://github.com/vinceliuice/WhiteSur-gtk-theme.git",
      "commit": "e39f6341fdcdf02826d3daab68faf4204669edf3",
      "license": "MIT",
      "args": [
        "-o",
        "normal",
        "-c",
        "light",
        "-c",
        "dark",
        "-a",
        "normal",
        "-t",
        "default",
        "-d",
        "@HOME@/.themes"
      ],
      "patches": [
        "config/themes/whitesur-no-session.patch"
      ]
    },
    {
      "name": "WhiteSur-icon-theme",
      "url": "https://github.com/vinceliuice/WhiteSur-icon-theme.git",
      "commit": "b860eb387fdb6c0cd6e4717a2b533e0ff419d118",
      "license": "GPL-3.0",
      "args": [
        "-d",
        "@HOME@/.icons"
      ]
    }
  ],
  "features": [
    "daily-install",
    "cpu-install",
    "wifi-install",
    "battery-install",
    "updates-install",
    "control-install",
    "bt-panel-install",
    "overview-install",
    "app-grid-install"
  ],
  "settings": {
    "xsettings": {
      "/Net/ThemeName": [
        "s",
        "WhiteSur-Light"
      ],
      "/Net/IconThemeName": [
        "s",
        "WhiteSur-light"
      ],
      "/Gtk/FontName": [
        "s",
        "Inter 10"
      ],
      "/Gtk/CursorThemeSize": [
        "i",
        32
      ],
      "/Gtk/DecorationLayout": [
        "s",
        "close,minimize,maximize:"
      ],
      "/Xft/DPI": [
        "i",
        96
      ]
    },
    "xfwm4": {
      "/general/theme": [
        "s",
        "WhiteSur-Light-hdpi"
      ],
      "/general/title_font": [
        "s",
        "Inter 10"
      ],
      "/general/button_layout": [
        "s",
        "CHM|"
      ],
      "/general/use_compositing": [
        "b",
        true
      ],
      "/general/margin_top": [
        "i",
        52
      ],
      "/general/show_dock_shadow": [
        "b",
        false
      ],
      "/general/tile_on_move": [
        "b",
        true
      ],
      "/general/wrap_windows": [
        "b",
        false
      ]
    },
    "xfce4-panel": {
