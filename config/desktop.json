  "dock": {
    "alignment": "center",
    "auto-pinning": false,
    "hide-mode": "intelligent",
    "icon-size": 64,
    "position": "bottom",
    "show-dock-item": false,
    "theme": "WhiteSur",
    "zoom-enabled": true,
    "zoom-percent": 150,
    "dock-items": [
      "01-thunar.dockitem",
      "browser.dockitem",
      "03-terminal.dockitem",
      "06-settings.dockitem"
    ]
  },
  "wallpaper": "/usr/share/backgrounds/linuxmint-wallpapers/ssinclair_psychedelic.jpg"
}
