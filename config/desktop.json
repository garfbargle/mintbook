    "python3-cairo",
    "python3-cryptography",
    "gir1.2-gtk-3.0",
    "gir1.2-pango-1.0",
    "gir1.2-xfconf-0",
    "dbus-user-session",
    "dconf-cli",
    "desktop-file-utils",
    "rofi",
    "xdotool",
