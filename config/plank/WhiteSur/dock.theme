# Mintbook's WhiteSur-derived dock theme. Palette values come from
# ../../theme/mintbook-glass.ini; keep the original geometry and animation.

[PlankTheme]
TopRoundness=23
BottomRoundness=23
LineWidth=0
OuterStrokeColor=0;;0;;0;;0
FillStartColor=229;;231;;234;;150
FillEndColor=202;;205;;210;;150
InnerStrokeColor=255;;255;;255;;50

[PlankDockTheme]
HorizPadding=1
TopPadding=2
BottomPadding=2
ItemPadding=3
IndicatorSize=5
IconShadowSize=0
UrgentBounceHeight=2
LaunchBounceHeight=0.7
FadeOpacity=1
ClickTime=300
UrgentBounceTime=0
LaunchBounceTime=600
ActiveTime=300
SlideTime=100
HideTime=200
GlowSize=0
GlowTime=0
GlowPulseTime=0
UrgentHueShift=150
ItemMoveTime=200
CascadeHide=true
BadgeColor=0;;0;;0;;0
