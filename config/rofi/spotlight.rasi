/* macOS Spotlight-style rofi theme — tuned for 2304x1440 @ Xft.dpi 168
 *
 * rofi lays px out literally (it does not scale them by Xft.dpi), so every
 * size here is a real device pixel on the Retina panel: ~1.7x the values a
 * 96dpi theme would use, which is what puts it at macOS Spotlight's size. */

* {
    font:                        "Inter 18";
    bg:                          rgba(28, 28, 30, 88%);
    bg-alt:                      rgba(255, 255, 255, 8%);
    fg:                          #f2f2f7ff;
    fg-dim:                      rgba(242, 242, 247, 55%);
    accent:                      rgba(255, 255, 255, 14%);
    background-color:            transparent;
    text-color:                  @fg;
}

window {
    transparency:                "real";
    location:                    north;
    anchor:                      north;
    y-offset:                    14%;
    width:                       52%;
    border-radius:               24px;
    background-color:            @bg;
    children:                    [ mainbox ];
}

mainbox {
    padding:                     0px;
    children:                    [ inputbar, listview ];
}

inputbar {
    padding:                     26px 34px;
    spacing:                     22px;
    children:                    [ prompt, entry ];
}

prompt {
    enabled:                     true;
    text-color:                  @fg-dim;
    font:                        "Noto Sans Symbols 42";
    str:                         "⌕";
    vertical-align:              0.5;
}

entry {
    placeholder:                 "Spotlight Search";
    placeholder-color:           @fg-dim;
    font:                        "Inter 30";
    vertical-align:              0.5;
    cursor:                      text;
}

listview {
    columns:                     1;
    lines:                       8;
    fixed-height:                false;
    scrollbar:                   false;
    padding:                     10px 12px 16px 12px;
    spacing:                     4px;
    border:                      1px 0px 0px 0px;
    border-color:                @accent;
}

element {
    padding:                     12px 20px;
    spacing:                     20px;
    border-radius:               12px;
    children:                    [ element-icon, element-text ];
}

element normal.normal   { text-color: @fg; }
element alternate.normal{ text-color: @fg; }

element selected.normal {
    background-color:            rgba(255, 255, 255, 14%);
    text-color:                  @fg;
}

element-icon {
    size:                        52px;
    vertical-align:              0.5;
}

element-text {
    vertical-align:              0.5;
    highlight:                   bold;
}

message { padding: 14px 28px; }
textbox { text-color: @fg-dim; }
