# User service. Follows _NET_ACTIVE_WINDOW and weights the focused application's
# cgroup scope above the rest. See docs/feel.md.
#
# Install:  systemctl --user enable --now mintbook-focus-priority.service
# Undo:     systemctl --user disable --now mintbook-focus-priority.service
#           (the script also clears every weight it set when it stops)
[Unit]
Description=mintbook focus priority — weight the window you are looking at
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/mintbook/bin/focus-priority
ExecStopPost=%h/mintbook/bin/focus-priority --undo
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
