# User service. Reads the APT cache that is already on disk and writes what is
# waiting to ~/.cache/mintbook/updates.state, which is the only thing the bar
# indicator ever looks at. No root, no network, no writes outside $HOME — the
# package lists are refreshed by the popup's own button, or by whatever else
# on this machine refreshes them. See docs/updates.md.
[Unit]
Description=mintbook update check — what apt has waiting

[Service]
Type=oneshot
ExecStart=%h/mintbook/bin/updates-check
Nice=19
IOSchedulingClass=idle
