# A cheap signature ignores unrelated dconf writes. A single collector lock
# serializes timer/popup/path requests, and dpkg changes settle before checking.
[Unit]
Description=Notice package and live updater preference changes

[Path]
Unit=mintbook-updates-local.service
PathChanged=/var/cache/apt/pkgcache.bin
# Mint also watches package installation/removal and live preference changes.
# The service serializes checks and waits for dpkg's status file to settle.
PathChanged=/var/lib/dpkg/status
PathChanged=%h/.config/dconf/user
PathChanged=/var/lib/flatpak/.changed
PathChanged=%h/.local/share/flatpak/.changed

[Install]
WantedBy=paths.target
