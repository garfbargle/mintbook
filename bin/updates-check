#!/usr/bin/env python3
"""updates-check — what is waiting, written down for the bar and the popup.

Read-only, and no root. Two halves that behave differently and are kept apart
on purpose:

  **apt** is local. It walks the package cache already on disk and never
  fetches anything. Refreshing the lists is a separate, privileged thing and
  belongs to whoever asked for it — bin/updates-menu does it through aptkit,
  whose update-cache action is `allow_active=yes` and so needs no password.

  **flatpak** is not local. There is no cached "what is new" to read: asking
  means asking flathub, which is a network round trip of about two and a half
  seconds. So it is skipped when NetworkManager says there is no route out,
  and — this is the part that matters — a skipped or failed flatpak check
  *keeps the previous answer and the previous timestamp* rather than reporting
  a confident zero. An empty list because we could not look is not the same
  fact as an empty list because there is nothing there.

The work is Linux Mint's own: `checkAPT.APTCheck`, the same class behind
`mintupdate-cli list` and the Update Manager window, so a package is grouped,
named, typed and described here exactly as the Update Manager would group,
name, type and describe it. Reimplementing that against python-apt would have
been a second opinion about what an update *is*, and two opinions on the bar
is one too many.

It costs about 2.5 s of CPU for apt and about 2.5 s of waiting for flatpak,
which is why nothing polls it:

    bin/panel-updates      reads the state file below, and nothing else
    bin/panel-system      the same file, for its compact status badge
    bin/updates-menu       reads it on open, then re-runs this in a thread
    mintbook-updates-check.timer   runs it 5 min after login and every 6 h
    mintbook-updates-check.path    runs it when the APT cache is rebuilt

Two files come out, in ~/.cache/mintbook:

    updates.state   `key = value`, for the two tiny status readers
    updates.json    the list, for the popup

Both are written atomically, because the popup reads them without a lock.

    bin/updates-check            write both, print a summary line
    bin/updates-check --print    write both, then print the list
    bin/updates-check --json     write nothing, print the JSON
    bin/updates-check --no-net   apt only; leave the flatpak answer alone

See docs/updates.md.
"""
import json
import os
import sys
import time

MINT = '/usr/lib/linuxmint/mintUpdate'
CACHE = os.path.expanduser('~/.cache/mintbook')
STATE = f'{CACHE}/updates.state'
LIST = f'{CACHE}/updates.json'
BLACKLIST = '/etc/mintupdate.blacklist'

# Past this, sizes stop being fetched and the remaining flatpak rows report 0.
# Each fetch_remote_ref_sync() is a round trip of roughly half a second, and a
# check that takes half a minute to tell you a size is not worth the size.
SIZE_BUDGET = 6.0


def blacklisted():
    """/etc/mintupdate.blacklist, the file the Update Manager's own ignore
    list writes. Honouring it is what keeps this from disagreeing with the
    Update Manager about how many updates there are."""
    out = []
    try:
        with open(BLACKLIST) as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith('#'):
                    out.append(line)
    except OSError:
        pass
    return out


def ignored(patterns, source_name, version):
    import fnmatch
    for pattern in patterns:
        pkg, _, ver = pattern.partition('=')
        if fnmatch.fnmatch(source_name, pkg) and (not ver or ver == version):
            return True
    return False


# ------------------------------------------------------------------- flatpak

def online():
    """NetworkManager's cached answer, not a probe. The *property* costs 15 ms;
    CheckConnectivity() goes and asks the network. bin/panel-wifi reads the
    same one for the same reason — see docs/desktop.md.

    4 is full, 2 is a captive portal, 3 is limited, 1 is none. Anything that is
    not a clear "no" is treated as a yes: being wrong the optimistic way costs
    a timeout, being wrong the other way silently reports no flatpak updates.
    """
    import subprocess
    try:
        out = subprocess.run(
            ['busctl', '--system', 'get-property',
             'org.freedesktop.NetworkManager',
             '/org/freedesktop/NetworkManager',
             'org.freedesktop.NetworkManager', 'Connectivity'],
            capture_output=True, text=True, timeout=5).stdout
    except Exception:
        return True                  # no NetworkManager to ask; try anyway
    return out.strip().split()[-1] != '1' if out.strip() else True


def installations():
    import gi
    gi.require_version('Flatpak', '1.0')
    from gi.repository import Flatpak
    out = []
    for scope, make in (('user', Flatpak.Installation.new_user),
                        ('system', Flatpak.Installation.new_system)):
        try:
            out.append((scope, make()))
        except Exception:
            pass                      # a scope that does not exist is not news
    return out


def flatpaks():
    """What flathub has that this machine does not.

    `list_installed_refs_for_update()` is the same question `flatpak update`
    asks, and it is a network call — about 2.5 s against flathub. Sizes are a
    second round trip each, so they run against a budget and the rows past it
    honestly report 0 rather than making the check take a minute.

    Apps get their appdata name; runtimes and extensions keep their ref name,
    because that is what `flatpak update` calls them and inventing a friendlier
    label for `org.freedesktop.Platform.GL.default` would only make it harder
    to match up the two.
    """
    import gi
    gi.require_version('Flatpak', '1.0')
    from gi.repository import Flatpak

    rows = []
    start = time.monotonic()
    for scope, inst in installations():
        for ref in inst.list_installed_refs_for_update(None):
            app = ref.get_kind() == Flatpak.RefKind.APP
            size = 0
            if time.monotonic() - start < SIZE_BUDGET:
                try:
                    remote = inst.fetch_remote_ref_sync(
                        ref.get_origin(), ref.get_kind(), ref.get_name(),
                        ref.get_arch(), ref.get_branch(), None)
                    size = int(remote.get_download_size() or 0)
                except Exception:
                    size = 0
            rows.append({
                'name': (ref.get_appdata_name() if app else ref.get_name())
                        or ref.get_name(),
                'source': ref.get_name(),
                # There is no "new version" here. A FlatpakRemoteRef carries a
                # commit and two sizes, not appdata, so the version on the far
                # side is not knowable without pulling and parsing the remote's
                # appstream. The row shows what you have and leaves it there
                # rather than printing a guess with an arrow in front of it.
                'old': ref.get_appdata_version() or '',
                'new': '',
                'size': size,
                'type': 'flatpak',
                'origin': f"{ref.get_origin()} · {scope}"
                          + ('' if app else ' · runtime'),
                'summary': (ref.get_appdata_summary() or '').strip(),
                # Everything the installer needs to find this again, without
                # having to guess a scope or re-derive an arch.
                'flatpak': {'scope': scope, 'ref': ref.format_ref(),
                            'app': app},
                'packages': [],
            })
    rows.sort(key=lambda r: (not r['flatpak']['app'], r['name'].lower()))
    return rows


def previous():
    """The last answer on disk, for carrying a flatpak result forward when we
    could not go and get a new one."""
    try:
        with open(LIST) as f:
            data = json.load(f)
        return ([r for r in data.get('updates', []) if r.get('type') == 'flatpak'],
                int(data.get('flatpak_checked', 0) or 0))
    except (OSError, ValueError, TypeError):
        return [], 0


# ----------------------------------------------------------------------- apt

def collect():
    """The updates, as plain dicts. Raises whatever APTCheck raises."""
    sys.path.insert(0, MINT)
    from checkAPT import APTCheck                                  # noqa: E402
    from Classes import PRIORITY_UPDATES                           # noqa: E402

    check = APTCheck()
    check.find_changes()
    check.load_aliases()
    check.apply_aliases()
    check.clean_descriptions()

    skip = blacklisted()
    rows = []
    for update in check.get_updates():
        if (update.source_name not in PRIORITY_UPDATES
                and ignored(skip, update.real_source_name, update.new_version)):
            continue
        rows.append({
            'name': update.display_name,
            'source': update.source_name,
            'old': update.old_version,
            'new': update.new_version,
            'size': int(update.size or 0),
            'type': update.type,          # package | security | kernel | unstable
            'origin': getattr(update, 'origin', ''),
            'summary': (update.short_description or '').strip(),
            'packages': list(update.package_names),
        })
    # Security first, then kernel, then by name — the order you would install
    # them in if you were only going to install some of them.
    rank = {'security': 0, 'kernel': 1}
    rows.sort(key=lambda r: (rank.get(r['type'], 2), r['name'].lower()))
    return rows


def write(rows, error='', fp_checked=0, fp_error=''):
    os.makedirs(CACHE, exist_ok=True)
    now = int(time.time())
    payload = {'checked': now, 'error': error,
               'flatpak_checked': fp_checked, 'flatpak_error': fp_error,
               'updates': rows}
    atomic(LIST, json.dumps(payload, indent=1))
    # The state file exists so that the two readers on the hot path — a genmon
    # tick and a Control Center plugin, both bash — never have to parse JSON.
    # Same `key = value` shape the Control Center plugins already speak.
    #
    # `count` is everything, apt and flatpak together, because that is the
    # number the bar is answering: how many things are waiting to be installed.
    # `flatpak` is broken out beside it so the tile can say so without JSON.
    atomic(STATE, ''.join(f'{k} = {v}\n' for k, v in (
        ('checked', now),
        ('count', len(rows)),
        ('security', sum(1 for r in rows if r['type'] == 'security')),
        ('kernel', sum(1 for r in rows if r['type'] == 'kernel')),
        ('flatpak', sum(1 for r in rows if r['type'] == 'flatpak')),
        ('flatpak_checked', fp_checked),
        ('size', sum(r['size'] for r in rows)),
        ('first', rows[0]['name'] if rows else ''),
        ('error', error),
    )))
    return payload


def atomic(path, text):
    """The popup reads these while this runs. A rename is how it never sees
    half a file."""
    tmp = f'{path}.{os.getpid()}'
    with open(tmp, 'w') as f:
        f.write(text)
    os.replace(tmp, path)


def human(n):
    for unit in ('B', 'kB', 'MB', 'GB'):
        if n < 1024 or unit == 'GB':
            return f'{n:.0f} {unit}' if unit == 'B' else f'{n:.1f} {unit}'
        n /= 1024.0


def main():
    args = sys.argv[1:]
    error = ''
    try:
        rows = collect()
    except Exception as exc:
        # A failure here is a fact about the machine, not a crash: apt is busy,
        # or a source is broken. It goes in the file so the popup can say so
        # rather than showing a confident zero.
        rows, error = [], f'{type(exc).__name__}: {exc}'[:200]

    # The flatpak half. Every way of not getting a fresh answer ends in the
    # same place: keep the last one, keep its timestamp, and say why. The one
    # thing that must never happen is an empty list dated now.
    fp_rows, fp_checked = previous()
    fp_error = ''
    if '--no-net' in args:
        fp_error = 'skipped (--no-net)'
    elif not online():
        fp_error = 'skipped, no route to the network'
    else:
        try:
            fp_rows, fp_checked, fp_error = flatpaks(), int(time.time()), ''
        except Exception as exc:
            fp_error = f'{type(exc).__name__}: {exc}'[:200]
    rows = rows + fp_rows

    if '--json' in args:
        json.dump({'checked': int(time.time()), 'error': error,
                   'flatpak_checked': fp_checked, 'flatpak_error': fp_error,
                   'updates': rows}, sys.stdout, indent=1)
        print()
        return 1 if error else 0

    write(rows, error, fp_checked, fp_error)
    if error:
        print(f'could not read the APT cache: {error}', file=sys.stderr)
        return 1
    if fp_error:
        print(f'flatpak: {fp_error} — kept the answer from '
              + (time.strftime('%H:%M', time.localtime(fp_checked)) if fp_checked
                 else 'nowhere, there is none yet'), file=sys.stderr)
    if '--print' in args:
        for row in rows:
            arrow = f"{row['old'] or '—'} → {row['new']}" if row['new'] else \
                    (row['old'] or row['origin'])
            print(f"{row['type']:<9} {row['name']:<38} {arrow}  "
                  f"{human(row['size'])}")
    total = sum(r['size'] for r in rows)
    sec = sum(1 for r in rows if r['type'] == 'security')
    fpn = sum(1 for r in rows if r['type'] == 'flatpak')
    print(f'{len(rows)} updates, {human(total)}'
          + (f', {sec} security' if sec else '')
          + (f', {fpn} flatpak' if fpn else '')
          + f' · {STATE}')
    return 0


if __name__ == '__main__':
    sys.exit(main())
