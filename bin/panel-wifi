#!/usr/bin/env bash
# Wifi indicator for xfce4-genmon-plugin.
# Replaces nm-applet's XApp tray icon, which xapp-status-plugin pins at 20px
# regardless of any panel setting. genmon renders an <img> at the SVG's own
# size, so this matches the other panel icons.
DIR="$HOME/.local/share/mintbook/wifi"
MENU="$HOME/.local/bin/wifi-menu"

# The click used to open nm-connection-editor, which is a window; it opens
# bin/wifi-menu now, which is the popup, and which still has Network Settings…
# in its footer for the things a popup should not try to be. Falling back to
# the editor when the menu is not installed is what makes
# `wifi-install --revert` a single `rm`.
[ -x "$MENU" ] || MENU=nm-connection-editor

# emitted on every path, including the early exits below
printf '<click>%s</click>\n<iconclick>%s</iconclick>\n' "$MENU" "$MENU"

# The interface comes from sysfs, not /proc/net/wireless. That file is the
# legacy WEXT stats table and brcmfmac (cfg80211) leaves it empty, so using it
# to find the device reported "No wireless device" on a working radio whenever
# the card was merely unassociated — which is exactly when the bar most needs
# to say "Disconnected". sysfs knows the interface in every link state;
# /proc/net/wireless is still read below, for link quality once associated.
iface=''
for d in /sys/class/net/*/wireless; do
    [ -d "$d" ] || continue
    d=${d%/wireless}; iface=${d##*/}; break
done
if [ -z "$iface" ]; then
    printf '<img>%s/wifi-off.svg</img>\n<tool>Wi-Fi\nNo wireless device</tool>\n' "$DIR"; exit 0
fi

qual=$(awk -v i="$iface" '$1 == i":" { q=$3; sub(/\./,"",q); print q+0; exit }' \
    /proc/net/wireless 2>/dev/null)
[ -n "$qual" ] || qual=0

# carrier tells us association state; quality alone reads 0 while connecting
carrier=$(cat "/sys/class/net/$iface/carrier" 2>/dev/null || echo 0)
if [ "$carrier" != "1" ]; then
    printf '<img>%s/wifi-off.svg</img>\n<tool>Wi-Fi\nDisconnected</tool>\n' "$DIR"; exit 0
fi

pct=$(( qual * 100 / 70 ))
[ "$pct" -gt 100 ] && pct=100
if   [ "$pct" -ge 70 ]; then lvl=3
elif [ "$pct" -ge 40 ]; then lvl=2
elif [ "$pct" -ge 15 ]; then lvl=1
else                         lvl=0
fi

ssid=$(/usr/sbin/iwgetid -r 2>/dev/null)

# Associated is not the same as online. Three full bars while the uplink is
# dead, or while a hotel portal is holding the connection, is the icon telling
# a confident lie — so ask NetworkManager what it last decided:
# 1 none, 2 behind a portal, 3 limited, 4 full.
#
# The *property*, not CheckConnectivity(): the property is NM's cached answer
# and costs 15 ms, the method goes and asks the network. That 15 ms is on
# every tick where the card is associated and takes panel-wifi from ~30 ms to
# ~45 ms — 0.9% of a core rather than 0.56%. See docs/desktop.md.
conn=$(busctl --system get-property org.freedesktop.NetworkManager \
  /org/freedesktop/NetworkManager org.freedesktop.NetworkManager \
  Connectivity 2>/dev/null)
case "${conn##* }" in
  1) state='No internet' ;;
  2) state='Sign-in required' ;;
  3) state='Limited connection' ;;
  *) state='' ;;                # 4 full, 0 unknown, or no NetworkManager
esac

if [ -n "$state" ]; then
  printf '<img>%s/wifi-warn.svg</img>\n' "$DIR"
  if [ -n "$ssid" ]; then
    printf '<tool>Wi-Fi\n%s · %s</tool>\n' "$ssid" "$state"
  else
    printf '<tool>Wi-Fi\n%s</tool>\n' "$state"
  fi
else
  printf '<img>%s/wifi-%s.svg</img>\n' "$DIR" "$lvl"
  if [ -n "$ssid" ]; then
    printf '<tool>Wi-Fi\n%s</tool>\n' "$ssid"
  else
    printf '<tool>Wi-Fi</tool>\n'
  fi
fi
