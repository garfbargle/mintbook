#!/usr/bin/env bash
# updates-install — the software-update popup and the timer that keeps it
# honest. On the current desktop its status lives in the System icon; older
# installs retain the standalone conditional indicator. No root.
#
#   bin/updates-install            # popup/cache/timer; System shows status
#   bin/updates-install --revert   # those off; nothing installed is removed
#
# Nothing here touches APT, and nothing here needs a password. The privileged
# half lives in aptkit, which the popup talks to when you press a button.
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
# Installed desktops route feature changes through the release transaction.
if [ "${MINTBOOK_INSTALL_TRANSACTION:-}" != 1 ] && [ -e "$HOME/.local/lib/mintbook/current/manifest.json" ]; then
  exec "$ROOT/bin/desktop-install" --feature "$(basename "$0")" "$@"
fi
if [ "${MINTBOOK_PANEL_MAINTENANCE:-}" != 1 ]; then
  exec "$ROOT/bin/panel-session" maintain -- "$0" "$@"
fi

BIN="$HOME/.local/bin"
SHARE="$HOME/.local/share/mintbook/control-center/plugins"
PANEL_RC="$HOME/.config/xfce4/panel"
UNITS="$HOME/.config/systemd/user"
STATE="$HOME/.config/mintbook"
CONF="$STATE/updates.conf"
SAVED="$STATE/panel-ids.before-updates"
AUTOSTART="$HOME/.config/autostart"
MINTUPDATE_AUTOSTART="$AUTOSTART/mintupdate.desktop"
MINTUPDATE_SAVED="$STATE/mintupdate.desktop.before-updates"
MINTUPDATE_WAS_ABSENT="$STATE/mintupdate.desktop.absent-before-updates"
PLUGIN=20
AFTER=10        # the indicator sits to the left of the CPU sparkline

current_ids() {
  xfconf-query -c xfce4-panel -p /panels/panel-1/plugin-ids | grep -oE '^[0-9]+$'
}

write_ids() {
  local args=() id
  for id in "$@"; do args+=(-t int -s "$id"); done
  xfconf-query -c xfce4-panel -p /panels/panel-1/plugin-ids --force-array "${args[@]}"
}

if [ "${1:-}" = --revert ]; then
  echo "==> timer and cache watch"
  systemctl --user disable --now mintbook-updates-check.timer 2>/dev/null || true
  systemctl --user disable --now mintbook-updates-check.path 2>/dev/null || true

  systemctl --user stop mintbook-updates-local.service mintbook-updates-check.service 2>/dev/null || true

  echo "==> Mint Update Manager autostart"
  if [ -e "$MINTUPDATE_SAVED" ]; then
    install -dm755 "$AUTOSTART"
    install -m644 "$MINTUPDATE_SAVED" "$MINTUPDATE_AUTOSTART"
  elif [ -e "$MINTUPDATE_WAS_ABSENT" ]; then
    rm -f "$MINTUPDATE_AUTOSTART"
  fi
  rm -f "$MINTUPDATE_SAVED" "$MINTUPDATE_WAS_ABSENT"

  echo "==> panel"
  ids=$(current_ids | tr '\n' ' ')
  "$ROOT/bin/panel-session" stop 2>/dev/null || true
  sleep 0.4
  out=(); for id in $ids; do [ "$id" = "$PLUGIN" ] || out+=("$id"); done
  write_ids "${out[@]}"
  "$ROOT/bin/panel-session" start

  echo "==> files"
  # Leave an active popup worker alive; it may be installing Flatpaks.
  echo "Close the update popup after any active job has finished."
  rm -f "$BIN/panel-updates" "$BIN/updates-menu" "$BIN/updates-check"
  rm -f "$SHARE/70-updates" "$CONF"
  rm -rf "$HOME/.local/share/mintbook/updates"
  echo
  echo "plugin-$PLUGIN stays registered but unused; the cached list in"
  echo "~/.cache/mintbook/updates.json is left alone — delete it if you want it gone"
  echo "Mint's Update Manager autostart was restored; run 'mintupdate' to open it"
  exit 0
fi

[ -n "${DISPLAY:-}" ] || { echo "DISPLAY is unset" >&2; exit 1; }
command -v mintupdate-cli >/dev/null \
  || echo "note: mintupdate is not installed — bin/updates-check needs its checkAPT" >&2

echo "==> $BIN"
install -dm755 "$BIN"
for f in panel-updates updates-menu updates-check mintbook_keys.py mintbook_instance.py; do
  rm -f "$BIN/$f"                       # it may be running; replace, don't write
  install -m755 "$ROOT/bin/$f" "$BIN/$f"
done

echo "==> icons"
# The generator defaults to white, which is right for a dark bar and invisible
# on a light one. bin/appearance-mode owns this file and re-runs every panel
# generator when the appearance changes; read it here so a fresh install on a
# light bar does not paint white-on-white until the next appearance switch.
FG='#ffffff'
# shellcheck disable=SC1090
[ -r "$STATE/system-chrome.env" ] \
  && . "$STATE/system-chrome.env" \
  && FG=$PANEL_FOREGROUND
MINTBOOK_PANEL_FG="$FG" python3 "$ROOT/icons/generate-updates-genmon.py"

echo "==> $CONF"
install -dm755 "$STATE"
if [ ! -e "$CONF" ]; then
  cat > "$CONF" <<CONFEOF
# mintbook software updates. Read by bin/updates-menu.
PANEL_ID=$PLUGIN   # so the popup can tell genmon to repaint after an install
CONFEOF
else
  grep -q '^PANEL_ID=' "$CONF" || printf 'PANEL_ID=%s\n' "$PLUGIN" >> "$CONF"
fi

# Updates moved to the System sheet. Clear the old Control Center tile when
# upgrading an existing installation.
rm -f "$SHARE/70-updates"

echo "==> disabling Mint's duplicate tray icon"
install -dm755 "$AUTOSTART"
if [ ! -e "$MINTUPDATE_SAVED" ] && [ ! -e "$MINTUPDATE_WAS_ABSENT" ]; then
  if [ -e "$MINTUPDATE_AUTOSTART" ]; then
    install -m644 "$MINTUPDATE_AUTOSTART" "$MINTUPDATE_SAVED"
  else
    : > "$MINTUPDATE_WAS_ABSENT"
  fi
fi
install -m644 "$ROOT/config/autostart/mintupdate.desktop" "$MINTUPDATE_AUTOSTART"
# The override takes effect at the next login. An existing Mint Update Manager
# may own a Flatpak worker, so never kill it during an installer rerun.

echo "==> genmon-$PLUGIN.rc"
install -dm755 "$PANEL_RC"
sed "s|^Command=.*|Command=$BIN/panel-updates|" \
  "$ROOT/config/xfce4-panel/genmon-$PLUGIN.rc" > "$PANEL_RC/genmon-$PLUGIN.rc"

echo "==> panel"
[ -s "$SAVED" ] || current_ids | tr '\n' ' ' > "$SAVED"

# Running plugins write xfconf back on shutdown, so stop the panel first.
ids=$(current_ids | tr '\n' ' ')
"$ROOT/bin/panel-session" stop 2>/dev/null || true
sleep 0.4
xfconf-query -c xfce4-panel -p "/plugins/plugin-$PLUGIN" -n -t string -s genmon 2>/dev/null || true

# With the System menu installed, its small badge replaces the conditional
# update arrow. Otherwise retain the legacy placement for a standalone update
# installation.
out=(); placed=0
for id in $ids; do
  [ "$id" = "$PLUGIN" ] && continue
  out+=("$id")
  if [ ! -e "$STATE/system.conf" ] && [ "$id" = "$AFTER" ]; then
    out+=("$PLUGIN"); placed=1
  fi
done
if [ ! -e "$STATE/system.conf" ] && [ "$placed" = 0 ]; then out=("$PLUGIN" "${out[@]}"); fi
write_ids "${out[@]}"

"$ROOT/bin/panel-session" start
sleep 1

echo "==> timer and cache watch"
install -dm755 "$UNITS"
install -m644 "$ROOT/config/systemd/mintbook-updates-check.service" "$UNITS/"
install -m644 "$ROOT/config/systemd/mintbook-updates-local.service" "$UNITS/"
install -m644 "$ROOT/config/systemd/mintbook-updates-check.timer" "$UNITS/"
# The timer is the floor; the path unit is what keeps the badge from sitting
# hours behind a refresh that has already happened. See the unit's own header.
install -m644 "$ROOT/config/systemd/mintbook-updates-check.path" "$UNITS/"
systemctl --user daemon-reload
systemctl --user enable --now mintbook-updates-check.timer
systemctl --user enable --now mintbook-updates-check.path

echo "==> first check"
timeout 120 "$BIN/updates-check" || true
# No panel nudge here any more. The `--plugin-event=plugin-<id>` form this
# sent matched nothing — the panel matches on the plugin *name* — and the
# working form reaches only the first genmon widget on the bar, which is the
# CPU sparkline. The panel was restarted forty lines up in any case, so every
# widget on it is already fresh. See docs/desktop.md.

echo
echo "bar: ${out[*]}"
if [ -e "$STATE/system.conf" ]; then
  echo "updates appear in the System menu; its badge changes when something is waiting"
else
  echo "the standalone icon is only there when something is waiting"
fi
echo "undo: $(basename "$0") --revert"
