#!/usr/bin/env python3
"""Mintbook Control Center — the macOS/iOS-style panel behind the bar icon.

Everything in it is a *plugin*: a small executable that prints what its tile
should say and takes one `set` argument when the tile is used. Nothing about
Wi-Fi, volume or the power profile is known to this file. See
docs/control-center.md for the eight-line contract.

Drawn entirely in cairo rather than themed GTK widgets. The panel has to sit on
top of WhiteSur without inheriting it, and every tile is a shape the theme has
no opinion about anyway. It is also an override-redirect window, for the same
reason bin/power-menu is: genmon spawns its click command with
g_spawn_command_line_async, there is no Gdk event behind it, and xfwm4 rejects
a Gtk.Menu grab at time 0.
"""
import math
import os
import signal
import subprocess
import sys
import time
from concurrent.futures import ThreadPoolExecutor

T0 = time.monotonic()      # MINTBOOK_CC_TIME=1 reports against this
PLUGINS = os.path.expanduser('~/.local/share/mintbook/control-center/plugins')


def plugin_paths():
    try:
        names = sorted(os.listdir(PLUGINS))
    except OSError:
        return []
    paths = [os.path.join(PLUGINS, n) for n in names
             if not n.startswith('.') and not n.endswith(('.md', '.disabled'))]
    return [p for p in paths if os.access(p, os.X_OK)]


def launch(paths):
    started = []
    for path in paths:
        try:
            started.append((path, subprocess.Popen(
                [path, 'read'], stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL, text=True)))
        except OSError:
            started.append((path, None))
    return started


# Deliberately before the GTK import. Importing Gtk/Gdk/Pango costs ~220 ms on
# this chip and reading the nine plugins costs ~210 ms; back to back, that is
# most of the time between the click and the panel. The plugins are separate
# processes, so they can spend their time inside the import instead.
PENDING = launch(plugin_paths())

# GTK_THEME before the Gtk import, because Gtk.init is what reads it and a
# theme cannot be unset afterwards. WhiteSur's gtk.css is 400 KB, and parsing
# it is ~190 ms of Gtk.init against Adwaita's ~70 — interleaved, five runs
# each. Nothing here spends any of it: everything visible is cairo on a
# DrawingArea, the only widgets are a POPUP window and a Box, and dark/light
# comes from appearance.applied rather than from the GTK theme. The stylesheet
# was being parsed and thrown away, once per click. setdefault rather than
# assignment, so `GTK_THEME=WhiteSur-Light control-center` still A/Bs it.
os.environ.setdefault('GTK_THEME', 'Adwaita')

# Where the pointer is now, which is where the icon was clicked: this popup
# hangs off that icon, and clicking it is the only way to get here.
#
# Read synchronously, and deliberately *not* hidden behind the GTK import the
# way the readings above are. Hiding it is what broke it. Spawned as a Popen
# the child is descheduled behind this process's own ~500 ms of CPU-bound
# import — on two cores there is nowhere else for it to run — so xdotool
# sampled the pointer after the import rather than before it, and returned the
# same late position the Gdk read did: click the icon, move the mouse away, and
# the popup opened where the mouse had got to. Costs ~12 ms, paid in full.
try:
    _ptr = subprocess.run(['xdotool', 'getmouselocation', '--shell'],
                          capture_output=True, text=True, timeout=3).stdout
    _ptr = dict(p.split('=', 1) for p in _ptr.split() if '=' in p)
    PTR_XY = (int(_ptr['X']), int(_ptr['Y']))
except Exception:
    PTR_XY = None

import gi                                                          # noqa: E402
gi.require_version('Gtk', '3.0')
gi.require_version('PangoCairo', '1.0')
from gi.repository import Gtk, Gdk, GLib, Pango, PangoCairo        # noqa: E402
APPLIED = os.path.expanduser('~/.config/mintbook/appearance.applied')
PIDFILE = os.path.expanduser('~/.cache/mintbook/control-center.pid')

# Panel geometry. WIDTH is macOS Control Center's 330 plus a little, because
# three-option segments ("Power Saver / Balanced / Sustained") need the room.
# All geometry below is in 1x units. XFCE only does integer window scaling, so
# this display runs WindowScalingFactor=1 with Xft/DPI at 168 — every
# pixel-sized thing has to be scaled by hand (see docs/display.md). The cairo
# context is scaled by SC once, and the rest of this file can stay in 1x.
SC = round((Gdk.Screen.get_default().get_resolution() or 96) / 96.0, 3) or 1.0
# Twelve columns rather than four, because a `cycle` tile is a third of the
# width and a third of four columns is not a column. Spanning n columns is
# n*COLW plus the n-1 gaps it swallows, so 6-of-12 is exactly the width
# 2-of-4 was: every tile that existed before the grid changed is the same
# size after it.
WIDTH, COLS, PAD, GAP, SHADOW = 356, 12, 14, 10, 16
RADIUS, TILE_RADIUS = 18, 12
COLW = (WIDTH - 2 * PAD - (COLS - 1) * GAP) / COLS
ROWH = {'toggle': 66, 'segment': 58, 'slider': 58, 'meter': 66,
        'cycle': 78, 'menu': 48}
SPAN = {'toggle': 6, 'segment': 12, 'slider': 12, 'meter': 6,
        'cycle': 4, 'menu': 12}
# The chevron is five pixels of hairline; this is the strip of tile that
# counts as clicking it. A 6-column toggle is 159 wide, so 40 gives a quarter
# of it to the door and leaves the rest to the switch — the old 26 was narrow
# enough that aiming for one reliably got the other. See _detail_zone.
DETAIL_W = 40

# The popup glass. Canonical values live in config/theme/mintbook-glass.ini
# under [PopupLight] / [PopupDark], and are hardcoded here the way
# config/firefox/userChrome.css and the rofi palettes hardcode theirs: a popup
# that has to find and parse a file before it can paint is a popup that can
# fail to paint. Alphas are the same numbers, as 0-1 rather than 0-255.
LIGHT = {  # generated by bin/palette-generate
    'top': (229, 231, 234, 0.980392),
    'bottom': (202, 205, 210, 0.968627),
    'edge': (255, 255, 255, 0.74902),
    'rim': (65, 68, 74, 0.180392),
    'fg': (45, 48, 54),
    'tile': (255, 255, 255, 0.54902),
    'tile_hi': (255, 255, 255, 0.780392),
    'tile_edge': (255, 255, 255, 0.65098),
    'track': (65, 68, 74, 0.129412),
    'fill': (255, 255, 255, 0.94902),
    'on_fill': (45, 48, 54),
    'accent': (0, 122, 255),
    'seg': (65, 68, 74, 0.101961),
    'seg_on': (255, 255, 255, 0.94902),
    'menu': (250, 250, 252, 0.988235),
}
DARK = {  # generated by bin/palette-generate
    'top': (104, 109, 119, 0.976471),
    'bottom': (74, 78, 86, 0.968627),
    'edge': (255, 255, 255, 0.180392),
    'rim': (0, 0, 0, 0.34902),
    'fg': (255, 255, 255),
    'tile': (255, 255, 255, 0.129412),
    'tile_hi': (255, 255, 255, 0.2),
    'tile_edge': (255, 255, 255, 0.101961),
    'track': (255, 255, 255, 0.160784),
    'fill': (255, 255, 255, 0.921569),
    'on_fill': (48, 51, 58),
    'accent': (10, 132, 255),
    'seg': (0, 0, 0, 0.2),
    'seg_on': (255, 255, 255, 0.278431),
    'menu': (96, 101, 111, 0.988235),
}


# ---------------------------------------------------------------- plugin I/O

TRUE = ('on', 'true', 'yes', '1', 'active', 'enabled')
# Which `cycle` states draw unlit. Not simply "not TRUE": `auto`, `light` and
# `balanced` are none of them on, and all three are a setting doing something.
OFF = ('off', 'false', 'no', '0', 'none', 'disabled')


def parse(text):
    """A plugin's stdout -> a spec dict.

    `key = value` lines, because a plugin should be writable in bash without
    quoting anything. Repeat `option` to build a segment. A leading `{` is
    taken as JSON instead, for values that need newlines or awkward characters.
    """
    text = text.strip()
    if text.startswith('{'):
        import json
        return json.loads(text)
    spec = {}
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith('#') or '=' not in line:
            continue
        key, _, val = line.partition('=')
        key, val = key.strip(), val.strip()
        if key == 'option':
            # key|Label|glyph|#accent — everything after the key is optional,
            # and only `cycle` reads the last two.
            f = [p.strip() for p in val.split('|')] + ['', '', '']
            spec.setdefault('options', []).append(
                [f[0], f[1] or f[0], f[2], f[3]])
        elif key == 'graph':
            spec['graph'] = [float(v) for v in val.replace(',', ' ').split() if v]
        else:
            spec[key] = val
    return spec


def spec_from(path, out, error=None):
    if error is None:
        try:
            spec = parse(out)
        except Exception as e:
            error, spec = e, {}
    else:
        spec = {}
    if error is not None:
        # A plugin that breaks gets a tile that says so, not a missing row.
        spec = {"kind": "meter", "title": os.path.basename(path),
                "subtitle": str(error)[:40], "value": "!"}
    spec["path"] = path
    spec["name"] = os.path.basename(path)
    return spec


def read_plugin(path):
    """One plugin, synchronously: the live refresh and the post-set re-read."""
    try:
        return spec_from(path, subprocess.run(
            [path, "read"], capture_output=True, text=True, timeout=4).stdout)
    except Exception as e:
        return spec_from(path, "", e)


def collect(pending):
    """The prefetched batch, in plugin-name order."""
    specs = []
    for path, proc in pending:
        if proc is None:
            specs.append(spec_from(path, "", "could not run"))
            continue
        try:
            specs.append(spec_from(path, proc.communicate(timeout=4)[0]))
        except Exception as e:
            proc.kill()
            specs.append(spec_from(path, "", e))
    return [s for s in specs
            if s.get("kind") in ROWH and str(s.get("skip", "")).lower() not in TRUE]


# ------------------------------------------------------------------- drawing

def rgba(cr, c, alpha=None):
    a = c[3] if len(c) > 3 else 1.0
    cr.set_source_rgba(c[0] / 255, c[1] / 255, c[2] / 255,
                       a if alpha is None else a * alpha)


def rrect(cr, x, y, w, h, r):
    r = min(r, w / 2, h / 2)
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


def text(cr, s, x, y, size, color, alpha=1.0, weight='normal', align=None, width=0):
    layout = PangoCairo.create_layout(cr)
    font = Pango.FontDescription('Inter Semi-Bold' if weight == 'bold' else 'Inter')
    # Absolute size, in the context's own units: the layout must not pick up
    # the 96 dpi a bare cairo context reports while SC already carries the DPI.
    font.set_absolute_size(size * Pango.SCALE)
    layout.set_font_description(font)
    layout.set_text(str(s), -1)
    layout.set_ellipsize(Pango.EllipsizeMode.END)
    if width:
        layout.set_width(int(width * Pango.SCALE))
        if align == 'center':
            layout.set_alignment(Pango.Alignment.CENTER)
        elif align == 'right':
            layout.set_alignment(Pango.Alignment.RIGHT)
    rgba(cr, color, alpha)
    cr.move_to(x, y)
    PangoCairo.show_layout(cr, layout)
    return layout.get_pixel_size()


# Glyphs are cairo paths in a unit box so a plugin can name one and get an
# icon that is crisp at any size and takes the panel's own colour. Adding one
# is a function and a line in GLYPHS.

def _wifi(cr, s):
    cr.set_line_width(.085 * s)
    cr.set_line_cap(cairo_round())
    for r in (.46, .31, .16):
        cr.new_sub_path()
        cr.arc(.5 * s, .78 * s, r * s, math.pi * 1.22, math.pi * 1.78)
        cr.stroke()
    cr.arc(.5 * s, .77 * s, .055 * s, 0, 2 * math.pi)
    cr.fill()


def _bluetooth(cr, s):
    cr.set_line_width(.09 * s)
    cr.set_line_cap(cairo_round())
    cr.set_line_join(cairo_round_join())
    cr.move_to(.28 * s, .30 * s)
    cr.line_to(.72 * s, .70 * s)
    cr.line_to(.50 * s, .88 * s)
    cr.line_to(.50 * s, .12 * s)
    cr.line_to(.72 * s, .30 * s)
    cr.line_to(.28 * s, .70 * s)
    cr.stroke()


def _moon(cr, s):
    # A crescent is one disc minus another, and cairo's fill rules will not do
    # it alone: even-odd also fills the part of the bite that hangs outside.
    # Clip to the disc first, then fill everything but the bite.
    cr.save()
    cr.arc(.5 * s, .5 * s, .42 * s, 0, 2 * math.pi)
    cr.clip()
    cr.set_fill_rule(cairo_even_odd())
    cr.rectangle(0, 0, s, s)
    cr.new_sub_path()
    cr.arc(.70 * s, .26 * s, .50 * s, 0, 2 * math.pi)
    cr.fill()
    cr.restore()


def _sun(cr, s):
    cr.arc(.5 * s, .5 * s, .21 * s, 0, 2 * math.pi)
    cr.fill()
    cr.set_line_width(.075 * s)
    cr.set_line_cap(cairo_round())
    for i in range(8):
        a = i * math.pi / 4
        cr.move_to(.5 * s + math.cos(a) * .32 * s, .5 * s + math.sin(a) * .32 * s)
        cr.line_to(.5 * s + math.cos(a) * .44 * s, .5 * s + math.sin(a) * .44 * s)
    cr.stroke()


def _speaker(cr, s):
    cr.move_to(.10 * s, .36 * s)
    cr.line_to(.26 * s, .36 * s)
    cr.line_to(.46 * s, .16 * s)
    cr.line_to(.46 * s, .84 * s)
    cr.line_to(.26 * s, .64 * s)
    cr.line_to(.10 * s, .64 * s)
    cr.close_path()
    cr.fill()
    cr.set_line_width(.075 * s)
    cr.set_line_cap(cairo_round())
    for r in (.16, .30):
        cr.new_sub_path()
        cr.arc(.50 * s, .50 * s, (r + .12) * s, -math.pi / 3.2, math.pi / 3.2)
        cr.stroke()


def _display(cr, s):
    cr.set_line_width(.08 * s)
    rrect(cr, .08 * s, .16 * s, .84 * s, .56 * s, .10 * s)
    cr.stroke()
    cr.set_line_cap(cairo_round())
    cr.move_to(.32 * s, .86 * s)
    cr.line_to(.68 * s, .86 * s)
    cr.stroke()


def _cpu(cr, s):
    cr.set_line_width(.075 * s)
    cr.set_line_cap(cairo_round())
    rrect(cr, .22 * s, .22 * s, .56 * s, .56 * s, .08 * s)
    cr.stroke()
    rrect(cr, .38 * s, .38 * s, .24 * s, .24 * s, .04 * s)
    cr.fill()
    for f in (.34, .5, .66):          # four sets of pins, one per edge
        cr.move_to(f * s, .22 * s); cr.line_to(f * s, .06 * s)
        cr.move_to(f * s, .78 * s); cr.line_to(f * s, .94 * s)
        cr.move_to(.22 * s, f * s); cr.line_to(.06 * s, f * s)
        cr.move_to(.78 * s, f * s); cr.line_to(.94 * s, f * s)
    cr.stroke()


def _thermometer(cr, s):
    cr.set_line_width(.085 * s)
    cr.set_line_cap(cairo_round())
    cr.move_to(.5 * s, .16 * s)
    cr.line_to(.5 * s, .60 * s)
    cr.stroke()
    cr.arc(.5 * s, .74 * s, .16 * s, 0, 2 * math.pi)
    cr.fill()


def _bolt(cr, s):
    cr.move_to(.58 * s, .06 * s)
    cr.line_to(.22 * s, .54 * s)
    cr.line_to(.46 * s, .54 * s)
    cr.line_to(.40 * s, .94 * s)
    cr.line_to(.78 * s, .44 * s)
    cr.line_to(.53 * s, .44 * s)
    cr.close_path()
    cr.fill()


def _gear(cr, s):
    for i in range(8):
        a = i * math.pi / 4
        cr.save()
        cr.translate(.5 * s, .5 * s)
        cr.rotate(a)
        rrect(cr, -.07 * s, -.48 * s, .14 * s, .22 * s, .04 * s)
        cr.fill()
        cr.restore()
    cr.set_line_width(.11 * s)
    cr.arc(.5 * s, .5 * s, .26 * s, 0, 2 * math.pi)
    cr.stroke()


def _box(cr, s):
    """A parcel. bin/updates-menu draws the same one beside an ordinary
    package update — keep the two in step."""
    cr.set_line_width(.085 * s)
    cr.set_line_join(cairo_round_join())
    rrect(cr, .17 * s, .17 * s, .66 * s, .70 * s, .09 * s)
    cr.stroke()
    cr.move_to(.17 * s, .42 * s); cr.line_to(.83 * s, .42 * s)
    cr.move_to(.50 * s, .17 * s); cr.line_to(.50 * s, .42 * s)
    cr.stroke()


def _half(cr, s):
    """Auto. A disc with one half filled — the shape macOS gives a setting
    that is following something else rather than being held at a value."""
    cr.set_line_width(.09 * s)
    cr.arc(.5 * s, .5 * s, .38 * s, 0, 2 * math.pi)
    cr.stroke()
    cr.move_to(.5 * s, .12 * s)
    cr.arc(.5 * s, .5 * s, .38 * s, -math.pi / 2, math.pi / 2)
    cr.close_path()
    cr.fill()


def _leaf(cr, s):
    """Power saver. Stroked rather than filled: a solid lens at 18px is a
    blob, and the midrib is what makes it read as a leaf — and a midrib can
    only be a second stroke, because a glyph is one colour."""
    cr.save()
    cr.translate(.5 * s, .5 * s)
    cr.rotate(-math.pi / 4)
    cr.set_line_width(.085 * s)
    cr.set_line_join(cairo_round_join())
    cr.set_line_cap(cairo_round())
    cr.move_to(0, -.42 * s)
    cr.curve_to(.32 * s, -.22 * s, .32 * s, .22 * s, 0, .42 * s)
    cr.curve_to(-.32 * s, .22 * s, -.32 * s, -.22 * s, 0, -.42 * s)
    cr.close_path()
    cr.stroke()
    cr.move_to(0, .42 * s)
    cr.line_to(0, -.10 * s)
    cr.stroke()
    cr.restore()


def _gauge(cr, s):
    """Sustained. A needle past three quarters, not a flame: this chip
    throttles rather than burns, and the tile should not promise otherwise."""
    cr.set_line_width(.10 * s)
    cr.set_line_cap(cairo_round())
    cr.new_sub_path()
    cr.arc(.5 * s, .62 * s, .36 * s, math.pi * 1.05, math.pi * 1.95)
    cr.stroke()
    cr.move_to(.5 * s, .62 * s)
    cr.line_to(.75 * s, .37 * s)
    cr.stroke()
    cr.arc(.5 * s, .62 * s, .07 * s, 0, 2 * math.pi)
    cr.fill()


def _check(cr, s):
    cr.set_line_width(.13 * s)
    cr.set_line_cap(cairo_round())
    cr.set_line_join(cairo_round_join())
    cr.move_to(.14 * s, .52 * s)
    cr.line_to(.39 * s, .76 * s)
    cr.line_to(.86 * s, .22 * s)
    cr.stroke()


def _chevron(cr, s):
    """The v on a dropdown. Drawn downward; the tile rotates it if it ever
    needs to point another way."""
    cr.set_line_width(.13 * s)
    cr.set_line_cap(cairo_round())
    cr.set_line_join(cairo_round_join())
    cr.move_to(.18 * s, .38 * s)
    cr.line_to(.50 * s, .68 * s)
    cr.line_to(.82 * s, .38 * s)
    cr.stroke()


def _dot(cr, s):
    cr.arc(.5 * s, .5 * s, .30 * s, 0, 2 * math.pi)
    cr.fill()


# cairo enum shims keep the glyph bodies readable
import cairo as _cairo
cairo_round = lambda: _cairo.LINE_CAP_ROUND
cairo_round_join = lambda: _cairo.LINE_JOIN_ROUND
cairo_even_odd = lambda: _cairo.FILL_RULE_EVEN_ODD
cairo_winding = lambda: _cairo.FILL_RULE_WINDING

def _broadcast(cr, s):
    """Rings going out from a point — this machine announcing itself.

    Concentric circles rather than the fan of arcs a signal-strength icon
    uses, because the panel already has that shape twice and a third would
    read as a third radio. This is not a radio: it says the machine is
    findable, which happens to travel over Bluetooth.
    """
    # The outermost ring plus half its stroke has to stay inside the box:
    # .42 + .03 clears .5, where .48 did not and came out flat-sided.
    cr.set_line_width(.06 * s)
    for radius in (.16, .29, .42):
        cr.new_sub_path()
        cr.arc(.5 * s, .5 * s, radius * s, 0, 2 * math.pi)
        cr.stroke()
    cr.arc(.5 * s, .5 * s, .065 * s, 0, 2 * math.pi)
    cr.fill()


GLYPHS = {'wifi': _wifi, 'broadcast': _broadcast, 'bluetooth': _bluetooth, 'moon': _moon, 'sun': _sun,
          'speaker': _speaker, 'display': _display, 'cpu': _cpu,
          'thermometer': _thermometer, 'bolt': _bolt, 'gear': _gear,
          'box': _box, 'half': _half, 'leaf': _leaf, 'gauge': _gauge,
          'check': _check, 'chevron': _chevron, 'dot': _dot}


def glyph(cr, name, x, y, size, color, alpha=1.0):
    cr.save()
    cr.translate(x, y)
    rgba(cr, color, alpha)
    GLYPHS.get(name, _dot)(cr, size)
    cr.restore()


def sparkline(cr, values, x, y, w, h, color, alpha=.7):
    """Filled area with both edges faded out — the panel-cpu look, in cairo."""
    if len(values) < 2:
        return
    cr.save()
    cr.push_group()
    step = w / (len(values) - 1)
    cr.move_to(x, y + h)
    for i, v in enumerate(values):
        cr.line_to(x + i * step, y + h - max(0.0, min(100.0, v)) / 100.0 * h)
    cr.line_to(x + w, y + h)
    cr.close_path()
    rgba(cr, color, alpha)
    cr.fill()
    pattern = cr.pop_group()
    mask = _cairo.LinearGradient(x, 0, x + w, 0)
    mask.add_color_stop_rgba(0, 0, 0, 0, 0)
    mask.add_color_stop_rgba(.16, 0, 0, 0, 1)
    mask.add_color_stop_rgba(.84, 0, 0, 0, 1)
    mask.add_color_stop_rgba(1, 0, 0, 0, 0)
    cr.set_source(pattern)
    cr.mask(mask)
    cr.restore()


# --------------------------------------------------------------------- tiles

class Tile(Gtk.DrawingArea):
    def __init__(self, spec, panel):
        super().__init__()
        self.spec, self.panel = spec, panel
        self.keyboard_part = None
        self.hover = self.pressing = False
        self.hit = None          # index of the segment under the pointer
        self.drag_value = None
        self.last_set = 0.0
        self.pending = None
        self.span = int(spec.get('span', SPAN[spec['kind']]))
        self.set_size_request(
            round((self.span * COLW + (self.span - 1) * GAP) * SC),
            round(ROWH[spec['kind']] * SC))
        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK
                        | Gdk.EventMask.BUTTON_RELEASE_MASK
                        | Gdk.EventMask.POINTER_MOTION_MASK
                        | Gdk.EventMask.LEAVE_NOTIFY_MASK
                        | Gdk.EventMask.SCROLL_MASK)
        self.connect('draw', self.on_draw)
        self.connect('button-press-event', self.on_press)
        self.connect('button-release-event', self.on_release)
        self.connect('motion-notify-event', self.on_motion)
        self.connect('scroll-event', self.on_scroll)
        self.connect('leave-notify-event', self.on_leave)
        if spec.get('subtitle') and spec['kind'] in ('segment', 'slider',
                                                     'meter', 'cycle'):
            self.set_tooltip_text(spec['subtitle'])

    # ---- state helpers

    @property
    def c(self):
        return self.panel.colors

    def on_value(self):
        return str(self.spec.get('value', '')).lower() in TRUE

    def number(self):
        try:
            return max(0.0, min(100.0, float(self.spec.get('value', 0))))
        except (TypeError, ValueError):
            return 0.0

    def options(self):
        """(key, label, glyph, accent) — the last two blank unless the plugin
        gave them, and only `cycle` looks at them."""
        out = []
        for o in self.spec.get('options') or []:
            if not isinstance(o, (list, tuple)):
                o = [str(o)]
            o = list(o) + ['', '', '']
            out.append((str(o[0]), str(o[1] or o[0]), str(o[2]), str(o[3])))
        return out

    def current(self):
        """The index of the option the plugin says is live, or -1."""
        cur = str(self.spec.get('value', ''))
        for i, o in enumerate(self.options()):
            if o[0] == cur:
                return i
        return -1

    def update(self, spec):
        spec['path'], spec['name'] = self.spec['path'], self.spec['name']
        self.spec = spec
        if self.drag_value is None:
            self.queue_draw()

    # ---- drawing

    def on_draw(self, _w, cr):
        a = self.get_allocation()
        cr.set_antialias(_cairo.ANTIALIAS_BEST)
        cr.scale(SC, SC)
        getattr(self, 'draw_' + self.spec['kind'])(cr, a.width / SC, a.height / SC)
        if self.keyboard_part is not None:
            w, h = a.width / SC, a.height / SC
            x = w - DETAIL_W if self.keyboard_part == 'detail' and self.spec['kind'] != 'meter' else 2
            rrect(cr, x, 2, w - x - 2, h - 4, 9)
            rgba(cr, self.c['accent'])
            cr.set_line_width(2)
            cr.stroke()
        return False

    def width(self):
        return self.get_allocation().width / SC

    def _card(self, cr, w, h, lit=False):
        rrect(cr, 0, 0, w, h, TILE_RADIUS)
        rgba(cr, self.c['tile_hi'] if (lit or self.hover) else self.c['tile'])
        cr.fill_preserve()
        rgba(cr, self.c['tile_edge'])
        cr.set_line_width(1)
        cr.stroke()

    def _detail_zone(self, cr, w, h):
        """The wash behind the chevron, painted under the label rather than
        over it.

        Drawn only while the pointer is in the zone, and only where the tile
        has something else the click could have meant. Until it was here the
        chevron was five pixels of hairline and the zone was forty, so the
        line between turning Wi-Fi off and opening Wi-Fi was invisible: you
        clicked and found out which one you had asked for.
        """
        if self.hit != 'detail':
            return
        rrect(cr, w - DETAIL_W + 4, 5, DETAIL_W - 9, h - 10, 9)
        rgba(cr, self.c['fg'], .07)
        cr.fill()

    def _detail_chevron(self, cr, w, h):
        if not self.spec.get('detail'):
            return
        cx, cy = w - 15, h / 2
        rgba(cr, self.c['fg'], .55 if self.hit == 'detail' else .28)
        cr.set_line_width(1.6)
        cr.set_line_cap(_cairo.LINE_CAP_ROUND)
        cr.move_to(cx - 2, cy - 4)
        cr.line_to(cx + 2.5, cy)
        cr.line_to(cx - 2, cy + 4)
        cr.stroke()

    def draw_toggle(self, cr, w, h):
        on = self.on_value()
        self._card(cr, w, h)
        self._detail_zone(cr, w, h)
        d = 34
        x, y = 13, (h - d) / 2
        cr.save()
        rrect(cr, x, y, d, d, d / 2)
        if on:
            rgba(cr, self.accent())
        else:
            rgba(cr, self.c['track'])
        cr.fill()
        cr.restore()
        glyph(cr, self.spec.get('glyph', 'dot'), x + d * .22, y + d * .22, d * .56,
              (255, 255, 255) if on else self.c['fg'], 1 if on else .8)
        tw = w - (x + d) - 12 - (14 if self.spec.get('detail') else 0)
        text(cr, self.spec.get('title', ''), x + d + 10, h / 2 - 17, 10.5,
             self.c['fg'], .95, 'bold', width=tw)
        text(cr, self.spec.get('subtitle', ''), x + d + 10, h / 2 + 1, 9.5,
             self.c['fg'], .55, width=tw)
        self._detail_chevron(cr, w, h)

    def draw_segment(self, cr, w, h):
        opts = self.options()
        self._card(cr, w, h)
        gx, gs = 14, 21
        glyph(cr, self.spec.get('glyph', 'dot'), gx, (h - gs) / 2, gs, self.c['fg'], .85)
        label_w = 94
        text(cr, self.spec.get('title', ''), gx + gs + 9, h / 2 - 16, 10.5,
             self.c['fg'], .95, 'bold', width=label_w)
        text(cr, self.spec.get('subtitle', ''), gx + gs + 9, h / 2 + 2, 9.5,
             self.c['fg'], .5, width=label_w)
        if not opts:
            return
        x0 = gx + gs + 9 + label_w + 8
        tw, th = w - x0 - 13, 30
        ty = (h - th) / 2
        rrect(cr, x0, ty, tw, th, 9)
        rgba(cr, self.c['seg'])
        cr.fill()
        cur = str(self.spec.get('value', ''))
        sw = tw / len(opts)
        self.seg_rects = []
        for i, (key, label, _g, _a) in enumerate(opts):
            sx = x0 + i * sw
            self.seg_rects.append((sx, sw, key))
            if key == cur:
                rrect(cr, sx + 2, ty + 2, sw - 4, th - 4, 7.5)
                rgba(cr, self.c['seg_on'])
                cr.fill()
            elif self.hit == i:
                rrect(cr, sx + 2, ty + 2, sw - 4, th - 4, 7.5)
                rgba(cr, self.c['fg'], .07)
                cr.fill()
            text(cr, label, sx, ty + th / 2 - 9, 9.5, self.c['fg'],
                 .95 if key == cur else .6, 'bold' if key == cur else 'normal',
                 align='center', width=sw)

    def draw_cycle(self, cr, w, h):
        """A third-width card you tap to advance. The three settings this
        replaced were full-width segments showing every option at once —
        three rows and 194px to say three words. The state is the icon; the
        options are one tap away each, and right-click walks back."""
        opts = self.options()
        i = self.current()
        if i >= 0:
            key, label, gname, acc = opts[i]
        else:
            key, label, gname, acc = '', str(self.spec.get('value', '')), '', ''
        # Lit unless the state is an off. A tile that is always lit says
        # nothing; a tile that is never lit cannot show Night Light burning.
        lit = bool(key) and key.lower() not in OFF
        self._card(cr, w, h)
        d = 32
        x, y = (w - d) / 2, 10
        rrect(cr, x, y, d, d, d / 2)
        rgba(cr, self.accent(acc) if lit else self.c['track'])
        cr.fill()
        glyph(cr, gname or self.spec.get('glyph', 'dot'),
              x + d * .22, y + d * .22, d * .56,
              (255, 255, 255) if lit else self.c['fg'], 1 if lit else .8)
        text(cr, self.spec.get('title', ''), 4, y + d + 6, 10, self.c['fg'],
             .95, 'bold', align='center', width=w - 8)
        text(cr, label, 4, y + d + 20, 9, self.c['fg'], .5,
             align='center', width=w - 8)

    def draw_menu(self, cr, w, h):
        """A row that names its current value and opens a list. A segment can
        hold four options; the number of playback sinks is whatever is plugged
        in and paired, so it cannot be a segment."""
        self._card(cr, w, h)
        gx, gs = 14, 20
        glyph(cr, self.spec.get('glyph', 'dot'), gx, (h - gs) / 2, gs,
              self.c['fg'], .85)
        tx, label_w = gx + gs + 9, 74
        text(cr, self.spec.get('title', ''), tx, h / 2 - 7, 10.5,
             self.c['fg'], .95, 'bold', width=label_w)
        i = self.current()
        cur = self.options()[i][1] if i >= 0 else self.spec.get('subtitle', '')
        vx = tx + label_w + 8
        text(cr, cur, vx, h / 2 - 6.5, 9.5, self.c['fg'], .55,
             align='right', width=max(24, w - 27 - vx))
        glyph(cr, 'chevron', w - 22, h / 2 - 5, 10, self.c['fg'],
              .55 if (self.hover or self.panel.menu_for is self) else .3)

    def draw_slider(self, cr, w, h):
        v = self.drag_value if self.drag_value is not None else self.number()
        text(cr, self.spec.get('title', ''), 2, 4, 9.5, self.c['fg'], .55)
        text(cr, self.spec.get('subtitle', f'{round(v)}%'), 0, 4, 9.5,
             self.c['fg'], .4, align='right', width=w - 2)
        th = 30
        ty = h - th - 3
        rrect(cr, 0, ty, w, th, th / 2)
        rgba(cr, self.c['track'])
        cr.fill()
        fw = max(th, w * v / 100.0) if v > 0 else 0
        if fw:
            cr.save()
            rrect(cr, 0, ty, w, th, th / 2)
            cr.clip()
            rrect(cr, 0, ty, fw, th, th / 2)
            rgba(cr, self.c['fill'])
            cr.fill()
            cr.restore()
        gs, gx = 17, 8
        gy = ty + (th - gs) / 2
        glyph(cr, self.spec.get('glyph', 'dot'), gx, gy, gs, self.c['fg'], .45)
        if fw > gx:                      # the part of the icon over the fill
            cr.save()
            cr.rectangle(0, ty, fw, th)
            cr.clip()
            glyph(cr, self.spec.get('glyph', 'dot'), gx, gy, gs, self.c['on_fill'], .75)
            cr.restore()

    def draw_meter(self, cr, w, h):
        self._card(cr, w, h)
        g = self.spec.get('graph')
        if g:
            cr.save()
            rrect(cr, 0, 0, w, h, TILE_RADIUS)
            cr.clip()
            sparkline(cr, g, 0, h * .42, w, h * .58, self.c['fg'], .22)
            cr.restore()
        gs = 15
        glyph(cr, self.spec.get('glyph', 'dot'), 13, 12, gs, self.c['fg'], .55)
        text(cr, self.spec.get('title', ''), 13 + gs + 7, 12, 9.5, self.c['fg'], .6)
        vw, _vh = text(cr, self.spec.get('value', ''), 13, h - 32, 17,
                       self.c['fg'], .95, 'bold')
        if self.spec.get('subtitle'):
            # Right-aligned in whatever the reading left over, and ellipsized
            # there — a top-process line is as long as the process name. The
            # chevron, where there is one, takes its 14 off the end first.
            x = 13 + vw + 8
            room = w - 13 - x - (14 if self.spec.get('detail') else 0)
            text(cr, self.spec['subtitle'], x, h - 25, 9.5, self.c['fg'], .45,
                 align='right', width=max(24, room))
        self._detail_chevron(cr, w, h)

    def accent(self, hexval=None):
        a = hexval or self.spec.get('accent')
        if a and a.startswith('#') and len(a) == 7:
            try:
                return (int(a[1:3], 16), int(a[3:5], 16), int(a[5:7], 16))
            except ValueError:
                pass
        return self.c['accent']

    # ---- input

    def _hit(self, x, y):
        if self.spec.get('detail'):
            # A meter is a reading with nothing to set, so the whole tile is
            # the door. A toggle has a switch to protect, so only the strip.
            if self.spec['kind'] == 'meter':
                return 'detail'
            if self.spec['kind'] == 'toggle' and x > self.width() - DETAIL_W:
                return 'detail'
        if self.spec['kind'] == 'segment':
            for i, (sx, sw, _k) in enumerate(getattr(self, 'seg_rects', [])):
                if sx <= x <= sx + sw:
                    return i
        return None

    def on_motion(self, _w, e):
        self.hover = True
        hit = self._hit(e.x / SC, e.y / SC)
        if self.pressing and self.spec['kind'] == 'slider':
            self.drag_value = self._slider_value(e.x / SC)
            self.apply_slider(False)
        if hit != self.hit:
            self.hit = hit
        self.queue_draw()
        return True

    def on_leave(self, *_a):
        self.hover, self.hit = False, None
        self.queue_draw()
        return True

    def _slider_value(self, x):
        return max(0.0, min(100.0, 100.0 * x / max(1, self.width())))

    def on_press(self, _w, e):
        if e.button == 3 and self.spec.get('detail'):
            return self.run_detail()
        if e.button == 3 and self.spec['kind'] == 'cycle':
            return self.step(-1)      # three states, so walking back matters
        self.pressing = True
        if self.spec['kind'] == 'slider':
            self.drag_value = self._slider_value(e.x / SC)
            self.apply_slider(False)
        self.queue_draw()
        return True

    def on_release(self, _w, e):
        self.pressing = False
        if e.button != 1:
            return True
        kind = self.spec['kind']
        hit = self._hit(e.x / SC, e.y / SC)
        if hit == 'detail':
            return self.run_detail()
        if kind == 'toggle':
            self.spec['value'] = 'off' if self.on_value() else 'on'
            self.queue_draw()
            self.panel.set_value(self, self.spec['value'])
        elif kind == 'segment' and isinstance(hit, int):
            key = self.seg_rects[hit][2]
            if key != str(self.spec.get('value', '')):
                self.spec['value'] = key
                self.queue_draw()
                self.panel.set_value(self, key)
        elif kind == 'slider':
            self.drag_value = self._slider_value(e.x / SC)
            self.apply_slider(True)
        elif kind == 'cycle':
            self.step(1)
        elif kind == 'menu':
            self.panel.open_menu(self)
        return True

    def step(self, d):
        opts = self.options()
        if not opts:
            return True
        i = self.current()
        key = opts[(i + d) % len(opts)][0] if i >= 0 else opts[0][0]
        # Optimistic: the icon and the word change on the tap, and the re-read
        # that follows the `set` replaces them with whatever actually happened.
        self.spec['value'] = key
        self.queue_draw()
        self.panel.set_value(self, key)
        return True

    def on_scroll(self, _w, e):
        if self.spec['kind'] != 'slider':
            return False
        step = 5 if e.direction in (Gdk.ScrollDirection.UP, Gdk.ScrollDirection.RIGHT) else -5
        if e.direction == Gdk.ScrollDirection.SMOOTH:
            step = -5 if e.delta_y > 0 else 5
        self.drag_value = max(0.0, min(100.0, (self.drag_value if self.drag_value
                                               is not None else self.number()) + step))
        self.apply_slider(True)
        self.queue_draw()
        return True

    def apply_slider(self, final):
        """Rate-limit a drag to ~20 Hz, but never drop the value it ended on."""
        self.queue_draw()
        now = time.monotonic()
        if final or now - self.last_set > 0.05:
            self.last_set = now
            self.pending = None
            self.panel.set_value(self, round(self.drag_value))
            if final:
                self.drag_value = None
        else:
            self.pending = round(self.drag_value)
            GLib.timeout_add(60, self._flush)

    def _flush(self):
        if self.pending is not None:
            self.panel.set_value(self, self.pending)
            self.pending = None
        return False

    def run_detail(self):
        """Open the tile's own panel, and stand it where this one stood.

        The popups behind the chevron — wifi-menu, bt-menu, updates-menu — hang
        off the bar icon that opened them, which they find by reading the
        pointer. Reached from here the pointer is down on a tile instead, and
        the popup would open halfway down the screen. So hand over the anchor
        this panel was opened with: same right edge, same top, and the sub-panel
        lands exactly where the panel it replaced was standing. Anything else
        behind a chevron ignores the variable and opens where it always did.
        """
        cmd = self.spec.get('detail')
        if cmd:
            env = dict(os.environ)
            if self.panel.anchor is not None:
                env['MINTBOOK_ANCHOR'] = '%d,%d' % self.panel.anchor
            subprocess.Popen(cmd, shell=True, start_new_session=True, env=env,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            self.panel.close()
        return True


# ------------------------------------------------------------------ dropdown

class MenuLayer(Gtk.DrawingArea):
    """The list a `menu` tile opens, drawn over the whole panel.

    An overlay rather than a second window: a Gtk.Menu needs a grab the panel
    already holds, and a second override-redirect window would need its own
    placement, its own shadow and its own dismissal. This is one DrawingArea
    that covers the panel, is hidden until it is asked for, and treats a click
    anywhere outside its own rectangle as a dismissal.
    """
    ROW, PADY, RADIUS = 30, 6, 12

    def __init__(self, panel):
        super().__init__()
        self.panel = panel
        self.tile = None
        self.opts = []
        self.cur = self.hit = -1
        self.rect = (0, 0, 0, 0)
        self.set_no_show_all(True)      # panel.show_all() must not reveal it
        self.set_halign(Gtk.Align.FILL)
        self.set_valign(Gtk.Align.FILL)
        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK
                        | Gdk.EventMask.BUTTON_RELEASE_MASK
                        | Gdk.EventMask.POINTER_MOTION_MASK
                        | Gdk.EventMask.ENTER_NOTIFY_MASK
                        | Gdk.EventMask.LEAVE_NOTIFY_MASK)
        self.connect('draw', self.on_draw)
        self.connect('button-press-event', self.on_press)
        self.connect('button-release-event', self.on_release)
        self.connect('motion-notify-event', self.on_motion)
        # The layer maps under a pointer that has not moved, so the row it
        # opened on top of has to light from the crossing event; there may be
        # no motion event until the user moves off it.
        self.connect('enter-notify-event', self.on_motion)

    # ---- geometry

    def _origin(self, tile):
        """The tile's top-left in this layer's own drawing coordinates."""
        a = tile.get_allocation()
        r = tile.translate_coordinates(self, 0, 0)
        if isinstance(r, (list, tuple)):
            if len(r) == 3 and r[0]:
                return r[1], r[2], a.width, a.height
            if len(r) == 2:
                return r[0], r[1], a.width, a.height
        return a.x, a.y, a.width, a.height

    def open(self, tile):
        # The options are snapshotted, not re-read from the tile: the audio
        # plugin is `live`, and a list that reorders under an open menu would
        # hand the click to a different device than the one pointed at.
        self.tile, self.opts = tile, tile.options()
        self.cur, self.hit = tile.current(), -1
        if not self.opts:
            return
        tx, ty, tw, th = self._origin(tile)
        tx, ty, tw, th = tx / SC, ty / SC, tw / SC, th / SC
        h = len(self.opts) * self.ROW + 2 * self.PADY
        # The live row sits over the tile, the way a macOS pop-up button opens
        # on its own value rather than below itself.
        y = ty + (th - self.ROW) / 2 - self.PADY - max(0, self.cur) * self.ROW
        top = SHADOW + 6
        # The window's height, not this widget's: a layer that has never been
        # shown has never been allocated either, and reports 1x1 — which
        # clamped every first open to the top of the panel.
        bottom = self.panel.win.get_allocated_height() / SC - SHADOW - 6 - h
        y = max(top, min(y, max(top, bottom)))
        self.rect = (tx, y, tw, h)
        self.show()
        self.queue_draw()

    def close(self):
        was, self.tile, self.opts = self.tile, None, []
        self.hide()
        # The tile draws its chevron brighter while its list is up, so it has
        # to be told when the list went away without going through the panel.
        self.panel.menu_for = None
        if was is not None:
            was.queue_draw()

    def _row_at(self, x, y):
        rx, ry, rw, rh = self.rect
        if not (rx <= x <= rx + rw and ry <= y <= ry + rh):
            return -1
        i = int((y - ry - self.PADY) // self.ROW)
        return i if 0 <= i < len(self.opts) else -1

    # ---- drawing

    def on_draw(self, _w, cr):
        if not self.tile:
            return False
        cr.set_antialias(_cairo.ANTIALIAS_BEST)
        cr.scale(SC, SC)
        c = self.panel.colors
        x, y, w, h = self.rect
        for i in range(12, 0, -1):
            rrect(cr, x - i, y - i + 2, w + 2 * i, h + 2 * i, self.RADIUS + i)
            cr.set_line_width(1.4)
            cr.set_source_rgba(0, 0, 0, .06 * (1 - i / 12) ** 2)
            cr.stroke()
        rrect(cr, x, y, w, h, self.RADIUS)
        rgba(cr, c['menu'])
        cr.fill_preserve()
        rgba(cr, c['rim'], .5)
        cr.set_line_width(1)
        cr.stroke()
        for i, o in enumerate(self.opts):
            ry = y + self.PADY + i * self.ROW
            on = i == self.hit
            if on:
                rrect(cr, x + 5, ry + 1, w - 10, self.ROW - 2, 7)
                rgba(cr, c['accent'])
                cr.fill()
            if i == self.cur:
                glyph(cr, 'check', x + 12, ry + self.ROW / 2 - 5, 10,
                      (255, 255, 255) if on else c['fg'], .95)
            text(cr, o[1], x + 30, ry + self.ROW / 2 - 8, 10,
                 (255, 255, 255) if on else c['fg'], .95,
                 'bold' if i == self.cur else 'normal', width=w - 42)
        return False

    # ---- input

    def on_motion(self, _w, e):
        hit = self._row_at(e.x / SC, e.y / SC)
        if hit != self.hit:
            self.hit = hit
            self.queue_draw()
        return True

    def on_press(self, _w, e):
        if self._row_at(e.x / SC, e.y / SC) < 0:
            self.close()
        return True

    def on_release(self, _w, e):
        if e.button != 1:
            return True
        i = self._row_at(e.x / SC, e.y / SC)
        tile = self.tile
        if i >= 0 and tile is not None:
            key = self.opts[i][0]
            self.close()
            if key != str(tile.spec.get('value', '')):
                tile.spec['value'] = key
                tile.queue_draw()
                self.panel.set_value(tile, key)
        return True


# --------------------------------------------------------------------- panel

class Panel:
    def __init__(self, specs):
        self.mode = 'dark' if read_file(APPLIED, 'light') == 'dark' else 'light'
        self.colors = DARK if self.mode == 'dark' else LIGHT
        self.tiles = []
        self.pool = ThreadPoolExecutor(max_workers=4)
        self.closing = False
        self.menu_for = None
        self.key_target = None
        self.anchor = None       # where the bar icon was; see Tile.run_detail

        self.win = win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
        win.set_decorated(False)
        win.set_skip_taskbar_hint(True)
        win.set_skip_pager_hint(True)
        win.set_keep_above(True)
        win.set_resizable(False)
        win.set_app_paintable(True)
        win.set_type_hint(Gdk.WindowTypeHint.POPUP_MENU)
        screen = Gdk.Screen.get_default()
        visual = screen.get_rgba_visual()
        if visual:
            win.set_visual(visual)
        win.connect('draw', self.draw_background)
        win.connect('key-press-event', self.on_key)
        win.connect('destroy', lambda *_a: self.close())

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=round(GAP * SC))
        for setter in (outer.set_margin_top, outer.set_margin_bottom,
                       outer.set_margin_start, outer.set_margin_end):
            setter(round((SHADOW + PAD) * SC))
        overlay = Gtk.Overlay()
        overlay.add(outer)
        self.menu = MenuLayer(self)
        overlay.add_overlay(self.menu)
        overlay.set_overlay_pass_through(self.menu, False)
        win.add(overlay)

        row, used = None, COLS
        for spec in specs:
            tile = Tile(spec, self)
            if used + tile.span > COLS:
                row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL,
                              spacing=round(GAP * SC))
                outer.pack_start(row, False, False, 0)
                used = 0
            row.pack_start(tile, False, False, 0)
            used += tile.span
            self.tiles.append(tile)

        self.height = 0
        win.show_all()

    # ---- chrome

    def draw_background(self, _w, cr):
        a = self.win.get_allocation()
        # GTK propagates this same context to the children afterwards, so every
        # change here has to be undone or the scale below lands on them twice.
        cr.save()
        cr.set_operator(_cairo.OPERATOR_SOURCE)
        cr.set_source_rgba(0, 0, 0, 0)
        cr.paint()
        cr.set_operator(_cairo.OPERATOR_OVER)
        cr.scale(SC, SC)
        x, y = SHADOW, SHADOW
        w, h = a.width / SC - 2 * SHADOW, a.height / SC - 2 * SHADOW
        # A soft edge without a blur pass: concentric strokes, falling off.
        for i in range(SHADOW, 0, -1):
            rrect(cr, x - i, y - i + 2, w + 2 * i, h + 2 * i, RADIUS + i)
            cr.set_line_width(1.4)
            cr.set_source_rgba(0, 0, 0, .055 * (1 - i / SHADOW) ** 2)
            cr.stroke()
        grad = _cairo.LinearGradient(0, y, 0, y + h)
        top, bot = self.colors['top'], self.colors['bottom']
        grad.add_color_stop_rgba(0, top[0] / 255, top[1] / 255, top[2] / 255, top[3])
        grad.add_color_stop_rgba(1, bot[0] / 255, bot[1] / 255, bot[2] / 255, bot[3])
        rrect(cr, x, y, w, h, RADIUS)
        cr.set_source(grad)
        cr.fill_preserve()
        rgba(cr, self.colors['rim'])
        cr.set_line_width(1)
        cr.stroke()
        rrect(cr, x + .75, y + .75, w - 1.5, h - 1.5, RADIUS - .75)
        rgba(cr, self.colors['edge'])
        cr.set_line_width(1)
        cr.stroke()
        cr.restore()
        return False

    def place(self, px, py):
        self.anchor = (int(px), int(py))
        win = self.win
        win.realize()
        gdk_win = win.get_window()
        if gdk_win is not None:
            gdk_win.set_override_redirect(True)
        alloc = win.get_allocation()
        w, h = alloc.width, alloc.height
        display = Gdk.Display.get_default()
        monitor = (display.get_monitor_at_point(px, py)
                   or display.get_primary_monitor())
        geo = monitor.get_geometry()
        # Hangs from the bar icon, right-aligned like macOS, clamped on screen.
        edge = round(SHADOW * SC)
        x = int(px - w + edge + round(24 * SC))
        x = max(geo.x + 2, min(x, geo.x + geo.width - w + edge - 4))
        y = 52 - edge + 4 if py < 64 else int(py) - edge + 8
        if y + h > geo.y + geo.height:
            y = geo.y + geo.height - h
        win.move(x, y)
        # Gtk.Widget.set_opacity, not win.set_opacity: Gtk.Window overrides it
        # with a deprecated variant, and PyGObject picks the override, so every
        # popup open wrote a DeprecationWarning to stderr. genmon discards that
        # stream; a terminal does not.
        Gtk.Widget.set_opacity(win, 0.0)
        win.present()
        self.grab(gdk_win, w, h)
        self.fade_in()

    def fade_in(self):
        self.t0 = time.monotonic()

        def step():
            if self.closing:
                return False
            f = min(1.0, (time.monotonic() - self.t0) / 0.11)
            Gtk.Widget.set_opacity(self.win, f * f * (3 - 2 * f))
            return f < 1.0
        GLib.timeout_add(16, step)

    def grab(self, gdk_win, w, h):
        if gdk_win is None:
            return
        seat = Gdk.Display.get_default().get_default_seat()
        seat.grab(gdk_win, Gdk.SeatCapabilities.ALL, True, None, None, None)

        def on_press(_w, e):
            if e.window != gdk_win:
                return False
            edge = round(SHADOW * SC)
            if not (edge < e.x < w - edge and edge < e.y < h - edge):
                self.close()
                return True
            return False
        self.win.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
        self.win.connect('button-press-event', on_press)

    def open_menu(self, tile):
        if self.menu_for is tile and self.menu.get_visible():
            self.menu.close()          # a second click on the row shuts it
        else:
            self.menu.open(tile)
        self.menu_for = tile if self.menu.get_visible() else None
        tile.queue_draw()

    def on_key(self, _w, e):
        key = e.keyval
        if key in (Gdk.KEY_Escape, Gdk.KEY_q):
            if self.menu.get_visible():
                self.menu.close()
            else:
                self.close()
            return True
        enter = key in (Gdk.KEY_Return, Gdk.KEY_KP_Enter, Gdk.KEY_space)
        if self.menu.get_visible():
            menu = self.menu
            if key in (Gdk.KEY_Up, Gdk.KEY_Down, Gdk.KEY_Home, Gdk.KEY_End):
                if key == Gdk.KEY_Home:
                    menu.hit = 0
                elif key == Gdk.KEY_End:
                    menu.hit = len(menu.opts) - 1
                else:
                    i = menu.hit if menu.hit >= 0 else max(0, menu.cur)
                    menu.hit = (i + (1 if key == Gdk.KEY_Down else -1)) % len(menu.opts)
                menu.queue_draw()
            elif enter:
                i = menu.hit if menu.hit >= 0 else max(0, menu.cur)
                tile, value = menu.tile, menu.opts[i][0]
                menu.close()
                tile.spec['value'] = value
                self.set_value(tile, value)
                tile.queue_draw()
            elif key in (Gdk.KEY_Tab, Gdk.KEY_ISO_Left_Tab):
                menu.close()
            return True
        targets = []
        for tile in self.tiles:
            if tile.spec['kind'] != 'meter':
                targets.append((tile, 'value'))
            if tile.spec.get('detail'):
                targets.append((tile, 'detail'))
        if not targets:
            return False
        if key in (Gdk.KEY_Tab, Gdk.KEY_ISO_Left_Tab):
            reverse = key == Gdk.KEY_ISO_Left_Tab or e.state & Gdk.ModifierType.SHIFT_MASK
            i = targets.index(self.key_target) if self.key_target in targets else (0 if reverse else -1)
            self.key_target = targets[(i + (-1 if reverse else 1)) % len(targets)]
        elif self.key_target not in targets:
            if not enter and key not in (Gdk.KEY_Left, Gdk.KEY_Right, Gdk.KEY_Up, Gdk.KEY_Down):
                return False
            self.key_target = targets[0]
        else:
            tile, part = self.key_target
            kind = tile.spec['kind']
            if enter:
                if part == 'detail':
                    return tile.run_detail()
                if kind == 'toggle':
                    tile.spec['value'] = 'off' if tile.on_value() else 'on'
                    self.set_value(tile, tile.spec['value'])
                elif kind in ('cycle', 'segment'):
                    tile.step(1)
                elif kind == 'menu':
                    self.open_menu(tile)
                    self.menu.hit = max(0, self.menu.cur)
            elif part == 'value' and key in (Gdk.KEY_Left, Gdk.KEY_Right, Gdk.KEY_Up, Gdk.KEY_Down, Gdk.KEY_Home, Gdk.KEY_End):
                delta = 1 if key in (Gdk.KEY_Right, Gdk.KEY_Up) else -1
                if kind == 'slider':
                    value = (0 if key == Gdk.KEY_Home else 100 if key == Gdk.KEY_End
                             else max(0, min(100, tile.number() + delta * 5)))
                    tile.spec['value'] = value
                    self.set_value(tile, round(value))
                elif kind in ('cycle', 'segment'):
                    tile.step(delta)
                elif kind == 'menu':
                    self.open_menu(tile)
                    self.menu.hit = max(0, self.menu.cur)
            else:
                return False
        for tile in self.tiles:
            tile.keyboard_part = self.key_target[1] if self.key_target[0] is tile else None
        self.queue_tiles()
        return True

    def queue_tiles(self):
        for tile in self.tiles:
            tile.queue_draw()

    def close(self):
        if self.closing:
            return
        self.closing = True
        try:
            Gdk.Display.get_default().get_default_seat().ungrab()
        except Exception:
            pass
        Gtk.main_quit()

    # ---- plugin traffic

    def set_value(self, tile, value):
        tile.requested_value = value
        if getattr(tile, 'setting', False):
            return
        tile.setting = True
        self._send_value(tile)

    def _send_value(self, tile):
        value = tile.requested_value
        def work():
            error = None
            try:
                result = subprocess.run([tile.spec['path'], 'set', str(value)],
                                        timeout=8, capture_output=True, text=True)
                if result.returncode:
                    error = result.stderr.strip()[-180:] or 'Could not apply setting'
            except Exception as exc:
                error = str(exc)
            spec = read_plugin(tile.spec['path'])
            GLib.idle_add(self._set_done, tile, value, spec, error)
        self.pool.submit(work)

    def _set_done(self, tile, value, spec, error):
        if tile.requested_value != value:
            self._send_value(tile)
        else:
            tile.setting = False
            tile.update(spec)
            if error:
                tile.set_tooltip_text(error)
                subprocess.Popen(['notify-send', 'Control Center', error],
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return False

    def refresh(self):
        """Re-read the tiles that asked to be live, on their own periods."""
        if self.closing:
            return False
        now = time.monotonic()
        due = []
        for tile in self.tiles:
            period = tile.spec.get('live')
            if not period or getattr(tile, 'setting', False):
                continue
            try:
                period = float(period)
            except (TypeError, ValueError):
                period = 1.0
            if now - getattr(tile, 'read_at', 0) >= period:
                tile.read_at = now
                due.append(tile)
        for tile in due:
            self.pool.submit(self._reread, tile)
        return True

    def _reread(self, tile):
        spec = read_plugin(tile.spec['path'])
        GLib.idle_add(self._refresh_done, tile, spec)

    def _refresh_done(self, tile, spec):
        if not getattr(tile, 'setting', False):
            tile.update(spec)
        return False


def read_file(path, default=''):
    try:
        return open(path).read().strip() or default
    except OSError:
        return default


def single_instance():
    """Second click on the bar icon closes the open panel, like macOS."""
    os.makedirs(os.path.dirname(PIDFILE), exist_ok=True)
    try:
        pid = int(read_file(PIDFILE, '0'))
    except ValueError:
        pid = 0
    if pid and pid != os.getpid():
        try:
            os.kill(pid, signal.SIGTERM)
            # It was up; this click was the dismiss.
            return False
        except OSError:
            pass
    with open(PIDFILE, 'w') as f:
        f.write(str(os.getpid()))
    return True


def pointer_xy():
    """Where the pointer was at startup, not where it is now — see PTR_XY.

    Falls back to asking Gdk, which is the old behaviour, drift and all, and is
    where this lands if xdotool is not installed.
    """
    if PTR_XY is not None:
        return PTR_XY
    _s, x, y = (Gdk.Display.get_default().get_default_seat()
                .get_pointer().get_position())
    return int(x), int(y)


def main():
    if not single_instance():
        return
    specs = collect(PENDING)
    read_ms = (time.monotonic() - T0) * 1000
    if not specs:
        subprocess.run(['notify-send', 'Control Center',
                        f'No plugins in {PLUGINS}'])
        return
    px, py = pointer_xy()
    panel = Panel(specs)
    signal.signal(signal.SIGTERM, lambda *_a: panel.close())
    now = time.monotonic()
    for tile in panel.tiles:
        tile.read_at = now
    GLib.timeout_add(250, panel.refresh)
    panel.place(px, py)
    if os.environ.get('MINTBOOK_CC_TIME'):
        print(f'{len(specs)} tiles: {read_ms:.0f} ms to import and read, '
              f'{(time.monotonic() - T0) * 1000:.0f} ms to on screen',
              file=sys.stderr)
    Gtk.main()


if __name__ == '__main__':
    Gdk.set_program_class('mintbook-control-center')
    try:
        main()
    finally:
        try:
            if read_file(PIDFILE) == str(os.getpid()):
                os.remove(PIDFILE)
        except OSError:
            pass
    sys.exit(0)
