#!/usr/bin/env python3
"""Install mintdrop, with a persistent undo snapshot.

    bin/mintdrop-install            # symlink the scripts, arm the socket
    bin/mintdrop-install --revert   # put everything back
    bin/mintdrop-install --advert   # the one step that needs root

Follows bin/daily-install: repository symlinks into ~/.local/bin, the
pre-install state of every file recorded once, and a rerun that adds newly
introduced files to the original snapshot rather than replacing it.

Only the mDNS advertisement needs root, because /etc/avahi/services is root's.
Everything else — the scripts, the user socket, the Thunar entry — is yours,
and skipping the advertisement only means other machines cannot *find* this
one. Sending from it, and receiving from a peer told where to look, still work.
"""
import argparse
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import time

ROOT = Path(__file__).resolve().parent.parent
HOME = Path.home()
SAVED = HOME / '.config/mintbook/mintdrop-install.json'
BIN = HOME / '.local/bin'
UNIT_DIR = HOME / '.config/systemd/user'
AUTOSTART = HOME / '.config/autostart'
APPS = HOME / '.local/share/applications'
UCA = HOME / '.config/Thunar/uca.xml'
DOCK = HOME / '.config/plank/dock1/launchers'
# Stamped into the Thunar action so a rerun can find its own entry and a
# revert can take out exactly that one, leaving actions added since alone.
UCA_ID = 'mintbook-mintdrop'
ADVERT = Path('/etc/avahi/services/mintdrop.service')
QS_ADVERT = Path('/etc/avahi/services/mintdrop-quickshare.service')

SCRIPTS = ('mintdrop', 'mintdrop-accept', 'mintdrop-menu', 'mintdrop-probe',
           'mintdrop-visible',
           'mintbook_drop.py', 'mintbook_quickshare.py', 'mintbook_appcolor.py')
UNITS = ('mintbook-drop.socket', 'mintbook-drop@.service')
SOCKET = 'mintbook-drop.socket'


def load(name):
    loader = importlib.machinery.SourceFileLoader(
        name, str(ROOT / 'bin' / (name + '.py')))
    module = importlib.util.module_from_spec(
        importlib.util.spec_from_loader(loader.name, loader))
    loader.exec_module(module)
    return module


def device_name():
    """What both advertisements call this machine."""
    drop = load('mintbook_drop')
    return drop.config()['name'] or drop.device_name()


def run(*argv, check=True):
    return subprocess.run(argv, check=check, text=True, capture_output=True)


def targets():
    result = [(ROOT / 'bin' / name, BIN / name) for name in SCRIPTS]
    result += [(ROOT / 'config/systemd' / name, UNIT_DIR / name)
               for name in UNITS]
    result += [(ROOT / 'config/autostart/mintbook-drop-env.desktop',
                AUTOSTART / 'mintbook-drop-env.desktop')]
    result += [(ROOT / 'config/applications/mintbook-mintdrop.desktop',
                APPS / 'mintbook-mintdrop.desktop')]
    result += [(ROOT / 'config/applications/mintbook-discoverable.desktop',
                APPS / 'mintbook-discoverable.desktop')]
    result += [(ROOT / 'config/plank/07-mintdrop.dockitem',
                DOCK / '07-mintdrop.dockitem')]
    return result


def snapshot():
    """Record what was there before, once, and keep it across reruns."""
    if SAVED.exists():
        data = json.loads(SAVED.read_text())
        known = {entry['path'] for entry in data['files']}
        added = [(src, dst) for src, dst in targets() if str(dst) not in known]
        if not added:
            return data
        backup = (HOME / '.local/state/mintbook' /
                  ('mintdrop-added-' + time.strftime('%Y%m%d-%H%M%S')))
        backup.mkdir(parents=True, exist_ok=True)
        for i, (_src, dst) in enumerate(added):
            entry = dict(path=str(dst), backup=None)
            if dst.exists() or dst.is_symlink():
                copy = backup / str(i)
                shutil.copy2(dst, copy, follow_symlinks=False)
                entry['backup'] = str(copy)
            data['files'].append(entry)
        SAVED.write_text(json.dumps(data, indent=2))
        return data

    backup = (HOME / '.local/state/mintbook' /
              ('mintdrop-before-' + time.strftime('%Y%m%d-%H%M%S')))
    backup.mkdir(parents=True, exist_ok=True)
    data = dict(files=[], socket=run('systemctl', '--user', 'is-enabled',
                                     SOCKET, check=False).returncode == 0)
    for i, (_src, dst) in enumerate(targets()):
        entry = dict(path=str(dst), backup=None)
        if dst.exists() or dst.is_symlink():
            copy = backup / str(i)
            shutil.copy2(dst, copy, follow_symlinks=False)
            entry['backup'] = str(copy)
        data['files'].append(entry)
    SAVED.parent.mkdir(parents=True, exist_ok=True)
    SAVED.write_text(json.dumps(data, indent=2))
    return data


def install_file(source, dest):
    # Plank requires an absolute file URI, rendered separately for each account.
    # Keep the generated file in the existing snapshot/revert lifecycle.
    if source.name == '07-mintdrop.dockitem':
        dest.parent.mkdir(parents=True, exist_ok=True)
        temporary = dest.with_name(dest.name + '.new')
        temporary.unlink(missing_ok=True)
        temporary.write_text(source.read_text().replace(
            '@MINTDROP_DESKTOP_URI@', (APPS / 'mintbook-mintdrop.desktop').as_uri()))
        temporary.replace(dest)
    else:
        link(source, dest)


def link(source, dest):
    dest.parent.mkdir(parents=True, exist_ok=True)
    if dest.exists() or dest.is_symlink():
        dest.unlink()
    dest.symlink_to(source)


def advert_files():
    """The two advertisements, as (destination, text) pairs.

    Two service groups rather than one file with two services in it: an avahi
    service-group has a single instance name, and Quick Share's name is not a
    hostname — it is ten bytes of endpoint id and service id in base64, which
    is how the phone learns the endpoint before resolving anything.

    Generated here rather than shipped because both carry this machine's
    identity: the Quick Share endpoint id, and the name the phone will show.
    """
    # Only the mintdrop advertisement is static now.
    #
    # The Quick Share one used to be written here too, and it actively got in
    # the way: it holds one endpoint id forever, while a phone matches the
    # BLE advertisement it discovered against the mDNS record by endpoint id.
    # A stale second record with a different id is a machine the phone
    # believes is two devices, and the connection goes to the wrong one.
    #
    # Quick Share visibility is `mintdrop visible` now — announced, listed
    # over BLE and served over GATT with one identity, for as long as you
    # asked and no longer.
    plain = (ROOT / 'config/avahi/mintdrop.service').read_text()
    return [(ADVERT, plain)]


def install_advert():
    """The mDNS advertisements — the only root step.

    Written as the user into a temporary directory and copied in with one
    sudo, rather than re-running this script as root: the Quick Share
    endpoint id lives under the user's ~/.local/state, and root would
    generate a different one every time it looked.
    """
    if os.geteuid() == 0:
        for dest, text in advert_files():
            dest.write_text(text)
        run('systemctl', 'reload-or-restart', 'avahi-daemon', check=False)
        print('[+] advertised as _mintdrop._tcp')
        return True

    print('[*] the advertisements need root; asking sudo once')
    staged = Path(tempfile.mkdtemp(prefix='mintdrop-advert-'))
    try:
        names = []
        for dest, text in advert_files():
            (staged / dest.name).write_text(text)
            names.append(str(staged / dest.name))
        (staged).chmod(0o755)
        for name in names:
            Path(name).chmod(0o644)
        result = subprocess.run(['sudo', 'install', '-m', '644', *names,
                                 str(ADVERT.parent)], check=False)
        if result.returncode != 0:
            print('[!] could not install the advertisements', file=sys.stderr)
            return False
        subprocess.run(['sudo', 'systemctl', 'reload-or-restart',
                        'avahi-daemon'], check=False)
        print('[+] advertised as _mintdrop._tcp (Linux peers); phones are '
              'served by `mintdrop visible`')
        return True
    finally:
        shutil.rmtree(staged, ignore_errors=True)


def thunar_action(remove=False):
    """Add (or take out) the Files right-click entry.

    Thunar keeps custom actions in ~/.config/Thunar/uca.xml and reads nothing
    from ~/.local/share/file-manager/actions — which is where the first
    version of this put a .desktop file, so the README promised a right-click
    entry that was never there. Nemo and Caja use that directory; Thunar does
    not, and Thunar is the file manager on this machine.

    The file belongs to the user and already has their own actions in it, so
    this edits rather than replaces, and removes by unique-id rather than
    restoring a backup — a wholesale restore would silently delete any action
    added after the install.
    """
    import xml.etree.ElementTree as ET
    if not UCA.exists():
        if remove:
            return False
        UCA.parent.mkdir(parents=True, exist_ok=True)
        UCA.write_text('<?xml version="1.0" encoding="UTF-8"?>\n<actions>\n</actions>\n')
    try:
        tree = ET.parse(UCA)
    except ET.ParseError as exc:
        print(f'[!] {UCA} will not parse ({exc}); leaving it alone',
              file=sys.stderr)
        return False
    root = tree.getroot()

    existing = [a for a in root.findall('action')
                if (a.findtext('unique-id') or '').startswith(UCA_ID)]
    for action in existing:
        root.remove(action)
    if remove:
        if existing:
            tree.write(UCA, encoding='UTF-8', xml_declaration=True)
        return bool(existing)

    action = ET.SubElement(root, 'action')
    for tag, text in (('icon', 'document-send'),
                      ('name', 'Send with Mintdrop'),
                      ('submenu', ''),
                      ('unique-id', UCA_ID),
                      ('command', 'mintdrop-menu %F'),
                      ('description', 'Send these files to a device nearby'),
                      # Thunar's <range> is a selection *count* — '1', '1-3',
                      # or empty for any number. It is not a glob. '*' here
                      # is invalid, and an action with an invalid range never
                      # matches, so the entry silently never appeared.
                      ('range', ''),
                      ('patterns', '*')):
        ET.SubElement(action, tag).text = text
    # Which selections it appears for. Not directories: the protocol sends
    # files, and an entry that appears on a folder and then refuses it is
    # worse than one that does not appear.
    for tag in ('audio-files', 'image-files', 'other-files', 'text-files',
                'video-files'):
        ET.SubElement(action, tag)
    tree.write(UCA, encoding='UTF-8', xml_declaration=True)
    return True


def install(args):
    snapshot()
    for source, dest in targets():
        if not source.exists():
            print(f'[!] missing from the checkout: {source}', file=sys.stderr)
            continue
        install_file(source, dest)
    print(f'[+] linked {len(SCRIPTS)} scripts into {BIN}')

    run('systemctl', '--user', 'daemon-reload', check=False)
    enabled = run('systemctl', '--user', 'enable', '--now', SOCKET, check=False)
    if enabled.returncode == 0:
        print(f'[+] {SOCKET} armed on port 8771 — nothing runs until a '
              f'connection arrives')
    else:
        print(f'[!] could not arm the socket: {enabled.stderr.strip()}',
              file=sys.stderr)

    # The socket-activated receiver needs to find the display to show its
    # prompt. The autostart file does this at every login; do it now too, so
    # the first transfer works without logging out first.
    run('systemctl', '--user', 'import-environment', 'DISPLAY', 'XAUTHORITY',
        'DBUS_SESSION_BUS_ADDRESS', check=False)

    if thunar_action():
        print('[+] Files: right-click → Send with Mintdrop')
    if DOCK.exists():
        print('[+] dock: Mintdrop added to Plank — drag files onto it')

    if not args.no_advert:
        install_advert()

    print('\nDone. Four ways in:')
    print('  the dock            drag files onto the Mintdrop icon')
    print('  Files               right-click → Send with Mintdrop')
    print('  mintdrop-menu       open the sheet and drop files on a device')
    print('  mintdrop send ...   from a terminal; mintdrop status to check')
    print('\nRevert with:  bin/mintdrop-install --revert')
    return 0


def revert(args):
    if not SAVED.exists():
        print('nothing to revert: no snapshot from an earlier install',
              file=sys.stderr)
        return 1
    data = json.loads(SAVED.read_text())

    run('systemctl', '--user', 'disable', '--now', SOCKET, check=False)
    for entry in data['files']:
        path = Path(entry['path'])
        if path.exists() or path.is_symlink():
            path.unlink()
        if entry['backup']:
            path.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(entry['backup'], path, follow_symlinks=False)
    run('systemctl', '--user', 'daemon-reload', check=False)
    if thunar_action(remove=True):
        print('[+] removed the Files right-click entry')
    print(f'[+] removed {len(data["files"])} files and disarmed {SOCKET}')

    present = [p for p in (ADVERT, QS_ADVERT) if p.exists()]
    if present:
        if os.geteuid() == 0:
            for path in present:
                path.unlink()
            run('systemctl', 'reload-or-restart', 'avahi-daemon', check=False)
            print(f'[+] removed {len(present)} advertisement(s)')
        else:
            print(f'[*] still advertised; remove them with:\n'
                  f'    sudo rm {" ".join(str(p) for p in present)} && '
                  f'sudo systemctl reload-or-restart avahi-daemon')
    SAVED.unlink()
    print('[+] snapshot consumed; this checkout is no longer installed')
    return 0


def main():
    parser = argparse.ArgumentParser(
        description=__doc__.split('\n\n')[0],
        formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--revert', action='store_true')
    parser.add_argument('--advert', action='store_true',
                        help='install only the mDNS advertisement (root)')
    parser.add_argument('--no-advert', action='store_true',
                        help='skip the advertisement and its sudo prompt')
    args = parser.parse_args()

    if args.advert:
        if os.geteuid() != 0:
            print('--advert must run as root', file=sys.stderr)
            return 1
        for dest, text in advert_files():
            dest.write_text(text)
        run('systemctl', 'reload-or-restart', 'avahi-daemon', check=False)
        print(f'[+] advertised: {ADVERT}, {QS_ADVERT}')
        return 0
    if args.revert:
        return revert(args)
    return install(args)


if __name__ == '__main__':
    sys.exit(main())
