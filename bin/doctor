#!/usr/bin/env bash
# doctor — verify every piece mintbook installs is still in place. Read-only, no sudo.
#
# This machine keeps working hardware alive through files scattered across
# /etc, /usr/local/sbin, /lib/firmware, DKMS and the initrd. A kernel or Mint
# update is exactly what quietly removes one of them. Run this after any update.
# See docs/hardware.md.
set -u

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PASS=0 WARN=0 FAIL=0

section() { printf '\n\033[1m%s\033[0m\n' "$1"; }
ok()   { printf '  \033[32mok\033[0m    %-28s %s\n' "$1" "${2-}"; PASS=$((PASS+1)); }
warn() { printf '  \033[33mwarn\033[0m  %-28s %s\n' "$1" "${2-}"; WARN=$((WARN+1)); }
bad()  { printf '  \033[31mFAIL\033[0m  %-28s %s\n' "$1" "${2-}"; FAIL=$((FAIL+1)); }

# check <label> <detail> <test...>  — ok if the test succeeds, FAIL if not
check() { local l=$1 d=$2; shift 2; if "$@" >/dev/null 2>&1; then ok "$l" "$d"; else bad "$l" "$d"; fi; }
have()  { [ -e "$1" ]; }

printf '\033[1mmintbook doctor\033[0m — %s\n' "$(date '+%Y-%m-%d %H:%M')"

section "Kernel"
KREL=$(uname -r)
case "$KREL" in
  7.*) ok "running kernel" "$KREL" ;;
  6.14*) warn "running kernel" "$KREL — fallback: speakers, camera and BT are dead here" ;;
  *) warn "running kernel" "$KREL — untested; 7.0 is the working kernel" ;;
esac
check "headers for this kernel" "/usr/src/linux-headers-$KREL" have "/usr/src/linux-headers-$KREL"
# Reported, never asserted: this is a security posture choice, not a fault.
# See docs/hardware.md for the measured cost and the OpenCore boot arg.
if grep -q 'mitigations=off' /proc/cmdline 2>/dev/null; then
  warn "cpu mitigations" "disabled on the cmdline — faster syscalls, no Meltdown/MDS protection"
else
  NMIT=$(grep -l 'Mitigation' /sys/devices/system/cpu/vulnerabilities/* 2>/dev/null | wc -l)
  ok "cpu mitigations" "$NMIT active (PTI, retpolines, MDS clear) — see docs/hardware.md"
fi

section "Power policy"
check "apply script" "/usr/local/sbin/mintbook-power-apply" have /usr/local/sbin/mintbook-power-apply
check "udev rule" "99-mintbook-power.rules" have /etc/udev/rules.d/99-mintbook-power.rules
check "boot unit enabled" "mintbook-power.service" systemctl is-enabled mintbook-power.service
check "request path unit" "mintbook-power-request.path" systemctl is-active mintbook-power-request.path
check "settle timer" "mintbook-power-settle.timer" systemctl is-enabled mintbook-power-settle.timer
check "tmpfiles" "/etc/tmpfiles.d/mintbook-power.conf" have /etc/tmpfiles.d/mintbook-power.conf
AC=$(cat /sys/class/power_supply/ADP1/online 2>/dev/null || echo 1)
PCT=$(cat /sys/devices/system/cpu/intel_pstate/max_perf_pct 2>/dev/null || echo '?')
PROF=$(powerprofilesctl get 2>/dev/null || echo '?')
if [ "$AC" = 1 ]; then WANT_PCT=100 WANT_PROF=balanced; else WANT_PCT=70 WANT_PROF=power-saver; fi
# A profile picked by hand moves BOTH the profile and the cap, because
# power-menu writes both. So a profile that still matches auto while the cap
# does not is not a manual override — it is something else having written
# max_perf_pct after we did. That is a real fault, not a preference.
case "$PROF" in
  power-saver) HAVE_PCT=70 ;;
  balanced) HAVE_PCT=100 ;;
  performance) HAVE_PCT=75 ;;
  *) HAVE_PCT='' ;;
esac
if [ "$PCT" = "$WANT_PCT" ] && [ "$PROF" = "$WANT_PROF" ]; then
  ok "live policy" "ac=$AC $PROF max_perf_pct=$PCT"
elif [ -n "$HAVE_PCT" ] && [ "$PCT" != "$HAVE_PCT" ]; then
  bad "live policy" "ac=$AC $PROF wants max_perf_pct=$HAVE_PCT but has $PCT — the cap was reset; pkexec bin/power-install"
else
  ok "live policy" "ac=$AC $PROF max_perf_pct=$PCT (manual override; auto would be $WANT_PROF/$WANT_PCT)"
fi

section "Thermals"
PKG=$(sensors 2>/dev/null | awk '/Package id 0/{gsub(/[+°C]/,"",$4); print int($4)}')
if [ -z "${PKG:-}" ]; then warn "package temp" "sensors gave nothing"
elif [ "$PKG" -ge 93 ]; then bad  "package temp" "${PKG}C — at the 95C throttle point"
elif [ "$PKG" -ge 85 ]; then warn "package temp" "${PKG}C — hot; fanless, throttles at 95C"
else ok "package temp" "${PKG}C"; fi
# thermald was in here as a "95C backstop". It is not one. On this machine it
# logs "NO RAPL sysfs", "No coretemp sysfs found" and "No Zones present", so it
# manages nothing — while still writing max_perf_pct, which is how the battery
# cap went missing at boot (see docs/hardware.md). The real backstop is the
# CPU's own TCC throttle, in silicon, which is what the throttle counters below
# are counting. Masked is the state we want.
if systemctl is-enabled thermald.service 2>/dev/null | grep -q masked; then
  ok "thermald" "masked — no zones on this machine, and it resets max_perf_pct"
elif systemctl is-active thermald.service >/dev/null 2>&1; then
  warn "thermald" "running — manages nothing here, resets max_perf_pct; pkexec bin/tune-install"
else
  ok "thermald" "not running"
fi
# Evidence that the cap is doing its job. The count is the sensitive signal:
# throttle stalls here are short and very frequent, which is exactly the
# behaviour the Sustained cap of 75 was measured to avoid.
TT=/sys/devices/system/cpu/cpu0/thermal_throttle
THR=$(cat "$TT/package_throttle_total_time_ms" 2>/dev/null || echo '')
THC=$(cat "$TT/package_throttle_count" 2>/dev/null || echo 0)
if [ -n "$THR" ]; then
  UPS=$(cut -d. -f1 /proc/uptime)
  DET="${THR}ms in ${UPS}s uptime, $THC events"
  if [ "$UPS" -gt 0 ] && [ "$THR" -gt $(( UPS * 10 )) ]; then
    warn "package throttling" "$DET — over 1% of uptime stalled"
  else
    ok "package throttling" "$DET"
  fi
fi

section "Storage"
# Recorded so the scheduler does not get "fixed" later. The obvious advice for
# an NVMe -- set the scheduler to none -- is wrong on this controller. See
# docs/hardware.md, and bin/io-probe for the numbers.
NVQ=$(cat /sys/class/nvme/nvme0/quirks 2>/dev/null | tr '\n' ' ')
TAGS=$(cat /sys/block/nvme0n1/mq/0/nr_tags 2>/dev/null || echo '?')
case "$NVQ" in
  *qdepth_one*) ok "nvme queue depth" "qdepth_one quirk, $TAGS tag — merging matters, keep a scheduler" ;;
  *)            ok "nvme queue depth" "$TAGS tags, quirks: ${NVQ:-none}" ;;
esac
SCHED=$(sed -n 's/.*\[\(.*\)\].*/\1/p' /sys/block/nvme0n1/queue/scheduler 2>/dev/null)
case "$SCHED:$NVQ" in
  none:*qdepth_one*) warn "io scheduler" "none on a queue-depth-1 device — it was merging 25% of reads and 52% of writes away; bin/io-probe" ;;
  '':*)              warn "io scheduler" "could not read" ;;
  *)                 ok   "io scheduler" "$SCHED" ;;
esac
check "fstrim timer" "weekly NVMe trim" systemctl is-enabled fstrim.timer

section "Memory / zram"
check "zram-generator conf" "/etc/systemd/zram-generator.conf" have /etc/systemd/zram-generator.conf
if swapon --show=NAME --noheadings 2>/dev/null | grep -q zram0; then
  ok "zram swap" "$(swapon --show=NAME,SIZE,PRIO --noheadings | tr -s ' ')"
else
  bad "zram swap" "/dev/zram0 is not swapped on"
fi
SW=$(sysctl -n vm.swappiness 2>/dev/null); PC=$(sysctl -n vm.page-cluster 2>/dev/null)
if [ "${SW:-0}" -ge 100 ] && [ "${PC:-9}" = 0 ]; then
  ok "zram sysctls" "swappiness=$SW page-cluster=$PC"
else
  warn "zram sysctls" "swappiness=$SW page-cluster=$PC — expected >=100 and 0; run pkexec bin/tune-install"
fi

section "Graphics"
check "i965 Xsession.d file" "/etc/X11/Xsession.d/56mintbook-libva" have /etc/X11/Xsession.d/56mintbook-libva
check "i965 env file" "/etc/environment.d/90-mintbook-libva.conf" have /etc/environment.d/90-mintbook-libva.conf
VADRV=$(vainfo 2>/dev/null | sed -n 's/.*Driver version: Intel \(\w*\).*/\1/p' | head -1)
case "$VADRV" in
  i965) ok "VA-API in this shell" "i965 — the session exports it" ;;
  iHD)  warn "VA-API in this shell" "iHD — LIBVA_DRIVER_NAME is not in the session env; log out" ;;
  *)    warn "VA-API in this shell" "could not read vainfo" ;;
esac
# Ground truth: the driver a running app actually mapped. Not vainfo, which
# only says what doctor's own shell would pick, and not /proc/<pid>/environ —
# Chrome and Electron overwrite that region, so it reads back blank. See
# docs/display.md.
MAPPED=$(for p in $(pgrep -f 'chrome|cursor|claude-desktop|firefox' 2>/dev/null); do
           grep -ohE '(i965|iHD)_drv_video' "/proc/$p/maps" 2>/dev/null
         done | sort -u | tr '\n' ' ')
case "$MAPPED" in
  '')                      warn "VA-API in use" "no browser or Electron app running to check" ;;
  *i965*iHD*|*iHD*i965*)   warn "VA-API in use" "both mapped ($MAPPED) — some apps predate the fix; restart them" ;;
  *i965*)                  ok   "VA-API in use" "i965 (Broadwell) — H.264 decode; its encode entrypoint aborts" ;;
  *iHD*)                   warn "VA-API in use" "iHD — Gen9+ driver, no encode on this chip; log out to pick up i965" ;;
esac

# Firefox is the only browser here that can reach the H.264 decoder, and it only
# gets the chance once YouTube is pushed off AV1. Two prefs, applied by
# bin/firefox-video. Optional tuning, so this warns rather than fails.
FFINI=$HOME/.mozilla/firefox/profiles.ini
FFPROF=$(awk -F= '/^\[Install/{i=1;next} /^\[/{i=0} i&&$1=="Default"{print $2;exit}' "$FFINI" 2>/dev/null)
if [ -z "${FFPROF:-}" ]; then
  :
elif grep -q "mintbook firefox-video" "$HOME/.mozilla/firefox/$FFPROF/user.js" 2>/dev/null; then
  ok "firefox video prefs" "VP9/AV1 off — YouTube serves H.264, which decodes on the GPU"
else
  warn "firefox video prefs" "not applied — run bin/firefox-video (see docs/video.md)"
fi

section "Audio"
if grep -q '^snd_hda_codec_cs420x ' /proc/modules; then ok "CS4208 codec module" "snd_hda_codec_cs420x"; else bad "CS4208 codec module" "not loaded"; fi
if aplay -l 2>/dev/null | grep -qi 'CS4208\|MacBook'; then ok "playback device" "$(aplay -l 2>/dev/null | grep -m1 -i 'CS4208\|MacBook' | cut -c1-60)"; else warn "playback device" "no CS4208 card in aplay -l"; fi
check "macbook12-audio dkms" "built for $KREL" bash -c "dkms status macbook12-audio 2>/dev/null | grep -q \"$KREL.*installed\""
# power_save=0 is load-bearing, not an oversight. The CS4208 class-D amp rails
# are set once by EFI and the driver never re-drives them, so a runtime-PM D3
# cycle kills the speakers until reboot. Guarded because a modprobe.d change or
# a kernel default flip would do it silently. See docs/audio.md.
PSV=$(cat /sys/module/snd_hda_intel/parameters/power_save 2>/dev/null || echo '?')
if [ "$PSV" = 0 ]; then
  ok "codec power_save" "0 — the EFI-set amp rails stay powered"
else
  bad "codec power_save" "$PSV — a D3 cycle kills the speaker amp until reboot (docs/audio.md)"
fi

section "Camera"
check "firmware" "/lib/firmware/facetimehd/firmware.bin" have /lib/firmware/facetimehd/firmware.bin
check "facetimehd dkms" "built for $KREL" bash -c "dkms status facetimehd 2>/dev/null | grep -q \"$KREL.*installed\""
if grep -q 'intel_iommu=off' /proc/cmdline; then ok "intel_iommu=off" "on the running cmdline"; else bad "intel_iommu=off" "missing — the ISP cannot DMA"; fi
if [ -e /dev/video0 ]; then ok "video node" "/dev/video0"; else warn "video node" "no /dev/video0 (module may be unloaded)"; fi

section "Bluetooth"
check "DSDT override image" "/boot/acpi_override_ssdc.img" have /boot/acpi_override_ssdc.img
check "initramfs re-apply hook" "post-update.d/zz-acpi-ssdc-override" have /etc/initramfs/post-update.d/zz-acpi-ssdc-override
if [ -e /sys/class/bluetooth/hci0 ]; then
  ok "hci0" "$(hciconfig hci0 2>/dev/null | sed -n 2p | tr -s ' ' | cut -c1-40 || echo present)"
else
  bad "hci0" "no adapter — SSDC is probably binding the UART again"
fi

section "Keyboard / trackpad"
check "DMA blacklist" "/etc/modprobe.d/blacklist-dw-dmac.conf" have /etc/modprobe.d/blacklist-dw-dmac.conf
check "libinput quirk" "/etc/libinput/local-overrides.quirks" have /etc/libinput/local-overrides.quirks
check "resume rebind script" "/usr/local/sbin/mintbook-applespi-rebind" have /usr/local/sbin/mintbook-applespi-rebind
check "resume hook enabled" "mintbook-applespi-resume.service" systemctl is-enabled mintbook-applespi-resume.service
if grep -qF 'Name="Apple SPI Touchpad"' /proc/bus/input/devices 2>/dev/null; then
  ok "touchpad present" "input survived this boot"
else
  bad "touchpad present" "no Apple SPI Touchpad — input is dead"
fi
if [ -e /sys/class/leds/spi::kbd_backlight ]; then ok "keyboard backlight" "spi::kbd_backlight"; else warn "keyboard backlight" "led node missing"; fi

section "Desktop"
DPI=$(xfconf-query -c xsettings -p /Xft/DPI 2>/dev/null || echo '?')
PSZ=$(xfconf-query -c xfce4-panel -p /panels/panel-1/size 2>/dev/null || echo '?')
MTOP=$(xfconf-query -c xfwm4 -p /general/margin_top 2>/dev/null || echo '?')
[ "$DPI" = 168 ] && ok "Xft/DPI" "$DPI" || warn "Xft/DPI" "$DPI (expected 168)"
if [ "$PSZ" = "$MTOP" ]; then
  ok "panel size / margin_top" "$PSZ — maximized windows clear the bar"
else
  bad "panel size / margin_top" "panel=$PSZ margin_top=$MTOP — they must match"
fi
PPOS=$(xfconf-query -c xfce4-panel -p /panels/panel-1/position 2>/dev/null || echo '?')
case "$PPOS" in
  p=6*) ok "panel snap position" "$PPOS — snapped to the top edge, so it sets a strut" ;;
  *)    bad "panel snap position" "$PPOS — must be p=6, or the panel sets no strut" ;;
esac
WA=$(xprop -root _NET_WORKAREA 2>/dev/null | cut -d= -f2 | tr -d ' ' | cut -d, -f1-4)
if [ "$WA" = "0,$PSZ,2304,$((1440 - PSZ))" ]; then
  ok "_NET_WORKAREA" "$WA — apps that place their own windows clear the bar"
else
  bad "_NET_WORKAREA" "$WA — expected 0,$PSZ,2304,$((1440 - PSZ)); windows will open under the bar"
fi
for p in 17 18 19 21 22 23; do
  [ -e "$HOME/.config/xfce4/panel/genmon-$p.rc" ] || MISSING="${MISSING-} $p"
done
[ -z "${MISSING-}" ] && ok "genmon panel plugins" "17 18 19 21 22 23" || warn "genmon panel plugins" "missing:${MISSING}"

# The battery indicator, only once it has been installed — this machine is
# fine with the XFCE plugin, so its absence is not a fault. See docs/battery.md.
if [ -e "$HOME/.config/mintbook/battery.conf" ]; then
  check "battery indicator" "bin/panel-battery" have "$HOME/.local/bin/panel-battery"
  check "battery menu" "bin/battery-menu" have "$HOME/.local/bin/battery-menu"
  check "battery history" "bin/battery-history" have "$HOME/.local/bin/battery-history"
  BID=$(sed -n 's/^PANEL_ID=\([0-9]*\).*/\1/p' "$HOME/.config/mintbook/battery.conf" | head -1)
  check "battery genmon rc" "genmon-${BID:-26}.rc" have "$HOME/.config/xfce4/panel/genmon-${BID:-26}.rc"
  BLOG="$HOME/.cache/mintbook/battery/history"
  if [ -s "$BLOG" ]; then
    BN=$(wc -l < "$BLOG")
    BAGE=$(( ( $(date +%s) - $(stat -c %Y "$BLOG") ) / 60 ))
    if [ "$BAGE" -le 5 ]; then
      ok "battery samples" "$BN samples, last one ${BAGE}m ago"
    else
      warn "battery samples" "$BN samples, but the last is ${BAGE}m old — is the panel running?"
    fi
  else
    warn "battery samples" "no samples yet — it fills at one a minute while the panel runs"
  fi
fi
# The Wi-Fi popup, only once it has been installed — bin/panel-wifi falls back
# to nm-connection-editor without it, so its absence is not a fault.
if [ -e "$HOME/.local/bin/wifi-menu" ]; then
  check "wifi indicator" "bin/panel-wifi" have "$HOME/.local/bin/panel-wifi"
  check "wifi menu" "bin/wifi-menu" have "$HOME/.local/bin/wifi-menu"
  if grep -q 'wifi-menu' "$HOME/.local/bin/panel-wifi" 2>/dev/null; then
    ok "wifi click target" "the bar icon opens the menu"
  else
    warn "wifi click target" "panel-wifi is older than the menu — run bin/wifi-install"
  fi
  WIF=$(sed -n '3p' /proc/net/wireless 2>/dev/null | cut -d: -f1 | tr -d ' ')
  if [ -n "$WIF" ]; then
    ok "wireless interface" "$WIF"
  else
    warn "wireless interface" "nothing in /proc/net/wireless — the menu will say so too"
  fi
fi
check "night light autostart" "mintbook-night.desktop" have "$HOME/.config/autostart/mintbook-night.desktop"
# Hidden=true user overrides of entries in /etc/xdg/autostart. An override is
# only meaningful while the system entry it shadows still exists, so check both
# — a stale override that shadows nothing is just a confusing file.
MISSING_AS=""
for e in org.gnome.Evolution-alarm-notify print-applet geoclue-demo-agent; do
  [ -f "/etc/xdg/autostart/$e.desktop" ] || continue
  [ -f "$HOME/.config/autostart/$e.desktop" ] || MISSING_AS="$MISSING_AS $e"
done
if [ -z "$MISSING_AS" ]; then
  ok "autostart overrides" "evolution, print-applet, geoclue all disabled"
else
  warn "autostart overrides" "still autostarting:$MISSING_AS — see docs/desktop.md"
fi

section "Housekeeping"
if systemctl --failed --no-legend --no-pager 2>/dev/null | grep -q .; then
  bad "failed units" "$(systemctl --failed --no-legend --no-pager | awk '{print $1}' | tr '\n' ' ')"
else
  ok "failed units" "none"
fi
# Services bin/service-trim masks. Reported, not asserted: an update can
# re-enable one, and a printer or modem appearing is a legitimate reason for
# one to come back. service-trim --check re-runs the probes and says which.
TRIM=""
for u in ModemManager.service cups.service cups.socket cups.path \
         cups-browsed.service switcheroo-control.service rsyslog.service \
         kerneloops.service casper.service casper-md5check.service; do
  systemctl list-unit-files "$u" >/dev/null 2>&1 || continue
  [ "$(systemctl is-enabled "$u" 2>/dev/null || true)" = masked ] && continue
  TRIM="$TRIM ${u%.service}"
done
if [ -n "$TRIM" ]; then
  warn "trimmable services" "still enabled:$TRIM — $ROOT/bin/service-trim --check"
else
  ok "trimmable services" "all masked"
fi
JD=$(journalctl --disk-usage 2>/dev/null | grep -o '[0-9.]*[MG]' | head -1)
check "journal cap" "/etc/systemd/journald.conf.d/mintbook.conf ($JD)" have /etc/systemd/journald.conf.d/mintbook.conf
FREE=$(df --output=pcent / | tail -1 | tr -dc 0-9)
[ "$FREE" -lt 90 ] && ok "root filesystem" "${FREE}% used" || warn "root filesystem" "${FREE}% used"
BATH=$(upower -i /org/freedesktop/UPower/devices/battery_BAT0 2>/dev/null | awk '/capacity:/{print int($2)}')
if [ -n "${BATH:-}" ]; then
  [ "$BATH" -ge 70 ] && ok "battery health" "${BATH}% of design" || warn "battery health" "${BATH}% of design"
fi

printf '\n%d ok, %d warn, %d FAIL\n' "$PASS" "$WARN" "$FAIL"
[ "$FAIL" -eq 0 ]
