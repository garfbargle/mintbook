#!/usr/bin/env bash
# doctor — verify every piece mintbook installs is still in place. Read-only, no sudo.
#
# This machine keeps working hardware alive through files scattered across
# /etc, /usr/local/sbin, /lib/firmware, DKMS and the initrd. A kernel or Mint
# update is exactly what quietly removes one of them. Run this after any update.
# See docs/hardware.md.
set -u

ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
PASS=0 WARN=0 FAIL=0
FORMAT=${1:-}
case "$FORMAT" in ''|--tsv) ;; *) echo 'usage: doctor [--tsv]' >&2; exit 2 ;; esac

# The section a check belongs to is structure, not decoration: the desktop
# view groups by it, so --tsv carries it too rather than making a reader guess
# from the label.
section() {
  if [ "$FORMAT" = --tsv ]; then printf 'section\t%s\t\n' "$1"
  else printf '\n\033[1m%s\033[0m\n' "$1"; fi
}
record() {
  local detail=${3-}
  detail=${detail//$'\n'/ }; detail=${detail//$'\t'/ }
  printf '%s\t%s\t%s\n' "$1" "$2" "$detail"
}
ok()   { if [ "$FORMAT" = --tsv ]; then record ok "$@"; else printf '  \033[32mok\033[0m    %-28s %s\n' "$1" "${2-}"; fi; PASS=$((PASS+1)); }
warn() { if [ "$FORMAT" = --tsv ]; then record warn "$@"; else printf '  \033[33mwarn\033[0m  %-28s %s\n' "$1" "${2-}"; fi; WARN=$((WARN+1)); }
bad()  { if [ "$FORMAT" = --tsv ]; then record fail "$@"; else printf '  \033[31mFAIL\033[0m  %-28s %s\n' "$1" "${2-}"; fi; FAIL=$((FAIL+1)); }

# check <label> <detail> <test...>  — ok if the test succeeds, FAIL if not
check() { local l=$1 d=$2; shift 2; if "$@" >/dev/null 2>&1; then ok "$l" "$d"; else bad "$l" "$d"; fi; }
have()  { [ -e "$1" ]; }

if [ "$FORMAT" != --tsv ]; then printf '\033[1mmintbook doctor\033[0m — %s\n' "$(date '+%Y-%m-%d %H:%M')"; fi

section "Kernel"
KREL=$(uname -r)
case "$KREL" in
  7.*) ok "running kernel" "$KREL" ;;
  6.14*) warn "running kernel" "$KREL — fallback: speakers, camera and BT are dead here" ;;
  *) warn "running kernel" "$KREL — untested; 7.0 is the working kernel" ;;
esac
check "headers for this kernel" "/usr/src/linux-headers-$KREL" have "/usr/src/linux-headers-$KREL"
# Reported, never asserted: this is a security posture choice, not a fault.
# See docs/hardware.md for the measured cost and the OpenCore boot arg.
if grep -q 'mitigations=off' /proc/cmdline 2>/dev/null; then
  warn "cpu mitigations" "disabled on the cmdline — faster syscalls, no Meltdown/MDS protection"
else
  NMIT=$(grep -l 'Mitigation' /sys/devices/system/cpu/vulnerabilities/* 2>/dev/null | wc -l)
  ok "cpu mitigations" "$NMIT active (PTI, retpolines, MDS clear) — see docs/hardware.md"
fi

section "Power policy"
check "apply script" "/usr/local/sbin/mintbook-power-apply" have /usr/local/sbin/mintbook-power-apply
check "udev rule" "99-mintbook-power.rules" have /etc/udev/rules.d/99-mintbook-power.rules
check "boot unit enabled" "mintbook-power.service" systemctl is-enabled mintbook-power.service
check "request path unit" "mintbook-power-request.path" systemctl is-active mintbook-power-request.path
check "settle timer" "mintbook-power-settle.timer" systemctl is-enabled mintbook-power-settle.timer
check "tmpfiles" "/etc/tmpfiles.d/mintbook-power.conf" have /etc/tmpfiles.d/mintbook-power.conf
AC=$(cat /sys/class/power_supply/ADP1/online 2>/dev/null || echo 1)
PCT=$(cat /sys/devices/system/cpu/intel_pstate/max_perf_pct 2>/dev/null || echo '?')
# bin/input-boost holds the cap at 100 for 2 s after a key/button press (up to
# 8 s MAXBOOST while typing or clicking). Let an active boost run out first.
if [ "$PCT" = 100 ] && pgrep -f input-boost >/dev/null 2>&1; then
  for _ in 1 2 3 4; do
    sleep 2.2
    PCT=$(cat /sys/devices/system/cpu/intel_pstate/max_perf_pct 2>/dev/null || echo '?')
    [ "$PCT" != 100 ] && break
    AGE=$(( $(date +%s) - $(stat -c %Y /sys/devices/system/cpu/intel_pstate/max_perf_pct 2>/dev/null || echo 0) ))
    [ "$AGE" -gt 9 ] && break
  done
fi
PROF=$(powerprofilesctl get 2>/dev/null || echo '?')
if [ "$AC" = 1 ]; then WANT_PCT=100 WANT_PROF=balanced; else WANT_PCT=70 WANT_PROF=power-saver; fi
# A profile picked by hand moves BOTH the profile and the cap, because
# power-menu writes both. So a profile that still matches auto while the cap
# does not is not a manual override — it is something else having written
# max_perf_pct after we did. That is a real fault, not a preference.
case "$PROF" in
  power-saver) HAVE_PCT=70 ;;
  balanced) HAVE_PCT=100 ;;
  performance) HAVE_PCT=75 ;;
  *) HAVE_PCT='' ;;
esac
if [ "$PCT" = "$WANT_PCT" ] && [ "$PROF" = "$WANT_PROF" ]; then
  ok "live policy" "ac=$AC $PROF max_perf_pct=$PCT"
elif [ -n "$HAVE_PCT" ] && [ "$PCT" != "$HAVE_PCT" ]; then
  bad "live policy" "ac=$AC $PROF wants max_perf_pct=$HAVE_PCT but has $PCT — the cap was reset; pkexec bin/power-install"
else
  ok "live policy" "ac=$AC $PROF max_perf_pct=$PCT (manual override; auto would be $WANT_PROF/$WANT_PCT)"
fi

# A tracked helper update must reach the installed root copy to protect the system.
for helper in login power; do
  if cmp -s "$ROOT/bin/$helper-apply" "/usr/local/sbin/mintbook-$helper-apply"; then
    ok "$helper helper revision" "matches the repository"
  else
    warn "$helper helper revision" "installed copy differs — pkexec bin/safety-install"
  fi
done
if [ -e /run/mintbook-policy/cap ]; then
  if [ "$(stat -c '%u:%a' /run/mintbook-policy)" = 0:755 ] && [ "$(stat -c '%u:%a' /run/mintbook-policy/cap)" = 0:644 ]; then
    ok "protected policy state" "root-owned /run/mintbook-policy/cap"
    if systemctl --user is-enabled mintbook-input-boost.service >/dev/null 2>&1; then
      BOOST_CMD=$(systemctl --user show mintbook-input-boost.service -p ExecStart --value 2>/dev/null)
      if [[ "$BOOST_CMD" == *"/.local/bin/input-boost"* ]]; then
        ok "Input Boost policy client" "installed client reads protected policy state"
      else
        warn "Input Boost policy client" "legacy unit — run bin/input-boost-install after the root migration"
      fi
    fi
  else
    bad "protected policy state" "unexpected ownership/mode; pkexec bin/safety-install"
  fi
else
  warn "protected policy state" "safety migration pending — pkexec bin/safety-install"
fi
if systemctl --user is-enabled mintbook-backlight-curve.service >/dev/null 2>&1; then
  check "brightness reconciliation" "shared curve watcher" systemctl --user is-active mintbook-backlight-curve.service
  check "shared display gamma" "Night Light and dimming" systemctl --user is-active mintbook-redshift.service
fi

section "Thermals"
PKG=$(sensors 2>/dev/null | awk '/Package id 0/{gsub(/[+°C]/,"",$4); print int($4)}')
if [ -z "${PKG:-}" ]; then warn "package temp" "sensors gave nothing"
elif [ "$PKG" -ge 93 ]; then bad  "package temp" "${PKG}C — at the 95C throttle point"
elif [ "$PKG" -ge 85 ]; then warn "package temp" "${PKG}C — hot; fanless, throttles at 95C"
else ok "package temp" "${PKG}C"; fi
# thermald was in here as a "95C backstop". It is not one. On this machine it
# logs "NO RAPL sysfs", "No coretemp sysfs found" and "No Zones present", so it
# manages nothing — while still writing max_perf_pct, which is how the battery
# cap went missing at boot (see docs/hardware.md). The real backstop is the
# CPU's own TCC throttle, in silicon, which is what the throttle counters below
# are counting. Masked is the state we want.
if systemctl is-enabled thermald.service 2>/dev/null | grep -q masked; then
  ok "thermald" "masked — no zones on this machine, and it resets max_perf_pct"
elif systemctl is-active thermald.service >/dev/null 2>&1; then
  warn "thermald" "running — manages nothing here, resets max_perf_pct; pkexec bin/tune-install"
else
  ok "thermald" "not running"
fi
# Evidence that the cap is doing its job. The count is the sensitive signal:
# throttle stalls here are short and very frequent, which is exactly the
# behaviour the Sustained cap of 75 was measured to avoid.
TT=/sys/devices/system/cpu/cpu0/thermal_throttle
THR=$(cat "$TT/package_throttle_total_time_ms" 2>/dev/null || echo '')
THC=$(cat "$TT/package_throttle_count" 2>/dev/null || echo 0)
if [ -n "$THR" ]; then
  UPS=$(cut -d. -f1 /proc/uptime)
  DET="${THR}ms in ${UPS}s uptime, $THC events"
  if [ "$UPS" -gt 0 ] && [ "$THR" -gt $(( UPS * 10 )) ]; then
    warn "package throttling" "$DET — over 1% of uptime stalled"
  else
    ok "package throttling" "$DET"
  fi
fi

section "Storage"
# Recorded so the scheduler does not get "fixed" later. The obvious advice for
# an NVMe -- set the scheduler to none -- is wrong on this controller. See
# docs/hardware.md, and bin/io-probe for the numbers.
NVQ=$(cat /sys/class/nvme/nvme0/quirks 2>/dev/null | tr '\n' ' ')
TAGS=$(cat /sys/block/nvme0n1/mq/0/nr_tags 2>/dev/null || echo '?')
case "$NVQ" in
  *qdepth_one*) ok "nvme queue depth" "qdepth_one quirk, $TAGS tag — merging matters, keep a scheduler" ;;
  *)            ok "nvme queue depth" "$TAGS tags, quirks: ${NVQ:-none}" ;;
esac
SCHED=$(sed -n 's/.*\[\(.*\)\].*/\1/p' /sys/block/nvme0n1/queue/scheduler 2>/dev/null)
case "$SCHED:$NVQ" in
  none:*qdepth_one*) warn "io scheduler" "none on a queue-depth-1 device — it was merging 25% of reads and 52% of writes away; bin/io-probe" ;;
  '':*)              warn "io scheduler" "could not read" ;;
  *)                 ok   "io scheduler" "$SCHED" ;;
esac
check "fstrim timer" "weekly NVMe trim" systemctl is-enabled fstrim.timer

section "Memory / zram"
check "zram-generator conf" "/etc/systemd/zram-generator.conf" have /etc/systemd/zram-generator.conf
if swapon --show=NAME --noheadings 2>/dev/null | grep -q zram0; then
  ok "zram swap" "$(swapon --show=NAME,SIZE,PRIO --noheadings | tr -s ' ')"
else
  bad "zram swap" "/dev/zram0 is not swapped on"
fi
SW=$(sysctl -n vm.swappiness 2>/dev/null); PC=$(sysctl -n vm.page-cluster 2>/dev/null)
if [ "${SW:-0}" -ge 100 ] && [ "${PC:-9}" = 0 ]; then
  ok "zram sysctls" "swappiness=$SW page-cluster=$PC"
else
  warn "zram sysctls" "swappiness=$SW page-cluster=$PC — expected >=100 and 0; run pkexec bin/tune-install"
fi

section "Graphics"
check "i965 Xsession.d file" "/etc/X11/Xsession.d/56mintbook-libva" have /etc/X11/Xsession.d/56mintbook-libva
check "i965 env file" "/etc/environment.d/90-mintbook-libva.conf" have /etc/environment.d/90-mintbook-libva.conf
VADRV=$(vainfo 2>/dev/null | sed -n 's/.*Driver version: Intel \(\w*\).*/\1/p' | head -1)
case "$VADRV" in
  i965) ok "VA-API in this shell" "i965 — the session exports it" ;;
  iHD)  warn "VA-API in this shell" "iHD — LIBVA_DRIVER_NAME is not in the session env; log out" ;;
  *)    warn "VA-API in this shell" "could not read vainfo" ;;
esac
# Ground truth: the driver a running app actually mapped. Not vainfo, which
# only says what doctor's own shell would pick, and not /proc/<pid>/environ —
# Chrome and Electron overwrite that region, so it reads back blank. See
# docs/display.md.
MAPPED=$(for p in $(pgrep -f 'chrome|cursor|claude-desktop|firefox' 2>/dev/null); do
           grep -ohE '(i965|iHD)_drv_video' "/proc/$p/maps" 2>/dev/null
         done | sort -u | tr '\n' ' ')
case "$MAPPED" in
  '')                      warn "VA-API in use" "no browser or Electron app running to check" ;;
  *i965*iHD*|*iHD*i965*)   warn "VA-API in use" "both mapped ($MAPPED) — some apps predate the fix; restart them" ;;
  *i965*)                  ok   "VA-API in use" "i965 (Broadwell) — H.264 decode; its encode entrypoint aborts" ;;
  *iHD*)                   warn "VA-API in use" "iHD — Gen9+ driver, no encode on this chip; log out to pick up i965" ;;
esac

# Firefox is the only browser here that can reach the H.264 decoder, and it only
# gets the chance once YouTube is pushed off AV1. Two prefs, applied by
# bin/firefox-video. Optional tuning, so this warns rather than fails.
FFINI=$HOME/.mozilla/firefox/profiles.ini
FFPROF=$(awk -F= '/^\[Install/{i=1;next} /^\[/{i=0} i&&$1=="Default"{print $2;exit}' "$FFINI" 2>/dev/null)
if [ -z "${FFPROF:-}" ]; then
  :
elif grep -q "mintbook firefox-video" "$HOME/.mozilla/firefox/$FFPROF/user.js" 2>/dev/null; then
  ok "firefox video prefs" "VP9/AV1 off — YouTube serves H.264, which decodes on the GPU"
else
  warn "firefox video prefs" "not applied — run bin/firefox-video (see docs/video.md)"
fi

section "Audio"
if grep -q '^snd_hda_codec_cs420x ' /proc/modules; then ok "CS4208 codec module" "snd_hda_codec_cs420x"; else bad "CS4208 codec module" "not loaded"; fi
# Named, not cut: a fixed-width cut of the aplay line lands mid-word and the
# detail stops saying anything. Card and device index still matter — the EQ
# sink has to point at the analog device, not the raw speaker one.
APLAY=$(aplay -l 2>/dev/null | grep -m1 -i 'CS4208\|MacBook')
if [ -n "$APLAY" ]; then
  ok "playback device" "$(printf '%s' "$APLAY" | sed -n 's/^card \([0-9]*\).*device \([0-9]*\): \([^[]*[^[ ]\).*/card \1 device \2 — \3/p')"
else
  warn "playback device" "no CS4208 card in aplay -l"
fi
check "macbook12-audio dkms" "built for $KREL" bash -c "dkms status macbook12-audio 2>/dev/null | grep -q \"$KREL.*installed\""
# power_save=0 is load-bearing, not an oversight. The CS4208 class-D amp rails
# are set once by EFI and the driver never re-drives them, so a runtime-PM D3
# cycle kills the speakers until reboot. Guarded because a modprobe.d change or
# a kernel default flip would do it silently. See docs/audio.md.
PSV=$(cat /sys/module/snd_hda_intel/parameters/power_save 2>/dev/null || echo '?')
if [ "$PSV" = 0 ]; then
  ok "codec power_save" "0 — the EFI-set amp rails stay powered"
else
  bad "codec power_save" "$PSV — a D3 cycle kills the speaker amp until reboot (docs/audio.md)"
fi

section "Camera"
check "firmware" "/lib/firmware/facetimehd/firmware.bin" have /lib/firmware/facetimehd/firmware.bin
check "facetimehd dkms" "built for $KREL" bash -c "dkms status facetimehd 2>/dev/null | grep -q \"$KREL.*installed\""
if grep -q 'intel_iommu=off' /proc/cmdline; then ok "intel_iommu=off" "on the running cmdline"; else bad "intel_iommu=off" "missing — the ISP cannot DMA"; fi
if [ -e /dev/video0 ]; then ok "video node" "/dev/video0"; else warn "video node" "no /dev/video0 (module may be unloaded)"; fi

section "Bluetooth"
check "DSDT override image" "/boot/acpi_override_ssdc.img" have /boot/acpi_override_ssdc.img
check "initramfs re-apply hook" "post-update.d/zz-acpi-ssdc-override" have /etc/initramfs/post-update.d/zz-acpi-ssdc-override
if [ -e /sys/class/bluetooth/hci0 ]; then
  # State and bus, never the BD address: doctor output gets pasted into issues,
  # and "Bus: UART" is the line that proves the DSDT override still holds.
  HCI_STATE=$(hciconfig hci0 2>/dev/null | sed -n 3p | tr -s ' \t' ' ' | sed 's/^ *//;s/ *$//')
  HCI_BUS=$(hciconfig hci0 2>/dev/null | sed -n 1p | grep -o 'Bus: [A-Za-z0-9]*')
  ok "hci0" "${HCI_STATE:-present}${HCI_BUS:+ — $HCI_BUS}"
else
  bad "hci0" "no adapter — SSDC is probably binding the UART again"
fi

section "Keyboard / trackpad"
check "DMA blacklist" "/etc/modprobe.d/blacklist-dw-dmac.conf" have /etc/modprobe.d/blacklist-dw-dmac.conf
check "libinput quirk" "/etc/libinput/local-overrides.quirks" have /etc/libinput/local-overrides.quirks
check "sleep mode service" "mintbook-s2idle.service" systemctl is-enabled mintbook-s2idle.service
SLEEP_MODE=$(sed -n 's/.*\[\([^]]*\)\].*/\1/p' /sys/power/mem_sleep 2>/dev/null)
if [ "$SLEEP_MODE" = s2idle ]; then
  ok "sleep mode" "s2idle — preserves Apple SPI input"
else
  bad "sleep mode" "${SLEEP_MODE:-unknown} — deep sleep kills Apple SPI input"
fi
LID_AC=$(xfconf-query -c xfce4-power-manager -p /xfce4-power-manager/lid-action-on-ac 2>/dev/null)
LID_BAT=$(xfconf-query -c xfce4-power-manager -p /xfce4-power-manager/lid-action-on-battery 2>/dev/null)
if [ "$LID_AC" = 1 ] && [ "$LID_BAT" = 1 ]; then
  ok "lid suspend" "battery + external power"
else
  bad "lid suspend" "battery=${LID_BAT:-unset}, external power=${LID_AC:-unset} — closed lid may stay awake"
fi
if grep -qF 'Name="Apple SPI Touchpad"' /proc/bus/input/devices 2>/dev/null; then
  ok "touchpad present" "input survived this boot"
else
  bad "touchpad present" "no Apple SPI Touchpad — input is dead"
fi
SLEEP_REPORT="$HOME/.local/bin/sleep-report"
if [ -x "$SLEEP_REPORT" ]; then
  if systemctl --user is-active mintbook-sleep-report.service >/dev/null 2>&1; then
    ok "controlled sleep check" "armed — close the lid or suspend normally"
  else
    SOUT=$("$SLEEP_REPORT" latest 2>/dev/null)
    SFIRST=$(printf '%s\n' "$SOUT" | head -1)
    SDETAIL=$(printf '%s\n' "$SOUT" | sed -n '2p;3p' | tr '\n' ' ')
    case "$SFIRST" in
      *'— PASS')            ok   "controlled sleep check" "$SDETAIL" ;;
      *'— PASS WITH NOTES') warn "controlled sleep check" "$SDETAIL" ;;
      *'— FAIL')            bad  "controlled sleep check" "$SDETAIL" ;;
      *)                    warn "controlled sleep check" "none recorded — run sleep-report arm" ;;
    esac
  fi
fi
if [ -e /sys/class/leds/spi::kbd_backlight ]; then ok "keyboard backlight" "spi::kbd_backlight"; else warn "keyboard backlight" "led node missing"; fi

workarea_fits_bar() {
  local width=$1 height=$2 bar=$3 area=$4
  [[ "$width" =~ ^[0-9]+$ && "$height" =~ ^[0-9]+$ && "$bar" =~ ^[0-9]+$ ]] || return 1
  (( width > 0 && height > bar )) || return 1
  [ "$area" = "0,$bar,$width,$((height - bar))" ]
}

section "Desktop"
if pgrep -u "$(id -u)" -x xfce4-panel >/dev/null 2>&1; then
  if busctl --user --timeout=2 call org.xfce.Panel /org/xfce/Panel org.xfce.Panel PluginEvent ssv mintbook-health ping b false >/dev/null 2>&1; then
    ok "top bar responsive" "panel is running and answering — bin/panel-install adds automatic recovery"
  else
    bad "top bar responsive" "panel is running but not answering — restart the bar"
  fi
else
  bad "top bar responsive" "panel is absent — run bin/panel-install from the desktop"
fi
if [ -e "$HOME/.config/autostart/mintbook-panel.desktop" ]; then
  check "top bar recovery" "bin/panel-install" systemctl --user is-active mintbook-panel.service
fi
DPI=$(xfconf-query -c xsettings -p /Xft/DPI 2>/dev/null || echo '?')
PSZ=$(xfconf-query -c xfce4-panel -p /panels/panel-1/size 2>/dev/null || echo '?')
MTOP=$(xfconf-query -c xfwm4 -p /general/margin_top 2>/dev/null || echo '?')
[ "$DPI" = 168 ] && ok "Xft/DPI" "$DPI" || warn "Xft/DPI" "$DPI (expected 168)"
if [ "$PSZ" = "$MTOP" ]; then
  ok "panel size / margin_top" "$PSZ — maximized windows clear the bar"
else
  bad "panel size / margin_top" "panel=$PSZ margin_top=$MTOP — they must match"
fi
PPOS=$(xfconf-query -c xfce4-panel -p /panels/panel-1/position 2>/dev/null || echo '?')
case "$PPOS" in
  p=6*) ok "panel snap position" "$PPOS — snapped to the top edge, so it sets a strut" ;;
  *)    bad "panel snap position" "$PPOS — must be p=6, or the panel sets no strut" ;;
esac
WA=$(xprop -root _NET_WORKAREA 2>/dev/null | cut -d= -f2 | tr -d ' ' | cut -d, -f1-4)
if [ -z "$WA" ]; then
  warn "_NET_WORKAREA" "cannot query the X display — run doctor inside the desktop session"
else
  GEOMETRY=$(xprop -root _NET_DESKTOP_GEOMETRY 2>/dev/null | cut -d= -f2 | tr -d ' ')
  IFS=, read -r DESKTOP_WIDTH DESKTOP_HEIGHT <<< "$GEOMETRY"
  if workarea_fits_bar "${DESKTOP_WIDTH:-}" "${DESKTOP_HEIGHT:-}" "$PSZ" "$WA"; then
    ok "_NET_WORKAREA" "$WA — apps that place their own windows clear the bar"
  elif [[ "${DESKTOP_WIDTH:-}" =~ ^[0-9]+$ && "${DESKTOP_HEIGHT:-}" =~ ^[0-9]+$ && "$PSZ" =~ ^[0-9]+$ ]]; then
    bad "_NET_WORKAREA" "$WA — expected 0,$PSZ,$DESKTOP_WIDTH,$((DESKTOP_HEIGHT - PSZ)); windows may open under the bar"
  else
    warn "_NET_WORKAREA" "$WA — could not read the current desktop geometry"
  fi
fi

# The genmon plugins actually on the bar, asked of the bar. This used to be the
# literal list "17 18 19 21 22 23", written down once and left there: 21, 22 and
# 23 have not been on the bar since the Control Center took Bluetooth, power and
# night light, so it was checking for .rc files belonging to nothing and going
# green while describing a bar that no longer existed.
GENMON=''
for p in $(xfconf-query -c xfce4-panel -p /panels/panel-1/plugin-ids 2>/dev/null | grep -oE '^[0-9]+$'); do
  [ "$(xfconf-query -c xfce4-panel -p "/plugins/plugin-$p" 2>/dev/null)" = genmon ] || continue
  GENMON="${GENMON} $p"
  [ -e "$HOME/.config/xfce4/panel/genmon-$p.rc" ] || MISSING="${MISSING-} $p"
done
if [ -z "${GENMON}" ]; then
  warn "genmon panel plugins" "none on the bar — is xfce4-panel running?"
elif [ -z "${MISSING-}" ]; then
  ok "genmon panel plugins" "on the bar:${GENMON}"
else
  bad "genmon panel plugins" "on the bar:${GENMON} — no .rc for:${MISSING}"
fi

# The battery indicator, only once it has been installed — this machine is
# fine with the XFCE plugin, so its absence is not a fault. See docs/battery.md.
if [ -e "$HOME/.config/mintbook/battery.conf" ]; then
  check "battery indicator" "bin/panel-battery" have "$HOME/.local/bin/panel-battery"
  check "battery menu" "bin/battery-menu" have "$HOME/.local/bin/battery-menu"
  check "battery history" "bin/battery-history" have "$HOME/.local/bin/battery-history"
  BID=$(sed -n 's/^PANEL_ID=\([0-9]*\).*/\1/p' "$HOME/.config/mintbook/battery.conf" | head -1)
  check "battery genmon rc" "genmon-${BID:-26}.rc" have "$HOME/.config/xfce4/panel/genmon-${BID:-26}.rc"
  BLOG="$HOME/.cache/mintbook/battery/history"
  if [ -s "$BLOG" ]; then
    BN=$(wc -l < "$BLOG")
    BAGE=$(( ( $(date +%s) - $(stat -c %Y "$BLOG") ) / 60 ))
    if [ "$BAGE" -le 5 ]; then
      ok "battery samples" "$BN samples, last one ${BAGE}m ago"
    else
      warn "battery samples" "$BN samples, but the last is ${BAGE}m old — is the panel running?"
    fi
  else
    warn "battery samples" "no samples yet — it fills at one a minute while the panel runs"
  fi

  # Recent is not the same as correctly spaced. A SAMPLE_EVERY left at 2 ran
  # the /proc walk six times too often for eleven hours and every check above
  # stayed green throughout, because they all only ever asked how old the last
  # line was. See docs/battery.md.
  BSE=$(sed -n 's/^SAMPLE_EVERY=\([0-9]*\).*/\1/p' "$HOME/.config/mintbook/battery.conf" | head -1)
  BSE=${BSE:-12}
  BWANT=$(( BSE * 5 ))          # genmon ticks every 5 s; the rc sets that
  BGAP=$(tail -40 "$BLOG" 2>/dev/null | awk '$5+0 > 0 {print $5+0}' | sort -n \
         | awk '{a[NR]=$1} END{if (NR) print a[int((NR+1)/2)]}')
  # The wear curve, such as there is one. panel-battery writes one line a day.
  BHL="$HOME/.cache/mintbook/battery/health"
  if [ -s "$BHL" ]; then
    BHN=$(wc -l < "$BHL")
    BHNOW=$(awk 'END{if ($3+0) printf "%d", $2*100/$3}' "$BHL")
    if [ "$BHN" -ge 2 ]; then
      BHTHEN=$(awk 'NR==1{if ($3+0) printf "%d", $2*100/$3}' "$BHL")
      BHDAYS=$(awk 'NR==1{f=$1} END{printf "%d", ($1-f)/86400}' "$BHL")
      ok "battery wear log" "${BHNOW}% of design, ${BHTHEN}% ${BHDAYS} days ago ($BHN readings)"
    else
      ok "battery wear log" "${BHNOW}% of design, 1 reading — a second lands tomorrow"
    fi
  else
    warn "battery wear log" "empty — the first line lands within an hour of the panel starting"
  fi

  if [ -z "$BGAP" ]; then
    warn "battery sample rate" "no spaced samples yet — needs two in a row"
  elif [ "$BGAP" -ge $(( BWANT * 6 / 10 )) ] && [ "$BGAP" -le $(( BWANT * 16 / 10 )) ]; then
    ok "battery sample rate" "${BGAP}s apart — SAMPLE_EVERY=$BSE wants ${BWANT}s"
  else
    warn "battery sample rate" "${BGAP}s apart, but SAMPLE_EVERY=$BSE wants ${BWANT}s"
  fi
fi
# The CPU popup, only once it has been installed — bin/panel-cpu falls back
# to gnome-system-monitor without it, so its absence is not a fault.
if [ -e "$HOME/.local/bin/cpu-menu" ]; then
  check "cpu indicator" "bin/panel-cpu" have "$HOME/.local/bin/panel-cpu"
  check "cpu menu" "bin/cpu-menu" have "$HOME/.local/bin/cpu-menu"
  check "cpu helpers" "bin/mintbook_cpu.py" have "$HOME/.local/bin/mintbook_cpu.py"
  if grep -q 'cpu-menu' "$HOME/.local/bin/panel-cpu" 2>/dev/null; then
    ok "cpu click target" "the sparkline opens the menu"
  else
    warn "cpu click target" "panel-cpu is older than the menu — run bin/cpu-install"
  fi
fi
# The Wi-Fi popup, only once it has been installed — bin/panel-wifi falls back
# to nm-connection-editor without it, so its absence is not a fault.
if [ -e "$HOME/.local/bin/wifi-menu" ]; then
  check "wifi indicator" "bin/panel-wifi" have "$HOME/.local/bin/panel-wifi"
  check "wifi menu" "bin/wifi-menu" have "$HOME/.local/bin/wifi-menu"
  if grep -q 'wifi-menu' "$HOME/.local/bin/panel-wifi" 2>/dev/null; then
    ok "wifi click target" "the bar icon opens the menu"
  else
    warn "wifi click target" "panel-wifi is older than the menu — run bin/wifi-install"
  fi
  # From sysfs, not /proc/net/wireless: that legacy WEXT table is empty on
  # cfg80211 drivers like brcmfmac until the card associates, so it cannot
  # answer "is there a wireless interface?".
  WIF=''
  for d in /sys/class/net/*/wireless; do
    [ -d "$d" ] || continue
    d=${d%/wireless}; WIF=${d##*/}; break
  done
  if [ -n "$WIF" ]; then
    ok "wireless interface" "$WIF"
  else
    warn "wireless interface" "no /sys/class/net/*/wireless — no Wi-Fi adapter"
  fi
fi
# The Bluetooth popup, only once bin/bt-panel-install has run — Bluetooth is a
# Control Center tile without it, and bin/panel-bt falls back to opening
# blueman-manager, so its absence is not a fault. This is the desktop half;
# whether the radio exists at all is the DSDT check in the Bluetooth section.
if [ -e "$HOME/.config/mintbook/bluetooth.conf" ]; then
  check "bluetooth indicator" "bin/panel-bt" have "$HOME/.local/bin/panel-bt"
  check "bluetooth menu" "bin/bt-menu" have "$HOME/.local/bin/bt-menu"
  BTID=$(sed -n 's/^PANEL_ID=\([0-9]*\).*/\1/p' "$HOME/.config/mintbook/bluetooth.conf" | head -1)
  check "bluetooth genmon rc" "genmon-${BTID:-21}.rc" \
    have "$HOME/.config/xfce4/panel/genmon-${BTID:-21}.rc"
  if grep -q 'bt-menu' "$HOME/.local/bin/panel-bt" 2>/dev/null; then
    ok "bluetooth click target" "the bar icon opens the menu"
  else
    warn "bluetooth click target" "panel-bt is older than the menu — run bin/bt-panel-install"
  fi
  # Without an <img> genmon puts the script's stdout on the bar as plain text —
  # the failure the update arrow hit before updates-none.svg existed. Both
  # icons or neither.
  for f in bt-on bt-off; do
    check "bluetooth icon" "$f.svg" have "$HOME/.local/share/mintbook/bt/$f.svg"
  done
  # blueman-applet is the BlueZ agent. bin/bt-menu asks a device to pair and
  # then has nothing to show a passkey with — that dialog is blueman's, and
  # without the applet running a pairing that needs one silently never finishes.
  if pgrep -x blueman-applet >/dev/null 2>&1; then
    ok "pairing agent" "blueman-applet is running"
  else
    warn "pairing agent" "no blueman-applet — pairing from the menu has no dialog"
  fi
  # blueman-tray is blueman's own Bluetooth icon. With ours on the bar it is a
  # second widget saying less, and it is what the systray collapse arrow was
  # there to hide. bin/bt-panel-install switches off the StatusIcon plugin that
  # spawns it; if it is back, that setting has been undone.
  if pgrep -x blueman-tray >/dev/null 2>&1; then
    warn "blueman tray icon" "blueman-tray is running — a second Bluetooth icon"
  else
    ok "blueman tray icon" "off; ours is the only one"
  fi
  # The arrow on the systray exists only when something is hidden behind it.
  if xfconf-query -c xfce4-panel -p /plugins/plugin-8/hidden-items >/dev/null 2>&1; then
    warn "systray collapse arrow" "hidden-items is set — the systray has an arrow again"
  else
    ok "systray collapse arrow" "nothing hidden, so no arrow"
  fi
fi
# The System sheet owns Doctor, update state and session actions once installed.
# Its icon is always present; only the small semantic badge changes.
if [ -e "$HOME/.config/mintbook/system.conf" ]; then
  SID=$(sed -n 's/^PANEL_ID=\([0-9]*\).*/\1/p' "$HOME/.config/mintbook/system.conf" | head -1)
  check "system indicator" "bin/panel-system" have "$HOME/.local/bin/panel-system"
  check "system menu" "bin/system-menu" have "$HOME/.local/bin/system-menu"
  check "system genmon rc" "genmon-${SID:-28}.rc" \
    have "$HOME/.config/xfce4/panel/genmon-${SID:-28}.rc"
  check "system icons" "normal, update, security, alert" \
    have "$HOME/.local/share/mintbook/system/system-alert.svg"
fi
# The software-update machinery, only once installed. The System icon replaces
# its standalone arrow on current installs, but the cache, timer and detailed
# package menu remain the same. See docs/updates.md.
if [ -e "$HOME/.config/mintbook/updates.conf" ]; then
  if [ ! -e "$HOME/.config/mintbook/system.conf" ]; then
    check "updates indicator" "bin/panel-updates" have "$HOME/.local/bin/panel-updates"
    UID_=$(sed -n 's/^PANEL_ID=\([0-9]*\).*/\1/p' "$HOME/.config/mintbook/updates.conf" | head -1)
    check "updates genmon rc" "genmon-${UID_:-20}.rc" have "$HOME/.config/xfce4/panel/genmon-${UID_:-20}.rc"
    check "updates icons" "updates.svg, -alert, -none" \
      have "$HOME/.local/share/mintbook/updates/updates-none.svg"
  fi
  check "updates menu" "bin/updates-menu" have "$HOME/.local/bin/updates-menu"
  check "updates check" "bin/updates-check" have "$HOME/.local/bin/updates-check"
  if grep -qx 'Hidden=true' "$HOME/.config/autostart/mintupdate.desktop" 2>/dev/null; then
    ok "stock update autostart" "disabled; Mintbook owns update status"
  else
    warn "stock update autostart" "enabled — run bin/updates-install to prevent a duplicate icon"
  fi
  check "updates timer" "mintbook-updates-check.timer" \
    systemctl --user is-enabled mintbook-updates-check.timer

  # The one check that matters. Everything above can be green while the answer
  # on the bar is a week old, and a stale "nothing waiting" is a lie the whole
  # indicator is built to avoid. The timer runs every 6 h; 18 h is three misses.
  USTATE="$HOME/.cache/mintbook/updates.state"
  if [ -s "$USTATE" ]; then
    UERR=$(sed -n 's/^error = //p' "$USTATE")
    UAGE=$(( ( $(date +%s) - $(sed -n 's/^checked = //p' "$USTATE") ) / 3600 ))
    UN=$(sed -n 's/^count = //p' "$USTATE")
    USEC=$(sed -n 's/^security = //p' "$USTATE")
    if [ -n "$UERR" ]; then
      warn "updates state" "the last check failed: ${UERR:0:60}"
    elif [ "$UAGE" -gt 18 ]; then
      warn "updates state" "${UN} waiting, but last checked ${UAGE}h ago — is the timer running?"
    else
      ok "updates state" "${UN} waiting (${USEC} security), checked ${UAGE}h ago"
    fi

    # The flatpak half is answered over the network, so it can be older than
    # the apt half beside it in the same file — or never answered at all. A
    # count that is half fresh is not a fresh count, and the whole reason
    # updates-check carries the old flatpak answer forward instead of writing
    # a zero is so that this line can tell you which half is stale.
    UFP=$(sed -n 's/^flatpak = //p' "$USTATE")
    UFPC=$(sed -n 's/^flatpak_checked = //p' "$USTATE")
    if ! python3 -c 'import gi; gi.require_version("Flatpak","1.0")' 2>/dev/null; then
      warn "flatpak updates" "no gir1.2-flatpak-1.0 — flatpaks are not counted"
    elif [ -z "${UFPC:-}" ] || [ "${UFPC:-0}" = 0 ]; then
      warn "flatpak updates" "never checked — needs the network once"
    else
      UFPAGE=$(( ( $(date +%s) - UFPC ) / 3600 ))
      if [ "$UFPAGE" -gt 48 ]; then
        warn "flatpak updates" "${UFP:-0} waiting, but last asked ${UFPAGE}h ago — offline since?"
      else
        ok "flatpak updates" "${UFP:-0} waiting, asked ${UFPAGE}h ago"
      fi
    fi
  else
    warn "updates state" "no state file yet — the timer writes one 5 min after login"
  fi
fi
check "night light autostart" "mintbook-night.desktop" have "$HOME/.config/autostart/mintbook-night.desktop"
# Hidden=true user overrides of entries in /etc/xdg/autostart. An override is
# only meaningful while the system entry it shadows still exists, so check both
# — a stale override that shadows nothing is just a confusing file.
MISSING_AS=""
for e in org.gnome.Evolution-alarm-notify print-applet geoclue-demo-agent; do
  [ -f "/etc/xdg/autostart/$e.desktop" ] || continue
  [ -f "$HOME/.config/autostart/$e.desktop" ] || MISSING_AS="$MISSING_AS $e"
done
if [ -z "$MISSING_AS" ]; then
  ok "autostart overrides" "evolution, print-applet, geoclue all disabled"
else
  warn "autostart overrides" "still autostarting:$MISSING_AS — see docs/desktop.md"
fi

section "Housekeeping"
if systemctl --failed --no-legend --no-pager 2>/dev/null | grep -q .; then
  bad "failed units" "$(systemctl --failed --no-legend --no-pager | awk '{print ($1 == "●" ? $2 : $1)}' | tr '\n' ' ')"
else
  ok "failed units" "none"
fi
# Services bin/service-trim masks. Reported, not asserted: an update can
# re-enable one, and a printer or modem appearing is a legitimate reason for
# one to come back. service-trim --check re-runs the probes and says which.
TRIM=""
for u in ModemManager.service cups.service cups.socket cups.path \
         cups-browsed.service switcheroo-control.service rsyslog.service \
         kerneloops.service casper.service casper-md5check.service; do
  systemctl list-unit-files "$u" >/dev/null 2>&1 || continue
  [ "$(systemctl is-enabled "$u" 2>/dev/null || true)" = masked ] && continue
  TRIM="$TRIM ${u%.service}"
done
if [ -n "$TRIM" ]; then
  warn "trimmable services" "still enabled:$TRIM — $ROOT/bin/service-trim --check"
else
  ok "trimmable services" "all masked"
fi
# The runaway watcher, and what it currently sees. A candidate here is not a
# fault: `runaway-watch --check` lists processes matching the *shape* it looks
# for, and on a healthy machine several do — redshift among them — all of them
# idle. Only one that is also burning a core gets a notification.
if systemctl --user is-enabled mintbook-runaway-watch.timer >/dev/null 2>&1; then
  RW=$("$ROOT/bin/runaway-watch" --check 2>/dev/null | sed -n 's/^would nominate: //p')
  if [ -n "${RW:-}" ] && [ "$RW" != nothing ]; then
    warn "runaway watch" "pid $RW is burning a core with no parent — $ROOT/bin/runaway-watch --check"
  else
    ok "runaway watch" "five-minute timer, nothing to report"
  fi
else
  warn "runaway watch" "not installed — $ROOT/bin/runaway-install"
fi
JD=$(journalctl --disk-usage 2>/dev/null | grep -o '[0-9.]*[MG]' | head -1)
check "journal cap" "/etc/systemd/journald.conf.d/mintbook.conf ($JD)" have /etc/systemd/journald.conf.d/mintbook.conf
FREE=$(df --output=pcent / | tail -1 | tr -dc 0-9)
[ "$FREE" -lt 90 ] && ok "root filesystem" "${FREE}% used" || warn "root filesystem" "${FREE}% used"
BATH=$(upower -i /org/freedesktop/UPower/devices/battery_BAT0 2>/dev/null | awk '/capacity:/{print int($2)}')
if [ -n "${BATH:-}" ]; then
  [ "$BATH" -ge 70 ] && ok "battery health" "${BATH}% of design" || warn "battery health" "${BATH}% of design"
fi

if [ "$FORMAT" = --tsv ]; then
  printf 'summary\t%d\t%d\t%d\n' "$PASS" "$WARN" "$FAIL"
else
  printf '\n%d ok, %d warn, %d FAIL\n' "$PASS" "$WARN" "$FAIL"
fi
[ "$FAIL" -eq 0 ]
