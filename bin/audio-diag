#!/usr/bin/env bash
# audio-diag - dump everything needed to reason about the CS4208 speaker problem.
# Read-only. No sudo. See docs/audio.md.
set -uo pipefail

hr() { printf '\n=== %s ===\n' "$1"; }

hr "KERNEL / MODULE"
uname -r
lsmod | grep -E 'cs420x|cirrus' || echo "(no cirrus codec module loaded)"
for m in snd_hda_codec_cs420x snd_hda_codec_cirrus; do
  modinfo "$m" 2>/dev/null | grep -E '^filename' && \
    echo "  ^ 'updates/dkms' = out-of-tree driver; 'kernel/' = in-tree"
done

hr "CRASH CHECK"
printf 'oops/UBSAN lines this boot: %s\n' "$(dmesg 2>/dev/null | grep -cE 'BUG:|Oops|UBSAN')"
dmesg 2>/dev/null | grep -E 'UBSAN|BUG:|RIP:' | head -5

hr "CARDS"
cat /proc/asound/cards

CODEC=$(grep -ls CS4208 /proc/asound/card*/codec#* 2>/dev/null | head -1)
if [ -z "$CODEC" ]; then
  echo "!! No CS4208 codec found - the analog card failed to initialise."
  exit 1
fi
echo "codec file: $CODEC"

hr "CODEC IDENTITY"
head -6 "$CODEC"

hr "GPIO  (amp enable lives here; all enable=0 means the amp is never powered)"
grep -A7 '^GPIO' "$CODEC"

hr "SPEAKER PIN 0x1d  (digital, no amp - fed by converter 0x0a)"
awk '/^Node 0x1d /,/^Node 0x1e /' "$CODEC" | head -12

hr "SPEAKER CONVERTER 0x0a"
awk '/^Node 0x0a /,/^Node 0x0b /' "$CODEC" | grep -iE 'Audio Output|Digital|Power'

hr "HEADPHONE PIN 0x10  (analog, works)"
awk '/^Node 0x10 /,/^Node 0x11 /' "$CODEC" | grep -iE 'wcaps|Pincap|Pin Default|Pin-ctls|Connection|0x02'

hr "AUDIO OUTPUT CONVERTERS"
grep -E '^Node 0x[0-9a-f]+ \[Audio Output\]' "$CODEC"

hr "AUTOCONFIG / FIXUP  (a blank fixup name means no mainline quirk matched)"
dmesg 2>/dev/null | grep -iE 'cs4208' | grep -iE 'fixup|autoconfig|_outs|inputs' | tail -8

hr "MIXER"
CARDNAME=$(basename "$(dirname "$CODEC")" | sed 's/^card//')
amixer -c "$CARDNAME" scontents 2>/dev/null | grep -E 'Simple mixer|Playback [0-9]|\[o[nf]+\]' | head -30

hr "PIPEWIRE"
pactl info 2>/dev/null | grep -E 'Server Name|Default Sink'
pactl list short sinks 2>/dev/null
pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null | head -1
pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null

hr "EXTERNAL AMP ON I2C?  (expect only SMBus + i915 - amp is NOT a separate I2C device)"
for d in /sys/bus/i2c/devices/*/; do
  n=$(cat "$d/name" 2>/dev/null) && echo "$(basename "$d"): $n"
done

hr "BLUETOOTH  (no adapter = BT audio is not a fallback)"
ls /sys/class/bluetooth/ 2>/dev/null | grep . || echo "(no adapter present)"
