#!/usr/bin/env bash
# appearance-mode - switch Mintbook's system chrome between pearl light and slate dark.
# Usage: appearance-mode auto|light|dark|toggle|--refresh
set -euo pipefail

root="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
state_dir="$HOME/.config/mintbook"
mode_file="$state_dir/appearance.mode"
env_file="$state_dir/system-chrome.env"
mode=${1:-}
applied_file="$state_dir/appearance.applied"

if [ "$mode" = --refresh ]; then
  mode=$(cat "$mode_file" 2>/dev/null || printf auto)
fi

if [ "$mode" = toggle ]; then
  [ "$(cat "$mode_file" 2>/dev/null || true)" = light ] && mode=dark || mode=light
fi
case "$mode" in
  light)
    rgba=(0.8431372549 0.8549019608 0.8705882353 0.8588235294)
    foreground='#2d3036'
    css="$root/config/gtk-3.0/panel-light.css"
    rasi="$root/config/rofi/palette-light.rasi"
    ;;
  dark)
    rgba=(0.3568627451 0.3764705882 0.4117647059 0.7019607843)
    foreground='#ffffff'
    css="$root/config/gtk-3.0/panel-dark.css"
    rasi="$root/config/rofi/palette-dark.rasi"
    ;;
  auto)
    period=$(redshift -p -c "$HOME/.config/redshift.conf" 2>/dev/null | awk -F: '/^Period:/ {gsub(/^[[:space:]]+/, "", $2); print $2; exit}')
    case "$period" in Night|Transition) target=dark ;; *) target=light ;; esac
    # The child records "auto", not the surface it applies. It used to write
    # its own target and let this branch put "auto" back afterwards, which left
    # a window where the file said light or dark — and anything reading it just
    # then (panel-control ticks --refresh every 60 s) latched that as the mode
    # and auto was gone for good. Observed: auto turned into a permanent light
    # on the evening of 2026-09-06.
    MINTBOOK_APPEARANCE_MODE=auto exec "$0" "$target"
    ;;
  *) echo "usage: $0 auto|light|dark|toggle|--refresh" >&2; exit 2 ;;
esac

mkdir -p "$state_dir" "$HOME/.config/gtk-3.0" "$HOME/.config/rofi"
printf '%s\n' "${MINTBOOK_APPEARANCE_MODE:-$mode}" > "$mode_file"
# The palette check is not redundant with the applied check: a fresh checkout
# has the mode already applied and no ~/.config/rofi/palette.rasi, and rofi
# fails hard on a missing @import. This makes --refresh able to heal that.
if [ "$(cat "$applied_file" 2>/dev/null || true)" = "$mode" ] \
   && [ -f "$HOME/.config/rofi/palette.rasi" ]; then
  exit 0
fi
# Single-quoted, not %q. %q escapes the '#' as '\#', which is correct shell and
# comes back right when this file is sourced — but bin/panel-cpu reads the line
# as text, and an SVG with fill="\#ffffff" is invalid, so librsvg drops the
# colour and paints black. The sparkline was black on the dark bar for that
# reason. Quoted like this, both a `.` and a naive parser get '#ffffff'.
printf "PANEL_FOREGROUND='%s'\n" "$foreground" > "$env_file"
install -m644 "$css" "$HOME/.config/gtk-3.0/gtk.css"
# Spotlight reads its theme at launch, so this needs no reload of anything.
install -m644 "$rasi" "$HOME/.config/rofi/palette.rasi"

xfconf-query -c xfce4-panel -p /panels/panel-1/background-rgba \
  -t double -s "${rgba[0]}" -t double -s "${rgba[1]}" \
  -t double -s "${rgba[2]}" -t double -s "${rgba[3]}"

for generator in generate-wifi-genmon.py generate-bt-genmon.py generate-power-genmon.py generate-night-genmon.py generate-appearance-genmon.py generate-control-genmon.py generate-updates-genmon.py; do
  MINTBOOK_PANEL_FG="$foreground" python3 "$root/icons/$generator"
done

xfce4-panel -r
printf '%s\n' "$mode" > "$applied_file"
printf 'system chrome: %s\n' "$mode"
