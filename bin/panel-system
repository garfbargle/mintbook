#!/usr/bin/env python3
"""Static System indicator with one small, meaningful status badge."""
import json
from pathlib import Path

home = Path.home()
menu = home / '.local/bin/system-menu'
icons = home / '.local/share/mintbook/system'

fail = notes = passed = 0
try:
    rows = json.loads((home / '.cache/mintbook/health.json').read_text())['rows']
    if not isinstance(rows, list) or any(not isinstance(row, dict) for row in rows):
        raise ValueError('invalid health rows')
    fail = sum(row.get('status') == 'fail' for row in rows)
    notes = sum(row.get('status') == 'warn' for row in rows)
    passed = sum(row.get('status') == 'ok' for row in rows)
except (OSError, ValueError, KeyError, TypeError):
    pass

updates = security = 0
update_error = ''
updates_installed = (home / '.config/mintbook/updates.conf').exists()
try:
    if not updates_installed:
        raise FileNotFoundError
    for line in (home / '.cache/mintbook/updates.state').read_text().splitlines():
        key, sep, value = line.partition(' = ')
        if sep and key in ('count', 'security'):
            try:
                if key == 'count': updates = int(value)
                else: security = int(value)
            except ValueError: pass
        elif sep and key == 'error': update_error = value.strip()
except OSError:
    pass

if fail or update_error:
    icon = 'system-alert.svg'
elif security:
    icon = 'system-security.svg'
elif updates:
    icon = 'system-update.svg'
else:
    icon = 'system.svg'

print(f'<click>{menu}</click>\n<iconclick>{menu}</iconclick>')
print(f'<img>{icons / icon}</img>')
status = []
if fail:
    status.append(f'{fail} error' + ('s' if fail != 1 else ''))
elif notes:
    status.append(f'{passed} passed · {notes} notes')
elif passed:
    status.append(f'{passed} passed')
if update_error:
    status.append('update check failed')
elif updates:
    status.append(f'{updates} update' + ('s' if updates != 1 else ''))
lines = ['System']
if status:
    lines.append(' · '.join(status))
print('<tool>' + '\n'.join(lines) + '</tool>')
