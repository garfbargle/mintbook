#!/usr/bin/env python3
"""The prompt that appears when something is being sent to this machine.

    mintdrop-accept --from NAME --what FILE --size 12 MB --address 192.168.1.9

Exit 0 accept, 1 decline, 2 accept and stop asking for this sender. bin/mintdrop
runs it and waits; a timeout out there is a decline, so nothing here has to
worry about being left open.

Centred rather than hung off a pointer, unlike the bar popups: nobody clicked
anything to get here, so there is no icon for it to belong to, and a prompt
that appears under wherever the mouse happens to be resting is a prompt that
gets dismissed by accident. Escape and Decline are the same answer, and the
window takes the keyboard so Return lands on Accept without aiming.
"""
import argparse
import math
import os
import sys
import time

# Adwaita before the Gtk import, for the reason bin/control-center and
# bin/bt-menu give: Gtk.init parses the GTK theme, WhiteSur's gtk.css is
# 400 KB, and that is ~120 ms of every launch spent on a stylesheet this
# window never reads a rule from. Every colour here comes from the embedded
# glass palette below and from appearance.applied.
os.environ.setdefault('GTK_THEME', 'Adwaita')

import cairo
import gi
gi.require_version('Gtk', '3.0')
from gi.repository import Gtk, Gdk, GLib

APPLIED = os.path.expanduser('~/.config/mintbook/appearance.applied')

LIGHT = {  # generated by bin/palette-generate
    'top': (229, 231, 234, 0.980392),
    'bottom': (202, 205, 210, 0.968627),
    'edge': (255, 255, 255, 0.74902),
    'rim': (65, 68, 74, 0.180392),
    'fg': (45, 48, 54),
    'tile': (255, 255, 255, 0.54902),
    'tile_hi': (255, 255, 255, 0.780392),
    'tile_edge': (255, 255, 255, 0.65098),
    'hair': (65, 68, 74, 0.121569),
    'accent': (0, 122, 255),
}
DARK = {  # generated by bin/palette-generate
    'top': (104, 109, 119, 0.976471),
    'bottom': (74, 78, 86, 0.968627),
    'edge': (255, 255, 255, 0.180392),
    'rim': (0, 0, 0, 0.34902),
    'fg': (255, 255, 255),
    'tile': (255, 255, 255, 0.129412),
    'tile_hi': (255, 255, 255, 0.2),
    'tile_edge': (255, 255, 255, 0.101961),
    'hair': (255, 255, 255, 0.121569),
    'accent': (10, 132, 255),
}

_screen = Gdk.Screen.get_default()
SC = float(os.environ.get('MINTBOOK_SCALE', 0)) or round(((_screen.get_resolution() if _screen else 96) or 96) / 96.0, 3) or 1.0
CORNER = 18
SHADOW = 16
ACCEPT, DECLINE, ALWAYS = 0, 1, 2


def px(value):
    return int(round(value * SC))


def appearance():
    override = os.environ.get('MINTBOOK_PREVIEW_APPEARANCE')
    if override in ('light', 'dark'):
        return DARK if override == 'dark' else LIGHT
    try:
        with open(APPLIED) as f:
            return DARK if f.read().strip() == 'dark' else LIGHT
    except OSError:
        return LIGHT


def rgba(cr, c, alpha=None):
    a = c[3] if len(c) > 3 else 1.0
    cr.set_source_rgba(c[0] / 255, c[1] / 255, c[2] / 255,
                       a if alpha is None else a * alpha)


def rrect(cr, x, y, w, h, r):
    r = max(0, min(r, w / 2, h / 2))
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


def main():
    parser = argparse.ArgumentParser(description=__doc__.split('\n\n')[0])
    parser.add_argument('--from', dest='sender', default='Unknown device')
    parser.add_argument('--what', default='a file')
    parser.add_argument('--size', default='')
    parser.add_argument('--address', default='')
    args = parser.parse_args()

    colors = appearance()
    answer = {'value': DECLINE}

    def css_rgb(key, alpha=None):
        c = colors[key]
        a = c[3] if len(c) == 4 else 1.0
        if alpha is not None:
            a *= alpha
        if a < 1.0:
            return f'rgba({c[0]},{c[1]},{c[2]},{a:.3f})'
        return f'rgb({c[0]},{c[1]},{c[2]})'

    def draw_background(widget, cr):
        alloc = widget.get_allocation()
        cr.save()
        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.set_source_rgba(0, 0, 0, 0)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)
        cr.scale(SC, SC)
        x = y = SHADOW
        w = alloc.width / SC - 2 * SHADOW
        h = alloc.height / SC - 2 * SHADOW
        for i in range(SHADOW, 0, -1):
            rrect(cr, x - i, y - i + 2, w + 2 * i, h + 2 * i, CORNER + i)
            cr.set_line_width(1.4)
            cr.set_source_rgba(0, 0, 0, .06 * (1 - i / SHADOW) ** 2)
            cr.stroke()
        top, bot = colors['top'], colors['bottom']
        grad = cairo.LinearGradient(0, y, 0, y + h)
        grad.add_color_stop_rgba(0, top[0] / 255, top[1] / 255, top[2] / 255, top[3])
        grad.add_color_stop_rgba(1, bot[0] / 255, bot[1] / 255, bot[2] / 255, bot[3])
        rrect(cr, x + .5, y + .5, w - 1, h - 1, CORNER)
        cr.set_source(grad)
        cr.fill_preserve()
        rgba(cr, colors['rim'])
        cr.set_line_width(1)
        cr.stroke()
        rrect(cr, x + 1.25, y + 1.25, w - 2.5, h - 2.5, CORNER - .75)
        rgba(cr, colors['edge'])
        cr.set_line_width(1)
        cr.stroke()
        cr.restore()
        return False

    win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
    win.set_decorated(False)
    win.set_skip_taskbar_hint(True)
    win.set_skip_pager_hint(True)
    win.set_keep_above(True)
    win.set_resizable(False)
    win.set_accept_focus(True)
    win.set_type_hint(Gdk.WindowTypeHint.DIALOG)
    win.set_position(Gtk.WindowPosition.CENTER_ALWAYS)
    win.set_app_paintable(True)
    visual = Gdk.Screen.get_default().get_rgba_visual()
    if visual is not None:
        win.set_visual(visual)
    win.connect('draw', draw_background)

    css = Gtk.CssProvider()
    css.load_from_data(f"""
        window {{ background-color: transparent; }}
        label {{ color: {css_rgb('fg')}; }}
        label.sub {{ color: {css_rgb('fg', 0.55)}; font-size: {px(11)}px; }}
        label.title {{ font-weight: 600; font-size: {px(14)}px; }}
        label.what {{ font-size: {px(12)}px; }}
        button {{
            color: {css_rgb('fg')};
            background-image: none;
            background-color: {css_rgb('tile')};
            border: 1px solid {css_rgb('tile_edge')};
            border-radius: {px(9)}px;
            padding: {px(7)}px {px(16)}px;
            box-shadow: none;
            font-size: {px(11)}px;
        }}
        button:hover {{ background-color: {css_rgb('tile_hi')}; }}
        button.suggested {{
            background-color: {css_rgb('accent')};
            color: #ffffff;
            border-color: {css_rgb('accent')};
        }}
        button.quiet {{
            border: none;
            background-color: transparent;
            color: {css_rgb('fg', 0.55)};
            font-size: {px(11)}px;
        }}
    """.encode())
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=px(6))
    for side in ('top', 'bottom', 'start', 'end'):
        getattr(box, f'set_margin_{side}')(px(18 + SHADOW))
    win.add(box)

    title = Gtk.Label(label=f'{args.sender} wants to send you a file', xalign=0)
    title.get_style_context().add_class('title')
    box.pack_start(title, False, False, 0)

    detail = args.what if not args.size else f'{args.what} \u00b7 {args.size}'
    what = Gtk.Label(label=detail, xalign=0)
    what.get_style_context().add_class('what')
    what.set_max_width_chars(44)
    what.set_ellipsize(3)                      # Pango.EllipsizeMode.END
    box.pack_start(what, False, False, 0)

    if args.address:
        where = Gtk.Label(label=args.address, xalign=0)
        where.get_style_context().add_class('sub')
        box.pack_start(where, False, False, 0)

    def answer_with(value):
        answer['value'] = value
        Gtk.main_quit()

    row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=px(8))
    row.set_margin_top(px(8))
    decline = Gtk.Button(label='Decline')
    decline.connect('clicked', lambda _b: answer_with(DECLINE))
    accept = Gtk.Button(label='Accept')
    accept.get_style_context().add_class('suggested')
    accept.connect('clicked', lambda _b: answer_with(ACCEPT))
    row.pack_end(accept, False, False, 0)
    row.pack_end(decline, False, False, 0)
    box.pack_start(row, False, False, 0)

    always = Gtk.Button(label=f'Always accept from {args.sender}')
    always.get_style_context().add_class('quiet')
    always.connect('clicked', lambda _b: answer_with(ALWAYS))
    box.pack_start(always, False, False, 0)

    def on_key(_w, event):
        if event.keyval == Gdk.KEY_Escape:
            answer_with(DECLINE)
            return True
        if event.keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            answer_with(ACCEPT)
            return True
        return False

    win.connect('key-press-event', on_key)
    win.connect('destroy', lambda *_: answer_with(DECLINE))
    Gtk.Widget.set_opacity(win, 0.0)
    win.show_all()
    accept.grab_focus()
    win.present()
    # Nothing clicked its way here, so nothing gave us a focus timestamp.
    # Ask the window manager for one explicitly, or the prompt opens behind
    # the window the user is looking at and they never see it.
    gdk_win = win.get_window()
    if gdk_win is not None:
        gdk_win.focus(GLib.get_monotonic_time() // 1000 & 0xffffffff)
    t0 = time.monotonic()

    def fade():
        f = min(1.0, (time.monotonic() - t0) / 0.095)
        Gtk.Widget.set_opacity(win, f * f * (3 - 2 * f))
        return f < 1.0

    GLib.timeout_add(16, fade)

    Gtk.main()
    return answer['value']


if __name__ == '__main__':
    Gdk.set_program_class('mintbook-mintdrop')
    sys.exit(main())
