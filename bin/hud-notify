#!/usr/bin/env python3
"""Transient Cairo glass HUD pill for hardware volume, mic and brightness keys.

No resident daemon: the first keypress writes the state and spawns a short-lived
window; repeat presses while the pill is visible send a datagram over a runtime
socket before importing GTK, updating the on-screen bar in <1 ms and extending
its display window before exiting completely.
"""
import json
import math
import os
from pathlib import Path
import signal
import socket
import subprocess
import sys
import time

HOME = Path.home()
APPLIED = HOME / '.config/mintbook/appearance.applied'
PIDFILE = HOME / '.cache/mintbook/hud-notify.pid'
KINDS = ('volume', 'muted', 'mic', 'mic-off', 'brightness', 'keyboard')

LIGHT = {  # generated by bin/palette-generate
    'top': (229, 231, 234, 0.980392),
    'bottom': (202, 205, 210, 0.968627),
    'edge': (255, 255, 255, 0.74902),
    'rim': (65, 68, 74, 0.180392),
    'fg': (45, 48, 54),
    'track': (65, 68, 74, 0.129412),
    'fill': (255, 255, 255, 0.94902),
}
DARK = {  # generated by bin/palette-generate
    'top': (104, 109, 119, 0.976471),
    'bottom': (74, 78, 86, 0.968627),
    'edge': (255, 255, 255, 0.180392),
    'rim': (0, 0, 0, 0.34902),
    'fg': (255, 255, 255),
    'track': (255, 255, 255, 0.160784),
    'fill': (255, 255, 255, 0.921569),
}


def runtime_dir():
    base = Path(os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}')) / 'mintbook'
    base.mkdir(mode=0o700, parents=True, exist_ok=True)
    return base


def state_paths(directory=None):
    base = runtime_dir() if directory is None else Path(directory)
    return base / 'hud.json', base / 'hud.sock'


def write_state(kind, title, value=None, directory=None):
    state_file, _ = state_paths(directory)
    state_file.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    if value is not None:
        value = max(0, min(100, int(value)))
    payload = {'kind': kind if kind in KINDS else 'volume',
               'title': str(title)[:48],
               'value': value,
               'updated': time.monotonic()}
    temp = state_file.with_name(f'.hud.json.{os.getpid()}')
    temp.write_text(json.dumps(payload))
    temp.replace(state_file)
    return payload


def read_state(directory=None):
    state_file, _ = state_paths(directory)
    try:
        data = json.loads(state_file.read_text())
        kind = data.get('kind', 'volume')
        value = data.get('value')
        if value is not None:
            value = max(0, min(100, int(value)))
        return {'kind': kind if kind in KINDS else 'volume',
                'title': str(data.get('title', ''))[:48],
                'value': value}
    except (OSError, ValueError, TypeError):
        return {'kind': 'volume', 'title': 'Volume', 'value': 50}


def notify_running(directory=None):
    _, sock_path = state_paths(directory)
    if not sock_path.exists():
        return False
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as client:
            client.settimeout(0.15)
            client.sendto(b'update', str(sock_path))
        return True
    except OSError:
        return False


def parse_args(argv):
    if argv == ['--serve']:
        return ('serve', None, None, None)
    if not 2 <= len(argv) <= 3 or argv[0] not in KINDS:
        raise ValueError('usage: hud-notify volume|muted|mic|mic-off|brightness|keyboard TITLE [0..100]')
    value = int(argv[2]) if len(argv) == 3 else None
    return ('send', argv[0], argv[1], value)


def serve():
    sys.path.insert(0, str(Path(__file__).resolve().parent))
    from mintbook_instance import claim
    if not claim(PIDFILE, 'hud-notify', signal.SIGTERM):
        return 0

    os.environ.setdefault('GTK_THEME', 'Adwaita')
    import cairo
    import gi
    gi.require_version('Gtk', '3.0')
    gi.require_version('PangoCairo', '1.0')
    from gi.repository import Gtk, Gdk, GLib, Pango, PangoCairo

    sc = round((Gdk.Screen.get_default().get_resolution() or 96) / 96.0, 3) or 1.0
    width, height, radius, shadow = 224, 60, 18, 14
    hold_seconds, fade_in_s, fade_out_s = 1.15, 0.09, 0.12

    def read_mode():
        override = os.environ.get('MINTBOOK_PREVIEW_APPEARANCE')
        if override in ('light', 'dark'):
            return override
        try:
            return 'dark' if APPLIED.read_text().strip() == 'dark' else 'light'
        except OSError:
            return 'light'

    def rgba(cr, c, alpha=None):
        a = c[3] if len(c) > 3 else 1.0
        cr.set_source_rgba(c[0] / 255, c[1] / 255, c[2] / 255,
                           a if alpha is None else a * alpha)

    def rrect(cr, x, y, w, h, r):
        r = max(0, min(r, w / 2, h / 2))
        cr.new_sub_path()
        cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
        cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
        cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
        cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
        cr.close_path()

    def draw_glyph(cr, kind, value, x, y, s, color, alpha=0.88):
        cr.save()
        cr.translate(x, y)
        rgba(cr, color, alpha)
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.set_line_join(cairo.LINE_JOIN_ROUND)
        if kind in ('volume', 'muted'):
            cr.move_to(0.14 * s, 0.39 * s)
            cr.line_to(0.28 * s, 0.39 * s)
            cr.line_to(0.48 * s, 0.22 * s)
            cr.line_to(0.48 * s, 0.78 * s)
            cr.line_to(0.28 * s, 0.61 * s)
            cr.line_to(0.14 * s, 0.61 * s)
            cr.close_path()
            cr.fill()
            cr.set_line_width(0.082 * s)
            if kind == 'muted' or (value is not None and value <= 0):
                cr.move_to(0.60 * s, 0.36 * s)
                cr.line_to(0.84 * s, 0.64 * s)
                cr.move_to(0.84 * s, 0.36 * s)
                cr.line_to(0.60 * s, 0.64 * s)
                cr.stroke()
            else:
                pct = 100 if value is None else value
                radii = (0.17,) if pct < 34 else ((0.17, 0.30) if pct < 67 else (0.17, 0.30, 0.42))
                for r in radii:
                    cr.new_sub_path()
                    cr.arc(0.48 * s, 0.50 * s, r * s, -math.pi * 0.30, math.pi * 0.30)
                    cr.stroke()
        elif kind in ('mic', 'mic-off'):
            rrect(cr, 0.34 * s, 0.14 * s, 0.32 * s, 0.46 * s, 0.16 * s)
            cr.fill()
            cr.set_line_width(0.082 * s)
            cr.new_sub_path()
            cr.arc(0.50 * s, 0.44 * s, 0.26 * s, 0.12 * math.pi, 0.88 * math.pi)
            cr.stroke()
            cr.move_to(0.50 * s, 0.70 * s)
            cr.line_to(0.50 * s, 0.86 * s)
            cr.move_to(0.34 * s, 0.86 * s)
            cr.line_to(0.66 * s, 0.86 * s)
            cr.stroke()
            if kind == 'mic-off':
                cr.move_to(0.18 * s, 0.18 * s)
                cr.line_to(0.82 * s, 0.82 * s)
                cr.stroke()
        elif kind == 'keyboard':
            cr.set_line_width(0.082 * s)
            if value is None or value > 0:
                for ang, rx in ((-0.50, 0.27), (-0.25, 0.38), (0.0, 0.50), (0.25, 0.62), (0.50, 0.73)):
                    cr.move_to(rx * s, 0.39 * s)
                    cr.line_to((rx + 0.16 * math.sin(ang)) * s, (0.39 - 0.17 * math.cos(ang)) * s)
                cr.stroke()
            cr.move_to(0.14 * s, 0.55 * s)
            cr.line_to(0.86 * s, 0.55 * s)
            cr.stroke()
            for kx in (0.18, 0.39, 0.60):
                rrect(cr, kx * s, 0.67 * s, 0.15 * s, 0.11 * s, 0.03 * s)
                cr.fill()
        else:
            cr.arc(0.50 * s, 0.50 * s, 0.21 * s, 0, 2 * math.pi)
            cr.fill()
            cr.set_line_width(0.085 * s)
            for i in range(8):
                ang = i * math.pi / 4
                cr.move_to((0.50 + 0.31 * math.cos(ang)) * s, (0.50 + 0.31 * math.sin(ang)) * s)
                cr.line_to((0.50 + 0.43 * math.cos(ang)) * s, (0.50 + 0.43 * math.sin(ang)) * s)
            cr.stroke()
        cr.restore()

    def draw_text(cr, label, x, y, size, color, alpha=1.0, weight='normal', align='left', box_w=0, tnum=False):
        layout = PangoCairo.create_layout(cr)
        font = Pango.FontDescription('Inter Semi-Bold' if weight == 'bold' else 'Inter')
        font.set_absolute_size(size * Pango.SCALE)
        layout.set_font_description(font)
        if tnum:
            attrs = Pango.AttrList()
            attrs.insert(Pango.attr_font_features_new('tnum=1'))
            layout.set_attributes(attrs)
        layout.set_text(str(label), -1)
        layout.set_ellipsize(Pango.EllipsizeMode.END)
        if box_w:
            layout.set_width(int(box_w * Pango.SCALE))
            layout.set_alignment(Pango.Alignment.RIGHT if align == 'right' else Pango.Alignment.LEFT)
        rgba(cr, color, alpha)
        cr.move_to(x, y)
        PangoCairo.show_layout(cr, layout)

    class Hud:
        def __init__(self):
            self.state = read_state()
            self.colors = DARK if read_mode() == 'dark' else LIGHT
            self.started = time.monotonic()
            self.last_update = self.started
            self.closing = False

            _, self.sock_path = state_paths()
            self.sock_path.unlink(missing_ok=True)
            self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
            self.sock.bind(str(self.sock_path))
            self.sock.setblocking(False)
            os.chmod(self.sock_path, 0o600)
            GLib.io_add_watch(self.sock.fileno(), GLib.IO_IN, self.on_socket)

            self.win = win = Gtk.Window(type=Gtk.WindowType.POPUP)
            win.set_decorated(False)
            win.set_skip_taskbar_hint(True)
            win.set_skip_pager_hint(True)
            win.set_keep_above(True)
            win.set_resizable(False)
            win.set_accept_focus(False)
            win.set_focus_on_map(False)
            win.set_app_paintable(True)
            win.set_type_hint(Gdk.WindowTypeHint.NOTIFICATION)
            visual = Gdk.Screen.get_default().get_rgba_visual()
            if visual is not None:
                win.set_visual(visual)

            total_w = round((width + 2 * shadow) * sc)
            total_h = round((height + 2 * shadow) * sc)
            win.set_size_request(total_w, total_h)
            win.connect('draw', self.on_draw)
            win.realize()

            gdk_win = win.get_window()
            if gdk_win is not None:
                gdk_win.set_override_redirect(True)
                try:
                    win.input_shape_combine_region(cairo.Region())
                except Exception:
                    pass

            display = Gdk.Display.get_default()
            _s, px, py = display.get_default_seat().get_pointer().get_position()
            monitor = display.get_monitor_at_point(px, py) or display.get_primary_monitor()
            work = monitor.get_workarea()
            x = work.x + (work.width - total_w) // 2
            y = work.y + work.height - total_h - round(54 * sc)
            win.move(x, y)
            Gtk.Widget.set_opacity(win, 0.0)
            win.show_all()
            GLib.timeout_add(16, self.tick)

        def on_socket(self, _fd, _cond):
            try:
                while True:
                    self.sock.recv(64)
            except BlockingIOError:
                pass
            self.state = read_state()
            self.colors = DARK if read_mode() == 'dark' else LIGHT
            self.last_update = time.monotonic()
            self.win.queue_draw()
            return not self.closing

        def on_draw(self, _w, cr):
            cr.save()
            cr.set_antialias(cairo.ANTIALIAS_BEST)
            cr.set_operator(cairo.OPERATOR_SOURCE)
            cr.set_source_rgba(0, 0, 0, 0)
            cr.paint()
            cr.set_operator(cairo.OPERATOR_OVER)
            cr.scale(sc, sc)

            x = y = shadow
            w, h = width, height
            c = self.colors
            for i in range(shadow, 0, -1):
                rrect(cr, x - i, y - i + 2, w + 2 * i, h + 2 * i, radius + i)
                cr.set_line_width(1.4)
                cr.set_source_rgba(0, 0, 0, 0.055 * (1 - i / shadow) ** 2)
                cr.stroke()

            grad = cairo.LinearGradient(0, y, 0, y + h)
            top, bot = c['top'], c['bottom']
            grad.add_color_stop_rgba(0, top[0] / 255, top[1] / 255, top[2] / 255, top[3])
            grad.add_color_stop_rgba(1, bot[0] / 255, bot[1] / 255, bot[2] / 255, bot[3])
            rrect(cr, x, y, w, h, radius)
            cr.set_source(grad)
            cr.fill_preserve()
            rgba(cr, c['rim'])
            cr.set_line_width(1)
            cr.stroke()
            rrect(cr, x + 0.75, y + 0.75, w - 1.5, h - 1.5, radius - 0.75)
            rgba(cr, c['edge'])
            cr.set_line_width(1)
            cr.stroke()

            kind = self.state['kind']
            title = self.state['title']
            val = self.state['value']
            gx, gy, gs = x + 15, y + (h - 22) / 2, 22
            draw_glyph(cr, kind, val, gx, gy, gs, c['fg'], 0.90)

            tx = gx + gs + 11
            tw = w - (tx - x) - 16
            if val is not None:
                draw_text(cr, title, tx, y + 12, 10.5, c['fg'], 0.94, 'bold', box_w=tw - 42)
                pct_label = 'Muted' if kind == 'muted' else f'{val}%'
                draw_text(cr, pct_label, tx, y + 12, 10.0, c['fg'], 0.58,
                          align='right', box_w=tw, tnum=True)
                bar_y, bar_h = y + 36, 8
                rrect(cr, tx, bar_y, tw, bar_h, bar_h / 2)
                rgba(cr, c['track'])
                cr.fill()
                if val > 0 and kind != 'muted':
                    fw = max(bar_h, tw * val / 100.0)
                    cr.save()
                    rrect(cr, tx, bar_y, tw, bar_h, bar_h / 2)
                    cr.clip()
                    rrect(cr, tx, bar_y, fw, bar_h, bar_h / 2)
                    rgba(cr, c['fill'])
                    cr.fill()
                    cr.restore()
            else:
                draw_text(cr, title, tx, y + (h - 16) / 2, 11.0, c['fg'], 0.94, 'bold', box_w=tw)

            cr.restore()
            return False

        def tick(self):
            if self.closing:
                return False
            now = time.monotonic()
            since_start = now - self.started
            since_update = now - self.last_update
            if since_start < fade_in_s:
                f = min(1.0, since_start / fade_in_s)
                Gtk.Widget.set_opacity(self.win, f * f * (3 - 2 * f))
                return True
            if since_update < hold_seconds:
                Gtk.Widget.set_opacity(self.win, 1.0)
                return True
            out = (since_update - hold_seconds) / fade_out_s
            if out >= 1.0:
                self.close()
                return False
            f = 1.0 - out
            Gtk.Widget.set_opacity(self.win, f * f * (3 - 2 * f))
            return True

        def close(self):
            if self.closing:
                return
            self.closing = True
            try:
                self.sock.close()
            except OSError:
                pass
            self.sock_path.unlink(missing_ok=True)
            Gtk.main_quit()

    hud = Hud()
    signal.signal(signal.SIGTERM, lambda *_a: hud.close())
    try:
        Gtk.main()
    finally:
        hud.sock_path.unlink(missing_ok=True)
        try:
            if PIDFILE.read_text().strip() == str(os.getpid()):
                PIDFILE.unlink(missing_ok=True)
        except OSError:
            pass
    return 0


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    try:
        mode, kind, title, value = parse_args(argv)
    except ValueError as err:
        print(err, file=sys.stderr)
        return 2
    if mode == 'serve':
        return serve()
    write_state(kind, title, value)
    if notify_running():
        return 0
    if not os.environ.get('DISPLAY'):
        return 0
    subprocess.Popen(
        [sys.executable, str(Path(__file__).resolve()), '--serve'],
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL, start_new_session=True)
    return 0


if __name__ == '__main__':
    sys.exit(main())
