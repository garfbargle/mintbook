#!/usr/bin/env bash
# control-install — Control Center and System menus on the top bar, with the
# indicators they replace taken off it. No root. See docs/control-center.md.
#
# What stays visible is the compact set: live readings, Control Center, System,
# clock, plus whatever apps put in the systray. Everything else moves behind a
# focused click. Both lists are right here — move an id back to VISIBLE and
# re-run if you want its indicator on the bar again.
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
# Installed desktops route feature changes through the release transaction.
if [ "${MINTBOOK_INSTALL_TRANSACTION:-}" != 1 ] && [ -e "$HOME/.local/lib/mintbook/current/manifest.json" ]; then
  exec "$ROOT/bin/desktop-install" --feature "$(basename "$0")" "$@"
fi
if [ "${MINTBOOK_PANEL_MAINTENANCE:-}" != 1 ]; then
  exec "$ROOT/bin/panel-session" maintain -- "$0" "$@"
fi

BIN="$HOME/.local/bin"
SHARE="$HOME/.local/share/mintbook/control-center"
PANEL_RC="$HOME/.config/xfce4/panel"
STATE="$HOME/.config/mintbook"
SAVED="$STATE/panel-ids.before-control-center"
PLUGIN=25

#   1 app grid     7 separator  8 systray  10 xapp-status  19 cpu sparkline
#  17 temperature  21 bluetooth 18 wifi    11 battery      25 control
#  28 system       13 clock        27 overview
#
# CPU and temperature stay on the bar deliberately: they are readings you
# glance at, not settings you open something to change. Everything that is a
# switch went behind the click.
#
# The battery is 11 (xfce4-power-manager-plugin) until bin/battery-install has
# run, and its own id after. Read it rather than hardcode it, or re-running
# this would quietly put the XFCE plugin back. See docs/battery.md.
BATTERY=11
if [ -r "$STATE/battery.conf" ]; then    # `[ ] && x` would exit under set -e
  BATTERY=$(sed -n 's/^PANEL_ID=\([0-9]*\).*/\1/p' "$STATE/battery.conf" | head -1)
  [ -n "$BATTERY" ] || BATTERY=11
fi
# Updates now report through the always-present System icon. The existing
# updater/timer still owns plugin-20's files and cache, but that conditional
# indicator no longer takes a second seat on the bar.
# Bluetooth is behind the click until bin/bt-panel-install puts it back on the
# bar, and read rather than hardcoded for the same reason the battery and the
# update arrow are: re-running this must not quietly undo that installer.
BLUETOOTH=()
if [ -r "$STATE/bluetooth.conf" ]; then
  bid=$(sed -n 's/^PANEL_ID=\([0-9]*\).*/\1/p' "$STATE/bluetooth.conf" | head -1)
  if [ -n "$bid" ]; then BLUETOOTH=("$bid"); fi
fi
# Overview is a separately installable launcher. Keep its far-right seat when
# this installer is rerun after bin/overview-install.
OVERVIEW=()
if [ -r "$STATE/overview.conf" ]; then
  oid=$(sed -n 's/^PANEL_ID=\([0-9]*\).*/\1/p' "$STATE/overview.conf" | head -1)
  if [ -n "$oid" ]; then OVERVIEW=("$oid"); fi
fi
SYSTEM_PLUGIN=28
VISIBLE=(1 7 8 10 19 17 "${BLUETOOTH[@]}" 18 "$BATTERY" $PLUGIN $SYSTEM_PLUGIN 13 "${OVERVIEW[@]}")
#  21 bluetooth (unless bt-panel-install has claimed it above)
#  22 power profile  23 night light  24 appearance
#  12 volume — its plugin was also the XF86Audio grab, so bin/volume-key
#  takes that over below.
RETIRED=(22 23 24 12)
if [ ${#BLUETOOTH[@]} -eq 0 ]; then RETIRED=(21 "${RETIRED[@]}"); fi

if [ "${1:-}" = --revert ]; then
  echo "==> restoring the bar"
  ids=$(cat "$SAVED" 2>/dev/null || echo '1 7 8 10 19 17 18 21 23 24 12 22 11 13')
  "$ROOT/bin/panel-session" stop 2>/dev/null || true
  sleep 0.4
  args=(); for id in $ids; do args+=(-t int -s "$id"); done
  xfconf-query -c xfce4-panel -p /panels/panel-1/plugin-ids --force-array "${args[@]}"
  for key in XF86AudioRaiseVolume XF86AudioLowerVolume XF86AudioMute XF86AudioMicMute; do
    xfconf-query -c xfce4-keyboard-shortcuts -p "/commands/custom/$key" -r 2>/dev/null || true
  done
  "$ROOT/bin/panel-session" start
  rm -f "$STATE/system.conf"
  echo "the old indicators are back; plugins $PLUGIN and $SYSTEM_PLUGIN stay registered but unused"
  exit 0
fi

[ -n "${DISPLAY:-}" ] || { echo "DISPLAY is unset" >&2; exit 1; }

echo "==> icon"
# The env file is written with printf %q, so '#' arrives backslash-escaped.
# Sourcing it is the only way to read it back correctly.
PANEL_FOREGROUND='#ffffff'
# shellcheck disable=SC1091
[ -r "$STATE/system-chrome.env" ] && . "$STATE/system-chrome.env"
MINTBOOK_PANEL_FG="$PANEL_FOREGROUND" python3 "$ROOT/icons/generate-control-genmon.py"
MINTBOOK_PANEL_FG="$PANEL_FOREGROUND" python3 "$ROOT/icons/generate-system-genmon.py"

echo "==> $BIN"
install -dm755 "$BIN"
for f in control-center panel-control system-menu panel-system mintbook-health doctor keep-awake volume-key hud-notify mintbook_instance.py; do
  rm -f "$BIN/$f"
  install -m755 "$ROOT/bin/$f" "$BIN/$f"
done

echo "==> plugins"
install -dm755 "$SHARE"
rm -rf "$SHARE/plugins"
install -dm755 "$SHARE/plugins"
for source in "$ROOT"/control-center/plugins/*; do
  [ -f "$source" ] || continue
  install -m755 "$source" "$SHARE/plugins/"
done

echo "==> genmon-$PLUGIN.rc"
install -dm755 "$PANEL_RC"
sed "s|^Command=.*|Command=$BIN/panel-control|" \
  "$ROOT/config/xfce4-panel/genmon-$PLUGIN.rc" > "$PANEL_RC/genmon-$PLUGIN.rc"
sed "s|^Command=.*|Command=$BIN/panel-system|" \
  "$ROOT/config/xfce4-panel/genmon-$SYSTEM_PLUGIN.rc" > "$PANEL_RC/genmon-$SYSTEM_PLUGIN.rc"
install -dm755 "$STATE"
printf 'PANEL_ID=%s\n' "$SYSTEM_PLUGIN" > "$STATE/system.conf"

echo "==> panel"
[ -s "$SAVED" ] || xfconf-query -c xfce4-panel -p /panels/panel-1/plugin-ids \
  | grep -oE '^[0-9]+$' | tr '\n' ' ' > "$SAVED"

# Running plugins write xfconf back on shutdown, so stop the panel first.
"$ROOT/bin/panel-session" stop 2>/dev/null || true
sleep 0.4
xfconf-query -c xfce4-panel -p "/plugins/plugin-$PLUGIN" -n -t string -s genmon 2>/dev/null || true
xfconf-query -c xfce4-panel -p "/plugins/plugin-$SYSTEM_PLUGIN" -n -t string -s genmon 2>/dev/null || true

args=(); for id in "${VISIBLE[@]}"; do args+=(-t int -s "$id"); done
xfconf-query -c xfce4-panel -p /panels/panel-1/plugin-ids --force-array "${args[@]}"

"$ROOT/bin/panel-session" start
sleep 1

echo "==> volume keys"
# After the panel restart, not before: the XFCE pulseaudio plugin held the
# XF86Audio grabs, and xfsettingsd only tries to take a key when the property
# changes. Bind these while the plugin is still up and the grab quietly fails —
# the shortcut is in xfconf, it just never fires. Remove first, so the value is
# always a change even on a re-run.
for pair in "XF86AudioRaiseVolume:up" "XF86AudioLowerVolume:down" \
            "XF86AudioMute:mute" "XF86AudioMicMute:mic"; do
  key=${pair%%:*}; arg=${pair##*:}
  xfconf-query -c xfce4-keyboard-shortcuts -p "/commands/custom/$key" -r 2>/dev/null || true
  xfconf-query -c xfce4-keyboard-shortcuts -p "/commands/custom/$key" \
    -n -t string -s "$BIN/volume-key $arg"
done

echo
echo "bar: app grid · systray · cpu · temp${BLUETOOTH:+ · bluetooth} · wi-fi · battery · control · system · clock${OVERVIEW:+ · overview}"
echo "behind the click: ${RETIRED[*]}"
echo "plugins: $SHARE/plugins"
echo "undo: $(basename "$0") --revert"
