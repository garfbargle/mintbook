#!/usr/bin/env python3
"""Popup to pick a power profile. Bound as the genmon click for panel-power.

Genmon starts this with g_spawn_command_line_async — there is no Gdk event —
so a Gtk.Menu vanishes immediately (xfwm4 rejects a grab at time 0). This is
an override-redirect window at the pointer instead.

The panel writes /run/mintbook-power/want; a root systemd path unit applies
it. No pkexec — a genmon-spawned pkexec still prompted for a password.
A charger event still restores the automatic AC/battery policy afterwards.
"""
import os
import signal
import subprocess
import sys
import tempfile
import time

import gi
gi.require_version('Gtk', '3.0')
from gi.repository import Gtk, Gdk

WANT = '/run/mintbook-power/want'
PIDFILE = os.path.expanduser('~/.cache/mintbook/power-menu.pid')
PROFILES = (
    ('power-saver', 'Power Saver', 'Cooler — CPU capped ~1.6 GHz'),
    ('balanced', 'Balanced', 'AC default — turbo allowed'),
    ('performance', 'Performance', 'Prefer speed — turbo allowed'),
)


def current():
    try:
        return subprocess.check_output(
            ['powerprofilesctl', 'get'], text=True, timeout=2).strip()
    except Exception:
        return 'balanced'


def kill_previous():
    try:
        with open(PIDFILE) as f:
            pid = int(f.read().strip())
    except (OSError, ValueError):
        return
    if pid == os.getpid():
        return
    try:
        os.kill(pid, signal.SIGTERM)
    except OSError:
        pass


def write_pid():
    os.makedirs(os.path.dirname(PIDFILE), exist_ok=True)
    with open(PIDFILE, 'w') as f:
        f.write(str(os.getpid()))


def pointer_xy():
    display = Gdk.Display.get_default()
    seat = display.get_default_seat()
    pointer = seat.get_pointer()
    _screen, x, y = pointer.get_position()
    return int(x), int(y)


def apply(profile):
    """Ask the root path unit to apply *profile* by writing the request file."""
    try:
        d = os.path.dirname(WANT)
        fd, tmp = tempfile.mkstemp(prefix='want.', dir=d)
        try:
            os.write(fd, (profile + '\n').encode())
        finally:
            os.close(fd)
        os.replace(tmp, WANT)
    except OSError as e:
        return subprocess.CompletedProcess(
            ['want'], 1, '',
            f'{e}\nRe-run: pkexec /home/cobo/mintbook/bin/power-install')
    for _ in range(25):
        time.sleep(0.1)
        if current() == profile:
            break
    subprocess.run(
        ['xfce4-panel', '--plugin-event=genmon-22:refresh:bool:true'],
        capture_output=True)
    if current() != profile:
        return subprocess.CompletedProcess(
            ['want'], 1, '',
            'profile did not change; is mintbook-power-request.path running?')
    return subprocess.CompletedProcess(['want'], 0, '', '')


def fail(msg):
    d = Gtk.MessageDialog(
        message_type=Gtk.MessageType.ERROR,
        buttons=Gtk.ButtonsType.OK,
        text='Could not change power profile',
    )
    d.format_secondary_text(msg)
    d.run()
    d.destroy()


def main():
    kill_previous()
    write_pid()
    cur = current()

    win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
    win.set_decorated(False)
    win.set_skip_taskbar_hint(True)
    win.set_skip_pager_hint(True)
    win.set_keep_above(True)
    win.set_resizable(False)
    win.set_accept_focus(True)
    win.set_type_hint(Gdk.WindowTypeHint.POPUP_MENU)

    css = Gtk.CssProvider()
    css.load_from_data(b"""
        window {
            background-color: #212124;
        }
        button {
            color: #ffffff;
            background-image: none;
            background-color: transparent;
            border: none;
            border-radius: 10px;
            padding: 8px 14px;
            box-shadow: none;
        }
        button:hover {
            background-color: rgba(255,255,255,0.12);
        }
        button.current {
            background-color: rgba(255,255,255,0.18);
        }
        label.title { font-weight: 600; }
        label.sub { color: rgba(255,255,255,0.55); font-size: 11px; }
    """)
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
    box.set_margin_top(10)
    box.set_margin_bottom(10)
    box.set_margin_start(10)
    box.set_margin_end(10)
    win.add(box)

    def quit(*_):
        Gtk.main_quit()
        return False

    def pick(_btn, profile):
        if profile != cur:
            r = apply(profile)
            if r.returncode != 0:
                msg = (r.stderr or r.stdout or f'exit {r.returncode}').strip()
                fail(msg or 'mintbook-power-apply failed')
        quit()

    for key, title, sub in PROFILES:
        btn = Gtk.Button()
        inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        t = Gtk.Label(label=title, xalign=0)
        t.get_style_context().add_class('title')
        s = Gtk.Label(label=sub, xalign=0)
        s.get_style_context().add_class('sub')
        inner.pack_start(t, False, False, 0)
        inner.pack_start(s, False, False, 0)
        btn.add(inner)
        if key == cur:
            btn.get_style_context().add_class('current')
        btn.connect('clicked', pick, key)
        box.pack_start(btn, False, False, 0)

    def on_key(_w, event):
        if event.keyval == Gdk.KEY_Escape:
            quit()
            return True
        return False

    win.connect('key-press-event', on_key)
    win.connect('destroy', quit)

    px, py = pointer_xy()
    win.realize()
    gdk_win = win.get_window()
    if gdk_win is not None:
        gdk_win.set_override_redirect(True)

    win.show_all()
    # Place just under the 52px bar if the click came from it, else at pointer.
    alloc = win.get_allocation()
    w, h = max(alloc.width, 260), max(alloc.height, 1)
    display = Gdk.Display.get_default()
    monitor = display.get_monitor_at_point(px, py) or display.get_primary_monitor()
    geo = monitor.get_geometry()
    x = min(max(px - 20, geo.x + 8), geo.x + geo.width - w - 8)
    y = py + 8
    if py < 64:
        y = 56
    if y + h > geo.y + geo.height - 8:
        y = geo.y + geo.height - h - 8
    win.move(x, y)
    win.present()

    # Click-away: grab the pointer on the popup. Time 0 is OK for a window
    # grab; it was menus that xfwm4 discarded.
    if gdk_win is not None:
        seat = display.get_default_seat()
        seat.grab(
            gdk_win, Gdk.SeatCapabilities.POINTER, True,
            None, None, None)

        def on_press(_w, event):
            if event.window != gdk_win:
                # child buttons have their own windows; leave those alone
                return False
            if event.x < 0 or event.y < 0 or event.x > w or event.y > h:
                quit()
                return True
            return False

        win.connect('button-press-event', on_press)

    Gtk.main()
    try:
        os.remove(PIDFILE)
    except OSError:
        pass


if __name__ == '__main__':
    Gdk.set_program_class('mintbook-power')
    try:
        main()
    finally:
        try:
            os.remove(PIDFILE)
        except OSError:
            pass
    sys.exit(0)
