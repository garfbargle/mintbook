#!/usr/bin/env bash
# camera-test — serve camera-test/ on localhost and open it.
# getUserMedia needs http://127.0.0.1 (file:// is blocked).
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PORT="${PORT:-8765}"
URL="http://127.0.0.1:${PORT}/"
cd "$ROOT/camera-test"
echo "$URL"
if command -v xdg-open >/dev/null; then
  (sleep 0.3; xdg-open "$URL") >/dev/null 2>&1 &
fi
exec python3 -m http.server "$PORT" --bind 127.0.0.1
