#!/usr/bin/env python3
"""System Health — the desktop view of bin/doctor, and the quiet check after
the running kernel changes.

`doctor` is the authority; nothing here re-implements a check or repairs
anything. This is a reader: it runs `doctor --tsv`, caches the result for the
System menu, and draws it.

The window is cairo on a DrawingArea rather than themed GTK widgets, for the
same reason the Control Center and the battery history window are: it has to
sit on top of WhiteSur without inheriting it, and everything in it is a shape
the theme has no opinion about. See docs/daily.md.

Opening it shows the cached answer immediately and re-checks behind it —
`doctor --tsv` takes about three and a half seconds on this machine, and a
window that spends that time empty is a window you stop opening.
"""
import fcntl
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import threading
import time

STATE = Path.home() / '.cache/mintbook/health.json'
DOCTOR = Path(__file__).resolve().parent / 'doctor'
APPLIED = Path.home() / '.config/mintbook/appearance.applied'

# The popup glass. Canonical values live in config/theme/mintbook-glass.ini
# under [PopupLight] / [PopupDark], and are hardcoded here the way the other
# popups hardcode theirs: a window that has to find and parse a file before it
# can paint is a window that can fail to paint. Alphas are the same numbers,
# as 0-1 rather than 0-255.
LIGHT = {  # generated by bin/palette-generate
    'top': (229, 231, 234, 0.980392),
    'bottom': (202, 205, 210, 0.968627),
    'edge': (255, 255, 255, 0.74902),
    'rim': (65, 68, 74, 0.180392),
    'fg': (45, 48, 54),
    'tile': (255, 255, 255, 0.54902),
    'tile_edge': (255, 255, 255, 0.65098),
    'hair': (65, 68, 74, 0.121569),
    'seg': (65, 68, 74, 0.101961),
    'seg_on': (255, 255, 255, 0.94902),
    'green': (52, 199, 89),
    'amber': (255, 159, 10),
    'red': (255, 59, 48),
    'blue': (0, 122, 255),
}
DARK = {  # generated by bin/palette-generate
    'top': (104, 109, 119, 0.976471),
    'bottom': (74, 78, 86, 0.968627),
    'edge': (255, 255, 255, 0.180392),
    'rim': (0, 0, 0, 0.34902),
    'fg': (255, 255, 255),
    'tile': (255, 255, 255, 0.129412),
    'tile_edge': (255, 255, 255, 0.101961),
    'hair': (255, 255, 255, 0.121569),
    'seg': (0, 0, 0, 0.2),
    'seg_on': (255, 255, 255, 0.278431),
    'green': (48, 209, 88),
    'amber': (255, 214, 10),
    'red': (255, 69, 58),
    'blue': (10, 132, 255),
}

STATUS_COLOR = {'ok': 'green', 'warn': 'amber', 'fail': 'red'}

# What to run when a check is unhappy. Read out of the check's own detail
# wherever doctor names a command there — doctor is where repair instructions
# belong, and duplicating them here is how the two drift apart. The table is
# only for the findings whose detail names no command at all.
COMMAND = re.compile(
    r'(?<![\w./~$-])(pkexec\s+)?((?:[\w.$~/-]*/)?bin/[a-z][a-z0-9-]*)'
    r'((?:\s+--[a-z][a-z-]*)*)')
REMEDY = {'updates genmon rc': 'bin/updates-install'}


def remedy(row):
    """The command that addresses a finding, or '' when there is not one."""
    if row['status'] == 'ok':
        return ''
    found = COMMAND.search(row['detail'])
    if found:
        return (found.group(1) or '') + found.group(2) + found.group(3)
    if row['label'] == 'failed units':
        unit = row['detail'].split()
        return 'systemctl status ' + unit[0] if unit else ''
    return REMEDY.get(row['label'], '')


def load():
    try:
        return json.loads(STATE.read_text())
    except (OSError, ValueError):
        return {}


def parse(output):
    """doctor --tsv into rows, each carrying the section it was printed under.

    Anything that is not a status or section line is ignored, including the
    summary: the counts are recomputed from the rows that survive parsing, so
    a truncated read can never be summarised as a clean machine.
    """
    rows, section = [], ''
    for line in output.splitlines():
        fields = line.split('\t', 2)
        if len(fields) != 3:
            continue
        if fields[0] == 'section':
            section = fields[1]
        elif fields[0] in ('ok', 'warn', 'fail'):
            rows.append(dict(status=fields[0], label=fields[1],
                             detail=fields[2], section=section))
    return rows


def check(only_changed=False, notify=False):
    STATE.parent.mkdir(parents=True, exist_ok=True)
    with STATE.with_suffix('.lock').open('w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        old = load()
        kernel = os.uname().release
        if only_changed and old.get('kernel') == kernel:
            return old
        result = subprocess.run([str(DOCTOR), '--tsv'], text=True, capture_output=True, timeout=90)
        rows = parse(result.stdout)
        complete = any(line.startswith('summary\t') for line in result.stdout.splitlines())
        if not rows or not complete or result.returncode not in (0, 1):
            raise RuntimeError('doctor did not finish — its output was incomplete.')
        state = dict(kernel=kernel, checked=time.time(), rows=rows)
        tmp = STATE.with_suffix('.tmp')
        tmp.write_text(json.dumps(state))
        tmp.replace(STATE)
        before = {r['label'] for r in old.get('rows', []) if r['status'] == 'fail'}
        new = [r['label'] for r in rows if r['status'] == 'fail' and r['label'] not in before]
        if notify and new:
            subprocess.run(['notify-send', '-a', 'Mintbook', 'System needs attention',
                            ', '.join(new) + '. Open “Check system health” in Overview.'], timeout=5)
        return state


def report(state):
    """The whole result as plain text, for pasting into an issue."""
    rows = state.get('rows', [])
    counts = tally(rows)
    lines = ['mintbook system health — '
             + time.strftime('%Y-%m-%d %H:%M', time.localtime(state.get('checked', time.time()))),
             f"kernel {state.get('kernel', '?')} — "
             f"{counts['fail']} failed, {plural(counts['warn'], 'note')}, "
             f"{counts['ok']} passed", '']
    section = None
    for row in rows:
        if row.get('section') != section:
            section = row.get('section')
            if lines[-1]:
                lines.append('')
            lines.append(section or 'Checks')
        lines.append(f"  {row['status']:<4}  {row['label']}  —  {row['detail']}")
    return '\n'.join(lines) + '\n'


def plural(n, word):
    return f'{n} {word}' if n == 1 else f'{n} {word}s'


def tally(rows):
    return {status: sum(r['status'] == status for r in rows)
            for status in ('ok', 'warn', 'fail')}


def ago(stamp):
    seconds = max(0, time.time() - stamp)
    if seconds < 90:
        return 'just now'
    if seconds < 5400:
        return f'{round(seconds / 60)} min ago'
    if seconds < 86400:
        return f'{round(seconds / 3600)} h ago'
    return time.strftime('%-d %b', time.localtime(stamp))


# ------------------------------------------------------------------- drawing
#
# Everything below is only reached by `show()`, which imports GTK. The parsing
# and checking above stay importable without a display.

W, PAD, SHADOW, RADIUS, CARD = 720, 18, 18, 20, 13
SC = 1.0                     # resolved from the desktop when opening the window
DOT_X, TEXT_X = 27, 48       # the status glyph, and where every row's text starts


def rgba(cr, c, alpha=None):
    a = c[3] if len(c) > 3 else 1.0
    cr.set_source_rgba(c[0] / 255, c[1] / 255, c[2] / 255,
                       a if alpha is None else a * alpha)


def rrect(cr, x, y, w, h, r):
    r = max(0, min(r, w / 2, h / 2))
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


FAMILY = {'normal': 'Inter', 'medium': 'Inter Medium', 'bold': 'Inter Semi-Bold',
          'display': 'Inter Display Semi-Bold', 'mono': 'DejaVu Sans Mono'}


def text(cr, s, x, y, size, color, alpha=1.0, weight='normal', align=None,
         width=0, lines=1, spacing=0, draw=True):
    """Lay out one run of text and return its (width, height) in 1x units.

    `lines` over 1 wraps and then ellipsizes at that many lines, so a long
    detail costs the row a predictable amount of height instead of an
    unbounded amount.
    """
    layout = PangoCairo.create_layout(cr)
    font = Pango.FontDescription(FAMILY[weight])
    font.set_absolute_size(size * Pango.SCALE)
    layout.set_font_description(font)
    if spacing:
        attrs = Pango.AttrList()
        attrs.insert(Pango.attr_letter_spacing_new(int(spacing)))
        layout.set_attributes(attrs)
    layout.set_text(str(s), -1)
    layout.set_ellipsize(Pango.EllipsizeMode.END)
    if width:
        layout.set_width(int(width * Pango.SCALE))
        layout.set_alignment({'center': Pango.Alignment.CENTER,
                              'right': Pango.Alignment.RIGHT}.get(
                                  align, Pango.Alignment.LEFT))
        if lines > 1:
            layout.set_wrap(Pango.WrapMode.WORD_CHAR)
            layout.set_height(-lines)
    if draw:
        rgba(cr, color, alpha)
        cr.move_to(x, y)
        PangoCairo.show_layout(cr, layout)
    return layout.get_pixel_size()


def glyph(cr, status, cx, cy, r, colors):
    """The status mark: green circle-check, amber triangle-bang, red
    circle-bang. Shape carries the meaning as well as colour does."""
    color = colors[STATUS_COLOR[status]]
    rgba(cr, color)
    cr.set_line_join(cairo.LINE_JOIN_ROUND)
    if status == 'warn':
        # Sat a little low so the triangle's visual centre matches a circle's.
        top, half, base = cy - r * 1.02, r * 1.13, cy + r * 0.78
        cr.move_to(cx, top)
        cr.line_to(cx + half, base)
        cr.line_to(cx - half, base)
        cr.close_path()
        cr.set_line_width(r * 0.42)
        cr.fill_preserve()
        cr.stroke()
    else:
        cr.arc(cx, cy, r, 0, 2 * math.pi)
        cr.fill()
    # White on the amber is unreadable; the mark is punched out dark instead.
    rgba(cr, (58, 46, 6) if status == 'warn' else (255, 255, 255))
    cr.set_line_cap(cairo.LINE_CAP_ROUND)
    if status == 'ok':
        cr.set_line_width(max(1.4, r * 0.28))
        cr.move_to(cx - r * .42, cy + r * .04)
        cr.line_to(cx - r * .12, cy + r * .36)
        cr.line_to(cx + r * .45, cy - r * .33)
        cr.stroke()
    else:
        dy = r * .16 if status == 'warn' else 0     # the triangle sits lower
        cr.set_line_width(max(1.4, r * 0.24))
        cr.move_to(cx, cy - r * .44 + dy)
        cr.line_to(cx, cy + r * .10 + dy)
        cr.stroke()
        cr.arc(cx, cy + r * .38 + dy, max(.8, r * .13), 0, 2 * math.pi)
        cr.fill()


def spinner(cr, cx, cy, r, color, phase):
    cr.save()
    cr.set_line_cap(cairo.LINE_CAP_ROUND)
    cr.set_line_width(r * .34)
    for i in range(8):
        a = i * math.pi / 4
        rgba(cr, color, .12 + .5 * (((i - phase) % 8) / 8.0))
        cr.move_to(cx + math.cos(a) * r * .5, cy + math.sin(a) * r * .5)
        cr.line_to(cx + math.cos(a) * r, cy + math.sin(a) * r)
        cr.stroke()
    cr.restore()


class Window:
    """One window: a fixed head, a scrolling list of findings under it."""

    HEAD = 190                    # title, summary card and the filter bar
    HERO_Y, HERO_H = 52, 90
    BAR_Y, BAR_H = 154, 26

    def __init__(self):
        override = os.environ.get('MINTBOOK_PREVIEW_APPEARANCE')
        if override in ('light', 'dark'):
            mode = override
        else:
            try:
                mode = APPLIED.read_text().strip()
            except OSError:
                mode = 'light'
        self.colors = DARK if mode == 'dark' else LIGHT
        self.content_w = W - 2 * PAD
        self.state = load()
        self.error = None
        self.checking = False
        self.phase = 0
        self.scroll = self.scroll_to = 0.0
        self.hit = None
        self.pressed = None
        self.copied = None
        self.drag_thumb = None
        # The System menu can open directly on a clicked count. Ordinary opens
        # still lead with errors only when there are any; notes do not make a
        # healthy machine open on an exception list.
        requested = os.environ.get('MINTBOOK_HEALTH_FILTER', '')
        available = {'all': True,
                     'errors': any(r['status'] == 'fail' for r in self.rows),
                     'notes': any(r['status'] == 'warn' for r in self.rows)}
        self.filter = (requested if requested in available and available[requested]
                       else 'errors' if self.failing else 'all')
        self.segments, self.seg_rects, self.chip_rects = [], [], []
        self.close_rect = self.recheck_rect = self.copy_rect = self.thumb_rect = (0, 0, 0, 0)
        self.measure = cairo.Context(cairo.ImageSurface(cairo.FORMAT_ARGB32, 1, 1))

        self.win = win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
        win.set_title('System Health')
        win.set_decorated(False)
        win.set_resizable(False)
        win.set_app_paintable(True)
        win.set_position(Gtk.WindowPosition.CENTER)
        visual = Gdk.Screen.get_default().get_rgba_visual()
        if visual:
            win.set_visual(visual)
        win.connect('draw', self.draw_background)
        win.connect('key-press-event', self.on_key)
        win.connect('destroy', Gtk.main_quit)

        self.area = Gtk.DrawingArea()
        self.area.add_events(Gdk.EventMask.BUTTON_PRESS_MASK
                             | Gdk.EventMask.BUTTON_RELEASE_MASK
                             | Gdk.EventMask.POINTER_MOTION_MASK
                             | Gdk.EventMask.LEAVE_NOTIFY_MASK
                             | Gdk.EventMask.SCROLL_MASK
                             | Gdk.EventMask.SMOOTH_SCROLL_MASK)
        self.area.connect('draw', self.on_draw)
        self.area.connect('button-press-event', self.on_press)
        self.area.connect('button-release-event', self.on_release)
        self.area.connect('motion-notify-event', self.on_motion)
        self.area.connect('leave-notify-event', lambda *_a: self.on_leave())
        self.area.connect('scroll-event', self.on_scroll)
        box = Gtk.Box()
        for setter in (box.set_margin_top, box.set_margin_bottom,
                       box.set_margin_start, box.set_margin_end):
            setter(round(SHADOW * SC))
        box.pack_start(self.area, False, False, 0)
        win.add(box)
        self.relayout()
        Gtk.Widget.set_opacity(win, 0.0)
        win.show_all()
        t0 = time.monotonic()

        def fade():
            f = min(1.0, (time.monotonic() - t0) / 0.095)
            Gtk.Widget.set_opacity(win, f * f * (3 - 2 * f))
            return f < 1.0

        GLib.timeout_add(16, fade)
        self.recheck()

    # ------------------------------------------------------------ the numbers

    @property
    def rows(self):
        return self.state.get('rows', [])

    @property
    def unhappy(self):
        return [r for r in self.rows if r['status'] != 'ok']

    @property
    def failing(self):
        return any(r['status'] == 'fail' for r in self.rows)

    @property
    def shown(self):
        if self.filter == 'errors':
            return [r for r in self.rows if r['status'] == 'fail']
        if self.filter == 'notes':
            return [r for r in self.rows if r['status'] == 'warn']
        return self.rows

    def relayout(self):
        """Place every section heading and row, and size the window to fit."""
        self.blocks, y, section = [], 0, None
        for row in self.shown:
            name = row.get('section') or 'Checks'
            if name != section:
                section = name
                y += 16 if self.blocks else 2
                self.blocks.append(dict(kind='section', label=name, y=y, h=22))
                y += 22
            fix = remedy(row)
            room = self.content_w - TEXT_X - 16
            wide = text(self.measure, row['detail'], 0, 0, 9.5, None, draw=False)[0]
            label_w = text(self.measure, row['label'], 0, 0, 10.5, None,
                           weight='medium', draw=False)[0]
            compact = (row['status'] == 'ok' and not fix
                       and label_w + 30 + wide <= room)
            detail = text(self.measure, row['detail'], 0, 0, 9.5, None,
                          width=room, lines=3, draw=False)[1]
            h = 42 if compact else 13 + 16 + detail + 13 + (26 if fix else 0)
            self.blocks.append(dict(kind='row', row=row, fix=fix, y=y, h=h,
                                    detail_h=detail, compact=compact,
                                    detail_w=wide))
            y += h
        self.content_h = y + 30                      # room for the footnote
        display = Gdk.Display.get_default()
        monitor = (display.get_primary_monitor() or display.get_monitor(0))
        ceiling = monitor.get_workarea().height / SC - 2 * SHADOW - 20
        self.height = max(360, min(self.HEAD + self.content_h + PAD, ceiling, 700))
        self.view_h = self.height - self.HEAD - PAD
        self.scroll = self.scroll_to = min(self.scroll, self.max_scroll)
        self.area.set_size_request(round(W * SC), round(self.height * SC))
        if self.win.get_realized():
            # Switching to All is a large growth, and the window keeps the
            # top-left corner it was centred on. Measured from what was just
            # requested rather than from get_size(), which is still the old
            # size until the resize has been through the window manager.
            edge = 2 * round(SHADOW * SC)
            self.stay_on_screen(monitor, round(W * SC) + edge,
                                round(self.height * SC) + edge)

    def stay_on_screen(self, monitor, width, height):
        area = monitor.get_workarea()
        x, y = self.win.get_position()
        placed = (min(max(area.x, x), area.x + area.width - width),
                  min(max(area.y, y), area.y + area.height - height))
        if placed != (x, y):
            self.win.move(*placed)

    @property
    def max_scroll(self):
        return max(0.0, self.content_h - self.view_h)

    @property
    def headline(self):
        if self.error:
            return 'Could not finish checking'
        if not self.rows:
            return 'Checking the system…' if self.checking else 'Not checked yet'
        counts = tally(self.rows)
        if counts['fail']:
            n = counts['fail']
            return f'{n} check needs attention' if n == 1 else f'{n} checks need attention'
        # A note is not a fault, so it does not get the headline. It is a
        # word at the end of the count line, and the filter below.
        return 'Everything checks out'

    @property
    def status(self):
        # Green unless something actually failed. doctor exits 0 on a run of
        # nothing but notes, so an amber card there is a false alarm about a
        # machine with nothing wrong with it.
        return 'fail' if tally(self.rows)['fail'] else 'ok'

    @property
    def subtitles(self):
        if self.error:
            # Whatever went wrong in its own words, then where to go and look —
            # and, because the findings below it are still on screen, how old
            # the answer they came from is.
            stale = ('Showing the last check, ' + ago(self.state['checked']) + '. '
                     if self.rows else '')
            return [self.error, stale + 'Run bin/doctor in a terminal to see it.']
        if not self.rows:
            return ['Running the checks for the first time.' if self.checking
                    else 'Choose Check again to run the checks.', '']
        counts = tally(self.rows)
        if counts['fail']:
            parts = [f"{counts['fail']} failing"]
            if counts['warn']:
                parts.append(plural(counts['warn'], 'note'))
            parts.append(f"{counts['ok']} passed")
        elif counts['warn']:
            parts = [f"{counts['ok']} passed", plural(counts['warn'], 'note')]
        else:
            parts = [f"{counts['ok']} checks passed"]
        second = ('Kernel ' + self.state.get('kernel', '?') + ' · '
                  + ('checking now' if self.checking
                     else 'checked ' + ago(self.state.get('checked', 0))))
        return [' · '.join(parts), second]

    # ---------------------------------------------------------------- drawing

    def on_draw(self, _w, cr):
        cr.set_antialias(cairo.ANTIALIAS_BEST)
        cr.scale(SC, SC)
        self.draw_head(cr)
        cr.save()
        cr.rectangle(0, self.HEAD - 6, W, self.view_h + 6)
        cr.clip()
        cr.translate(PAD, self.HEAD - self.scroll)
        self.draw_list(cr)
        cr.restore()
        self.edge_fades(cr)
        self.draw_scrollbar(cr)
        return False

    def draw_head(self, cr):
        c = self.colors
        text(cr, 'System Health', PAD + 2, PAD - 1, 15, c['fg'], .95, 'bold')
        self.close_rect = (W - PAD - 24, PAD - 4, 26, 26)
        cx, cy = W - PAD - 11, PAD + 9
        if self.hit == ('close', 0):
            cr.arc(cx, cy, 13, 0, 2 * math.pi)
            rgba(cr, c['fg'], .10)
            cr.fill()
        rgba(cr, c['fg'], .55)
        cr.set_line_width(1.6)
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        for dx, dy in ((-1, -1), (-1, 1)):
            cr.move_to(cx + dx * 5, cy + dy * 5)
            cr.line_to(cx - dx * 5, cy - dy * 5)
        cr.stroke()
        self.draw_hero(cr)
        self.draw_bar(cr)

    def draw_hero(self, cr):
        c, y = self.colors, self.HERO_Y
        rrect(cr, PAD, y, self.content_w, self.HERO_H, CARD)
        rgba(cr, c['tile'])
        cr.fill_preserve()
        rgba(cr, c['tile_edge'])
        cr.set_line_width(1)
        cr.stroke()

        gx, gy = PAD + 46, y + self.HERO_H / 2
        if self.rows:
            status = 'warn' if self.error else self.status
            cr.arc(gx, gy, 25, 0, 2 * math.pi)
            rgba(cr, c[STATUS_COLOR[status]], .14)
            cr.fill()
            glyph(cr, status, gx, gy, 13, c)
        elif self.checking:
            spinner(cr, gx, gy, 14, c['fg'], self.phase)
        else:
            cr.arc(gx, gy, 13, 0, 2 * math.pi)
            rgba(cr, c['fg'], .22)
            cr.set_line_width(2)
            cr.stroke()

        head, subs = self.headline, self.subtitles
        wide = self.content_w - 84 - 132
        text(cr, head, PAD + 84, y + 20, 17, c['fg'], .95, 'display', width=wide)
        text(cr, subs[0], PAD + 84, y + 46, 10.5, c['fg'], .58, width=wide)
        text(cr, subs[1], PAD + 84, y + 63, 9.5, c['fg'], .38, width=wide)

        bw, bh = 112, 30
        bx, by = PAD + self.content_w - bw - 16, y + (self.HERO_H - bh) / 2
        self.recheck_rect = (bx, by, bw, bh)
        rrect(cr, bx, by, bw, bh, 9)
        rgba(cr, c['seg_on'], .55 if self.checking else
             (1.0 if self.hit == ('recheck', 0) else .8))
        cr.fill_preserve()
        rgba(cr, c['fg'], .07)
        cr.set_line_width(1)
        cr.stroke()
        if self.checking:
            tw = text(self.measure, 'Checking', 0, 0, 10, None, weight='medium',
                      draw=False)[0]
            start = bx + (bw - tw - 20) / 2
            spinner(cr, start + 7, by + bh / 2, 7, c['fg'], self.phase)
            text(cr, 'Checking', start + 20, by + 8, 10, c['fg'], .55, 'medium')
        else:
            text(cr, 'Check again', bx, by + 8, 10, c['fg'], .85, 'medium',
                 align='center', width=bw)

    def draw_bar(self, cr):
        """The filter segment, and the copy affordance opposite it."""
        c, y = self.colors, self.BAR_Y
        counts = tally(self.rows)
        self.segments = []
        if counts['fail']:
            self.segments.append(('errors', f"Errors {counts['fail']}"))
        if counts['warn']:
            self.segments.append(('notes', f"Notes {counts['warn']}"))
        if self.segments:
            self.segments.append(('all', f'All {len(self.rows)}'))
        self.seg_rects = []
        if self.segments:
            widths = [text(self.measure, label, 0, 0, 9.5, None, weight='medium',
                           draw=False)[0] + 26 for _k, label in self.segments]
            rrect(cr, PAD, y, sum(widths), self.BAR_H, 8)
            rgba(cr, c['seg'])
            cr.fill()
            x = PAD
            for (key, label), sw in zip(self.segments, widths):
                self.seg_rects.append((key, x, y, sw, self.BAR_H))
                on = key == self.filter
                if on:
                    rrect(cr, x + 2, y + 2, sw - 4, self.BAR_H - 4, 6.5)
                    rgba(cr, c['seg_on'])
                    cr.fill()
                elif self.hit == ('seg', key):
                    rrect(cr, x + 2, y + 2, sw - 4, self.BAR_H - 4, 6.5)
                    rgba(cr, c['fg'], .07)
                    cr.fill()
                text(cr, label, x, y + 6, 9.5, c['fg'], .95 if on else .5,
                     'bold' if on else 'medium', align='center', width=sw)
                x += sw
        else:
            text(cr, 'Every check passed on this kernel.', PAD + 2, y + 6, 9.5,
                 c['fg'], .42)

        label = 'Report copied' if self.copied == 'report' else 'Copy report'
        tw = text(self.measure, label, 0, 0, 9.5, None, weight='medium', draw=False)[0]
        rx = PAD + self.content_w - tw - 4
        self.copy_rect = (rx - 8, y + 1, tw + 16, self.BAR_H - 2)
        if self.hit == ('copy', 0) and self.copied != 'report':
            rrect(cr, *self.copy_rect, 7)
            rgba(cr, c['fg'], .07)
            cr.fill()
        text(cr, label, rx, y + 6, 9.5,
             c['green'] if self.copied == 'report' else c['blue'], .95, 'medium')

    def draw_list(self, cr):
        c, w = self.colors, self.content_w
        self.chip_rects = []
        top, bottom = self.scroll - 40, self.scroll + self.view_h + 40
        # One card per section, so a group reads as a group. Drawn first, then
        # the rows on top of it.
        card, spans = None, []
        for block in self.blocks:
            if block['kind'] == 'section':
                card = [block['y'] + 22, block['y'] + 22]
                spans.append(card)
            elif card:
                card[1] = block['y'] + block['h']
        for y0, y1 in spans:
            if y1 < top or y0 > bottom:
                continue
            rrect(cr, 0, y0, w, y1 - y0, CARD)
            rgba(cr, c['tile'])
            cr.fill_preserve()
            rgba(cr, c['tile_edge'])
            cr.set_line_width(1)
            cr.stroke()

        first_in_card = True
        for block in self.blocks:
            y, h = block['y'], block['h']
            if block['kind'] == 'section':
                first_in_card = True
                if top <= y + h and y <= bottom:
                    text(cr, block['label'].upper(), 3, y + 6, 8.5, c['fg'], .40,
                         'bold', spacing=700)
                continue
            if y > bottom or y + h < top:
                first_in_card = False
                continue
            row, fix = block['row'], block['fix']
            key = row['label']
            if self.hit == ('row', key) or self.copied == key:
                rrect(cr, 4, y + 2, w - 8, h - 4, 9)
                rgba(cr, c['fg'], .05)
                cr.fill()
            if not first_in_card:
                rgba(cr, c['hair'])
                cr.set_line_width(1)
                cr.move_to(TEXT_X, y + .5)
                cr.line_to(w - 14, y + .5)
                cr.stroke()
            first_in_card = False
            copied = self.copied == key
            glyph(cr, row['status'], DOT_X, y + (21 if not block['compact'] else h / 2), 7.5, c)
            if block['compact']:
                text(cr, row['label'], TEXT_X, y + 14, 10.5, c['fg'], .92, 'medium',
                     width=w - TEXT_X - 30 - block['detail_w'])
                text(cr, 'Copied' if copied else row['detail'], 0, y + 15, 9.5,
                     c['green'] if copied else c['fg'], .95 if copied else .5,
                     'medium' if copied else 'normal', align='right', width=w - 16)
            else:
                text(cr, row['label'], TEXT_X, y + 12, 10.5, c['fg'], .92, 'medium',
                     width=w - TEXT_X - 96)
                if copied:
                    text(cr, 'Copied', 0, y + 13, 9.5, c['green'], .95, 'medium',
                         align='right', width=w - 16)
                text(cr, row['detail'], TEXT_X, y + 30, 9.5, c['fg'], .55,
                     width=w - TEXT_X - 16, lines=3)
                if fix:
                    self.draw_chip(cr, fix, TEXT_X, y + 32 + block['detail_h'], key)

        text(cr, 'Read-only checks — nothing here changes the system. '
                 'Click a finding to copy it.', 3, self.content_h - 24, 9,
             c['fg'], .35, width=w - 6)

    def draw_chip(self, cr, command, x, y, key):
        """A repair command, as something you can take away with you."""
        c = self.colors
        copied = self.copied == 'fix:' + key
        # Sized on the command either way, so confirming the copy does not
        # make the thing you just clicked change shape under the pointer.
        cw = text(self.measure, command, 0, 0, 9, None, weight='mono',
                  draw=False)[0] + 22
        ch = 21
        self.chip_rects.append((key, x, y, cw, ch))
        rrect(cr, x, y, cw, ch, 6)
        rgba(cr, c['fg'], .11 if self.hit == ('chip', key) else .07)
        cr.fill()
        if copied:
            text(cr, 'Copied', x, y + 4.5, 9, c['green'], .95, 'medium',
                 align='center', width=cw)
        else:
            text(cr, command, x + 11, y + 4.5, 9, c['fg'], .72, 'mono')

    def edge_fades(self, cr):
        """Content passes under the head and the lower rim instead of being
        chopped off at them. Faded to the window's own gradient at that y."""
        if self.max_scroll <= 0:
            return
        top, bottom = self.colors['top'], self.colors['bottom']
        for y0, depth, on in ((self.HEAD, 14, self.scroll > 1),
                              (self.height - PAD, -16,
                               self.scroll < self.max_scroll - 1)):
            if not on:
                continue
            mix = y0 / self.height
            colour = [a + (b - a) * mix for a, b in zip(top, bottom)]
            grad = cairo.LinearGradient(0, y0, 0, y0 + depth)
            for stop, alpha in ((0, colour[3]), (1, 0)):
                grad.add_color_stop_rgba(stop, colour[0] / 255, colour[1] / 255,
                                         colour[2] / 255, alpha)
            cr.rectangle(PAD - 4, min(y0, y0 + depth), self.content_w + 8, abs(depth))
            cr.set_source(grad)
            cr.fill()

    def draw_scrollbar(self, cr):
        if self.max_scroll <= 0:
            return
        c = self.colors
        track_h = self.view_h - 8
        length = max(34, track_h * self.view_h / self.content_h)
        pos = (self.scroll / self.max_scroll) * (track_h - length)
        x = W - PAD + 4
        self.thumb_rect = (x - 4, self.HEAD + 4 + pos, 12, length)
        rrect(cr, x, self.HEAD + 4 + pos, 4, length, 2)
        rgba(cr, c['fg'], .30 if self.drag_thumb or self.hit == ('thumb', 0) else .18)
        cr.fill()

    def draw_background(self, _w, cr):
        a = self.win.get_allocation()
        cr.save()
        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.set_source_rgba(0, 0, 0, 0)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)
        cr.scale(SC, SC)
        x = y = SHADOW
        w, h = a.width / SC - 2 * SHADOW, a.height / SC - 2 * SHADOW
        for i in range(SHADOW, 0, -1):
            rrect(cr, x - i, y - i + 2, w + 2 * i, h + 2 * i, RADIUS + i)
            cr.set_line_width(1.4)
            cr.set_source_rgba(0, 0, 0, .06 * (1 - i / SHADOW) ** 2)
            cr.stroke()
        grad = cairo.LinearGradient(0, y, 0, y + h)
        top, bot = self.colors['top'], self.colors['bottom']
        grad.add_color_stop_rgba(0, top[0] / 255, top[1] / 255, top[2] / 255, top[3])
        grad.add_color_stop_rgba(1, bot[0] / 255, bot[1] / 255, bot[2] / 255, bot[3])
        rrect(cr, x, y, w, h, RADIUS)
        cr.set_source(grad)
        cr.fill_preserve()
        rgba(cr, self.colors['rim'])
        cr.set_line_width(1)
        cr.stroke()
        rrect(cr, x + .75, y + .75, w - 1.5, h - 1.5, RADIUS - .75)
        rgba(cr, self.colors['edge'])
        cr.set_line_width(1)
        cr.stroke()
        cr.restore()
        return False

    # ------------------------------------------------------------------ input

    def what(self, x, y):
        """What is under the pointer, in 1x window coordinates."""
        def inside(rect):
            rx, ry, rw, rh = rect
            return rx <= x <= rx + rw and ry <= y <= ry + rh

        if y < self.HEAD:
            if inside(self.close_rect):
                return ('close', 0)
            if inside(self.recheck_rect):
                return ('recheck', 0)
            if inside(self.copy_rect):
                return ('copy', 0)
            for key, sx, sy, sw, sh in self.seg_rects:
                if inside((sx, sy, sw, sh)):
                    return ('seg', key)
            return None
        if self.max_scroll > 0 and inside(self.thumb_rect):
            return ('thumb', 0)
        ly = y - self.HEAD + self.scroll
        for key, cx, cy, cw, ch in self.chip_rects:
            if inside((cx + PAD, cy + self.HEAD - self.scroll, cw, ch)):
                return ('chip', key)
        for block in self.blocks:
            if block['kind'] == 'row' and block['y'] <= ly <= block['y'] + block['h']:
                return ('row', block['row']['label'])
        return None

    def on_motion(self, _w, e):
        x, y = e.x / SC, e.y / SC
        if self.drag_thumb is not None:
            track_h = self.view_h - 8
            length = max(34, track_h * self.view_h / self.content_h)
            span = max(1, track_h - length)
            self.scroll_to = self.scroll = min(self.max_scroll, max(
                0, (y - self.HEAD - 4 - self.drag_thumb) / span * self.max_scroll))
            self.area.queue_draw()
            return True
        hit = self.what(x, y)
        if hit != self.hit:
            self.hit = hit
            self.area.queue_draw()
        return True

    def on_leave(self):
        self.hit = None
        self.area.queue_draw()
        return True

    def on_press(self, _w, e):
        if e.button != 1:
            return False
        x, y = e.x / SC, e.y / SC
        self.pressed = self.what(x, y)
        if self.pressed and self.pressed[0] == 'thumb':
            self.drag_thumb = y - self.thumb_rect[1]
        elif self.pressed is None and y < self.HEAD:
            # the head is the title bar this window does not have
            self.win.begin_move_drag(e.button, int(e.x_root), int(e.y_root), e.time)
        return True

    def on_release(self, _w, e):
        if e.button != 1:
            return False
        if self.drag_thumb is not None:
            self.drag_thumb = None
            return True
        hit = self.what(e.x / SC, e.y / SC)
        if hit is not None and hit == self.pressed:
            self.activate(*hit)
        self.pressed = None
        return True

    def activate(self, kind, key):
        if kind == 'close':
            Gtk.main_quit()
        elif kind == 'recheck':
            self.recheck()
        elif kind == 'copy':
            self.to_clipboard(report(self.state), 'report')
        elif kind == 'seg' and key != self.filter:
            self.filter = key
            self.scroll = self.scroll_to = 0
            self.relayout()
            self.area.queue_draw()
        elif kind in ('row', 'chip'):
            row = next((r for r in self.shown if r['label'] == key), None)
            if row is None:
                return
            if kind == 'chip':
                self.to_clipboard(remedy(row), 'fix:' + key)
            else:
                self.to_clipboard(f"{row['status']}  {row['label']} — {row['detail']}", key)

    def to_clipboard(self, value, mark):
        clipboard = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
        clipboard.set_text(value, -1)
        clipboard.store()
        self.copied = mark
        GLib.timeout_add(1400, self.uncopy, mark)
        self.area.queue_draw()

    def uncopy(self, mark):
        if self.copied == mark:
            self.copied = None
            self.area.queue_draw()
        return False

    def on_scroll(self, _w, e):
        if self.max_scroll <= 0:
            return True
        if e.direction == Gdk.ScrollDirection.SMOOTH:
            dy = e.get_scroll_deltas()[2]
        else:
            dy = {Gdk.ScrollDirection.UP: -1, Gdk.ScrollDirection.DOWN: 1}.get(e.direction, 0)
        self.glide(dy * 58)
        return True

    def glide(self, delta):
        """Scroll with a short ease. A list this long reads badly when it jumps."""
        target = min(self.max_scroll, max(0.0, self.scroll_to + delta))
        if target == self.scroll_to:
            return
        self.scroll_to = target
        if not getattr(self, 'gliding', False):
            self.gliding = True
            GLib.timeout_add(16, self.step)

    def step(self):
        gap = self.scroll_to - self.scroll
        if abs(gap) < .6:
            self.scroll = self.scroll_to
            self.gliding = False
            self.area.queue_draw()
            return False
        self.scroll += gap * .28
        self.area.queue_draw()
        return True

    def on_key(self, _w, e):
        code = e.keyval
        if code in (Gdk.KEY_Escape, Gdk.KEY_q):
            Gtk.main_quit()
        elif code in (Gdk.KEY_r, Gdk.KEY_F5):
            self.recheck()
        elif code == Gdk.KEY_c:
            self.to_clipboard(report(self.state), 'report')
        elif code in (Gdk.KEY_1, Gdk.KEY_2, Gdk.KEY_3) and self.segments:
            index = code - Gdk.KEY_1
            if index < len(self.segments):
                self.activate('seg', self.segments[index][0])
        elif code in (Gdk.KEY_Down, Gdk.KEY_Up):
            self.glide(56 if code == Gdk.KEY_Down else -56)
        elif code in (Gdk.KEY_Page_Down, Gdk.KEY_Page_Up):
            self.glide((self.view_h - 40) * (1 if code == Gdk.KEY_Page_Down else -1))
        elif code in (Gdk.KEY_Home, Gdk.KEY_End):
            self.glide(-self.max_scroll if code == Gdk.KEY_Home else self.max_scroll)
        else:
            return False
        return True

    # --------------------------------------------------------------- checking

    def recheck(self):
        if self.checking:
            return
        self.checking = True
        GLib.timeout_add(90, self.tick)

        def worker():
            try:
                state, error = check(), None
            except Exception as exc:                          # doctor's own words
                state, error = None, str(exc)
            GLib.idle_add(self.landed, state, error)
        threading.Thread(target=worker, daemon=True).start()
        self.area.queue_draw()

    def tick(self):
        self.phase = (self.phase + 1) % 8
        self.area.queue_draw()
        return self.checking

    def landed(self, state, error):
        self.checking = False
        self.error = error
        if state:
            was_failing = self.failing
            self.state = state
            empty_filter = ((self.filter == 'errors' and not self.failing) or
                            (self.filter == 'notes' and not any(
                                r['status'] == 'warn' for r in self.rows)))
            if empty_filter or (was_failing and not self.failing and self.filter == 'errors'):
                self.filter = 'all'
        self.relayout()
        self.area.queue_draw()
        return False


def show():
    global Gtk, Gdk, GLib, Pango, PangoCairo, cairo, math, SC
    import importlib.machinery
    import importlib.util
    import math
    import signal
    import gi
    gi.require_version('Gtk', '3.0')
    gi.require_version('PangoCairo', '1.0')
    import cairo
    from gi.repository import Gtk, Gdk, GLib, Pango, PangoCairo
    if Gdk.Screen.get_default() is None:
        raise SystemExit('No desktop display.')
    loader = importlib.machinery.SourceFileLoader(
        'mintbook_instance', str(Path(__file__).resolve().parent / 'mintbook_instance.py'))
    instance = importlib.util.module_from_spec(
        importlib.util.spec_from_loader(loader.name, loader))
    loader.exec_module(instance)
    pidfile = Path.home() / '.cache/mintbook/mintbook-health.pid'
    if not instance.claim(str(pidfile), 'mintbook-health', signal.SIGTERM):
        raise SystemExit(0)
    SC = float(os.environ.get('MINTBOOK_SCALE', 0)) or round((Gdk.Screen.get_default().get_resolution() or 96) / 96.0, 3) or 1.0
    Gdk.set_program_class('mintbook-health')
    win = Window()
    signal.signal(signal.SIGTERM, lambda *_: GLib.idle_add(Gtk.main_quit))
    Gtk.main()
    pidfile.unlink(missing_ok=True)


# GTK_THEME before the Gtk import, because Gtk.init is what reads it. WhiteSur's
# gtk.css is 400 KB and nothing here is a themed widget; parsing it would be the
# largest single cost of opening the window. setdefault, so it can still be A/B'd.
os.environ.setdefault('GTK_THEME', 'Adwaita')

if __name__ == '__main__':
    if sys.argv[1:] == ['--on-kernel-change']:
        check(only_changed=True, notify=True)
    elif sys.argv[1:] == ['--check']:
        print(json.dumps(check()))
    elif sys.argv[1:] == ['--report']:
        sys.stdout.write(report(load() or check()))
    elif not sys.argv[1:]:
        show()
    else:
        sys.exit('usage: mintbook-health [--check|--report|--on-kernel-change]')
