#!/usr/bin/env bash
# camera-diag - FaceTime HD (14e4:1570) state. Read-only, no sudo.
# See docs/camera.md.
set -uo pipefail

hr() { printf '\n=== %s ===\n' "$1"; }

hr "KERNEL / IOMMU"
uname -r
echo "cmdline: $(cat /proc/cmdline)"
if grep -qw intel_iommu=off /proc/cmdline; then
  echo "intel_iommu=off: YES"
else
  echo "intel_iommu=off: NO  (ISP DMA usually fails without this)"
fi
dmesg 2>/dev/null | grep -iE 'iommu: Default|DMAR: IOMMU disabled|Intel-IOMMU' | head -5

hr "PCI"
lspci -nnk -d 14e4:1570 2>/dev/null || echo "(no 14e4:1570)"

hr "MODULE"
lsmod | grep -E 'facetimehd|bdc_pci' || echo "(facetimehd not loaded)"
modinfo facetimehd 2>/dev/null | grep -E '^filename|^version|^srcversion' || echo "(no facetimehd module installed)"
echo "firmware: $(ls -l /lib/firmware/facetimehd/firmware.bin 2>/dev/null || echo MISSING)"
dkms status facetimehd 2>/dev/null || echo "(facetimehd not in DKMS)"

hr "VIDEO NODES"
ls -l /dev/video* /dev/media* 2>&1 || true

hr "DMESG"
dmesg 2>/dev/null | grep -iE 'facetimehd|fthd|SIF errors|1570' | tail -40 || echo "(no facetimehd lines, or dmesg needs root)"

if [ -e /dev/video0 ]; then
  hr "FORMATS"
  if command -v v4l2-ctl >/dev/null; then
    v4l2-ctl -d /dev/video0 --all 2>/dev/null | grep -E 'Card type|Driver name|Width/Height|Pixel Format|Frames per'
    echo
    v4l2-ctl -d /dev/video0 --list-formats-ext 2>/dev/null | head -30
  else
    echo "(v4l-utils not installed; sudo apt install v4l-utils)"
  fi
fi
