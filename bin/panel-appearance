#!/usr/bin/env python3
"""Appearance-mode indicator; genmon refreshes it every minute."""
import os
import subprocess

APPLY = os.path.expanduser('~/.local/bin/appearance-mode')
MENU = os.path.expanduser('~/.local/bin/appearance-menu')
STATE = os.path.expanduser('~/.config/mintbook/appearance.mode')
APPLIED = os.path.expanduser('~/.config/mintbook/appearance.applied')
DIR = os.path.expanduser('~/.local/share/mintbook/appearance')

def read(path, default):
    try:
        value = open(path).read().strip()
        return value or default
    except OSError:
        return default

subprocess.run([APPLY, '--refresh'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=8)
mode = read(STATE, 'auto')
actual = read(APPLIED, 'light')
print(f'<click>{MENU}</click>')
print(f'<iconclick>{MENU}</iconclick>')
print(f'<img>{DIR}/appearance-{actual}.svg</img>')
print(f'<tool>Appearance · {mode.title()}\nCurrently {actual.title()}\nClick to choose</tool>')
