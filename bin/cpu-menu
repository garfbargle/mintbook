#!/usr/bin/env python3
"""CPU menu — the glass popup behind the bar's sparkline.

The bar already shows how busy the machine is. This is the story behind that
line: which processes made it, in colour, over the last few minutes, and a
deeper look at one of them — CPU, memory, whether it was reading or writing,
and which files it has open.

Drawn the way bin/battery-menu is — cairo on one override-redirect window,
one DrawingArea, a list of rows — for the reasons in docs/control-center.md:
genmon spawns a click command with no Gdk event behind it, and xfwm4 discards
a Gtk.Menu grab at time 0. Activity Monitor stays in the footer for the
things a popup should not try to be.
"""
import math
import os
import signal
import subprocess
import sys
import time

T0 = time.monotonic()

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import mintbook_cpu as mcpu                                         # noqa: E402

HOME = os.path.expanduser('~')
APPLIED = f'{HOME}/.config/mintbook/appearance.applied'
PIDFILE = f'{HOME}/.cache/mintbook/cpu-menu.pid'
MONITOR = 'gnome-system-monitor'


def read_file(path, default=''):
    try:
        with open(path) as handle:
            return handle.read().strip() or default
    except OSError:
        return default


os.environ.setdefault('GTK_THEME', 'Adwaita')

# Where the pointer is now, which is where the icon was clicked. Read
# synchronously *before* the GTK import — hiding it behind the import is what
# broke the battery and Wi-Fi menus. See bin/battery-menu.
PTR_XY = None
try:
    _ax, _ay = os.environ['MINTBOOK_ANCHOR'].split(',')
    PTR_XY = (int(_ax), int(_ay))
except (KeyError, ValueError):
    try:
        _ptr = subprocess.run(['xdotool', 'getmouselocation', '--shell'],
                              capture_output=True, text=True, timeout=3).stdout
        _ptr = dict(p.split('=', 1) for p in _ptr.split() if '=' in p)
        PTR_XY = (int(_ptr['X']), int(_ptr['Y']))
    except Exception:
        PTR_XY = None

import gi                                                          # noqa: E402
gi.require_version('Gtk', '3.0')
gi.require_version('PangoCairo', '1.0')
import cairo                                                       # noqa: E402
from gi.repository import Gtk, Gdk, GLib, Pango, PangoCairo        # noqa: E402
import mintbook_keys                                               # noqa: E402

SC = round((Gdk.Screen.get_default().get_resolution() or 96) / 96.0, 3) or 1.0
WIDTH, PAD, GAP, SHADOW, RADIUS, CARD = 372, 14, 10, 16, 18, 12

LIGHT = {  # generated by bin/palette-generate
