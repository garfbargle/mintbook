    'tile_edge': (255, 255, 255, 0.65098),
    'track': (65, 68, 74, 0.129412),
    'hair': (65, 68, 74, 0.121569),
    'seg': (65, 68, 74, 0.101961),
    'seg_on': (255, 255, 255, 0.94902),
    'green': (52, 199, 89),
    'amber': (255, 159, 10),
    'red': (255, 59, 48),
    'blue': (0, 122, 255),
}
DARK = {  # generated by bin/palette-generate
    'top': (104, 109, 119, 0.976471),
    'bottom': (74, 78, 86, 0.968627),
    'edge': (255, 255, 255, 0.180392),
    'rim': (0, 0, 0, 0.34902),
    'fg': (255, 255, 255),
    'tile': (255, 255, 255, 0.129412),
    'tile_hi': (255, 255, 255, 0.2),
    'tile_edge': (255, 255, 255, 0.101961),
    'track': (255, 255, 255, 0.160784),
    'hair': (255, 255, 255, 0.121569),
    'seg': (0, 0, 0, 0.2),
    'seg_on': (255, 255, 255, 0.278431),
    'green': (48, 209, 88),
    'amber': (255, 214, 10),
    'red': (255, 69, 58),
    'blue': (10, 132, 255),
}


def rgba(cr, color, alpha=None):
    base = color[3] if len(color) > 3 else 1.0
    cr.set_source_rgba(color[0] / 255, color[1] / 255, color[2] / 255,
                       base if alpha is None else base * alpha)


def rrect(cr, x, y, w, h, radius):
    radius = min(radius, w / 2, h / 2)
    cr.new_sub_path()
    cr.arc(x + w - radius, y + radius, radius, -math.pi / 2, 0)
    cr.arc(x + w - radius, y + h - radius, radius, 0, math.pi / 2)
    cr.arc(x + radius, y + h - radius, radius, math.pi / 2, math.pi)
    cr.arc(x + radius, y + radius, radius, math.pi, 3 * math.pi / 2)
    cr.close_path()


def text(cr, value, x, y, size, color, alpha=1, weight='normal',
         align=None, width=0, tnum=False):
    layout = PangoCairo.create_layout(cr)
    family = 'Inter Semi-Bold' if weight == 'bold' else 'Inter'
    font = Pango.FontDescription(family)
    font.set_absolute_size(size * Pango.SCALE)
    layout.set_font_description(font)
    if tnum:
        attrs = Pango.AttrList()
        attrs.insert(Pango.attr_font_features_new('tnum=1'))
        layout.set_attributes(attrs)
    layout.set_text(str(value), -1)
    layout.set_ellipsize(Pango.EllipsizeMode.END)
    if width:
        layout.set_width(int(width * Pango.SCALE))
        layout.set_alignment({'center': Pango.Alignment.CENTER,
                              'right': Pango.Alignment.RIGHT}.get(
                                  align, Pango.Alignment.LEFT))
    rgba(cr, color, alpha)
    cr.move_to(x, y)
    PangoCairo.show_layout(cr, layout)
    return layout.get_pixel_size()


def chevron(cr, x, y, color, alpha=.35, flip=False):
    rgba(cr, color, alpha)
    cr.set_line_width(1.5)
    cr.set_line_cap(cairo.LINE_CAP_ROUND)
    if flip:
        cr.move_to(x + 2, y - 4)
        cr.line_to(x - 2, y)
        cr.line_to(x + 2, y + 4)
    else:
        cr.move_to(x - 2, y - 4)
        cr.line_to(x + 2, y)
        cr.line_to(x - 2, y + 4)
    cr.stroke()


def fade_mask(cr, x, w):
    mask = cairo.LinearGradient(x, 0, x + w, 0)
    mask.add_color_stop_rgba(0, 0, 0, 0, 0)
    mask.add_color_stop_rgba(.12, 0, 0, 0, 1)
    mask.add_color_stop_rgba(.88, 0, 0, 0, 1)
    mask.add_color_stop_rgba(1, 0, 0, 0, 0)
    return mask


def stacked_chart(cr, samples, keys, x, y, w, h, dark, fg, hot_key=None):
    """Process bands stacked as share of the machine, idle left as glass."""
    if len(samples) < 2:
        return False
    series, other, _busy = mcpu.series_for(samples, keys)
    n = len(samples)
    xs = [x + i * w / (n - 1) for i in range(n)]

    def ys(values):
        return [y + h - max(0.0, min(100.0, v)) / 100.0 * h for v in values]

    ranked = sorted(keys, key=lambda key: -sum(series.get(key, ())))
    layers = []
    baseline = [0.0] * n

    def add(color, values, key):
        top = [b + v for b, v in zip(baseline, values)]
        layers.append((color, ys(baseline), ys(top), key))
        baseline[:] = top

    add(fg, other, None)
    for key in ranked:
        add(mcpu.swatch(key, dark), series.get(key, [0] * n), key)

    cr.save()
    cr.push_group()
    for color, y_bot, y_top, key in layers:
        if hot_key is None:
            alpha = 0.16 if key is None else 0.72
        elif key == hot_key:
            alpha = 0.92
        else:
            alpha = 0.08 if key is None else 0.22
        cr.move_to(xs[0], y_bot[0])
        for i in range(1, n):
            cr.line_to(xs[i], y_bot[i])
        for i in range(n - 1, -1, -1):
            cr.line_to(xs[i], y_top[i])
        cr.close_path()
        rgba(cr, color, alpha)
        cr.fill()
        if key is not None and key == hot_key:
            cr.move_to(xs[0], y_top[0])
            for i in range(1, n):
                cr.line_to(xs[i], y_top[i])
            rgba(cr, color, 1)
            cr.set_line_width(1.2)
            cr.set_line_join(cairo.LINE_JOIN_ROUND)
            cr.stroke()
    cr.move_to(xs[0], ys(baseline)[0])
    for i in range(1, n):
        cr.line_to(xs[i], ys(baseline)[i])
    rgba(cr, fg, 0.28)
    cr.set_line_width(1.1)
    cr.stroke()
    pattern = cr.pop_group()
    cr.set_source(pattern)
    cr.mask(fade_mask(cr, x, w))
    cr.restore()
    return True


def sparkline(cr, values, x, y, w, h, color, alpha=.30, floor=0.0, ceil=100.0):
    if len(values) < 2:
        return
    cr.save()
    cr.push_group()
    step = w / (len(values) - 1)
    span = max(1e-6, ceil - floor)
    pts = [(x + i * step,
            y + h - max(0.0, min(1.0, (v - floor) / span)) * h)
           for i, v in enumerate(values)]
    cr.move_to(x, y + h)
    for px, py in pts:
        cr.line_to(px, py)
    cr.line_to(x + w, y + h)
    cr.close_path()
    rgba(cr, color, alpha)
    cr.fill()
    cr.move_to(*pts[0])
    for px, py in pts[1:]:
        cr.line_to(px, py)
    rgba(cr, color, min(1.0, alpha * 3.2))
    cr.set_line_width(1.3)
    cr.set_line_join(cairo.LINE_JOIN_ROUND)
    cr.stroke()
    pattern = cr.pop_group()
    cr.set_source(pattern)
    cr.mask(fade_mask(cr, x, w))
    cr.restore()


# ---------------------------------------------------------------------- rows

class Row:
    h = 0
    interactive = False

    def __init__(self, panel):
        self.panel = panel
        self.hit = None

    @property
    def c(self):
        return self.panel.colors

    def card(self, cr, w, h, lit=False):
        rrect(cr, 0, 0, w, h, CARD)
        rgba(cr, self.c['tile_hi'] if lit else self.c['tile'])
        cr.fill_preserve()
        rgba(cr, self.c['tile_edge'])
        cr.set_line_width(1)
        cr.stroke()

    def draw(self, cr, w):
        pass

    def test(self, x, y):
        return None

    def release(self, x, y):
        pass


class HeaderRow(Row):
    h = 48

    def draw(self, cr, w):
        p = self.panel
        text(cr, 'CPU', 2, 0, 15, self.c['fg'], .96, 'bold')
        text(cr, f'{p.pct:.0f}%', 0, -2, 22, self.c['fg'], .95, 'bold',
             'right', w - 2, tnum=True)
        text(cr, p.subtitle, 2, 28, 9.2, self.c['fg'], .48, width=w - 4)


class ChartRow(Row):
    h = 124
    GY, GH = 10, 90

    def draw(self, cr, w):
        p = self.panel
        self.card(cr, w, self.h)
        gx, gy, gw, gh = 14, self.GY, w - 28, self.GH
        rgba(cr, self.c['hair'])
        cr.set_line_width(1)
        cr.move_to(gx, gy + gh * .5)
        cr.line_to(gx + gw, gy + gh * .5)
        cr.stroke()
        text(cr, '100', gx, gy - 2, 7.5, self.c['fg'], .28, tnum=True)
        text(cr, '0', gx, gy + gh + 2, 7.5, self.c['fg'], .28, tnum=True)
        names = [name for _pid, name in p.legend]
        drew = stacked_chart(cr, p.samples, names, gx, gy, gw, gh,
                             p.dark, self.c['fg'], p.hot_key)
        if not drew:
            text(cr, 'Collecting history…', 15, gy + gh / 2 - 8, 9.5,
                 self.c['fg'], .35)
        text(cr, mcpu.span_label(p.samples), 15, gy + gh + 4, 8.5,
             self.c['fg'], .35)
        text(cr, 'share of the machine', 0, gy + gh + 4, 8.5,
             self.c['fg'], .32, 'normal', 'right', w - 15)


class ProcessRow(Row):
    """The legend for the chart. Hover lights the matching band; click opens
    the process. LINE/LEAD/visible exist so mintbook_keys can walk the rows."""
    interactive = True
    LEAD = 26
    LINE = 36

    def __init__(self, panel):
        super().__init__(panel)
        self.h = self.LEAD + self.LINE * max(1, len(panel.procs)) + 10

    @property
    def procs(self):
        return self.panel.procs

    @property
    def visible(self):
        return [{'name': p['label'], 'pid': p['i'], 'path': str(p['i'])}
                for p in self.procs]

    def draw(self, cr, w):
        self.card(cr, w, self.h)
        text(cr, 'Processes', 15, 8, 9.5, self.c['fg'], .5)
        if not self.procs:
            text(cr, 'Quiet', 15, self.LEAD + 4, 10.5, self.c['fg'], .4)
            return
        dark = self.panel.dark
        for i, proc in enumerate(self.procs):
            y = self.LEAD + i * self.LINE
            hot = self.hit == proc['i']
            if hot:
                rrect(cr, 6, y - 2, w - 12, self.LINE - 2, 8)
                rgba(cr, self.c['fg'], .06)
                cr.fill()
            color = mcpu.swatch(proc['n'], dark)
            cr.arc(22, y + 10, 4.2, 0, 2 * math.pi)
            rgba(cr, color, .95)
            cr.fill()
            text(cr, proc['label'], 34, y - 1, 10.5, self.c['fg'],
                 .94 if hot else .88, 'bold', width=w - 118)
            text(cr, f"{mcpu.cores(proc['s']):.1f}", 0, y - 1, 11,
                 self.c['fg'], .55 if not hot else .8, 'bold', 'right',
                 w - 15, tnum=True)
            sub = proc['sub']
            text(cr, sub or 'idle', 34, y + 16, 8.7, self.c['fg'], .4,
                 width=w - 50)
            chevron(cr, w - 19, y + 16, self.c['fg'],
                    .55 if hot else .28)

    def test(self, x, y):
        if y < self.LEAD:
            return None
        i = int((y - self.LEAD) / self.LINE)
        if 0 <= i < len(self.procs):
            return self.procs[i]['i']
        return None

    def release(self, x, y):
        pid = self.test(x, y)
        if pid:
            self.panel.open_process(pid)


class FooterRow(Row):
    h = 48
    interactive = True

    def draw(self, cr, w):
        hot = self.hit is not None
        self.card(cr, w, self.h, hot)
        text(cr, 'Activity Monitor…', 15, self.h / 2 - 8, 10.5,
             self.c['fg'], .92)
        chevron(cr, w - 19, self.h / 2, self.c['fg'], .55 if hot else .3)

    def test(self, x, y):
        return 'monitor'

    def release(self, x, y):
        self.panel.open_monitor()


class BackRow(Row):
    h = 52
    interactive = True

    def draw(self, cr, w):
        d = self.panel.detail or {}
        hot = self.hit is not None
        text(cr, '', 0, 0, 1, self.c['fg'], 0)
        chevron(cr, 12, 14, self.c['fg'], .7 if hot else .45, flip=True)
        color = mcpu.swatch(mcpu.pretty(d.get('comm', ''), ''), self.panel.dark)
        cr.arc(36, 14, 5, 0, 2 * math.pi)
        rgba(cr, color)
        cr.fill()
        text(cr, d.get('name', 'Process'), 48, 2, 13, self.c['fg'], .96, 'bold',
             width=w - 52)
        bits = [str(d.get('pid', '')), d.get('state', '')]
        if d.get('threads'):
            bits.append(f"{d['threads']} threads")
        count = next((p.get('count', 1) for p in self.panel.procs
                      if p['i'] == d.get('pid')), 1)
        if count > 1:
            bits.append(f'busiest of {count}')
        if d.get('cgroup'):
            bits.append(d['cgroup'])
        text(cr, ' · '.join(b for b in bits if b), 48, 24, 9, self.c['fg'], .45,
             width=w - 52)

    def test(self, x, y):
        return 'back'

    def release(self, x, y):
        self.panel.open_process(None)


class DetailChartRow(Row):
    h = 86

    def draw(self, cr, w):
        p = self.panel
        self.card(cr, w, self.h)
        d = p.detail or {}
        color = mcpu.swatch(mcpu.pretty(d.get('comm', ''), ''), p.dark)
        values = p.pid_series
        gx, gy, gw, gh = 14, 10, w - 28, 54
        if len(values) > 1:
            peak = max(values) or 1.0
            sparkline(cr, values, gx, gy, gw, gh, color, .28, 0,
                      max(8.0, peak * 1.25))
        else:
            text(cr, 'No history for this process yet', 15, gy + 16, 9.5,
                 self.c['fg'], .35)
        text(cr, mcpu.span_label(p.samples), 15, gy + gh + 2, 8.5,
             self.c['fg'], .35)


class StatsRow(Row):
    h = 164

    def draw(self, cr, w):
        d = self.panel.detail or {}
        self.card(cr, w, self.h)
        rows = self.panel.stat_lines()
        y = 12
        for label, value, note in rows:
            text(cr, label, 15, y, 9.3, self.c['fg'], .42)
            text(cr, value, 108, y, 10.5, self.c['fg'], .92, 'bold',
                 width=w - 124, tnum=True)
            if note:
                text(cr, note, 108, y + 15, 8.5, self.c['fg'], .38,
                     width=w - 124)
                y += 36
            else:
                y += 24


class FilesRow(Row):
    LEAD = 26
    LINE = 18

    def __init__(self, panel):
        super().__init__(panel)
        d = panel.detail or {}
        files = d.get('files') or []
        extra = 1 if d.get('cmd') or d.get('cwd') else 0
        extra += 1 if d.get('cwd') and d.get('cmd') else 0
        n = max(1, len(files)) + extra + (1 if d.get('fd') else 0)
        self.h = self.LEAD + self.LINE * n + 16

    def draw(self, cr, w):
        d = self.panel.detail or {}
        self.card(cr, w, self.h)
        text(cr, 'Open files', 15, 8, 9.5, self.c['fg'], .5)
        y = self.LEAD
        files = d.get('files') or []
        if files:
            for path in files:
                text(cr, mcpu.home_short(path), 15, y, 9, self.c['fg'], .78,
                     width=w - 30)
                y += self.LINE
        else:
            text(cr, 'None visible', 15, y, 9.5, self.c['fg'], .4)
            y += self.LINE
        fd = d.get('fd') or {}
        bits = []
        if fd.get('socket'):
            bits.append(f"{fd['socket']} sockets")
        if fd.get('pipe'):
            bits.append(f"{fd['pipe']} pipes")
        if bits:
            text(cr, ' · '.join(bits), 15, y, 8.7, self.c['fg'], .4)
            y += self.LINE
        if d.get('cwd'):
            text(cr, 'in  ' + mcpu.home_short(d['cwd']), 15, y, 8.7,
                 self.c['fg'], .4, width=w - 30)
            y += self.LINE
        if d.get('cmd'):
            text(cr, d['cmd'], 15, y, 8.5, self.c['fg'], .36, width=w - 30)


# --------------------------------------------------------------------- panel

class Menu:
    def __init__(self):
        self.mode = 'dark' if read_file(APPLIED, 'light') == 'dark' else 'light'
        self.dark = self.mode == 'dark'
        self.colors = DARK if self.dark else LIGHT
        self.closing = False
        self.press_row = None
        self.selected = None
        self.detail = None
        self.geo = None
        self.x = self.y = 0
        self.gdk_win = None
        self.load()
        self.rows = []
        self.rebuild(initial=True)

        self.win = win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
        win.set_title('CPU')
        win.set_decorated(False)
        win.set_skip_taskbar_hint(True)
        win.set_skip_pager_hint(True)
        win.set_keep_above(True)
        win.set_resizable(False)
        win.set_app_paintable(True)
        win.set_type_hint(Gdk.WindowTypeHint.POPUP_MENU)
        visual = Gdk.Screen.get_default().get_rgba_visual()
        if visual:
            win.set_visual(visual)
        win.connect('draw', self.draw_background)
        win.connect('key-press-event', self.on_key)
        win.connect('destroy', lambda *_a: self.close())

        self.area = Gtk.DrawingArea()
        self.area.set_size_request(round(WIDTH * SC),
                                   round((self.height - 2 * PAD) * SC))
        self.area.add_events(Gdk.EventMask.BUTTON_PRESS_MASK
                             | Gdk.EventMask.BUTTON_RELEASE_MASK
                             | Gdk.EventMask.POINTER_MOTION_MASK
                             | Gdk.EventMask.LEAVE_NOTIFY_MASK)
        self.area.connect('draw', self.on_draw)
        self.area.connect('button-press-event', self.on_press)
        self.area.connect('button-release-event', self.on_release)
        self.area.connect('motion-notify-event', self.on_motion)
        self.area.connect('leave-notify-event', self.on_leave)

        box = Gtk.Box()
        for setter in (box.set_margin_top, box.set_margin_bottom,
                       box.set_margin_start, box.set_margin_end):
            setter(round((SHADOW + PAD) * SC))
        box.pack_start(self.area, False, False, 0)
        win.add(box)
        win.show_all()
        GLib.timeout_add(1000, self.tick)

    def load(self):
        state = mcpu.read_state()
        self.hist = state['hist']
        self.pct = self.hist[-1] if self.hist else 0.0
        self.samples = mcpu.collapse_samples(mcpu.read_stack())
        self.legend = mcpu.legend_pids(self.samples, mcpu.LIST_N)
        self.mem = mcpu.meminfo()
        self.load1 = mcpu.loadavg()
        self.psi_cpu = mcpu.pressure('cpu')
        self.psi_io = mcpu.pressure('io')
        names = dict(self.legend)
        self.procs = []
        latest = {p['i']: p for p in mcpu.latest_procs(self.samples, 16)}
        for pid, comm in self.legend:
            row = latest.get(pid, {'i': pid, 'n': comm, 's': 0, 'm': 0, 'r': 0, 'w': 0})
            cmd = mcpu.cmdline_of(pid) if os.path.exists(f'/proc/{pid}') else ''
            label = row.get('n', comm)
            if row.get('count', 1) == 1:
                label = mcpu.pretty(row.get('comm', comm), cmd)
            dt = self.samples[-1].get('d', 0) if self.samples else 0
            sub = self.proc_sub(row, dt)
            self.procs.append({**row, 'label': label, 'sub': sub})
        if self.selected:
            self.detail = mcpu.inspect(self.selected, prev=self.detail)

    def proc_sub(self, row, dt):
        bits = []
        rss = row.get('m') or 0
        if rss:
            bits.append(mcpu.human(rss))
        if dt > 0:
            read_s = (row.get('r') or 0) / dt
            write_s = (row.get('w') or 0) / dt
            if read_s >= 50_000:
                bits.append('read ' + mcpu.human(read_s, True))
            if write_s >= 50_000:
                bits.append('write ' + mcpu.human(write_s, True))
        if row.get('count', 1) > 1:
            bits.append(f"{row['count']} processes")
        return ' · '.join(bits)

    @property
    def subtitle(self):
        bits = [f'{mcpu.NCPU} cores', f'load {self.load1:.2f}']
        if self.mem['avail']:
            bits.append(f"{mcpu.human(self.mem['avail'])} free")
        if self.psi_cpu >= 1:
            bits.append(f'waiting {self.psi_cpu:.0f}%')
        elif self.psi_io >= 1:
            bits.append(f'I/O wait {self.psi_io:.0f}%')
        if self.mem['swap_used'] >= 8_000_000:
            bits.append('swap ' + mcpu.human(self.mem['swap_used']))
        return ' · '.join(bits)

    @property
    def hot_key(self):
        pid = self.selected
        if pid is None:
            for row in self.rows:
                if isinstance(row, ProcessRow) and row.hit is not None:
                    pid = row.hit
                    break
        if pid is None:
            return None
        for proc in self.procs:
            if proc['i'] == pid:
                return proc['n']
        if self.detail:
            return mcpu.pretty(self.detail.get('comm', ''), '')
        return None

    @property
    def pid_series(self):
        comm = (self.detail or {}).get('comm')
        if not comm or not self.samples:
            return []
        key = mcpu.pretty(comm, '')
        series, _other, _busy = mcpu.series_for(self.samples, [key])
        return series.get(key, [])

    def stat_lines(self):
        d = self.detail or {}
        share = 0.0
        if self.samples:
            for proc in self.samples[-1].get('p', []):
                if proc['i'] == self.selected:
                    share = proc.get('s', 0.0)
        live = d.get('cores') or 0.0
        cpu_n = live if live else mcpu.cores(share)
        io = d.get('io') or {}
        cache_note = ''
        if d.get('rchar_s', 0) > 200_000 and d.get('rchar_s', 0) > d.get('read_s', 0) * 4:
            cache_note = 'mostly page cache, not disk'
        elif d.get('read_s', 0) >= 50_000:
            cache_note = 'physical disk reads'
        lines = [
            ('CPU', f'{cpu_n:.2f} cores',
             f'{share:.0f}% of the machine' if share else ''),
            ('Memory', mcpu.human(d.get('rss') or 0),
             (mcpu.human(d.get('vsize') or 0) + ' virtual') if d.get('vsize') else ''),
            ('Read', mcpu.human(d.get('read_s') or 0, True),
             cache_note or (mcpu.human(io.get('read_bytes', 0)) + ' from disk'
                            if io.get('read_bytes') else '')),
            ('Write', mcpu.human(d.get('write_s') or 0, True),
             mcpu.human(io.get('write_bytes', 0)) + ' to disk' if io.get('write_bytes') else ''),
        ]
        return lines

    def build_rows(self):
        if self.selected and self.detail:
            return [BackRow(self), DetailChartRow(self), StatsRow(self),
                    FilesRow(self), FooterRow(self)]
        return [HeaderRow(self), ChartRow(self), ProcessRow(self), FooterRow(self)]

    def rebuild(self, initial=False):
        self.rows = self.build_rows()
        self.height = (sum(r.h for r in self.rows) + GAP * (len(self.rows) - 1)
                       + 2 * PAD)
        if initial or not hasattr(self, 'area'):
            return
        self.area.set_size_request(round(WIDTH * SC),
                                   round((self.height - 2 * PAD) * SC))
        self.reposition()
        self.area.queue_draw()

    def tick(self):
        if self.closing:
            return False
        was = self.selected
        n = len(self.procs)
        self.load()
        if was and not self.detail:
            self.selected = None
        if self.selected != was or len(self.procs) != n:
            self.rebuild()
        else:
            self.area.queue_draw()
        return True

    def open_process(self, pid):
        self.detail = mcpu.inspect(pid) if pid else None
        self.selected = pid if self.detail else None
        self.rebuild()

    def open_monitor(self):
        subprocess.Popen([MONITOR], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.close()

    def on_draw(self, _w, cr):
        cr.set_antialias(cairo.ANTIALIAS_BEST)
        cr.scale(SC, SC)
        y = 0
        for row in self.rows:
            cr.save()
            cr.translate(0, y)
            cr.rectangle(0, 0, WIDTH, row.h)
            cr.clip()
            row.draw(cr, WIDTH)
            mintbook_keys.draw(self, row, cr, WIDTH)
            cr.restore()
            y += row.h + GAP
        return False

    def draw_background(self, _w, cr):
        a = self.win.get_allocation()
        cr.save()
        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.set_source_rgba(0, 0, 0, 0)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)
        cr.scale(SC, SC)
        x = y = SHADOW
        w, h = a.width / SC - 2 * SHADOW, a.height / SC - 2 * SHADOW
        for i in range(SHADOW, 0, -1):
            rrect(cr, x - i, y - i + 2, w + 2 * i, h + 2 * i, RADIUS + i)
            cr.set_line_width(1.4)
            cr.set_source_rgba(0, 0, 0, .055 * (1 - i / SHADOW) ** 2)
            cr.stroke()
        grad = cairo.LinearGradient(0, y, 0, y + h)
        top, bot = self.colors['top'], self.colors['bottom']
        grad.add_color_stop_rgba(0, top[0] / 255, top[1] / 255, top[2] / 255, top[3])
        grad.add_color_stop_rgba(1, bot[0] / 255, bot[1] / 255, bot[2] / 255, bot[3])
        rrect(cr, x, y, w, h, RADIUS)
        cr.set_source(grad)
        cr.fill_preserve()
        rgba(cr, self.colors['rim'])
        cr.set_line_width(1)
        cr.stroke()
        rrect(cr, x + .75, y + .75, w - 1.5, h - 1.5, RADIUS - .75)
        rgba(cr, self.colors['edge'])
        cr.set_line_width(1)
        cr.stroke()
        cr.restore()
        return False

    def locate(self, ex, ey):
        x, y = ex / SC, ey / SC
        for row in self.rows:
            if y < row.h:
                return row, x, y
            y -= row.h + GAP
        return None, x, y

    def on_motion(self, _w, e):
        self.keyboard_target = None
        for row in self.rows:
            row.hit = None
        row, x, y = self.locate(e.x, e.y)
        if row is not None and row.interactive:
            row.hit = row.test(x, y)
        self.area.queue_draw()
        return True

    def on_leave(self, *_a):
        for row in self.rows:
            row.hit = None
        self.area.queue_draw()
        return True

    def on_press(self, _w, e):
        self.press_row = self.locate(e.x, e.y)[0]
        return True

    def on_release(self, _w, e):
        row, x, y = self.locate(e.x, e.y)
        if row is not None and row is self.press_row and row.interactive:
            row.release(x, y)
        self.press_row = None
        return True

    def on_key(self, _w, e):
        if e.keyval in (Gdk.KEY_Escape, Gdk.KEY_q):
            if self.selected:
                self.open_process(None)
            else:
                self.close()
            return True
        if e.keyval in (Gdk.KEY_BackSpace, Gdk.KEY_Left) and self.selected:
            self.open_process(None)
            return True
        if mintbook_keys.key(self, e, WIDTH):
            return True
        return False

    def place(self, px, py):
        self.anchor = (px, py)
        win = self.win
        win.realize()
        gdk_win = win.get_window()
        if gdk_win is not None:
            gdk_win.set_override_redirect(True)
        self.gdk_win = gdk_win
        alloc = win.get_allocation()
        w, h = alloc.width, alloc.height
        display = Gdk.Display.get_default()
        monitor = (display.get_monitor_at_point(px, py)
                   or display.get_primary_monitor())
        work = monitor.get_workarea()
        self.geo = work
        edge = round(SHADOW * SC)
        left = work.x - edge + 4
        right = work.x + work.width - w + edge - 4
        x = max(left, min(int(px - w + edge + round(24 * SC)), right))
        top = work.y - edge + 4
        bottom = work.y + work.height - h + edge - 4
        if py < work.y + round(32 * SC):
            y = top
        elif py > work.y + work.height - round(32 * SC):
            y = bottom
        else:
            y = max(top, min(int(py) - edge + 8, bottom))
        self.x, self.y = x, y
        win.move(x, y)
        Gtk.Widget.set_opacity(win, 0.0)
        win.present()
        self.grab(gdk_win, w, h)
        started = time.monotonic()

        def fade():
            if self.closing:
                return False
            f = min(1.0, (time.monotonic() - started) / 0.11)
            Gtk.Widget.set_opacity(win, f * f * (3 - 2 * f))
            return f < 1.0
        GLib.timeout_add(16, fade)

    def grab(self, gdk_win, w, h):
        if gdk_win is None:
            return
        seat = Gdk.Display.get_default().get_default_seat()
        seat.grab(gdk_win, Gdk.SeatCapabilities.ALL, True, None, None, None)

        def on_press(_w, e):
            if e.window != gdk_win:
                return False
            edge = round(SHADOW * SC)
            if not (edge < e.x < w - edge and edge < e.y < h - edge):
                self.close()
                return True
            return False
        self.win.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
        self.win.connect('button-press-event', on_press)

    @property
    def pixel_height(self):
        return round(self.height * SC) + 2 * round(SHADOW * SC)

    def reposition(self):
        if self.geo is None:
            return
        y, bottom = self.y, self.geo.y + self.geo.height
        h = self.pixel_height
        if y + h > bottom:
            y = max(self.geo.y, bottom - h)
        self.win.move(self.x, y)

    def close(self):
        if self.closing:
            return
        self.closing = True
        try:
            Gdk.Display.get_default().get_default_seat().ungrab()
        except Exception:
            pass
        Gtk.main_quit()


def single_instance():
    os.makedirs(os.path.dirname(PIDFILE), exist_ok=True)
    try:
        pid = int(read_file(PIDFILE, '0'))
    except ValueError:
        pid = 0
    if pid and pid != os.getpid():
        try:
            with open(f'/proc/{pid}/cmdline', 'rb') as handle:
                ours = b'cpu-menu' in handle.read()
        except OSError:
            ours = False
        if ours:
            try:
                os.kill(pid, signal.SIGTERM)
                return False
            except OSError:
                pass
    with open(PIDFILE, 'w') as handle:
        handle.write(str(os.getpid()))
    return True


def pointer_xy():
    if PTR_XY is not None:
        return PTR_XY
    _s, x, y = (Gdk.Display.get_default().get_default_seat()
                .get_pointer().get_position())
    return int(x), int(y)


def main():
    if not single_instance():
        return
    px, py = pointer_xy()
    menu = Menu()
    signal.signal(signal.SIGTERM, lambda *_a: menu.close())
    menu.place(int(px), int(py))
    if os.environ.get('MINTBOOK_CPU_TIME'):
        print(f'{(time.monotonic() - T0) * 1000:.0f} ms to on screen',
              file=sys.stderr)
    Gtk.main()


if __name__ == '__main__':
    Gdk.set_program_class('mintbook-cpu-menu')
    try:
        main()
    finally:
        try:
            if read_file(PIDFILE) == str(os.getpid()):
                os.remove(PIDFILE)
        except OSError:
            pass
    sys.exit(0)
