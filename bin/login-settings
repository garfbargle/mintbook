#!/usr/bin/env python3
"""Wallpaper — one picture for light, one for dark, on the desktop and the
login screen together.

The background lives in /etc/lightdm/slick-greeter.conf, which is root-owned,
and the greeter reads it as the `lightdm` user, which cannot enter a 0750 home
directory. Both of those are real, and neither is the user's problem: this
window offers pictures and hands the choice to
/usr/local/sbin/mintbook-login-apply through pkexec, which does the copying and
the authorisation. See docs/login.md.

Drawn in cairo on the same glass as Control Center and the battery window, for
the same reason: it has to sit on WhiteSur without inheriting it.
"""
import hashlib
import math
import os
import signal
import subprocess
import sys
import threading
import time

HOME = os.path.expanduser('~')
CONF = os.environ.get('MINTBOOK_GREETER_CONF', '/etc/lightdm/slick-greeter.conf')
APPLY = '/usr/local/sbin/mintbook-login-apply'
APPLIED = f'{HOME}/.config/mintbook/appearance.applied'
PIDFILE = f'{HOME}/.cache/mintbook/login-settings.pid'
SLOT_FILE = f'{HOME}/.config/mintbook/wallpaper.%s'
# Next to this script, whether that is the checkout or ~/.local/bin: realpath
# resolves the symlink the installer leaves, so both find the same one.
WALLPAPER_MODE = os.path.join(os.path.dirname(os.path.realpath(__file__)),
                              'wallpaper-mode')
THUMBS = f'{HOME}/.cache/mintbook/login/thumbs'
DESKTOP_XML = (f'{HOME}/.config/xfce4/xfconf/xfce-perchannel-xml/'
               'xfce4-desktop.xml')

SC = 1.0                       # resolved from the desktop when the window opens
W, PAD, SHADOW, RADIUS = 640, 18, 18, 20
HERO_H = 200                   # the selected picture, at the panel's 16:10
PAIR_W, PAIR_H = 142, 62       # a light half and a dark half, side by side
COLS, TILE_W, TILE_H, GAP = 4, 142, 89, 12
GRID_H = TILE_H * 2 + GAP + 6  # two rows visible; the rest scrolls

# The popup glass, hardcoded the way every other mintbook popup hardcodes it —
# canonical values in config/theme/mintbook-glass.ini, generated by
# bin/palette-generate. A window that must parse a file before it can paint is
# a window that can fail to paint.
LIGHT = {  # generated by bin/palette-generate
    'top': (229, 231, 234, 0.980392),
    'bottom': (202, 205, 210, 0.968627),
    'edge': (255, 255, 255, 0.74902),
    'rim': (65, 68, 74, 0.180392),
    'fg': (45, 48, 54),
    'tile': (255, 255, 255, 0.54902),
    'tile_hi': (255, 255, 255, 0.780392),
    'tile_edge': (255, 255, 255, 0.65098),
    'hair': (65, 68, 74, 0.121569),
    'seg': (65, 68, 74, 0.101961),
    'seg_on': (255, 255, 255, 0.94902),
    'blue': (0, 122, 255),
    'red': (255, 59, 48),
    'green': (52, 199, 89),
}
DARK = {  # generated by bin/palette-generate
    'top': (104, 109, 119, 0.976471),
    'bottom': (74, 78, 86, 0.968627),
    'edge': (255, 255, 255, 0.180392),
    'rim': (0, 0, 0, 0.34902),
    'fg': (255, 255, 255),
    'tile': (255, 255, 255, 0.129412),
    'tile_hi': (255, 255, 255, 0.2),
    'tile_edge': (255, 255, 255, 0.101961),
    'hair': (255, 255, 255, 0.121569),
    'seg': (0, 0, 0, 0.2),
    'seg_on': (255, 255, 255, 0.278431),
    'blue': (10, 132, 255),
    'red': (255, 69, 58),
    'green': (48, 209, 88),
}

# Where pictures come from. Order is deliberate: the wallpaper you are already
# looking at, then the ones the system ships, then your own.
PICTURE_DIRS = (
    '/usr/share/backgrounds/linuxmint-wallpapers',
    '/usr/share/xfce4/backdrops',
    '/usr/share/backgrounds/xfce',
    f'{HOME}/Pictures',
)
EXTS = ('.jpg', '.jpeg', '.png', '.webp', '.bmp')

# Pairs that already live on the disk, chosen by measuring rather than by name:
# mean luminance across the whole Mint set, keeping each pair to one
# photographer so the two halves look like the same machine at two times of
# day. The numbers are the light half and the dark half.
MINT = '/usr/share/backgrounds/linuxmint-wallpapers'
PAIRS = (
    ('Silver', f'{MINT}/mfakurian_silver.jpg', f'{MINT}/mfakurian_order.jpg'),     # 193 / 21
    ('Gold', f'{MINT}/jpanchal_gold.jpg', f'{MINT}/jpanchal_waves.jpg'),           # 163 / 28
    ('Sweets', f'{MINT}/rapciu_sweets.png', f'{MINT}/rapciu_pearl.png'),           # 188 / 91
    ('Snow', f'{MINT}/sjohnson_snow.jpg', f'{MINT}/sjohnson_sphere.jpg'),          # 104 / 50
)


def read_file(path, default=''):
    try:
        return open(path).read().strip()
    except OSError:
        return default


def conf_get(key, default=''):
    """One key out of the greeter's config. World-readable, unlike its home."""
    try:
        for line in open(CONF):
            if line.startswith(f'{key}='):
                return line.split('=', 1)[1].strip()
    except OSError:
        pass
    return default


def desktop_wallpaper():
    import re
    m = re.search(r'name="last-image" type="string" value="([^"]*)"',
                  read_file(DESKTOP_XML))
    return m.group(1) if m else ''


def gather():
    """Every candidate picture, de-duplicated, existing, in source order."""
    seen, out = set(), []

    def add(path, label):
        path = os.path.realpath(path)
        if path in seen or not os.path.isfile(path):
            return
        seen.add(path)
        out.append((path, label))

    current = conf_get('background')
    if current.startswith('/'):
        add(current, 'Current')
    add(desktop_wallpaper(), 'Desktop')
    for d in PICTURE_DIRS:
        try:
            names = sorted(os.listdir(d))
        except OSError:
            continue
        for n in names:
            if n.lower().endswith(EXTS):
                add(os.path.join(d, n), '')
    return out


def load_scaled(path, w, h):
    """A PNG at the size it will be drawn, cached. Decoding fifty wallpapers
    costs real seconds on this chip, and all of it is paid once — but the hero
    is drawn four times the width of a tile, so it gets its own cache entry
    rather than an upscale of the tile, which is visibly soft."""
    from gi.repository import GdkPixbuf
    w, h = int(w * 2), int(h * 2)               # 2x, so HiDPI has pixels to use
    mtime = os.path.getmtime(path)
    key = hashlib.sha1(f'{path}:{mtime}:{w}x{h}'.encode()).hexdigest()
    cached = os.path.join(THUMBS, f'{key}.png')
    if os.path.exists(cached):
        try:
            return GdkPixbuf.Pixbuf.new_from_file(cached)
        except Exception:
            pass
    pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, w, h, False)
    os.makedirs(THUMBS, exist_ok=True)
    try:
        pb.savev(cached, 'png', [], [])
    except Exception:
        pass
    return pb


def load_thumb(path):
    return load_scaled(path, TILE_W, TILE_H)


def rgba(cr, c, alpha=1.0):
    if len(c) == 4:
        cr.set_source_rgba(c[0] / 255, c[1] / 255, c[2] / 255, c[3] * alpha)
    else:
        cr.set_source_rgba(c[0] / 255, c[1] / 255, c[2] / 255, alpha)


def rrect(cr, x, y, w, h, r):
    r = max(0, min(r, w / 2, h / 2))
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


def text(cr, s, x, y, size, color, alpha=1.0, weight='normal',
         align=None, width=0):
    layout = PangoCairo.create_layout(cr)
    font = Pango.FontDescription(
        'Inter Semi-Bold' if weight == 'bold' else 'Inter')
    font.set_absolute_size(size * SC * Pango.SCALE)
    layout.set_font_description(font)
    layout.set_text(str(s), -1)
    layout.set_ellipsize(Pango.EllipsizeMode.END)
    if width:
        layout.set_width(int(width * SC * Pango.SCALE))
        layout.set_alignment({'center': Pango.Alignment.CENTER,
                              'right': Pango.Alignment.RIGHT}.get(
                                  align, Pango.Alignment.LEFT))
    rgba(cr, color, alpha)
    cr.move_to(x * SC, y * SC)
    PangoCairo.show_layout(cr, layout)
    return [v / SC for v in layout.get_pixel_size()]


def measure(cr, s, size):
    layout = PangoCairo.create_layout(cr)
    font = Pango.FontDescription('Inter')
    font.set_absolute_size(size * SC * Pango.SCALE)
    layout.set_font_description(font)
    layout.set_text(str(s), -1)
    return [v / SC for v in layout.get_pixel_size()]


def paint_cover(cr, pb, x, y, w, h, r):
    """Draw a pixbuf filling the box, cropped rather than squashed — which is
    what the greeter itself does with a background."""
    cr.save()
    rrect(cr, x, y, w, h, r)
    cr.clip()
    pw, ph = pb.get_width(), pb.get_height()
    s = max(w / pw, h / ph)
    cr.translate(x + (w - pw * s) / 2, y + (h - ph * s) / 2)
    cr.scale(s, s)
    Gdk.cairo_set_source_pixbuf(cr, pb, 0, 0)
    cr.paint()
    cr.restore()


class Window:
    def __init__(self):
        override = os.environ.get('MINTBOOK_PREVIEW_APPEARANCE')
        self.mode = (override if override in ('light', 'dark')
                     else ('dark' if read_file(APPLIED, 'light') == 'dark' else 'light'))
        self.colors = DARK if self.mode == 'dark' else LIGHT
        self.pictures = gather()
        self.thumbs = {}
        self.heroes = {}
        self.hero_pending = set()
        self.status = ''
        self.busy = False
        self.scroll = 0.0
        self.scroll_to = 0.0
        self.gliding = False
        self.hit = None

        self.installed = os.path.exists(CONF)
        # Two pictures, not one. The appearance switch picks between them; this
        # window is where each is chosen, and the segment says which one you
        # are looking at rather than what the greeter's theme is.
        self.slots = {}
        for mode in ('light', 'dark'):
            stored = read_file(SLOT_FILE % mode)
            if not stored:
                # Nothing chosen yet: fall back to what is already on screen,
                # so the window opens showing the truth rather than blanks.
                stored = (conf_get('background') if mode == self.mode else '') \
                    or desktop_wallpaper()
            self.slots[mode] = (os.path.realpath(stored)
                                if stored.startswith('/') and os.path.isfile(stored) else '')
        # Open on the appearance you are actually in.
        self.slot = self.mode
        if not self.installed:
            self.status = 'Login screen not installed — sudo bin/login-install'

        self.pairs = [(name, lt, dk) for name, lt, dk in PAIRS
                      if os.path.isfile(lt) and os.path.isfile(dk)]
        rows = max(1, math.ceil(max(1, len(self.pictures) + 1) / COLS))
        self.grid_full_h = rows * TILE_H + (rows - 1) * GAP
        self.h = (PAD + 30 + 8 + HERO_H + 16 + 34 + 16 + PAIR_H + 20
                  + GRID_H + 16 + 36 + PAD)

        self.win = win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
        win.set_title('Login Screen')
        win.set_decorated(False)
        win.set_resizable(False)
        win.set_app_paintable(True)
        win.set_position(Gtk.WindowPosition.CENTER)
        visual = Gdk.Screen.get_default().get_rgba_visual()
        if visual:
            win.set_visual(visual)
        win.connect('draw', self.draw_background)
        win.connect('key-press-event', self.on_key)
        win.connect('destroy', Gtk.main_quit)

        self.area = Gtk.DrawingArea()
        self.area.add_events(Gdk.EventMask.BUTTON_PRESS_MASK
                             | Gdk.EventMask.POINTER_MOTION_MASK
                             | Gdk.EventMask.SCROLL_MASK
                             | Gdk.EventMask.SMOOTH_SCROLL_MASK
                             | Gdk.EventMask.LEAVE_NOTIFY_MASK)
        self.area.connect('draw', self.on_draw)
        self.area.connect('button-press-event', self.on_press)
        self.area.connect('motion-notify-event', self.on_motion)
        self.area.connect('scroll-event', self.on_scroll)
        self.area.connect('leave-notify-event', lambda *_a: self.set_hit(None))
        self.area.set_size_request(round(W * SC), round(self.h * SC))
        box = Gtk.Box()
        for setter in (box.set_margin_top, box.set_margin_bottom,
                       box.set_margin_start, box.set_margin_end):
            setter(round(SHADOW * SC))
        box.pack_start(self.area, False, False, 0)
        win.add(box)
        Gtk.Widget.set_opacity(win, 0.0)
        win.show_all()
        t0 = time.monotonic()

        def fade():
            f = min(1.0, (time.monotonic() - t0) / 0.095)
            Gtk.Widget.set_opacity(win, f * f * (3 - 2 * f))
            return f < 1.0

        GLib.timeout_add(16, fade)
        threading.Thread(target=self.load_thumbs, daemon=True).start()

    # ---------------------------------------------------------------- data

    def load_thumbs(self):
        for path, _label in self.pictures:
            try:
                pb = load_thumb(path)
            except Exception:
                pb = None
            self.thumbs[path] = pb
            GLib.idle_add(self.area.queue_draw)

    @property
    def selected(self):
        return self.slots.get(self.slot, '')

    def hero_pixbuf(self):
        """The big one, at its own resolution. Falls back to the tile while the
        full-size decode is still running, so the hero is never empty."""
        path = self.selected
        if not path:
            return None
        if path in self.heroes:
            return self.heroes[path]
        if path not in self.hero_pending:
            self.hero_pending.add(path)

            def load():
                try:
                    pb = load_scaled(path, W - 2 * PAD, HERO_H)
                except Exception:
                    pb = None
                def done():
                    self.heroes[path] = pb
                    self.hero_pending.discard(path)
                    self.area.queue_draw()
                    return False
                GLib.idle_add(done)
            threading.Thread(target=load, daemon=True).start()
        return self.thumbs.get(path)

    def apply(self):
        if self.busy:
            return
        if not os.access(WALLPAPER_MODE, os.X_OK):
            self.status = f'{WALLPAPER_MODE} is missing'
            self.area.queue_draw()
            return
        self.busy = True
        self.status = 'Applying…'
        self.area.queue_draw()

        def run():
            # Both halves are stored; only the live one touches the screen and
            # the login screen, which is what makes it safe to choose the other
            # half at any hour. wallpaper-mode owns that rule, not this window.
            rc, err = 0, ''
            for mode in ('light', 'dark'):
                picture = self.slots.get(mode)
                if not picture:
                    continue
                try:
                    p = subprocess.run(
                        [WALLPAPER_MODE, '--set', mode, picture],
                        capture_output=True, text=True, timeout=120)
                    if p.returncode != 0:
                        rc, err = p.returncode, (p.stderr or '').strip()
                except Exception as e:                   # noqa: BLE001
                    rc, err = -1, str(e)
            # 126 is polkit's "you said no", which is an answer rather than a
            # failure, and should not be shouted about in red.
            if rc == 0:
                msg = 'Applied. The login screen follows at the next lock.'
            elif rc == 126:
                msg = 'Cancelled.'
            else:
                msg = f'Could not apply: {err or "see the journal"}'

            def done():
                self.busy = False
                self.status = msg
                if not self.installed:
                    self.status += '  (login screen not installed)'
                self.area.queue_draw()
                return False
            GLib.idle_add(done)
        threading.Thread(target=run, daemon=True).start()

    def choose_file(self):
        dialog = Gtk.FileChooserDialog(
            title='Choose a picture', transient_for=self.win,
            action=Gtk.FileChooserAction.OPEN)
        dialog.add_buttons('Cancel', Gtk.ResponseType.CANCEL,
                           'Choose', Gtk.ResponseType.ACCEPT)
        dialog.set_current_folder(f'{HOME}/Pictures')
        f = Gtk.FileFilter()
        f.set_name('Pictures')
        for ext in EXTS:
            f.add_pattern(f'*{ext}')
            f.add_pattern(f'*{ext.upper()}')
        dialog.add_filter(f)
        if dialog.run() == Gtk.ResponseType.ACCEPT:
            path = os.path.realpath(dialog.get_filename() or '')
            if path and os.path.isfile(path):
                if path not in dict(self.pictures):
                    self.pictures.insert(0, (path, 'Chosen'))
                    rows = max(1, math.ceil((len(self.pictures) + 1) / COLS))
                    self.grid_full_h = rows * TILE_H + (rows - 1) * GAP
                    threading.Thread(target=self.load_thumbs, daemon=True).start()
                self.slots[self.slot] = path
                self.status = ''
        dialog.destroy()
        self.area.queue_draw()

    # ------------------------------------------------------------ geometry

    def layout(self):
        """Every clickable box, in logical pixels. One source of truth for
        both the drawing and the hit testing."""
        y = PAD + 30 + 8
        hero = (PAD, y, W - 2 * PAD, HERO_H)
        y += HERO_H + 16
        seg_w = 190
        seg = (PAD, y, seg_w, 34)
        apply_w = 168
        apply_box = (W - PAD - apply_w, y, apply_w, 34)
        y += 34 + 16
        pairs = (PAD, y, W - 2 * PAD, PAIR_H)
        y += PAIR_H + 20
        grid = (PAD, y, W - 2 * PAD, GRID_H)
        y += GRID_H + 16
        status = (PAD, y, W - 2 * PAD, 36)
        return {'hero': hero, 'seg': seg, 'apply': apply_box, 'pairs': pairs,
                'grid': grid, 'status': status,
                'close': (W - PAD - 24, PAD - 4, 26, 26)}

    def tiles(self):
        """(index, x, y, path, label) for every tile, grid coordinates."""
        gx, gy, _gw, _gh = self.layout()['grid']
        items = [(None, 'Choose…')] + list(self.pictures)
        for i, (path, label) in enumerate(items):
            col, row = i % COLS, i // COLS
            x = gx + col * (TILE_W + GAP)
            y = gy + row * (TILE_H + GAP) - self.scroll
            yield i, x, y, path, label

    def hit_test(self, mx, my):
        box = self.layout()
        for name in ('close', 'seg', 'apply'):
            x, y, w, h = box[name]
            if x <= mx <= x + w and y <= my <= y + h:
                if name == 'seg':
                    return ('appearance', 'dark' if mx > x + w / 2 else 'light')
                return (name, None)
        px, py, _pw, _ph = box['pairs']
        for i in range(len(self.pairs)):
            x = px + i * (PAIR_W + GAP)
            if x <= mx <= x + PAIR_W and py <= my <= py + PAIR_H:
                return ('pair', i)
        gx, gy, gw, gh = box['grid']
        if gx <= mx <= gx + gw and gy <= my <= gy + gh:
            for i, x, y, path, _label in self.tiles():
                if x <= mx <= x + TILE_W and y <= my <= y + TILE_H:
                    return ('tile', i)
        return None

    # -------------------------------------------------------------- events

    @property
    def max_scroll(self):
        return max(0.0, self.grid_full_h - GRID_H)

    def set_hit(self, hit):
        if hit != self.hit:
            self.hit = hit
            self.area.queue_draw()

    def on_motion(self, _w, e):
        self.set_hit(self.hit_test(e.x / SC, e.y / SC))

    def on_press(self, _w, e):
        if e.button != 1:
            return False
        mx, my = e.x / SC, e.y / SC
        hit = self.hit_test(mx, my)
        if not hit:
            if my < PAD + 38:
                self.win.begin_move_drag(e.button, int(e.x_root), int(e.y_root), e.time)
            return True
        kind, value = hit
        if kind == 'appearance':
            self.slot = value
        elif kind == 'close':
            self.win.destroy()
            return True
        elif kind == 'apply':
            self.apply()
        elif kind == 'tile':
            items = [(None, 'Choose…')] + list(self.pictures)
            path = items[value][0]
            if path is None:
                self.choose_file()
                return True
            self.slots[self.slot] = path
            self.status = ''
        elif kind == 'pair':
            _name, light, dark = self.pairs[value]
            self.slots['light'], self.slots['dark'] = light, dark
            self.status = ''
        self.area.queue_draw()
        return True

    def glide(self, delta):
        target = max(0.0, min(self.scroll_to + delta, self.max_scroll))
        if target == self.scroll_to:
            return
        self.scroll_to = target
        if not self.gliding:
            self.gliding = True
            GLib.timeout_add(16, self._step_glide)

    def _step_glide(self):
        gap = self.scroll_to - self.scroll
        if abs(gap) < 0.6:
            self.scroll = self.scroll_to
            self.gliding = False
            self.area.queue_draw()
            return False
        self.scroll += gap * 0.28
        self.area.queue_draw()
        return True

    def on_scroll(self, _w, e):
        dy = 0.0
        if e.direction == Gdk.ScrollDirection.UP:
            dy = -TILE_H / 2
        elif e.direction == Gdk.ScrollDirection.DOWN:
            dy = TILE_H / 2
        elif e.direction == Gdk.ScrollDirection.SMOOTH:
            dy = e.delta_y * TILE_H / 2
        self.glide(dy)
        return True

    def on_key(self, _w, e):
        name = Gdk.keyval_name(e.keyval)
        if name in ('Escape', 'q'):
            self.win.destroy()
        elif name in ('Return', 'KP_Enter'):
            self.apply()
        elif name == '1':
            self.slot = 'light'
            self.area.queue_draw()
        elif name == '2':
            self.slot = 'dark'
            self.area.queue_draw()
        elif name in ('Down', 'Up'):
            self.glide((TILE_H + GAP) * (1 if name == 'Down' else -1))
        elif name in ('Page_Down', 'Page_Up'):
            self.glide(GRID_H * (1 if name == 'Page_Down' else -1))
        elif name in ('Home', 'End'):
            self.glide(-self.max_scroll if name == 'Home' else self.max_scroll)
        return True

    # ------------------------------------------------------------- drawing

    def draw_background(self, _w, cr):
        a = self.win.get_allocation()
        cr.save()
        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.set_source_rgba(0, 0, 0, 0)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)
        cr.scale(SC, SC)
        x = y = SHADOW
        w, h = a.width / SC - 2 * SHADOW, a.height / SC - 2 * SHADOW
        for i in range(SHADOW, 0, -1):
            rrect(cr, x - i, y - i + 2, w + 2 * i, h + 2 * i, RADIUS + i)
            cr.set_line_width(1.4)
            cr.set_source_rgba(0, 0, 0, 0.06 * (1 - i / SHADOW) ** 2)
            cr.stroke()
        grad = cairo.LinearGradient(0, y, 0, y + h)
        top, bottom = self.colors['top'], self.colors['bottom']
        grad.add_color_stop_rgba(0, top[0] / 255, top[1] / 255, top[2] / 255, top[3])
        grad.add_color_stop_rgba(1, bottom[0] / 255, bottom[1] / 255,
                                 bottom[2] / 255, bottom[3])
        rrect(cr, x, y, w, h, RADIUS)
        cr.set_source(grad)
        cr.fill_preserve()
        rgba(cr, self.colors['rim'])
        cr.set_line_width(1)
        cr.stroke()
        rrect(cr, x + 0.75, y + 0.75, w - 1.5, h - 1.5, RADIUS - 0.75)
        rgba(cr, self.colors['edge'])
        cr.set_line_width(1)
        cr.stroke()
        cr.restore()
        return False

    def on_draw(self, _w, cr):
        cr.set_antialias(cairo.ANTIALIAS_BEST)
        c = self.colors
        text(cr, 'Wallpaper', PAD, PAD, 15, c['fg'], weight='bold')
        text(cr, 'The desktop and the login screen. One picture for light, one for dark.',
             PAD, PAD + 19, 10.5, c['fg'], 0.55)

        box = self.layout()
        self.draw_close(cr, *box['close'])
        self.draw_hero(cr, *box['hero'])
        self.draw_segment(cr, *box['seg'])
        self.draw_apply(cr, *box['apply'])
        self.draw_pairs(cr, *box['pairs'])
        self.draw_grid(cr, *box['grid'])
        self.draw_status(cr, *box['status'])
        return False

    def draw_close(self, cr, x, y, w, h):
        c = self.colors
        cx, cy = (x + w / 2) * SC, (y + h / 2) * SC
        if self.hit and self.hit[0] == 'close':
            cr.arc(cx, cy, 13 * SC, 0, 2 * math.pi)
            rgba(cr, c['fg'], 0.10)
            cr.fill()
        rgba(cr, c['fg'], 0.55)
        cr.set_line_width(1.6 * SC)
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        for dx, dy in ((-1, -1), (-1, 1)):
            cr.move_to(cx + dx * 5 * SC, cy + dy * 5 * SC)
            cr.line_to(cx - dx * 5 * SC, cy - dy * 5 * SC)
        cr.stroke()

    def draw_hero(self, cr, x, y, w, h):
        c = self.colors
        x, y, w, h = x * SC, y * SC, w * SC, h * SC
        pb = self.hero_pixbuf()
        if pb is not None:
            paint_cover(cr, pb, x, y, w, h, 14 * SC)
        else:
            rrect(cr, x, y, w, h, 14 * SC)
            rgba(cr, c['tile'])
            cr.fill()
            text(cr, 'No picture — the greeter shows a flat colour',
                 PAD, (y / SC) + h / SC / 2 - 7, 11, c['fg'], 0.6,
                 align='center', width=w / SC)
        rrect(cr, x + 0.5, y + 0.5, w - 1, h - 1, 14 * SC)
        rgba(cr, c['rim'])
        cr.set_line_width(1)
        cr.stroke()
        if self.selected:
            label = os.path.basename(self.selected)
            pad = 8 * SC
            tw, th = measure(cr, label, 10.5)
            bw, bh = tw * SC + pad * 2, th * SC + pad
            rrect(cr, x + 10 * SC, y + h - bh - 10 * SC, bw, bh, 8 * SC)
            cr.set_source_rgba(0, 0, 0, 0.45)
            cr.fill()
            text(cr, label, (x + 10 * SC + pad) / SC,
                 (y + h - bh - 10 * SC + pad / 2) / SC, 10.5, (255, 255, 255))

    def draw_segment(self, cr, x, y, w, h):
        c = self.colors
        rrect(cr, x * SC, y * SC, w * SC, h * SC, 9 * SC)
        rgba(cr, c['seg'])
        cr.fill()
        for i, (key, label) in enumerate((('light', 'Light'), ('dark', 'Dark'))):
            sw = w / 2
            sx = x + i * sw
            live = key == self.mode
            if self.slot == key:
                rrect(cr, (sx + 2) * SC, (y + 2) * SC, (sw - 4) * SC,
                      (h - 4) * SC, 7 * SC)
                rgba(cr, c['seg_on'])
                cr.fill()
            elif self.hit == ('appearance', key):
                rrect(cr, (sx + 2) * SC, (y + 2) * SC, (sw - 4) * SC,
                      (h - 4) * SC, 7 * SC)
                rgba(cr, c['fg'], 0.07)
                cr.fill()
            text(cr, label + (' •' if live else ''), sx, y + h / 2 - 8, 11.5,
                 c['fg'], 1.0 if self.slot == key else 0.65,
                 weight='bold' if self.slot == key else 'normal',
                 align='center', width=sw)

    def draw_apply(self, cr, x, y, w, h):
        c = self.colors
        hot = self.hit and self.hit[0] == 'apply'
        enabled = not self.busy
        rrect(cr, x * SC, y * SC, w * SC, h * SC, 9 * SC)
        rgba(cr, c['blue'], 1.0 if enabled and hot else 0.85 if enabled else 0.35)
        cr.fill()
        text(cr, 'Applying…' if self.busy else 'Use this pair',
             x, y + h / 2 - 8, 11.5, (255, 255, 255), 1.0 if enabled else 0.7,
             weight='bold', align='center', width=w)

    def draw_pairs(self, cr, x, y, w, _h):
        """Ready-made pairs: a light half and a dark half of one picture set,
        so choosing both is one click rather than two searches."""
        c = self.colors
        text(cr, 'Pairs', x, y - 15, 10, c['fg'], 0.5, weight='bold')
        for i, (name, light, dark) in enumerate(self.pairs):
            tx = x + i * (PAIR_W + GAP)
            sx, sy = tx * SC, y * SC
            tw, th = PAIR_W * SC, PAIR_H * SC
            chosen = (self.slots.get('light') == os.path.realpath(light)
                      and self.slots.get('dark') == os.path.realpath(dark))
            for half, path in ((0, light), (1, dark)):
                pb = self.thumbs.get(os.path.realpath(path))
                cr.save()
                rrect(cr, sx, sy, tw, th, 9 * SC)
                cr.clip()
                cr.rectangle(sx + half * tw / 2, sy, tw / 2, th)
                cr.clip()
                if pb is not None:
                    paint_cover(cr, pb, sx, sy, tw, th, 0)
                else:
                    rgba(cr, c['tile'], 0.6)
                    cr.paint()
                cr.restore()
            cr.save()
            cr.set_source_rgba(0, 0, 0, 0.45)
            text(cr, name, tx + 8.5, y + PAIR_H - 19.5, 9.5, (0, 0, 0), 0.5,
                 weight='bold')
            cr.restore()
            text(cr, name, tx + 8, y + PAIR_H - 20, 9.5, (255, 255, 255), 0.98,
                 weight='bold')
            rrect(cr, sx + 0.5, sy + 0.5, tw - 1, th - 1, 9 * SC)
            rgba(cr, c['rim'], 0.8)
            cr.set_line_width(1)
            cr.stroke()
            if chosen or self.hit == ('pair', i):
                rrect(cr, sx - 2 * SC, sy - 2 * SC, tw + 4 * SC, th + 4 * SC,
                      11 * SC)
                rgba(cr, c['blue'], 1.0 if chosen else 0.45)
                cr.set_line_width(2.5 * SC)
                cr.stroke()

    def draw_grid(self, cr, x, y, w, h):
        c = self.colors
        cr.save()
        cr.rectangle(x * SC, y * SC, w * SC, h * SC)
        cr.clip()
        for i, tx, ty, path, label in self.tiles():
            if ty + TILE_H < y - 1 or ty > y + h + 1:
                continue                                   # off-screen: skip
            sx, sy = tx * SC, ty * SC
            tw, th = TILE_W * SC, TILE_H * SC
            hot = self.hit == ('tile', i)
            chosen = path is not None and path == self.selected
            if path is None:
                rrect(cr, sx, sy, tw, th, 10 * SC)
                rgba(cr, c['tile_hi'] if hot else c['tile'])
                cr.fill()
                text(cr, '＋', tx, ty + TILE_H / 2 - 18, 20, c['fg'], 0.7,
                     align='center', width=TILE_W)
                text(cr, 'Choose…', tx, ty + TILE_H - 26, 10.5, c['fg'], 0.7,
                     align='center', width=TILE_W)
            else:
                pb = self.thumbs.get(path)
                if pb is not None:
                    paint_cover(cr, pb, sx, sy, tw, th, 10 * SC)
                else:
                    rrect(cr, sx, sy, tw, th, 10 * SC)
                    rgba(cr, c['tile'], 0.6)
                    cr.fill()
                if label:
                    text(cr, label, tx + 7, ty + 6, 9.5, (255, 255, 255), 0.95,
                         weight='bold')
            rrect(cr, sx + 0.5, sy + 0.5, tw - 1, th - 1, 10 * SC)
            rgba(cr, c['rim'], 0.8)
            cr.set_line_width(1)
            cr.stroke()
            if chosen or (hot and path is not None):
                rrect(cr, sx - 2 * SC, sy - 2 * SC, tw + 4 * SC, th + 4 * SC,
                      12 * SC)
                rgba(cr, c['blue'], 1.0 if chosen else 0.45)
                cr.set_line_width(2.5 * SC)
                cr.stroke()
        cr.restore()
        if self.grid_full_h > GRID_H:                      # a hint that it scrolls
            frac = GRID_H / self.grid_full_h
            bar_h = max(24, h * frac)
            top = y + (h - bar_h) * (self.scroll /
                                     max(1e-6, self.grid_full_h - GRID_H))
            rrect(cr, (x + w + 4) * SC, top * SC, 3 * SC, bar_h * SC, 1.5 * SC)
            rgba(cr, c['fg'], 0.22)
            cr.fill()

    def draw_status(self, cr, x, y, w, _h):
        c = self.colors
        cr.move_to(x * SC, (y - 8) * SC)
        cr.line_to((x + w) * SC, (y - 8) * SC)
        rgba(cr, c['hair'])
        cr.set_line_width(1)
        cr.stroke()
        if self.status:
            bad = self.status.startswith(('Could not', 'Not installed')) or \
                APPLY in self.status
            text(cr, self.status, x, y, 11, c['red'] if bad else c['fg'],
                 1.0 if bad else 0.72, width=w)
        else:
            light = os.path.basename(self.slots.get('light') or '—')
            dark = os.path.basename(self.slots.get('dark') or '—')
            text(cr, f'Light  {light}      Dark  {dark}', x, y, 11, c['fg'],
                 0.6, width=w)


def single_instance():
    sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
    from mintbook_instance import claim
    return claim(PIDFILE, 'login-settings', signal.SIGTERM)


def main():
    global Gtk, Gdk, GLib, Pango, PangoCairo, cairo, SC
    if not single_instance():
        return 0
    os.environ.setdefault('GTK_THEME', 'Adwaita')
    import gi
    gi.require_version('Gtk', '3.0')
    gi.require_version('PangoCairo', '1.0')
    gi.require_version('GdkPixbuf', '2.0')
    import cairo
    from gi.repository import Gtk, Gdk, GLib, Pango, PangoCairo
    if Gdk.Screen.get_default() is None:
        raise SystemExit('No desktop display.')
    # MINTBOOK_SCALE exists so the layout can be checked at this panel's real
    # 1.75 from a nested display, which has no XSETTINGS manager to ask.
    SC = round((Gdk.Screen.get_default().get_resolution() or 96) / 96.0, 3) or 1.0
    SC = float(os.environ.get('MINTBOOK_SCALE') or SC)
    Gdk.set_program_class('mintbook-login-settings')
    win = Window()
    signal.signal(signal.SIGTERM, lambda *_a: GLib.idle_add(win.win.destroy))
    try:
        Gtk.main()
    finally:
        try:
            if read_file(PIDFILE) == str(os.getpid()):
                os.unlink(PIDFILE)
        except OSError:
            pass
    return 0


if __name__ == '__main__':
    sys.exit(main())
