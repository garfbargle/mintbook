#!/usr/bin/env bash
# turbo-budget — cap the sustained, not the burst.
#
# Measured (bin/burst-probe, docs/feel.md): the battery cap costs +241 ms on a
# ~1 s single-core task, +36.5%, with the two arms not overlapping. Measured
# earlier (docs/hardware.md): under *sustained* load an uncapped chassis is
# slower than a capped one, because it sprints into the 95 C wall and eats
# throttle stalls. Both are true. They are statements about different lengths
# of work.
#
# So: while a cap is in force, run uncapped for the first few seconds of any
# burst, then fall back to that cap and stay there until the machine goes quiet.
# A click gets the whole chip. A compile gets the cap it was always going to get.
#
# No root. Profiles go through /run/mintbook-power/want, the password-free
# channel the panel uses. It stands down whenever nothing is capped, so
# choosing Balanced by hand switches it off.
set -uo pipefail

WANT=/run/mintbook-power/want
PSTATE=/sys/devices/system/cpu/intel_pstate/max_perf_pct

BUDGET=${BUDGET:-8}        # seconds of uncapped time granted per burst
TRIGGER=${TRIGGER:-25}     # % of total CPU that counts as a burst (one core of four)
QUIET=${QUIET:-15}         # % below which the machine counts as gone quiet again
QUIET_FOR=${QUIET_FOR:-8}  # consecutive quiet samples needed to re-arm (8 = 2 s)
COOLDOWN=${COOLDOWN:-45}   # re-arm after this long regardless, so a busy desktop
                           # cannot park the budget in "spent" forever
PERIOD=${PERIOD:-0.25}     # sampling period, seconds
MINGAP=${MINGAP:-3}        # minimum seconds between profile requests

# The cap that belongs to each profile, from bin/power-apply. Kept as a lookup
# so this script can name a profile when all it has read is a percentage.
profile_for() {
  case "$1" in
    70)  echo power-saver ;;
    75)  echo performance ;;
    100) echo balanced ;;
    *)   echo '' ;;
  esac
}

case "${1:-}" in
  -h|--help) sed -n '2,22p' "$0" | sed 's/^# \?//'; exit 0 ;;
  --check)
    read -r pct < "$PSTATE"
    echo "cap:      max_perf_pct=$pct  ($(profile_for "$pct" || echo unknown))"
    echo "channel:  $(test -w "$(dirname "$WANT")" && echo writable || echo 'NOT writable')"
    echo "service:  $(systemctl --user is-enabled mintbook-turbo-budget.service 2>&1) / $(systemctl --user is-active mintbook-turbo-budget.service 2>&1)"
    echo "budget:   ${BUDGET}s uncapped per burst, trigger ${TRIGGER}% CPU, quiet below ${QUIET}%"
    [ "$pct" = 100 ] && echo "state:    standing down — nothing is capped"
    exit 0 ;;
  "") ;;
  *) echo "usage: $0 [--check]" >&2; exit 2 ;;
esac

[ -w "$(dirname "$WANT")" ] || { echo "cannot write $(dirname "$WANT")" >&2; exit 1; }

# This loop runs four times a second for the life of the session, so it forks
# nothing: /proc through the read builtin, time from EPOCHREALTIME, arithmetic
# in bash, and the sleep is a read timeout on a fifo nobody writes to. The most
# expensive software ever found on this machine was a panel plugin that forked
# a Python interpreter twice a tick (docs/desktop.md). Not again.
FIFO=$(mktemp -u "${XDG_RUNTIME_DIR:-/tmp}/turbo-budget.XXXXXX")
mkfifo -m600 "$FIFO"
exec 9<>"$FIFO"
rm -f "$FIFO"
nap() { read -r -t "$1" -u 9 _ || true; }

prev_busy=0 prev_total=0 busy_pct=0
state=normal            # normal | boosted | spent
boost_until=0 last_req=0 spent_at=0 quiet_run=0
baseline_pct=0
mine=""                 # the last profile this script asked for

request() {             # request PROFILE WHY — rate-limited, state-change only
  local p=$1 now=${EPOCHREALTIME%%.*}
  [ -z "$p" ] && return 1
  [ "$p" = "$mine" ] && return 0
  (( now - last_req < MINGAP )) && return 1
  echo "$p" > "$WANT" || return 1
  mine=$p; last_req=$now
  # One journal line per request, from a builtin. Without it the only record is
  # mintbook-power-apply's, which cannot tell this script apart from a click.
  echo "request $p ($2, cpu ${busy_pct}%)"
  return 0
}

cpu_busy() {            # -> busy_pct since the previous call
  local cpu u n s i rest total busy
  read -r cpu u n s i rest < /proc/stat
  total=$(( u + n + s + i ))
  busy=$(( u + n + s ))
  if (( prev_total == 0 || total <= prev_total )); then
    busy_pct=0
  else
    busy_pct=$(( (busy - prev_busy) * 100 / (total - prev_total) ))
  fi
  prev_busy=$busy prev_total=$total
}

restore() { [ -n "$mine" ] && [ "$baseline_pct" != 0 ] && echo "$(profile_for "$baseline_pct")" > "$WANT"; }
trap 'restore; exit 0' TERM INT

echo "turbo-budget: ${BUDGET}s per burst above ${TRIGGER}% CPU, back to the cap after"

while :; do
  nap "$PERIOD"
  cpu_busy
  if (( busy_pct < QUIET )); then quiet_run=$(( quiet_run + 1 )); else quiet_run=0; fi
  read -r pct < "$PSTATE"
  now=${EPOCHREALTIME%%.*}

  # Nothing is capped: there is no burst to give back. Stand down cheaply, and
  # treat a hand-picked profile as the new baseline when one appears.
  if [ "$state" = normal ] && [ "$pct" = 100 ]; then
    baseline_pct=0; mine=""
    nap 2
    continue
  fi
  if [ "$state" = normal ] || [ "$state" = spent ]; then
    baseline_pct=$pct
  fi

  case $state in
    normal)
      if (( busy_pct >= TRIGGER )); then
        if request balanced burst; then
          state=boosted; boost_until=$(( now + BUDGET ))
        fi
      fi ;;
    # A burst is over when the machine has gone quiet by the same rule that
    # re-arms "spent" below, not when one sample dips. The first version ended a
    # boost on a single sample under QUIET and went straight back to normal,
    # skipping the re-arm rule: a desktop hovering around 15-25% then flipped
    # the profile every 3 s (MINGAP) for minutes at a time. docs/feel.md.
    boosted)
      if (( quiet_run >= QUIET_FOR )); then
        request "$(profile_for "$baseline_pct")" 'burst over' && state=normal
      elif (( now >= boost_until )); then
        request "$(profile_for "$baseline_pct")" 'budget spent' && { state=spent; spent_at=$now; }
      fi ;;
    # Re-arming needs the machine to be quiet for a stretch, not for one sample —
    # and it happens anyway after COOLDOWN. A desktop with a live Electron app in
    # it is rarely below 15% for even a moment, and the first version of this
    # parked here permanently because of exactly that.
    spent)
      if (( quiet_run >= QUIET_FOR || now - spent_at >= COOLDOWN )); then
        state=normal
      fi ;;
  esac
done
