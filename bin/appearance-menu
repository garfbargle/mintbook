#!/usr/bin/env python3
"""Small pointer-anchored picker for Mintbook system-chrome appearance."""
import os
import fcntl
import signal
import subprocess
import sys

# The pointer, read before the GTK import rather than after it: this menu hangs
# off the icon that was clicked, and the import is ~590 ms, long enough to click
# and move the mouse on before the old code sampled. Synchronous on purpose —
# as a Popen the child loses the CPU to this process's own import and samples
# too late, which is the bug it was meant to fix. See bin/control-center.
try:
    _p = subprocess.run(['xdotool', 'getmouselocation', '--shell'], capture_output=True, text=True, timeout=3).stdout
    _p = dict(q.split('=', 1) for q in _p.split() if '=' in q)
    PTR_XY = (int(_p['X']), int(_p['Y']))
except Exception: PTR_XY = None

import gi
gi.require_version('Gtk', '3.0')
from gi.repository import Gtk, Gdk

APPLY = os.path.expanduser('~/.local/bin/appearance-mode')
STATE = os.path.expanduser('~/.config/mintbook/appearance.mode')
MODES = (('auto', 'Auto', 'Follow sunset and sunrise'), ('light', 'Light', 'Pearl system chrome'), ('dark', 'Dark', 'Slate system chrome'))
LOCK = os.path.join(os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}'), 'mintbook-appearance-menu.lock')

def pointer_xy(display):
    """Where the pointer was at startup; Gdk now if xdotool is missing."""
    if PTR_XY is not None: return PTR_XY
    _s, x, y = display.get_default_seat().get_pointer().get_position()
    return int(x), int(y)

def current():
    try: return open(STATE).read().strip()
    except OSError: return 'auto'

def claim_instance():
    lock = open(LOCK, 'a+')
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        lock.seek(0)
        try: os.kill(int(lock.read().strip()), signal.SIGTERM)
        except (OSError, ValueError): pass
        return None
    lock.seek(0); lock.truncate(); lock.write(str(os.getpid())); lock.flush()
    return lock

def main():
    lock = claim_instance()
    if lock is None: return
    signal.signal(signal.SIGTERM, lambda *_args: Gtk.main_quit())
    cur = current()
    menu = Gtk.Menu()
    css = Gtk.CssProvider(); css.load_from_data(b'''menu { background:#212124; padding:8px; } menuitem { color:white; border-radius:10px; min-width:150px; padding:8px 12px; } menuitem:hover, menuitem.current { background:rgba(255,255,255,.15); }''')
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    for key, title, sub in MODES:
        item = Gtk.CheckMenuItem(label=title)
        item.set_draw_as_radio(True); item.set_active(key == cur); item.set_tooltip_text(sub)
        if key == cur: item.get_style_context().add_class('current')
        item.connect('activate', lambda _item, m=key: (subprocess.Popen([APPLY, m], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL), Gtk.main_quit()))
        menu.append(item)
    menu.connect('deactivate', lambda _menu: Gtk.main_quit())
    display = Gdk.Display.get_default(); x, y = pointer_xy(display)
    menu.show_all()
    menu.set_size_request(190, 150)
    menu.popup(None, None, lambda _menu, _x, _y, _data: (x - 20, 42 if y < 64 else y + 8, True), None, 0, Gdk.CURRENT_TIME)
    while Gtk.events_pending(): Gtk.main_iteration_do(False)
    menu.queue_draw(); display.flush()
    Gtk.main()

if __name__ == '__main__':
    main(); sys.exit(0)
