#!/usr/bin/env python3
"""Generate embedded Cairo colors from the canonical INI. No runtime I/O."""
import ast
import configparser
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parent.parent
FILES = ('control-center', 'wifi-menu', 'bt-menu', 'battery-menu', 'battery-history',
         'updates-menu', 'mintbook-health', 'system-menu', 'cpu-menu',
         'hud-notify', 'mintdrop-menu', 'mintdrop-accept', 'login-settings')
ALIASES = {'accent': 'Blue'}


def generate(check=False):
    palette = configparser.ConfigParser()
    palette.read(ROOT / 'config/theme/mintbook-glass.ini')
    changed = []
    for name in FILES:
        path = ROOT / 'bin' / name
        source = path.read_text()
        lines = source.splitlines(keepends=True)
        edits = []
        for node in ast.parse(source).body:
            if not isinstance(node, ast.Assign) or len(node.targets) != 1 or not isinstance(node.targets[0], ast.Name):
                continue
            mode = node.targets[0].id
            if mode not in ('LIGHT', 'DARK') or not isinstance(node.value, ast.Dict):
                continue
            values = ast.literal_eval(node.value)
            section = palette['PopupLight' if mode == 'LIGHT' else 'PopupDark']
            for key, old in list(values.items()):
                canonical = ALIASES.get(key, ''.join(part.title() for part in key.split('_')))
                if canonical in section:
                    rgba = [int(v) for v in section[canonical].split(';')]
                    if len(rgba) != 4 or any(v < 0 or v > 255 for v in rgba):
                        raise ValueError(f'Invalid color: {canonical}')
                    values[key] = tuple(rgba[:3]) + ((round(rgba[3] / 255, 6),) if len(old) == 4 else ())
            replacement = mode + ' = {  # generated by bin/palette-generate\n'
            replacement += ''.join(f'    {key!r}: {value!r},\n' for key, value in values.items()) + '}\n'
            edits.append((node.lineno - 1, node.end_lineno, replacement))
        for start, end, replacement in reversed(edits):
            lines[start:end] = [replacement]
        output = ''.join(lines)
        if output != source:
            changed.append(name)
            if not check:
                path.write_text(output)
    if check and changed:
        print('Regenerate palette: ' + ', '.join(changed), file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    if sys.argv[1:] not in ([], ['--check']):
        sys.exit('usage: palette-generate [--check]')
    sys.exit(generate('--check' in sys.argv))
