#!/usr/bin/env bash
# hw-report - live hardware status for this machine. Read-only, no sudo.
# See docs/hardware.md.
set -uo pipefail

hr() { printf '\n=== %s ===\n' "$1"; }

hr "MACHINE"
cat /sys/class/dmi/id/product_name /sys/class/dmi/id/board_name 2>/dev/null
printf 'BIOS %s (%s)\n' "$(cat /sys/class/dmi/id/bios_version 2>/dev/null)" \
                        "$(cat /sys/class/dmi/id/bios_date 2>/dev/null)"
. /etc/os-release 2>/dev/null && echo "$PRETTY_NAME"
echo "kernel $(uname -r)   desktop ${XDG_CURRENT_DESKTOP:-?}/${XDG_SESSION_TYPE:-?}"

hr "CPU / MEM"
lscpu 2>/dev/null | grep -E '^(Model name|CPU\(s\)|Thread|Core)' | sed 's/  */ /g'
free -h | head -2
swapon --show 2>/dev/null | grep . || echo "swap: NONE configured"

hr "DISPLAY"
xrandr 2>/dev/null | grep -E ' connected'
printf 'Xft.DPI=%s  WindowScalingFactor=%s  CursorSize=%s\n' \
  "$(xfconf-query -c xsettings -p /Xft/DPI 2>/dev/null)" \
  "$(xfconf-query -c xsettings -p /Gdk/WindowScalingFactor 2>/dev/null)" \
  "$(xfconf-query -c xsettings -p /Gtk/CursorThemeSize 2>/dev/null)"

hr "STORAGE"
lsblk -o NAME,SIZE,FSTYPE,MOUNTPOINT 2>/dev/null | grep -vE '^loop'

hr "NETWORK"
nmcli -t -f TYPE,STATE,CONNECTION device 2>/dev/null | grep -v '^loopback'
lspci -k 2>/dev/null | grep -A2 -i 'network controller' | grep -E 'Network|driver'

hr "BLUETOOTH"
ls /sys/class/bluetooth/ 2>/dev/null | grep . || echo "NO ADAPTER PRESENT"

hr "WEBCAM"
lspci -nnk -d 14e4:1570 2>/dev/null | sed 's/^/  /' || echo "  (no 14e4:1570)"
ls /dev/video* 2>/dev/null | sed 's/^/  /' || echo "  no /dev/video*"
modinfo facetimehd 2>/dev/null | grep '^filename' || echo "  facetimehd: not installed"
grep -qw intel_iommu=off /proc/cmdline && echo "  intel_iommu=off: yes" || echo "  intel_iommu=off: no"

hr "AUDIO"
cat /proc/asound/cards
echo "(speakers are expected to be silent - see docs/audio.md)"

hr "BATTERY"
upower -i /org/freedesktop/UPower/devices/battery_BAT0 2>/dev/null \
  | grep -E 'state|percentage|capacity|energy-full' \
  | sed 's/^ */  /'
echo "  cycles: $(cat /sys/class/power_supply/BAT0/cycle_count 2>/dev/null)"
echo "  (percentage = charge; capacity = health)"

hr "THERMALS"
sensors 2>/dev/null | grep -E 'Core [0-9]|temp1' | head -5 || echo "(lm-sensors unavailable)"

hr "KERNELS INSTALLED"
ls /boot/vmlinuz-* 2>/dev/null | sed 's|.*vmlinuz-|  |'
echo "  running: $(uname -r)   (6.14 has NO working keyboard/trackpad)"

hr "DKMS"
dkms status 2>/dev/null | grep . || echo "(none installed)"
