#!/usr/bin/env bash
# Battery indicator for xfce4-genmon-plugin, and the sampler behind
# bin/battery-history. See docs/battery.md.
#
# Replaces xfce4-power-manager-plugin (plugin-11), which draws a filled green
# capsule at whatever size GTK feels like, has no percentage that matches the
# rest of this bar, and opens xfce4-power-manager-settings on click.
#
# Bash, not Python, and the reason is in docs/desktop.md: python3 costs 30-50 ms
# to start before it has done anything, and this runs every 5 s forever. The
# whole tick is six sysfs reads and one 1 KB write. The /proc walk that feeds
# the history is the expensive part, and it runs every SAMPLE_EVERY-th tick.
#
#   panel-battery            # a genmon tick
#   panel-battery --sample   # force a history sample (for testing)
#
# The icon is drawn here rather than picked from a set of pre-rendered files
# like wifi/bt, because it has 101 states and a fill width is one integer.
# Coordinates are in half-pixels: viewBox is 2x the width/height attributes, so
# integer arithmetic — all bash has — still lands on half a pixel.
set -u

CONF="$HOME/.config/mintbook/battery.conf"
CACHE="$HOME/.cache/mintbook/battery"
SVG="$CACHE/icon.svg"
STATE="$CACHE/state"
PROCS="$CACHE/procs"
LOG="$CACHE/history"
HLOG="$CACHE/health"
MENU="$HOME/.local/bin/battery-menu"

SHOW_PERCENT=0        # macOS's "Show Percentage"; the menu writes this back
COLOR=traffic         # traffic | mono — mono is the macOS look, ink only
LOW=15                # below this the fill goes red
MID=40                # below this it goes amber
SAMPLE_EVERY=12       # ticks between /proc walks (5 s tick -> 60 s)
HISTORY_DAYS=7        # how much of the log to keep
BAT=BAT0
AC=ADP1
# shellcheck disable=SC1090
[ -r "$CONF" ] && . "$CONF"
# A 0 here is a division by zero on the tick below, and a negative one never
# samples. The config is hand-edited; this is the one value that can break it.
[ "$SAMPLE_EVERY" -ge 1 ] 2>/dev/null || SAMPLE_EVERY=12

B=/sys/class/power_supply/$BAT

# ---------------------------------------------------------------- read state

# No battery at all: say nothing rather than show a dead icon. Same rule the
# control-center plugins follow with `skip = on`.
[ -r "$B/status" ] || exit 0

printf '<click>%s</click>\n<iconclick>%s</iconclick>\n' "$MENU" "$MENU"

# rd <var> <file> <default>. Assigns rather than echoing, because $(r ...) is a
# fork per reading and there are nine of them every five seconds; `read < file`
# is none. That is the whole difference between a 120 ms tick and a 9 ms one.
rd() { local v=''; [ -r "$2" ] && read -r v < "$2"; printf -v "$1" '%s' "${v:-$3}"; }

rd status "$B/status" Unknown
rd reported_pct "$B/capacity" 0
rd now "$B/charge_now" 0
rd full "$B/charge_full" 0
rd design "$B/charge_full_design" 0
rd cur "$B/current_avg" 0; [ "$cur" = 0 ] && rd cur "$B/current_now" 0
rd volt "$B/voltage_now" 0
rd online "/sys/class/power_supply/$AC/online" 1

# This Mac's ACPI battery reports capacity against charge_full_design, so an
# aged pack stops around its health percentage even when status says Full.
# A user-facing state of charge is charge_now against the pack's present
# charge_full. Keep capacity only as the fallback for batteries that do not
# expose those counters, and make the driver's authoritative Full state 100.
pct=$reported_pct
if [ "$full" -gt 0 ] && [ "$now" -ge 0 ] 2>/dev/null; then
  pct=$(( (now * 100 + full / 2) / full ))
fi
[ "$status" = Full ] && pct=100
[ "$pct" -gt 100 ] 2>/dev/null && pct=100
[ "$pct" -lt 0 ] 2>/dev/null && pct=0

# Milliwatts. uA x uV is 1.3e13 here — well inside bash's 64-bit ints.
mw=$(( cur * volt / 1000000000 ))

case "$status" in
  Charging)    st=C ;;
  Full)        st=F ;;
  Discharging) st=D ;;
  *)           st=$([ "$online" = 1 ] && echo F || echo U) ;;
esac

# Time to empty, or to full. current_avg reads 0 for a while after a state
# change and right after resume; an estimate from a zero is not an estimate.
eta=''
if [ "$cur" -gt 0 ] 2>/dev/null; then
  case "$st" in
    D) mins=$(( now * 60 / cur )) ;;
    C) mins=$(( (full - now) * 60 / cur )) ;;
    *) mins=-1 ;;
  esac
  if [ "$mins" -ge 0 ] && [ "$mins" -lt 6000 ]; then
    if [ "$mins" -ge 60 ]; then eta=$(( mins / 60 ))h\ $(( mins % 60 ))m
    else eta=${mins}m; fi
  fi
fi

# ------------------------------------------------------------------ the icon

PANEL_FOREGROUND='#ffffff'
# Sourced, not grepped: an older bin/appearance-mode wrote this with printf %q,
# so '#ffffff' is on disk as '\#ffffff' and only the shell gives it back whole.
# An SVG with stroke="\#ffffff" renders nothing at all — docs/control-center.md.
# shellcheck disable=SC1090
[ -r "$HOME/.config/mintbook/system-chrome.env" ] && . "$HOME/.config/mintbook/system-chrome.env"
fg=$PANEL_FOREGROUND

# Light or dark is decided by the ink, not by a second file. bin/appearance-mode
# writes system-chrome.env before it writes appearance.applied, and a tick
# landing between the two would otherwise draw the new ink against the old
# palette. White ink means a dark bar; #2d3036 means a light one.
r16=${fg:1:2}
mode=light
[ "$((16#${r16:-ff}))" -gt 128 ] 2>/dev/null && mode=dark

# Apple's system palette in both appearances, plus a yellow that is not in it.
# The charge answers one question and the bolt answers another, so they get
# separate colours: the fill is the traffic light for how much is left, and the
# bolt is electric yellow for current going in. Charging used to force the fill
# green, which said "plugged in" and "fine" with the same paint and left a 12%
# battery looking healthy the moment it was plugged in.
if [ "$mode" = dark ]; then
  GREEN='#30d158' AMBER='#ffd60a' RED='#ff453a' YELLOW='#ffe814'
else
  GREEN='#34c759' AMBER='#ff9f0a' RED='#ff3b30' YELLOW='#ffcc00'
fi
case "$COLOR" in
  # mono is the macOS look — ink only, and that includes the bolt.
  mono) fill=$fg boltfill=$fg ;;
  *)
    if   [ "$pct" -lt "$LOW" ]; then fill=$RED
    elif [ "$pct" -lt "$MID" ]; then fill=$AMBER
    else fill=$GREEN; fi
    boltfill=$YELLOW ;;
esac

# Only rewrite the file when what it would draw has changed.
sig="v2:$pct/$st/$fill/$boltfill/$fg/$SHOW_PERCENT"
osig='' otick=0 oprev=0
[ -r "$STATE" ] && read -r osig otick oprev < "$STATE"
otick=${otick:-0} oprev=${oprev:-0}
# v2 changes the logged percentage from design-relative to usable-relative.
# Make the first new sample a graph break rather than drawing a fake 20-point
# charge jump from a legacy sample to a normalized one.
case "$osig" in v2:*) ;; *) oprev=0 ;; esac

# A rounded rectangle as an SVG path, in half-pixel units — `rr x y w h r`.
# Two of them under fill-rule=evenodd is an outline of exactly the thickness
# of the gap between them, which is the one shape a battery icon is.
rr() {
  local x=$1 y=$2 w=$3 h=$4 r=$5
  printf 'M%s,%s h%s a%s,%s 0 0 1 %s,%s v%s a%s,%s 0 0 1 -%s,%s h-%s a%s,%s 0 0 1 -%s,-%s v-%s a%s,%s 0 0 1 %s,-%s z' \
    "$(( x + r ))" "$y" "$(( w - 2 * r ))" "$r" "$r" "$r" "$r" \
    "$(( h - 2 * r ))" "$r" "$r" "$r" "$r" "$(( w - 2 * r ))" \
    "$r" "$r" "$r" "$r" "$(( h - 2 * r ))" "$r" "$r" "$r" "$r"
}

if [ "${osig:-}" != "$sig" ] || [ ! -s "$SVG" ]; then
  # Half-pixel units, canvas 68 tall (34 px, the same box wifi and Bluetooth
  # use). The body is 42x22 px — a little under 2:1, which is the proportion
  # macOS's is — and the outline is the panel's own ink at .9, not a grey, so
  # it sits with the rest of the bar rather than behind it.
  #
  # With the percentage on, the body grows to hold the number *inside* it
  # rather than standing next to it, the number is drawn in the panel's ink,
  # and the charge drops to .66 so the ink stays legible over it. Punching the
  # digits out of the charge the way the bolt is punched was tried first and is
  # in docs/battery.md: it is prettier at 100% and unreadable at 30, where half
  # a number sits on the fill and half on the glass.
  bx=14 marks='' boltmark='' opacity=1
  if [ "$SHOW_PERCENT" = 1 ]; then bw=92 opacity=.66; else bw=84; fi
  # The bolt is inside the body in every state. With the percentage on it takes
  # the trailing end of the well and the number takes what is left, so the body
  # grows by the bolt's 18 units and a gap rather than the number giving way.
  [ "$st" = C ] && [ "$SHOW_PERCENT" = 1 ] && bw=$(( bw + 23 ))
  iw=$(( bw - 14 ))                     # the well inside the outline
  w=$(( bx + bw + 9 + 14 ))             # + cap + right padding
  fw=$(( (pct * iw + 50) / 100 )); [ "$fw" -lt 8 ] && fw=8
  ix=$(( bx + 7 ))
  body="$(rr "$bx" 12 "$bw" 44 14) $(rr "$(( bx + 4 ))" 16 "$(( bw - 8 ))" 36 10)"
  cap=$(rr "$(( bx + bw + 3 ))" 24 6 20 3)

  if [ "$SHOW_PERCENT" = 1 ]; then
    tx=$(( bx + bw / 2 ))
    [ "$st" = C ] && tx=$(( ix + (iw - 26) / 2 ))   # the well before the bolt
    marks=$(printf '  <text x="%s" y="44" text-anchor="middle" fill="%s" fill-opacity=".95" font-family="Inter" font-size="29" font-weight="600" style="font-feature-settings:%s">%s</text>' \
      "$tx" "$fg" "'tnum'" "$pct")
  fi

  if [ "$st" = C ]; then
    # One solid yellow bolt, painted over whatever is under it. It used to be
    # negative space punched out of the charge with the charge's own colour
    # past it — two masks, and a bolt that was green because the charge was.
    # A bolt with a colour of its own needs neither: yellow reads on the glass
    # and on all three fills. Being drawn over the charge rather than punched
    # out of it is also the only version with no seam where the charge ends —
    # a mask leaves the fill's rounded cap showing inside the bolt's notch.
    #
    # The one fill that could swallow it is amber, which is nearly the same
    # hue. That needs the charge to reach the bolt while still under MID, so it
    # is 36-39% with the percentage off (the number pushes the bolt out to 78%,
    # where the fill is green) — and there the charge has only just touched the
    # bolt's leading tip.
    if [ "$SHOW_PERCENT" = 1 ]; then cx=$(( ix + iw - 13 )); else cx=$(( bx + bw / 2 )); fi
    boltmark=$(printf '  <path d="M%s,18 L%s,36 L%s,36 L%s,50 L%s,32 L%s,32 Z" fill="%s"/>' \
      "$(( cx + 5 ))" "$(( cx - 9 ))" "$(( cx - 1 ))" "$(( cx - 5 ))" \
      "$(( cx + 9 ))" "$(( cx + 1 ))" "$boltfill")
  fi

  mkdir -p "$CACHE"
  cat > "$SVG.tmp" <<SVGDOC
<svg width="$(( w / 2 ))" height="34" viewBox="0 0 $w 68" xmlns="http://www.w3.org/2000/svg">
 <g fill="$fg" fill-opacity=".9">
  <path d="$body" fill-rule="evenodd"/>
  <path d="$cap"/>
 </g>
 <rect x="$ix" y="19" width="$fw" height="30" rx="10" fill="$fill" fill-opacity="$opacity"/>
$marks
$boltmark
</svg>
SVGDOC
  mv -f "$SVG.tmp" "$SVG"
fi

# ---------------------------------------------------------------- the tooltip

health=''
[ "$design" -gt 0 ] 2>/dev/null && health=$(( full * 100 / design ))
rd temp "$B/temp" ''
rd cycles "$B/cycle_count" ''


case "$st" in
  C) line1="Charging${eta:+ · ${eta} to full}" ;;
  F) line1='Charged' ;;
  D) line1="${eta:+$eta remaining}" ;;
  *) line1='On AC power' ;;
esac
[ -z "$line1" ] && line1=$([ "$online" = 1 ] && echo 'Plugged in' || echo 'On battery')

line2="$(( mw / 1000 )).$(( (mw % 1000) / 100 )) W"
[ -n "$health" ] && line2="$line2 · health ${health}%"
[ -n "$cycles" ] && line2="$line2 · ${cycles} cycles"
[ -n "$temp" ] && line2="$line2 · $(( temp / 10 )) °C"

printf '<img>%s</img>\n' "$SVG"
printf '<tool><span font_family="Inter"><b>Battery %s%%</b>\n%s\n<small>%s</small></span></tool>\n' \
  "$pct" "$line1" "$line2"

# ----------------------------------------------------------------- the sample
#
# One line per minute, holding everything bin/battery-history needs: the
# charge, the measured watts, the machine's CPU deltas, and the CPU each
# *application* spent since the last line. Applications, not processes: a
# process is resolved up its parent chain to the thing you would name if asked
# what was using the battery, so Firefox's dozen content processes arrive as
# "firefox" rather than as twelve rows of "Isolated Web Co".

tick=$(( otick + 1 ))
[ "${1:-}" = --sample ] && tick=$SAMPLE_EVERY
if [ $(( tick % SAMPLE_EVERY )) -ne 0 ]; then
  printf '%s %s %s\n' "$sig" "$tick" "${oprev:-0}" > "$STATE.tmp"
  mv -f "$STATE.tmp" "$STATE"
  exit 0
fi

# /proc/stat's first line, without awk: cpu user nice system idle iowait ...
read -ra cstat < /proc/stat
cpu_t=0; for n in "${cstat[@]:1}"; do cpu_t=$(( cpu_t + n )); done
cpu_i=$(( cstat[4] + cstat[5] ))

declare -A JIF PAR COMM
lines=()
for d in /proc/[0-9]*; do
  # `read` from the file splits the line in C and costs one open. Splitting it
  # in bash instead — arr=($rest) over 50 fields and 260 processes — was 13000
  # word splits and most of a quarter-second. The 9 bare _ are stat fields 5
  # to 13; utime and stime are 14 and 15.
  { read -r pid c st_ up _ _ _ _ _ _ _ _ _ ut sy _ < "$d/stat"; } 2>/dev/null || continue
  if [ "${c: -1}" = ')' ]; then
    c=${c#\(}; c=${c%\)}
  else
    # comm contains a space, so the field count is wrong. Rare enough to pay
    # for properly: cut on the last ')' instead, which is what it is there for.
    { s=$(<"$d/stat"); } 2>/dev/null || continue
    c=${s#*\(}; c=${c%\)*}
    arr=(${s##*\)})
    up=${arr[1]:-0} ut=${arr[11]:-0} sy=${arr[12]:-0} c=${c// /_}
  fi
  j=$(( ut + sy ))
  JIF[$pid]=$j PAR[$pid]=$up COMM[$pid]=$c
  lines+=("$pid $j")
done

# The previous walk, and the /proc/stat totals it was taken against — the
# per-application share is measured over the same interval as the watts.
declare -A OLD
prev_total=0 prev_idle=0
if [ -r "$PROCS" ]; then
  while read -r p j k; do
    [ "$p" = '#' ] && { prev_total=$j prev_idle=${k:-0}; continue; }
    OLD[$p]=$j
  done < "$PROCS"
fi

printf '# %s %s\n%s\n' "$cpu_t" "$cpu_i" "$(IFS=$'\n'; echo "${lines[*]}")" > "$PROCS.tmp"
mv -f "$PROCS.tmp" "$PROCS"

apps=''
if [ "$prev_total" -gt 0 ] && [ "$cpu_t" -gt "$prev_total" ]; then
  declare -A APP
  for p in "${!JIF[@]}"; do
    o=${OLD[$p]:-}
    [ -z "$o" ] && continue                      # started since the last walk
    d=$(( ${JIF[$p]} - o ))
    [ "$d" -le 0 ] && continue
    # Walk to the application: stop at init, at a session or service manager,
    # or after eight hops, which is deeper than any real tree here.
    root=$p n=0
    while [ "$n" -lt 8 ]; do
      up=${PAR[$root]:-0}
      [ "$up" -le 1 ] && break
      case "${COMM[$up]:-}" in
        systemd|xfce4-session|lightdm|init|'') break ;;
      esac
      root=$up; n=$(( n + 1 ))
    done
    k=${COMM[$root]:-?}
    APP[$k]=$(( ${APP[$k]:-0} + d ))
  done
  # 2 jiffies over a minute is 0.03% of a core. Below that a name on the line
  # is noise, and there are a hundred of them.
  for k in "${!APP[@]}"; do
    [ "${APP[$k]}" -ge 2 ] && apps="$apps $k:${APP[$k]}"
  done
fi

printf -v stamp '%(%s)T' -1          # date(1) would be two forks a minute
dt=0
[ "$oprev" -gt 0 ] && dt=$(( stamp - oprev ))
[ "$dt" -lt 0 ] && dt=0
[ "$dt" -gt 3600 ] && dt=0                       # a suspend is a gap, not a sample

# total and busy are jiffy *deltas* over the same interval as dt and the watts,
# which is what makes the fit in bin/battery-history a fit and not a guess.
dtotal=0 dbusy=0
if [ "$prev_total" -gt 0 ] && [ "$cpu_t" -gt "$prev_total" ]; then
  dtotal=$(( cpu_t - prev_total ))
  dbusy=$(( dtotal - (cpu_i - prev_idle) ))
  [ "$dbusy" -lt 0 ] && dbusy=0
fi

printf '%s %s %s %s %s %s %s%s\n' \
  "$stamp" "$pct" "$st" "$mw" "$dt" "$dtotal" "$dbusy" "$apps" >> "$LOG"

printf '%s %s %s\n' "$sig" "$tick" "$stamp" > "$STATE.tmp"
mv -f "$STATE.tmp" "$STATE"

# Trim once an hour, by date. It used to keep HISTORY_DAYS x 24 x 60 *lines*,
# which is HISTORY_DAYS days only while there is exactly one line a minute. At
# SAMPLE_EVERY=2 the same count is 28 hours, and nothing anywhere said so — see
# docs/battery.md. A cutoff makes the setting mean what it says at any rate.
#
# The first line's timestamp decides whether to rewrite at all, so the ordinary
# hour costs one `read` and no forks.
if [ $(( tick % (SAMPLE_EVERY * 60) )) -eq 0 ]; then
  # One line a day of what the pack is actually worth. charge_full moves by
  # more from the gauge re-estimating it than from a day of wear, so a single
  # reading is not a wear figure and two of them six days apart are not a
  # curve — which is exactly the argument for writing it down every day
  # instead. 23 h rather than 24 so it does not drift out of a day.
  # Never trimmed: a line is 40 bytes and a decade is 150 KB.
  hlast=$(tail -1 "$HLOG" 2>/dev/null | cut -d' ' -f1)
  if [ $(( stamp - ${hlast:-0} )) -ge 82800 ] 2>/dev/null; then
    printf '%s %s %s %s %s\n' \
      "$stamp" "$full" "$design" "${cycles:-0}" "${temp:-0}" >> "$HLOG"
  fi

  cutoff=$(( stamp - HISTORY_DAYS * 86400 ))
  first=0
  read -r first _ < "$LOG" 2>/dev/null || true
  if [ "${first:-0}" -lt "$cutoff" ] 2>/dev/null; then
    awk -v c="$cutoff" '$1+0 >= c' "$LOG" > "$LOG.tmp" && mv -f "$LOG.tmp" "$LOG"
  fi
fi
exit 0
