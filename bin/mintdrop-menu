#!/usr/bin/env python3
"""The sheet — the devices that are nearby, as things you can drop a file on.

    mintdrop-menu                 open it, then drag files onto a device
    mintdrop-menu FILE...         open it with those files ready to send
    mintdrop-menu --pick          print the chosen peer's name and exit

AirDrop's window is the whole of its interface: a name, a picture, and you
let go of the file. This is that, drawn for this machine — one row of round
tiles, a glyph that says what kind of device it is, and the transfer
happening on the tile itself rather than in a dialog somewhere else.

Discovery runs only while this window is open. avahi-daemon is already
running for the rest of the system, so browsing costs one short-lived
`avahi-browse --terminate` and nothing between them. There is no resident
process on either side of this feature.

The browse happens on a thread because it takes about a second, and so does
the transfer: a window that paints after its own discovery looks broken, and
one that freezes while a file moves looks worse. Gtk is not thread-safe, so
every result comes back through GLib.idle_add and nothing off the main loop
touches a widget.
"""
import argparse
import importlib.machinery
import importlib.util
import math
import os
import sys
import threading
import time

BIN = os.path.dirname(os.path.realpath(__file__))
APPLIED = os.path.expanduser('~/.config/mintbook/appearance.applied')

# Adwaita before the Gtk import, for the reason bin/control-center and
# bin/bt-menu give: Gtk.init parses the GTK theme, WhiteSur's gtk.css is
# 400 KB, and that is ~120 ms of every launch spent on a stylesheet this
# window never reads a rule from. Every colour here is drawn or set below.
os.environ.setdefault('GTK_THEME', 'Adwaita')

import cairo
import gi
gi.require_version('Gtk', '3.0')
from gi.repository import Gtk, Gdk, GLib


def load(name):
    loader = importlib.machinery.SourceFileLoader(
        name, os.path.join(BIN, name + '.py'))
    module = importlib.util.module_from_spec(
        importlib.util.spec_from_loader(loader.name, loader))
    loader.exec_module(module)
    return module


drop = load('mintbook_drop')
quickshare = load('mintbook_quickshare')
try:
    ble = load('mintbook_ble')
except Exception:            # python3-dbus absent: everything else still works
    ble = None

# Drawn, not themed. Tuples because cairo wants numbers and because these are
# shapes rather than widgets — the only CSS below is for the two text labels.
LIGHT = {  # generated by bin/palette-generate
    'top': (229, 231, 234, 0.980392),
    'bottom': (202, 205, 210, 0.968627),
    'edge': (255, 255, 255, 0.74902),
    'rim': (65, 68, 74, 0.180392),
    'fg': (45, 48, 54),
    'tile': (255, 255, 255, 0.54902),
    'tile_hi': (255, 255, 255, 0.780392),
    'tile_edge': (255, 255, 255, 0.65098),
    'track': (65, 68, 74, 0.129412),
    'accent': (0, 122, 255),
    'green': (52, 199, 89),
    'red': (255, 59, 48),
}
DARK = {  # generated by bin/palette-generate
    'top': (104, 109, 119, 0.976471),
    'bottom': (74, 78, 86, 0.968627),
    'edge': (255, 255, 255, 0.180392),
    'rim': (0, 0, 0, 0.34902),
    'fg': (255, 255, 255),
    'tile': (255, 255, 255, 0.129412),
    'tile_hi': (255, 255, 255, 0.2),
    'tile_edge': (255, 255, 255, 0.101961),
    'track': (255, 255, 255, 0.160784),
    'accent': (10, 132, 255),
    'green': (48, 209, 88),
    'red': (255, 69, 58),
}

# This display runs at 168 DPI, so every size below is a *logical* one and
# gets multiplied by SC before it reaches a pixel — the same constant and the
# same reason as bin/bt-menu. Hardcoding pixels here is what made the first
# version of this window render at 57% of its intended size: readable on a
# 96 DPI screen, and far too small on the one this machine actually has.
_screen = Gdk.Screen.get_default()
SC = float(os.environ.get('MINTBOOK_SCALE', 0)) or round(((_screen.get_resolution() if _screen else 96) or 96) / 96.0, 3) or 1.0

TILE = 92           # the drawing area, square, logical
RADIUS = 33         # the circle inside it
CORNER = 18         # the window's own rounded corner
SHADOW = 16         # soft multi-ring drop shadow margin
IDLE, SENDING, DONE, FAILED = 'idle', 'sending', 'done', 'failed'


def px(value):
    return int(round(value * SC))


def appearance():
    override = os.environ.get('MINTBOOK_PREVIEW_APPEARANCE')
    if override in ('light', 'dark'):
        return DARK if override == 'dark' else LIGHT
    try:
        with open(APPLIED) as f:
            return DARK if f.read().strip() == 'dark' else LIGHT
    except OSError:
        return LIGHT


def rgba(cr, c, alpha=None):
    a = c[3] if len(c) > 3 else 1.0
    cr.set_source_rgba(c[0] / 255, c[1] / 255, c[2] / 255,
                       a if alpha is None else a * alpha)


def rrect(cr, x, y, w, h, r):
    r = max(0, min(r, w / 2, h / 2))
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


# ---------------------------------------------------------------------------
# glyphs
# ---------------------------------------------------------------------------
# Drawn rather than pulled from an icon theme: three shapes at one size, and
# this way they inherit the appearance's foreground exactly and cannot go
# missing when a theme changes. bin/bt-menu draws its device glyphs the same
# way and for the same reason.

def glyph_phone(cr, cx, cy, colour, alpha=1.0):
    rgba(cr, colour, alpha)
    cr.set_line_width(1.8)
    w, h, r = 19, 32, 4
    x, y = cx - w / 2, cy - h / 2
    rrect(cr, x, y, w, h, r)
    cr.stroke()
    cr.move_to(cx - 3.5, y + 4.5)
    cr.line_to(cx + 3.5, y + 4.5)
    cr.stroke()


def glyph_laptop(cr, cx, cy, colour, alpha=1.0):
    rgba(cr, colour, alpha)
    cr.set_line_width(1.8)
    w, h = 28, 19
    x, y = cx - w / 2, cy - h / 2 - 3
    cr.rectangle(x, y, w, h)
    cr.stroke()
    cr.move_to(cx - w / 2 - 4, y + h + 5)
    cr.line_to(cx + w / 2 + 4, y + h + 5)
    cr.stroke()


def glyph_unknown(cr, cx, cy, colour, alpha=1.0):
    rgba(cr, colour, alpha)
    cr.set_line_width(1.8)
    cr.rectangle(cx - 13, cy - 10, 26, 20)
    cr.stroke()


def glyph_check(cr, cx, cy, colour):
    rgba(cr, colour)
    cr.set_line_width(3)
    cr.set_line_cap(1)                      # cairo.LINE_CAP_ROUND
    cr.move_to(cx - 8, cy)
    cr.line_to(cx - 2, cy + 6.5)
    cr.line_to(cx + 9, cy - 6)
    cr.stroke()


def glyph_cross(cr, cx, cy, colour):
    rgba(cr, colour)
    cr.set_line_width(3)
    cr.set_line_cap(1)
    for dx in (-1, 1):
        cr.move_to(cx - 7 * dx, cy - 7)
        cr.line_to(cx + 7 * dx, cy + 7)
        cr.stroke()


GLYPHS = {quickshare.PHONE: glyph_phone, quickshare.FOLDABLE: glyph_phone,
          quickshare.TABLET: glyph_phone, quickshare.LAPTOP: glyph_laptop}


# ---------------------------------------------------------------------------
# one device
# ---------------------------------------------------------------------------

class Tile:
    """A device, and whatever is currently happening to it."""

    def __init__(self, sheet, peer):
        self.sheet = sheet
        self.peer = peer
        self.state = IDLE
        self.share = 0.0
        self.hover = False
        self.dropping = False
        self.note = ''
        self.protocol = peer.get('protocol', 'mintdrop')
        self.supported = True

        self.area = Gtk.DrawingArea()
        self.area.set_size_request(px(TILE), px(TILE))
        self.area.connect('draw', self.draw)

        self.label = Gtk.Label(label=peer['name'])
        self.label.get_style_context().add_class('name')
        self.label.set_max_width_chars(16)
        self.label.set_ellipsize(3)
        self.label.set_justify(Gtk.Justification.CENTER)
        self.label.set_line_wrap(False)

        self.status = Gtk.Label(
            label='Quick Share' if self.protocol == 'quickshare' else '')
        self.status.get_style_context().add_class('status')
        self.status.set_max_width_chars(15)
        self.status.set_ellipsize(3)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        box.pack_start(self.area, False, False, 0)
        box.pack_start(self.label, False, False, 0)
        box.pack_start(self.status, False, False, 0)

        self.widget = Gtk.EventBox()
        self.widget.add(box)
        self.widget.set_events(Gdk.EventMask.BUTTON_PRESS_MASK
                               | Gdk.EventMask.ENTER_NOTIFY_MASK
                               | Gdk.EventMask.LEAVE_NOTIFY_MASK)
        self.widget.connect('button-press-event', self.clicked)
        self.widget.connect('enter-notify-event', self.entered, True)
        self.widget.connect('leave-notify-event', self.entered, False)

        # The whole point of the window: let go of a file on a face.
        self.widget.drag_dest_set(Gtk.DestDefaults.ALL, [],
                                  Gdk.DragAction.COPY)
        self.widget.drag_dest_add_uri_targets()
        self.widget.connect('drag-data-received', self.dropped)
        self.widget.connect('drag-motion', self.drag_over, True)
        self.widget.connect('drag-leave', self.drag_over, False)

    # -- painting ----------------------------------------------------------

    def draw(self, area, cr):
        colours = self.sheet.colours
        cr.scale(SC, SC)              # everything below is in logical units
        cx = cy = TILE / 2
        lit = (self.hover or self.dropping) and self.state is IDLE

        rgba(cr, colours['tile_hi'] if lit else colours['tile'])
        cr.arc(cx, cy, RADIUS, 0, 2 * math.pi)
        cr.fill_preserve()
        rgba(cr, colours['tile_edge'])
        cr.set_line_width(1)
        cr.stroke()

        if self.dropping:
            rgba(cr, colours['accent'])
            cr.set_line_width(2)
            cr.arc(cx, cy, RADIUS + 3, 0, 2 * math.pi)
            cr.stroke()

        if self.state is DONE:
            glyph_check(cr, cx, cy, colours['green'])
        elif self.state is FAILED:
            glyph_cross(cr, cx, cy, colours['red'])
        else:
            GLYPHS.get(self.peer.get('device_type'), glyph_unknown)(
                cr, cx, cy, colours['fg'], 1.0 if self.supported else 0.45)

        if self.state is SENDING:
            # The ring is the progress bar. Starting at twelve o'clock and
            # going clockwise is the only reading of a circle that does not
            # need a legend.
            rgba(cr, colours['track'])
            cr.set_line_width(3)
            cr.arc(cx, cy, RADIUS + 5, 0, 2 * math.pi)
            cr.stroke()
            rgba(cr, colours['accent'])
            cr.set_line_width(3)
            cr.set_line_cap(1)
            cr.arc(cx, cy, RADIUS + 5, -math.pi / 2,
                   -math.pi / 2 + 2 * math.pi * max(self.share, 0.01))
            cr.stroke()
        return False

    def repaint(self):
        self.area.queue_draw()
        self.status.set_text(self.note)
        return False

    # -- input -------------------------------------------------------------

    def entered(self, _widget, _event, inside):
        self.hover = inside
        self.area.queue_draw()
        return False

    def drag_over(self, _widget, _ctx=None, _x=None, _y=None, _t=None,
                  inside=False):
        self.dropping = bool(inside)
        self.area.queue_draw()
        return False

    def dropped(self, _widget, _ctx, _x, _y, data, _info, _time):
        self.dropping = False
        paths = []
        for uri in data.get_uris():
            path, _host = GLib.filename_from_uri(uri)
            paths.append(path)
        if paths:
            self.send(paths)

    def clicked(self, _widget, _event):
        if self.sheet.files:
            self.send(self.sheet.files)
        else:
            self.sheet.say('Drag files onto a device to send them')
        return True

    # -- the transfer ------------------------------------------------------

    def send(self, paths):
        if self.state is SENDING:
            return
        self.state = SENDING
        self.share = 0.0
        self.note = 'Waiting…'
        self.repaint()
        threading.Thread(target=self.transfer, args=(paths,),
                         daemon=True).start()

    def finish(self, state, note):
        self.state = state
        self.note = note
        self.repaint()
        return False

    def transfer(self, paths):
        """Off the main loop. Everything it learns goes back through idle_add."""
        if self.protocol == 'quickshare':
            return self.transfer_quickshare(paths)
        try:
            files = []
            for path in paths:
                if os.path.isdir(path):
                    raise drop.DropError(f'{os.path.basename(path)} is a folder')
                files.append({'path': path, 'name': os.path.basename(path),
                              'size': os.stat(path).st_size})
            total = sum(f['size'] for f in files) or 1

            sock = drop.connect(self.peer['address'], self.peer['port'])
            try:
                drop.write_header(sock, {
                    'name': drop.config()['name'] or drop.device_name(),
                    'files': [{'name': f['name'], 'size': f['size']}
                              for f in files]})
                sock.settimeout(90)
                answer = drop.read_exactly(sock, 1)
                if answer == drop.DECLINE:
                    GLib.idle_add(self.finish, FAILED, 'Declined')
                    return
                if answer != drop.ACCEPT:
                    GLib.idle_add(self.finish, FAILED, 'Busy')
                    return

                sock.setblocking(True)
                moved = [0]
                last = [0.0]
                started = time.monotonic()

                def progress(chunk):
                    moved[0] += chunk
                    now = time.monotonic()
                    # Twenty repaints a second is plenty and costs nothing;
                    # one per megabyte would cost more than the transfer.
                    if now - last[0] < 0.05 and moved[0] < total:
                        return
                    last[0] = now
                    self.share = moved[0] / total
                    rate = moved[0] / max(now - started, 1e-6) / (1 << 20)
                    self.note = f'{self.share * 100:.0f}%  ·  {rate:.0f} MB/s'
                    GLib.idle_add(self.repaint)

                for entry in files:
                    drop.send_file(sock, entry['path'], entry['size'], progress)
                sock.settimeout(120)
                drop.read_exactly(sock, 1)
            finally:
                sock.close()
        except (drop.DropError, OSError) as exc:
            message = getattr(exc, 'strerror', None) or str(exc)
            GLib.idle_add(self.finish, FAILED, message[:40])
            return
        seconds = max(time.monotonic() - started, 1e-6)
        GLib.idle_add(self.finish, DONE,
                      f'Sent · {total / seconds / (1 << 20):.0f} MB/s')

    def transfer_quickshare(self, paths):
        """The same tile, the other protocol.

        The wait between the offer and the first byte is a person picking up
        a phone, so the tile says so instead of sitting at 0%.
        """
        started = [time.monotonic()]
        total = sum(os.stat(p).st_size for p in paths) or 1
        moved = [0]
        last = [0.0]

        def waiting():
            self.note = 'Waiting for the phone…'
            GLib.idle_add(self.repaint)

        def progress(chunk):
            moved[0] += chunk
            now = time.monotonic()
            if now - last[0] < 0.05 and moved[0] < total:
                return
            last[0] = now
            self.share = moved[0] / total
            rate = moved[0] / max(now - started[0], 1e-6) / (1 << 20)
            self.note = f'{self.share * 100:.0f}%  ·  {rate:.0f} MB/s'
            GLib.idle_add(self.repaint)

        try:
            sent, seconds = quickshare.send_files(
                self.peer, paths, on_wait=waiting, progress=progress)
        except Exception as exc:
            GLib.idle_add(self.finish, FAILED, str(exc)[:40])
            return
        GLib.idle_add(self.finish, DONE,
                      f'Sent · {sent / max(seconds, 1e-6) / (1 << 20):.0f} MB/s')


# ---------------------------------------------------------------------------
# the window
# ---------------------------------------------------------------------------

class Sheet:
    def __init__(self, files, pick_only=False):
        self.files = files
        self.pick_only = pick_only
        self.colours = appearance()
        self.chosen = None
        self.tiles = []
        self.closed = False

    def build(self):
        dark = self.colours is DARK
        win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
        win.set_decorated(False)
        win.set_skip_taskbar_hint(True)
        win.set_keep_above(True)
        win.set_resizable(False)
        win.set_accept_focus(True)
        win.set_type_hint(Gdk.WindowTypeHint.DIALOG)
        win.set_position(Gtk.WindowPosition.CENTER_ALWAYS)
        # Rounded corners are only rounded if something transparent is behind
        # them. Without an RGBA visual and a background this window paints
        # itself, GTK fills an opaque square first and the CSS radius just
        # reveals it — which is the black right-angle behind each corner.
        win.set_app_paintable(True)
        visual = Gdk.Screen.get_default().get_rgba_visual()
        if visual is not None:
            win.set_visual(visual)
        win.connect('draw', self.draw_background)

        def css_rgb(key, alpha=None):
            c = self.colours[key]
            a = c[3] if len(c) == 4 else 1.0
            if alpha is not None:
                a *= alpha
            if a < 1.0:
                return f'rgba({c[0]},{c[1]},{c[2]},{a:.3f})'
            return f'rgb({c[0]},{c[1]},{c[2]})'

        css = Gtk.CssProvider()
        css.load_from_data(f'''
            window {{ background-color: transparent; }}
            label {{ color: {css_rgb('fg')}; }}
            label.title {{ font-weight: 600; font-size: {px(13)}px; }}
            label.name {{ font-size: {px(12)}px; }}
            label.status, label.hint {{
                color: {css_rgb('fg', 0.55)}; font-size: {px(10)}px;
            }}
            label.hint {{ font-size: {px(11)}px; }}
            button.close {{
                background-image: none; background-color: transparent;
                border: none; box-shadow: none; padding: {px(2)}px {px(6)}px;
                color: {css_rgb('fg', 0.55)}; font-size: {px(15)}px;
            }}
            button.close:hover {{ color: {css_rgb('fg')}; }}
        '''.encode())
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), css,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=px(8))
        for side in ('top', 'bottom', 'start', 'end'):
            getattr(outer, f'set_margin_{side}')(px(16 + SHADOW))
        win.add(outer)

        # A window that can only be dismissed with Escape is a window with no
        # way out the moment it loses focus — which is exactly what happens
        # when you click another window to drag a file from it. It kept itself
        # above everything with no way to close. Hence a visible close.
        top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        close = Gtk.Button(label='\u00d7')
        close.get_style_context().add_class('close')
        close.set_relief(Gtk.ReliefStyle.NONE)
        close.connect('clicked', lambda _b: Gtk.main_quit())
        top.pack_end(close, False, False, 0)
        outer.pack_start(top, False, False, 0)

        if self.files:
            what = (os.path.basename(self.files[0]) if len(self.files) == 1
                    else f'{len(self.files)} files')
            heading = f'Send {what} to'
        else:
            heading = 'Send to'
        self.title = Gtk.Label(label=heading, xalign=0.5)
        self.title.get_style_context().add_class('title')
        self.title.set_max_width_chars(40)
        self.title.set_ellipsize(3)
        outer.pack_start(self.title, False, False, 0)

        self.flow = Gtk.FlowBox()
        self.flow.set_selection_mode(Gtk.SelectionMode.NONE)
        self.flow.set_max_children_per_line(4)
        self.flow.set_min_children_per_line(1)
        self.flow.set_homogeneous(True)
        self.flow.set_column_spacing(px(6))
        self.flow.set_row_spacing(px(6))
        # Centre the tiles rather than letting the FlowBox fill: with one
        # device the window is as wide as its hint text, and a single tile
        # pinned to the left of all that space looks like a mistake.
        self.flow.set_halign(Gtk.Align.CENTER)
        self.flow.set_hexpand(False)
        centred = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        centred.set_center_widget(self.flow)
        outer.pack_start(centred, False, False, 0)

        self.hint = Gtk.Label(label='Looking for devices…', xalign=0.5)
        self.hint.get_style_context().add_class('hint')
        self.hint.set_line_wrap(True)
        self.hint.set_max_width_chars(34)
        self.hint.set_justify(Gtk.Justification.CENTER)
        outer.pack_start(self.hint, False, False, 0)

        win.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
        win.connect('button-press-event', self.on_press)
        win.connect('key-press-event', self.on_key)
        win.connect('destroy', lambda *_: Gtk.main_quit())
        self.win = win
        return win

    def on_press(self, win, event):
        if event.button == 1 and event.y < px(SHADOW + 54):
            win.begin_move_drag(event.button, int(event.x_root), int(event.y_root), event.time)
            return True
        return False

    def draw_background(self, widget, cr):
        """The glass: soft multi-ring drop shadow, canonical gradient, outer
        rim, and specular inner edge on a cleared RGBA surface."""
        allocation = widget.get_allocation()
        cr.save()
        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.set_source_rgba(0, 0, 0, 0)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)
        cr.scale(SC, SC)
        x = y = SHADOW
        w = allocation.width / SC - 2 * SHADOW
        h = allocation.height / SC - 2 * SHADOW
        for i in range(SHADOW, 0, -1):
            rrect(cr, x - i, y - i + 2, w + 2 * i, h + 2 * i, CORNER + i)
            cr.set_line_width(1.4)
            cr.set_source_rgba(0, 0, 0, .06 * (1 - i / SHADOW) ** 2)
            cr.stroke()
        top, bot = self.colours['top'], self.colours['bottom']
        grad = cairo.LinearGradient(0, y, 0, y + h)
        grad.add_color_stop_rgba(0, top[0] / 255, top[1] / 255, top[2] / 255, top[3])
        grad.add_color_stop_rgba(1, bot[0] / 255, bot[1] / 255, bot[2] / 255, bot[3])
        rrect(cr, x + .5, y + .5, w - 1, h - 1, CORNER)
        cr.set_source(grad)
        cr.fill_preserve()
        rgba(cr, self.colours['rim'])
        cr.set_line_width(1)
        cr.stroke()
        rrect(cr, x + 1.25, y + 1.25, w - 2.5, h - 2.5, CORNER - .75)
        rgba(cr, self.colours['edge'])
        cr.set_line_width(1)
        cr.stroke()
        cr.restore()
        return False

    def say(self, text):
        self.hint.set_text(text)

    def on_key(self, _w, event):
        if event.keyval == Gdk.KEY_Escape:
            Gtk.main_quit()
            return True
        return False

    # -- discovery ---------------------------------------------------------

    def search(self, repeat=False):
        """Browse now, and keep browsing while the window is open.

        A phone advertises only while its own share sheet is up, so a single
        browse at open time finds nothing if the phone was a second behind —
        which is what 'it isn't showing the device' looks like. Still nothing
        resident: this stops when the window closes.
        """
        peers = list(drop.discover())
        for peer in peers:
            peer.setdefault('protocol', 'mintdrop')
            peer.setdefault('device_type', quickshare.LAPTOP)
        try:
            peers += quickshare.discover()
        except Exception:
            pass                      # a phone we cannot list is not an error
        GLib.idle_add(self.show, peers)
        if repeat and not self.closed:
            GLib.timeout_add_seconds(3, lambda: (
                threading.Thread(target=self.search, args=(True,),
                                 daemon=True).start(), False)[1])

    def show(self, peers):
        # Leave a tile that is mid-transfer alone: rebuilding the grid under a
        # running send would drop the widget its progress is drawn on.
        if any(tile.state is SENDING for tile in self.tiles):
            return False
        if [p['address'] for p in peers] == [t.peer['address']
                                             for t in self.tiles]:
            return False
        for tile in self.tiles:
            parent = tile.widget.get_parent()
            if parent is not None:
                self.flow.remove(parent)
        self.tiles = []
        if not peers:
            self.hint.set_text('No devices nearby.\nA phone needs its Quick '
                               'Share sheet open.')
            return False
        # Size the grid to what is actually here. A FlowBox reserves width
        # for max_children_per_line whether or not those children exist, so
        # leaving it at four made one device sit in the left quarter of an
        # empty four-wide grid — which no amount of centring fixes, because
        # the grid itself was the right size and the tile was at its edge.
        self.flow.set_max_children_per_line(max(1, min(len(peers), 4)))
        for peer in peers:
            tile = Tile(self, peer)
            self.tiles.append(tile)
            self.flow.add(tile.widget)
        if self.files:
            self.hint.set_text('Click a device, or drop the files on one.')
        else:
            self.hint.set_text('Drag files onto a device to send them.')
        self.flow.show_all()
        self.win.resize(1, 1)          # shrink back to what the tiles need
        return False

    def run(self):
        win = self.build()
        Gtk.Widget.set_opacity(win, 0.0)
        win.show_all()
        win.present()
        gdk_win = win.get_window()
        if gdk_win is not None:
            gdk_win.focus(GLib.get_monotonic_time() // 1000 & 0xffffffff)
        t0 = time.monotonic()

        def fade():
            f = min(1.0, (time.monotonic() - t0) / 0.095)
            Gtk.Widget.set_opacity(win, f * f * (3 - 2 * f))
            return f < 1.0

        GLib.timeout_add(16, fade)
        # Advertise over BLE for exactly as long as this window is open.
        # A phone whose Nearby stack is asleep never looks at mDNS, so
        # without this the sheet can sit there listing nothing while the
        # phone is a metre away. It stops when the window does.
        visibility = None
        if ble is not None:
            try:
                visibility = ble.Visibility().start(
                    on_error=lambda exc: None)
            except ble.NotAvailable:
                visibility = None        # no Bluetooth is not an error here

        threading.Thread(target=self.search, args=(True,),
                         daemon=True).start()
        Gtk.main()
        self.closed = True
        if visibility is not None:
            visibility.stop()
        return self.chosen


def main():
    parser = argparse.ArgumentParser(description=__doc__.split('\n\n')[0])
    parser.add_argument('--pick', action='store_true',
                        help='print the chosen peer and exit')
    parser.add_argument('files', nargs='*')
    args = parser.parse_args()

    files = [os.path.abspath(os.path.expanduser(f)) for f in args.files]
    sheet = Sheet(files, pick_only=args.pick)
    if args.pick:
        # The old contract, still used by `mintdrop send --pick`: choose a
        # peer, print its name, send nothing.
        def choose(tile, paths=None):
            sheet.chosen = tile.peer
            Gtk.main_quit()
        Tile.send = choose
    chosen = sheet.run()
    if args.pick:
        if chosen is None:
            return 1
        print(chosen['name'])
    return 0


if __name__ == '__main__':
    Gdk.set_program_class('mintbook-mintdrop')
    sys.exit(main())
