     'Advanced utilities'),
)


def read_mode():
    override = os.environ.get('MINTBOOK_PREVIEW_APPEARANCE')
    if override in ('light', 'dark'):
        return override
    try:
        with open(APPLIED, encoding='utf-8') as f:
            return f.read().strip()
    except OSError:
        return 'light'


def rrect(cr, x, y, w, h, r):
    r = max(0, min(r, w / 2, h / 2))
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


class ActionIcon(Gtk.DrawingArea):
    """Monochrome controls that do not inherit WhiteSur's black SVG fill."""

    def __init__(self, kind, color):
        super().__init__()
        self.kind = kind
        self.color = Gdk.RGBA()
        self.color.parse(color)
        self.set_size_request(24, 24)
        self.connect('draw', self.on_draw)

    def on_draw(self, _widget, cr):
        Gdk.cairo_set_source_rgba(cr, self.color)
        cr.set_line_width(2)
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.set_line_join(cairo.LINE_JOIN_ROUND)

        if self.kind == 'close':
            cr.move_to(7, 7)
            cr.line_to(17, 17)
            cr.move_to(17, 7)
            cr.line_to(7, 17)
        elif self.kind == 'lock':
            cr.arc(12, 10, 5, math.pi, 2 * math.pi)
            cr.rectangle(6, 10, 12, 10)
        elif self.kind == 'logout':
            cr.move_to(9, 5)
            cr.line_to(5, 5)
            cr.line_to(5, 19)
            cr.line_to(9, 19)
            cr.move_to(10, 12)
            cr.line_to(19, 12)
            cr.move_to(15, 8)
            cr.line_to(19, 12)
            cr.line_to(15, 16)
        elif self.kind == 'restart':
            cr.arc(12, 12, 7, .55, 5.55)
            cr.move_to(17.2, 6.9)
            cr.line_to(17.4, 11.5)
            cr.line_to(13.2, 8.9)
        elif self.kind == 'power':
            cr.arc(12, 13, 7, -.75, 3.89)
            cr.move_to(12, 3)
            cr.line_to(12, 12)
        elif self.kind == 'back':
            cr.move_to(15, 5)
            cr.line_to(8, 12)
            cr.line_to(15, 19)
        cr.stroke()
        return False


class FolderIcon(Gtk.DrawingArea):
    """Glass squircle displaying a 2x2 preview of the folder's first 4 apps."""

    SIZE = 128
    BOX = 104
    MINI = 40

    def __init__(self, apps, colors):
        super().__init__()
        self.colors = colors
        self.pixbufs = self.load_mini_icons(apps[:4])
        self.set_size_request(self.SIZE, self.SIZE)
        self.connect('draw', self.on_draw)

    @classmethod
    def load_mini_icons(cls, apps):
        theme = Gtk.IconTheme.get_default()
        if theme is None:
            return []
        flags = Gtk.IconLookupFlags.FORCE_SIZE
        icons = []
        for app in apps[:4]:
            gicon = app.get_icon() if hasattr(app, 'get_icon') else None
            if gicon is None:
                continue
            info = theme.lookup_by_gicon(gicon, cls.MINI, flags)
            if info is None:
                continue
            try:
                pixbuf = info.load_icon()
            except GLib.Error:
                continue
            if pixbuf is not None:
                icons.append(pixbuf)
        return icons

    def on_draw(self, _widget, cr):
        pad = (self.SIZE - self.BOX) / 2
        radius = 24
        # Soft drop shadow under the folder squircle
        for i in range(6, 0, -1):
            rrect(cr, pad - i, pad - i + 2, self.BOX + 2 * i, self.BOX + 2 * i, radius + i)
            cr.set_line_width(1.2)
            cr.set_source_rgba(0, 0, 0, .045 * (1 - i / 6) ** 2)
            cr.stroke()

        fill = self.colors['folder_fill']
        rim = self.colors['folder_rim']
        edge = self.colors['folder_edge']
        rrect(cr, pad, pad, self.BOX, self.BOX, radius)
        cr.set_source_rgba(fill[0] / 255, fill[1] / 255, fill[2] / 255, fill[3])
        cr.fill_preserve()
        cr.set_source_rgba(rim[0] / 255, rim[1] / 255, rim[2] / 255, rim[3])
        cr.set_line_width(1)
        cr.stroke()

        rrect(cr, pad + 1, pad + 1, self.BOX - 2, self.BOX - 2, radius - 1)
        cr.set_source_rgba(edge[0] / 255, edge[1] / 255, edge[2] / 255, edge[3])
        cr.set_line_width(1)
        cr.stroke()

        gap = 8
        cell = self.MINI
        start = pad + (self.BOX - (2 * cell + gap)) / 2
        for index, pixbuf in enumerate(self.pixbufs[:4]):
            col = index % 2
            row = index // 2
            x = start + col * (cell + gap) + (cell - pixbuf.get_width()) / 2
            y = start + row * (cell + gap) + (cell - pixbuf.get_height()) / 2
            Gdk.cairo_set_source_pixbuf(cr, pixbuf, round(x), round(y))
            cr.paint()
        return False


class AppGrid:
    def __init__(self):
        self.colors = DARK if read_mode() == 'dark' else LIGHT
        self.handing_off = False
        self.current_group = None
        self.pending_action = None
        self.win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
        self.win.set_name('mintbook-app-grid')
        self.win.set_title('Applications')
        self.win.set_decorated(False)
        self.win.set_skip_taskbar_hint(True)
        self.win.set_skip_pager_hint(True)
        self.win.set_keep_above(True)
        self.win.set_app_paintable(True)
        self.win.set_type_hint(Gdk.WindowTypeHint.DIALOG)

        screen = Gdk.Screen.get_default()
        visual = screen.get_rgba_visual()
        if visual:
            self.win.set_visual(visual)

        display = Gdk.Display.get_default()
        monitor = display.get_primary_monitor() or display.get_monitor(0)
        self.geometry = monitor.get_workarea()
        self.win.set_default_size(self.geometry.width, self.geometry.height)
        self.win.move(self.geometry.x, self.geometry.y)
        self.win.set_resizable(False)

        self.win.connect('draw', self.draw_background)
        self.win.connect('key-press-event', self.on_key)
        self.win.connect('destroy', self.on_destroy)
        self.install_css()
        self.build()

    def install_css(self):
        c = self.colors
        css = f'''
        window#mintbook-app-grid,
        window#mintbook-app-grid box,
        window#mintbook-app-grid scrolledwindow,
        window#mintbook-app-grid viewport,
        window#mintbook-app-grid flowbox,
        window#mintbook-app-grid flowboxchild {{
          color: {c['fg']};
          background-color: transparent;
          background-image: none;
          border: 0;
        }}
        window#mintbook-app-grid .topbar {{
          padding: 22px 28px 14px;
          border-bottom: 1px solid {c['edge']};
        }}
        window#mintbook-app-grid .app-title {{
          font: 600 22px Inter;
        }}
        window#mintbook-app-grid .search-hint {{
          color: {c['dim']};
          font: 500 16px Inter;
        }}
        window#mintbook-app-grid .confirm-label {{
          font: 600 15px Inter;
          margin-left: 8px;
          margin-right: 4px;
        }}
        window#mintbook-app-grid button {{
          color: {c['fg']};
          text-shadow: none;
          outline: none;
        }}
        window#mintbook-app-grid button.session-button,
        window#mintbook-app-grid button.close-button,
        window#mintbook-app-grid button.back-button {{
          min-height: 42px;
          padding: 6px 14px;
          margin: 0 4px;
          background-color: {c['control']};
          background-image: none;
          border: 1px solid {c['edge']};
          border-radius: 12px;
          box-shadow: inset 0 1px rgba(255,255,255,.14), 0 2px 5px rgba(0,0,0,.10);
          font: 600 14px Inter;
        }}
        window#mintbook-app-grid button.confirm-danger {{
          background-color: {c['danger_solid']};
          border-color: {c['danger_solid']};
          color: #ffffff;
        }}
        window#mintbook-app-grid button.confirm-danger:hover {{
          background-color: {c['danger_solid']};
          opacity: 0.92;
        }}
        window#mintbook-app-grid button.close-button {{
          min-width: 42px;
          padding: 6px;
          margin-right: 12px;
        }}
        window#mintbook-app-grid button.back-button {{
          min-width: 42px;
          padding: 6px;
          margin-right: 4px;
        }}
        window#mintbook-app-grid button.session-button:hover,
        window#mintbook-app-grid button.close-button:hover,
        window#mintbook-app-grid button.back-button:hover {{
          background-color: {c['control_hover']};
        }}
        window#mintbook-app-grid button.session-button:active,
        window#mintbook-app-grid button.close-button:active,
        window#mintbook-app-grid button.back-button:active {{
          background-color: {c['danger']};
          box-shadow: inset 0 2px 4px rgba(0,0,0,.16);
        }}
        window#mintbook-app-grid button.app-tile {{
          min-width: 230px;
          min-height: 178px;
          padding: 12px;
          margin: 0;
          background-color: {c['tile']};
          background-image: none;
          border: 1px solid transparent;
          border-radius: 18px;
          box-shadow: none;
          font: 500 18px Inter;
        }}
        window#mintbook-app-grid button.app-tile:hover {{
          background-color: {c['tile_hover']};
          border-color: {c['edge']};
          box-shadow: none;
        }}
        window#mintbook-app-grid button.app-tile:focus {{
          background-color: {c['tile_hover']};
          border-color: {c['edge']};
          box-shadow: inset 0 0 0 1px {c['edge']};
        }}
        window#mintbook-app-grid button.app-tile:active {{
          background-color: {c['control_hover']};
        }}
        window#mintbook-app-grid .folder-subtitle {{
          color: {c['dim']};
          font: 500 14px Inter;
        }}
        window#mintbook-app-grid scrollbar slider {{
          min-width: 7px;
          min-height: 36px;
          background-color: {c['dim']};
          border: 0;
          border-radius: 999px;
        }}
        '''
        provider = Gtk.CssProvider()
        provider.load_from_data(css.encode())
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def build(self):
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.win.add(root)

        topbar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        topbar.get_style_context().add_class('topbar')
        root.pack_start(topbar, False, False, 0)

        close = self.icon_button('close', '', 'Close applications')
        close.get_style_context().add_class('close-button')
        close.connect('clicked', lambda *_: self.win.destroy())
        topbar.pack_start(close, False, False, 0)

        self.back = self.icon_button('back', '', 'Back to all applications')
        self.back.get_style_context().add_class('back-button')
        self.back.connect('clicked', lambda *_: self.show_group(None))
        self.back.set_no_show_all(True)
        topbar.pack_start(self.back, False, False, 0)

        self.session_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        topbar.pack_start(self.session_box, False, False, 0)

        actions = (
            ('lock', 'Lock', ['xflock4'], False),
            ('logout', 'Log Out', ['xfce4-session-logout', '--logout'], True),
            ('restart', 'Restart', ['xfce4-session-logout', '--reboot'], True),
            ('power', 'Shut Down', ['xfce4-session-logout', '--halt'], True),
        )
        for icon, label, command, confirm in actions:
            button = self.icon_button(icon, label, label)
            button.get_style_context().add_class('session-button')
            button.connect('clicked', self.session_action, label, command, confirm)
            self.session_box.pack_start(button, False, False, 0)

        self.confirm_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        self.confirm_box.set_no_show_all(True)
        self.confirm_label = Gtk.Label(label='')
        self.confirm_label.get_style_context().add_class('confirm-label')
        self.confirm_cancel = Gtk.Button(label='Cancel')
        self.confirm_cancel.set_relief(Gtk.ReliefStyle.NONE)
        self.confirm_cancel.get_style_context().add_class('session-button')
        self.confirm_cancel.connect('clicked', lambda *_: self.cancel_confirm())
        self.confirm_ok = Gtk.Button(label='Confirm')
        self.confirm_ok.set_relief(Gtk.ReliefStyle.NONE)
        self.confirm_ok.get_style_context().add_class('session-button')
        self.confirm_ok.get_style_context().add_class('confirm-danger')
        self.confirm_ok.connect('clicked', lambda *_: self.execute_pending_action())
        for child in (self.confirm_label, self.confirm_cancel, self.confirm_ok):
            child.show()
            self.confirm_box.pack_start(child, False, False, 0)
        topbar.pack_start(self.confirm_box, False, False, 0)

        self.title = Gtk.Label(label='Applications')
        self.title.get_style_context().add_class('app-title')
        self.title.set_margin_start(22)
        topbar.pack_start(self.title, False, False, 0)

        hint = Gtk.Label(label='Just start typing  \u00b7  Overview search')
        hint.get_style_context().add_class('search-hint')
        topbar.pack_end(hint, False, False, 8)

        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.set_overlay_scrolling(True)
        scroll.set_margin_start(24)
        scroll.set_margin_end(24)
        scroll.set_margin_top(12)
        scroll.set_margin_bottom(14)
        root.pack_start(scroll, True, True, 0)

        self.scroll = scroll
        self.flow = Gtk.FlowBox()
        self.flow.set_homogeneous(True)
        self.flow.set_selection_mode(Gtk.SelectionMode.NONE)
        self.flow.set_row_spacing(4)
        self.flow.set_column_spacing(4)
        # Eight generous tiles fit on the target 2304px display. Narrower
        # screens reflow down to four columns instead of shrinking the content.
        self.flow.set_min_children_per_line(4)
        self.flow.set_max_children_per_line(max(4, min(8, self.geometry.width // 270)))
        scroll.add(self.flow)

        self.grouped_apps = self.group_applications(self.applications())
        self.populate_flow(None)

        Gtk.Widget.set_opacity(self.win, 0.0)
        self.win.show_all()
        self.win.present()
        self.win.grab_focus()
        t0 = time.monotonic()

        def fade():
            f = min(1.0, (time.monotonic() - t0) / 0.095)
            Gtk.Widget.set_opacity(self.win, f * f * (3 - 2 * f))
            return f < 1.0

        GLib.timeout_add(16, fade)

    @staticmethod
    def applications():
        apps = [app for app in Gio.AppInfo.get_all()
                if app.should_show() and app.get_id() != 'mintbook-app-grid.desktop']
        unique = {}
        for app in apps:
            key = app.get_id() or app.get_executable() or app.get_display_name()
            unique.setdefault(key, app)
        return sorted(unique.values(), key=lambda app: app.get_display_name().casefold())

    @staticmethod
    def group_for_app(app):
        app_id = app.get_id() or ''
        categories = set(filter(None, (app.get_categories() or '').split(';')))
        if app_id in PRIMARY_SETTINGS_APPS:
            return None
        if 'Settings' in categories or 'HardwareSettings' in categories:
            return 'settings'
        if app_id in SYSTEM_TOOL_APPS:
            return 'system'
        return None

    @classmethod
    def group_applications(cls, apps):
        grouped = {None: [], **{key: [] for key, *_rest in GROUPS}}
        for app in apps:
            grouped[cls.group_for_app(app)].append(app)
        return grouped

    @staticmethod
    def folder_preview_apps(apps):
        """Up to four representative apps for the 2x2 folder icon."""
        return list(apps[:4])

    def populate_flow(self, group_key):
        for child in self.flow.get_children():
            self.flow.remove(child)

        if group_key is None:
            items = [(app.get_display_name(), self.app_button(app))
                     for app in self.grouped_apps[None]]
            for key, label, icon, subtitle in GROUPS:
                apps = self.grouped_apps[key]
                if apps:
                    items.append((label, self.folder_button(
                        key, label, icon, subtitle, apps)))
            for _label, button in sorted(items, key=lambda item: item[0].casefold()):
                self.flow.add(button)
        else:
            for app in self.grouped_apps[group_key]:
                self.flow.add(self.app_button(app))
        self.flow.show_all()

    def show_group(self, group_key):
        self.cancel_confirm()
        self.current_group = group_key
        label = next((label for key, label, *_rest in GROUPS if key == group_key), None)
        self.title.set_text(label or 'Applications')
        self.title.set_margin_start(8 if group_key else 22)
        if group_key:
            self.back.show()
        else:
            self.back.hide()
        self.populate_flow(group_key)
        adjustment = self.scroll.get_vadjustment()
        adjustment.set_value(adjustment.get_lower())

    def folder_button(self, key, label, icon_name, subtitle, apps):
        count = len(apps) if hasattr(apps, '__len__') else int(apps)
        preview = self.folder_preview_apps(apps) if hasattr(apps, '__getitem__') else []
        button = Gtk.Button()
        button.get_style_context().add_class('app-tile')
        button.set_relief(Gtk.ReliefStyle.NONE)
        button.set_tooltip_text(f'{label} \u00b7 {count} applications')

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=7)
        box.set_valign(Gtk.Align.CENTER)
        folder_icon = FolderIcon(preview, self.colors)
        if folder_icon.pixbufs:
            image = folder_icon
        else:
            image = Gtk.Image.new_from_icon_name(icon_name, Gtk.IconSize.DIALOG)
            image.set_pixel_size(128)
        box.pack_start(image, False, False, 0)
        box.pack_start(Gtk.Label(label=label), False, False, 0)
        detail = Gtk.Label(label=f'{subtitle}  \u00b7  {count}')
        detail.get_style_context().add_class('folder-subtitle')
        detail.set_ellipsize(Pango.EllipsizeMode.END)
        detail.set_max_width_chars(22)
        box.pack_start(detail, False, False, 0)
        button.add(box)
        button.connect('clicked', lambda *_: self.show_group(key))
        return button

    def app_button(self, app):
        button = Gtk.Button()
        button.get_style_context().add_class('app-tile')
        button.set_relief(Gtk.ReliefStyle.NONE)
        button.set_tooltip_text(app.get_description() or app.get_display_name())

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.set_valign(Gtk.Align.CENTER)
        icon = app.get_icon()
        image = Gtk.Image.new_from_gicon(icon, Gtk.IconSize.DIALOG) if icon else Gtk.Image()
        image.set_pixel_size(128)
        box.pack_start(image, False, False, 0)

        label = Gtk.Label(label=app.get_display_name())
        label.set_ellipsize(Pango.EllipsizeMode.END)
        label.set_max_width_chars(24)
        label.set_justify(Gtk.Justification.CENTER)
        box.pack_start(label, False, False, 0)
        button.add(box)
        button.connect('clicked', self.launch_app, app)
        return button

    def icon_button(self, icon_name, label, tooltip):
        button = Gtk.Button()
        button.set_relief(Gtk.ReliefStyle.NONE)
        button.set_tooltip_text(tooltip)
        image = ActionIcon(icon_name, self.colors['fg'])
        if label:
            box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            box.pack_start(image, False, False, 0)
            box.pack_start(Gtk.Label(label=label), False, False, 0)
            button.add(box)
        else:
            button.add(image)
        return button

    def draw_background(self, widget, cr):
        width = widget.get_allocated_width()
        height = widget.get_allocated_height()
        top, bottom = self.colors['top'], self.colors['bottom']
        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.set_source_rgba(0, 0, 0, 0)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)
        gradient = cairo.LinearGradient(0, 0, 0, height)
        gradient.add_color_stop_rgba(0, top[0] / 255, top[1] / 255, top[2] / 255, top[3])
        gradient.add_color_stop_rgba(1, bottom[0] / 255, bottom[1] / 255,
                                     bottom[2] / 255, bottom[3])
        cr.set_source(gradient)
        cr.rectangle(0, 0, width, height)
        cr.fill()
        cr.set_source_rgba(1, 1, 1, .12)
        cr.rectangle(0, 0, width, 1)
        cr.fill()
        return False

    def on_key(self, _widget, event):
        if event.keyval == Gdk.KEY_Escape and self.pending_action:
            self.cancel_confirm()
            return True
        if event.keyval in (Gdk.KEY_Escape, Gdk.KEY_BackSpace) and self.current_group:
            self.show_group(None)
            return True
        if event.keyval == Gdk.KEY_Escape or event.keyval in (Gdk.KEY_Super_L, Gdk.KEY_Super_R):
            self.win.destroy()
            return True

        blocked = (Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.MOD1_MASK |
                   Gdk.ModifierType.SUPER_MASK)
        codepoint = Gdk.keyval_to_unicode(event.keyval)
        if codepoint and not (event.state & blocked):
            char = chr(codepoint)
            if char.isprintable() and not char.isspace():
                self.handoff_to_overview(char)
                return True
        return False

    def handoff_to_overview(self, text):
        if self.handing_off:
            return
        self.handing_off = True
        self.win.hide()
        subprocess.Popen([OVERVIEW, '--filter', text], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        GLib.timeout_add(80, self.win.destroy)

    def launch_app(self, _button, app):
        context = Gdk.Display.get_default().get_app_launch_context()
        try:
            app.launch([], context)
        except GLib.Error as error:
            print(f'app-grid: {error.message}', file=sys.stderr)
            return
        self.win.destroy()

    def session_action(self, _button, label, command, confirm):
        if confirm:
            self.pending_action = (label, list(command))
            if hasattr(self, 'confirm_label'):
                self.confirm_label.set_text(f'{label}?  Open apps will close.')
                self.confirm_ok.set_label(label)
                self.session_box.hide()
                self.confirm_box.show()
                self.confirm_ok.grab_focus()
            return
        self.run_session_command(command)

    def cancel_confirm(self):
        self.pending_action = None
        if hasattr(self, 'confirm_box'):
            self.confirm_box.hide()
            self.session_box.show()

    def execute_pending_action(self):
        if not self.pending_action:
            return
        _label, command = self.pending_action
        self.pending_action = None
        self.run_session_command(command)

    def run_session_command(self, command):
        self.win.hide()
        subprocess.Popen(command, start_new_session=True, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL)
        self.win.destroy()

    @staticmethod
    def on_destroy(*_args):
        Gtk.main_quit()


def load_module(name):
    loader = importlib.machinery.SourceFileLoader(name, os.path.join(BIN, name + '.py'))
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
    loader.exec_module(module)
    return module


def single_instance():
    if not load_module('mintbook_instance').claim(PIDFILE, 'app-grid', signal.SIGTERM):
        raise SystemExit(0)


def main():
    single_instance()
    Gdk.set_program_class('mintbook-app-grid')
    grid = AppGrid()
    signal.signal(signal.SIGTERM, lambda *_: GLib.idle_add(grid.win.destroy))
    Gtk.main()
    try:
        os.unlink(PIDFILE)
    except OSError:
        pass


if __name__ == '__main__':
    main()
