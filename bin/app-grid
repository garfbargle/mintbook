# Adwaita before the Gtk import, for the reason bin/control-center and
# bin/bt-menu give: Gtk.init parses the GTK theme, WhiteSur's gtk.css is
# 400 KB, and that is ~120 ms of every launch spent on a stylesheet this
# window never reads a rule from. The icon theme comes from GtkSettings, not
# GTK_THEME, so full-colour app icons stay on WhiteSur-light.
os.environ.setdefault('GTK_THEME', 'Adwaita')

import cairo
import gi

gi.require_version('Gtk', '3.0')
gi.require_version('Gdk', '3.0')
gi.require_version('Gio', '2.0')
from gi.repository import Gdk, Gio, GLib, Gtk, Pango


HOME = os.path.expanduser('~')
BIN = os.path.dirname(os.path.realpath(__file__))
PIDFILE = os.path.join(HOME, '.cache', 'mintbook', 'app-grid.pid')
APPLIED = os.path.join(HOME, '.config', 'mintbook', 'appearance.applied')
OVERVIEW = os.path.join(HOME, '.local', 'bin', 'overview')

