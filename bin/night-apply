#!/usr/bin/env python3
"""Start, force, or stop redshift. Mode persists in ~/.config/mintbook/night.mode.

  night-apply           apply the saved mode (default: auto)
  night-apply auto|on|off

Auto follows sunset/sunrise from ~/.config/redshift.conf. On locks the night
temperature. Off resets the LUT. redshift-gtk is not used — this is the
session copy, started from autostart.
"""
import fcntl
import os
import signal
import subprocess
import sys
import time

MODES = ('auto', 'on', 'off')
MODE_FILE = os.path.expanduser('~/.config/mintbook/night.mode')
CONF = os.path.expanduser('~/.config/redshift.conf')
LOCK_FILE = os.path.expanduser('~/.cache/mintbook/night-apply.lock')

# There used to be a refresh_panel() here, telling genmon plugin-23 to
# repaint after a change. The moon left the bar on 2026-09-06 for the 50-night
# tile, so it has had nothing to tell since — and the event it sent never
# reached a plugin even when the moon was there, because the panel matches on
# the plugin name. See docs/desktop.md.


def read_mode():
    try:
        m = open(MODE_FILE).read().strip()
    except OSError:
        return 'auto'
    return m if m in MODES else 'auto'


def write_mode(mode):
    os.makedirs(os.path.dirname(MODE_FILE), exist_ok=True)
    tmp = MODE_FILE + '.tmp'
    with open(tmp, 'w') as f:
        f.write(mode + '\n')
    os.replace(tmp, MODE_FILE)


def night_temp():
    try:
        for line in open(CONF):
            line = line.split(';', 1)[0].strip()
            if line.startswith('temp-night='):
                return int(line.split('=', 1)[1])
    except (OSError, ValueError):
        pass
    return 3500


def redshift_daemon_pids():
    """Pids of redshift adjusting the LUT — not `redshift -p` from the panel."""
    pids = []
    try:
        names = os.listdir('/proc')
    except OSError:
        return pids
    for name in names:
        if not name.isdigit():
            continue
        try:
            if os.stat(f'/proc/{name}').st_uid != os.getuid():
                continue
            raw = open(f'/proc/{name}/cmdline', 'rb').read().split(b'\0')
        except OSError:
            continue
        if not raw or not raw[0]:
            continue
        base = os.path.basename(raw[0].decode(errors='replace'))
        if base != 'redshift':
            continue
        args = [a.decode(errors='replace') for a in raw[1:] if a]
        if '-p' in args or '--print' in args:
            continue
        pids.append(int(name))
    return pids


def stop_redshift():
    subprocess.run(
        ['pkill', '-f', '/usr/bin/redshift-gtk'],
        capture_output=True)
    subprocess.run(
        ['pkill', '-f', '/usr/bin/gtk-redshift'],
        capture_output=True)
    pids = redshift_daemon_pids()
    for pid in pids:
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
    deadline = time.time() + 1.5
    while time.time() < deadline and redshift_daemon_pids():
        time.sleep(0.05)
    for pid in redshift_daemon_pids():
        try:
            os.kill(pid, signal.SIGKILL)
        except OSError:
            pass
    subprocess.run(['redshift', '-x'], capture_output=True)


def start_redshift(args):
    subprocess.Popen(
        ['redshift', '-c', CONF, *args],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def apply(mode):
    if not os.path.isfile(CONF):
        sys.stderr.write(f'missing {CONF}\n')
        return 1
    write_mode(mode)
    unit = subprocess.run(['systemctl', '--user', 'show', 'mintbook-redshift.service',
                           '-p', 'LoadState', '--value'], capture_output=True, text=True, timeout=3)
    if unit.returncode == 0 and unit.stdout.strip() == 'loaded':
        # Off means neutral colour while retaining software brightness.
        return subprocess.run(['systemctl', '--user', 'restart', 'mintbook-redshift.service'],
                              timeout=5).returncode
    stop_redshift()
    if mode == 'auto':
        start_redshift([])
    elif mode == 'on':
        t = str(night_temp())
        start_redshift(['-t', f'{t}:{t}'])
    return 0


def main():
    if len(sys.argv) > 2 or (len(sys.argv) == 2 and sys.argv[1] not in MODES):
        sys.stderr.write('usage: night-apply [auto|on|off]\n')
        return 2
    # The control-center tile, its old genmon menu, and autostart can all
    # launch this command.  Without a lock, two invocations can both finish
    # stop_redshift() before either starts its replacement, leaving multiple
    # Redshift daemons fighting over the RandR LUT.  Keep the whole
    # stop/reset/start sequence atomic, not just the state-file write.
    os.makedirs(os.path.dirname(LOCK_FILE), exist_ok=True)
    with open(LOCK_FILE, 'w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        mode = sys.argv[1] if len(sys.argv) == 2 else read_mode()
        rc = apply(mode)
    return rc


if __name__ == '__main__':
    sys.exit(main())
