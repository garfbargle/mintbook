#!/usr/bin/env bash
# cpu-install — the glass CPU menu behind the sparkline. No root.
# See docs/desktop.md.
#
#   bin/cpu-install            # panel-cpu + cpu-menu
#   bin/cpu-install --revert   # the bar icon opens System Monitor again
#
# The sparkline itself is plugin-19 and stays on the bar; this only installs
# what is behind the click. --revert removes the menu, and panel-cpu falls
# back to gnome-system-monitor on its own.
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
BIN="$HOME/.local/bin"

nudge() {   # re-run the first genmon widget (the sparkline) now
  # The event matches on the plugin *name*: plugin-19:refresh, which this used
  # to send, was delivered to nothing and returned FALSE. bin/cpu-hover has
  # the same working event. Only the first matching widget handles it.
  # See docs/desktop.md.
  [ -n "${DISPLAY:-}" ] || return 0
  xfce4-panel --plugin-event=genmon:refresh:bool:true >/dev/null 2>&1 || true
}

if [ "${1:-}" = --revert ]; then
  echo "==> removing the menu"
  "$ROOT/bin/cpu-hover" stop
  for f in cpu-menu; do
    P=$(cat "$HOME/.cache/mintbook/$f.pid" 2>/dev/null || true)
    [ -n "$P" ] && kill "$P" 2>/dev/null || true
  done
  rm -f "$BIN/cpu-menu" "$HOME/.cache/mintbook/cpu-menu.pid"
  rm -f "$BIN/cpu-hover" "$HOME/.cache/mintbook/cpu-hover.pid" \
        "$HOME/.cache/mintbook/cpu.hover"
  install -m755 "$ROOT/bin/panel-cpu" "$BIN/panel-cpu"
  install -m755 "$ROOT/bin/mintbook_cpu.py" "$BIN/mintbook_cpu.py"
  rm -f "$BIN/mintbook_appcolor.py"
  nudge   # and the bar goes back to a plain trace on its next tick
  echo "the bar icon opens gnome-system-monitor again"
  exit 0
fi

echo "==> $BIN"
install -dm755 "$BIN"
"$ROOT/bin/cpu-hover" stop
for f in panel-cpu cpu-menu cpu-hover mintbook_cpu.py mintbook_appcolor.py mintbook_keys.py mintbook_instance.py; do
  rm -f "$BIN/$f"
  install -m755 "$ROOT/bin/$f" "$BIN/$f"
done

nudge

echo
echo "click the CPU sparkline for the menu · Activity Monitor… for the full list"
echo "undo: $(basename "$0") --revert"
