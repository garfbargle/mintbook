#!/usr/bin/env bash
# cpu-install — the glass CPU menu behind the sparkline. No root.
# See docs/desktop.md.
#
#   bin/cpu-install            # panel-cpu + cpu-menu
#   bin/cpu-install --revert   # the bar icon opens System Monitor again
#
# The sparkline itself is plugin-19 and stays on the bar; this only installs
# what is behind the click. --revert removes the menu, and panel-cpu falls
# back to gnome-system-monitor on its own.
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
BIN="$HOME/.local/bin"

nudge() {   # genmon only re-reads its command when the plugin next ticks
  [ -n "${DISPLAY:-}" ] || return 0
  xfce4-panel --plugin-event=plugin-19:refresh:bool:true >/dev/null 2>&1 || true
}

if [ "${1:-}" = --revert ]; then
  echo "==> removing the menu"
  P=$(cat "$HOME/.cache/mintbook/cpu-menu.pid" 2>/dev/null || true)
  [ -n "$P" ] && kill "$P" 2>/dev/null || true
  rm -f "$BIN/cpu-menu" "$HOME/.cache/mintbook/cpu-menu.pid"
  install -m755 "$ROOT/bin/panel-cpu" "$BIN/panel-cpu"
  install -m755 "$ROOT/bin/mintbook_cpu.py" "$BIN/mintbook_cpu.py"
  rm -f "$BIN/mintbook_appcolor.py"
  nudge
  echo "the bar icon opens gnome-system-monitor again"
  exit 0
fi

echo "==> $BIN"
install -dm755 "$BIN"
for f in panel-cpu cpu-menu mintbook_cpu.py mintbook_appcolor.py mintbook_keys.py; do
  rm -f "$BIN/$f"
  install -m755 "$ROOT/bin/$f" "$BIN/$f"
done

nudge

echo
echo "click the CPU sparkline for the menu · Activity Monitor… for the full list"
echo "undo: $(basename "$0") --revert"
