#!/usr/bin/env bash
# CPU package temperature for xfce4-genmon-plugin.
# Finds coretemp by name (hwmon numbering is not stable across boots).
t=""
PANEL_FOREGROUND='#ffffff'
[ -r "$HOME/.config/mintbook/system-chrome.env" ] && . "$HOME/.config/mintbook/system-chrome.env"
for h in /sys/class/hwmon/hwmon*; do
    [ "$(cat "$h/name" 2>/dev/null)" = "coretemp" ] || continue
    for f in "$h"/temp*_input; do
        [ -e "$f" ] || continue
        case "$(cat "${f%_input}_label" 2>/dev/null)" in
            Package*) t=$(cat "$f" 2>/dev/null) ;;
        esac
    done
    [ -n "$t" ] || t=$(cat "$h/temp1_input" 2>/dev/null)
done
if [ -z "$t" ]; then echo "<txt>--</txt>"; exit 0; fi
c=$(( t / 1000 ))

# Smooth with an EMA (alpha 0.35) held in a state file. The raw sensor is
# instantaneous, so restarting the panel - itself a CPU burst - made the
# reading jump and then drift back. State persists across restarts, so the
# displayed value eases instead of slamming.
SF="$HOME/.cache/mintbook/temp.state"
mkdir -p "$(dirname "$SF")"
prev=$(cat "$SF" 2>/dev/null)
case "$prev" in ''|*[!0-9]*) prev=$c ;; esac
c=$(( (35 * c + 65 * prev) / 100 ))
printf '%s' "$c" > "$SF"

# warn as the fanless Core M approaches its throttle point
if   [ "$c" -ge 90 ]; then col='#ff5f56'
elif [ "$c" -ge 80 ]; then col='#ffbd2e'
else                       col="$PANEL_FOREGROUND"
fi

# Pad to a constant 3 digits with U+2007 FIGURE SPACE (exactly one digit wide)
# and render with tabular figures, so the label never changes width.
padded="$c"
while [ "${#padded}" -lt 3 ]; do padded=$' '"$padded"; done

printf '<txt><span font_features="tnum" foreground="%s">%s°C </span></txt>\n' "$col" "$padded"

# CPU is already on the bar. The hover names the other sensors that are not.
bits=''
for h in /sys/class/hwmon/hwmon*; do
    n=$(cat "$h/name" 2>/dev/null)
    v=$(cat "$h/temp1_input" 2>/dev/null)
    [ -n "$v" ] || continue
    case "$n" in
        nvme)  bits="${bits:+$bits · }SSD $(( v / 1000 ))°C" ;;
        pch_*) bits="${bits:+$bits · }PCH $(( v / 1000 ))°C" ;;
        BAT*)  bits="${bits:+$bits · }Battery $(( v / 1000 ))°C" ;;
    esac
done
if [ -n "$bits" ]; then
    printf '<tool>Temperature\n%s</tool>\n' "$bits"
else
    printf '<tool>Temperature</tool>\n'
fi
