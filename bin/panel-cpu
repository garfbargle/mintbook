#!/usr/bin/env python3
"""
CPU sparkline for xfce4-genmon-plugin.

Replaces xfce4-cpugraph-plugin, which draws hard vertical edges and offers no
control over its tooltip. This renders an SVG with the leading and trailing
edges faded out via a gradient mask, and builds a tooltip listing the top 5
processes by *interval* CPU (computed from /proc deltas, not ps's
since-process-start average, which is misleading for a live readout).

The sparkline samples every 2 s off two numbers in /proc/stat, which is cheap.
The tooltip is not: it opens /proc/<pid>/stat for every process on the machine
and writes the whole table back out. At 2 s that was 159 s of CPU in a
two-hour session. The walk now runs every PROC_EVERY-th tick into its own
state file, so the sparkline keeps its 2 s resolution and the process table
costs a third of what it did. The tooltip's CPU header stays live every tick;
only the per-process rows can be up to PROC_EVERY ticks old, and nothing reads
them until the pointer is over the plugin anyway. See docs/desktop.md.
"""
import os, sys

W, H      = 92, 36          # canvas; height sits inside the 52px bar
HIST      = 46              # samples retained
STATE     = os.path.expanduser('~/.cache/mintbook/cpu.state')
PROCS     = os.path.expanduser('~/.cache/mintbook/cpu.procs')
PROC_EVERY = 3              # walk /proc every Nth tick (2 s tick -> every 6 s)
FADE      = 0.16            # fraction of width faded at each edge
NCPU      = os.cpu_count() or 1
CLK       = os.sysconf('SC_CLK_TCK')

def read_state():
    """total, idle, history, tick counter and the cached top-5 rows.

    Small, rewritten every tick.
    """
    try:
        with open(STATE) as f:
            parts = f.read().split('\n')
        total = int(parts[0]); idle = int(parts[1])
        hist  = [float(x) for x in parts[2].split(',') if x]
        tick  = int(parts[3])
        top   = []
        for fld in parts[4].split('\x1e'):
            if not fld: continue
            v, name = fld.split('\x1f', 1)
            top.append((float(v), name))
        return total, idle, hist, tick, top
    except Exception:
        return None, None, [], -1, []


def read_procs():
    """The process table, and the /proc/stat total it was taken against.

    Its own file because it is ~200 lines and only rewritten every
    PROC_EVERY ticks — keeping it here is what makes that saving real.
    """
    try:
        with open(PROCS) as f:
            parts = f.read().split('\n')
        proc_total = int(parts[0])
        procs = {}
        for ln in parts[1:]:
            if not ln: continue
            pid, t, name = ln.split(' ', 2)
            procs[pid] = (int(t), name)
        return proc_total, procs
    except Exception:
        return None, {}


def write_atomic(path, text):
    tmp = path + '.tmp'
    with open(tmp, 'w') as f:
        f.write(text)
    os.replace(tmp, path)

def cpu_totals():
    with open('/proc/stat') as f:
        v = [int(x) for x in f.readline().split()[1:]]
    idle = v[3] + (v[4] if len(v) > 4 else 0)
    return sum(v), idle

def proc_times():
    out = {}
    for pid in os.listdir('/proc'):
        if not pid.isdigit(): continue
        try:
            with open(f'/proc/{pid}/stat') as f:
                s = f.read()
            name  = s[s.index('(')+1 : s.rindex(')')]
            rest  = s[s.rindex(')')+2:].split()
            out[pid] = (int(rest[11]) + int(rest[12]), name)   # utime + stime
        except Exception:
            continue
    return out

def area_path(hist):
    if len(hist) < 2:
        return None
    n = len(hist)
    step = W / (n - 1)
    pts = []
    for i, v in enumerate(hist):
        x = i * step
        y = H - (max(0.0, min(100.0, v)) / 100.0) * (H - 1) - 0.5
        pts.append(f'{x:.1f} {y:.1f}')
    return f'M0 {H} L' + ' L'.join(pts) + f' L{W} {H} Z'

HEX = set('0123456789abcdefABCDEF')


def panel_foreground():
    """The bar's ink, from the file bin/appearance-mode writes.

    That file is shell and used to be written with printf %q, so '#ffffff' was
    stored as '\\#ffffff'. Sourcing it gives the right value back; reading the
    line as text does not, and fill="\\#ffffff" is not a colour — librsvg
    drops it and paints black, which is why this trace stayed black on the dark
    bar. The writer no longer escapes; the backslash is stripped here too so an
    env file left by an older appearance-mode still comes out right, and
    anything that is not a hex colour falls back rather than painting black.
    """
    try:
        for line in open(os.path.expanduser('~/.config/mintbook/system-chrome.env')):
            if line.startswith('PANEL_FOREGROUND='):
                v = line.split('=', 1)[1].strip().strip("'\"").replace('\\', '')
                if v[:1] == '#' and len(v) in (4, 7, 9) and set(v[1:]) <= HEX:
                    return v
    except OSError:
        pass
    return '#ffffff'

def render(hist, path_out):
    color = panel_foreground()
    d = area_path(hist)
    body = '' if not d else (
        f'  <g mask="url(#fade)">\n'
        f'    <path d="{d}" fill="{color}" fill-opacity="0.82"/>\n'
        f'  </g>\n')
    svg = (
f'''<svg width="{W}" height="{H}" viewBox="0 0 {W} {H}" xmlns="http://www.w3.org/2000/svg">
 <defs>
  <linearGradient id="g" x1="0" y1="0" x2="1" y2="0">
   <stop offset="0" stop-color="#fff" stop-opacity="0"/>
   <stop offset="{FADE}" stop-color="#fff" stop-opacity="1"/>
   <stop offset="{1-FADE}" stop-color="#fff" stop-opacity="1"/>
   <stop offset="1" stop-color="#fff" stop-opacity="0"/>
  </linearGradient>
  <mask id="fade"><rect width="{W}" height="{H}" fill="url(#g)"/></mask>
 </defs>
{body}</svg>
''')
    write_atomic(path_out, svg)

def main():
    out_svg = os.path.expanduser('~/.cache/mintbook/cpu.svg')
    ptotal, pidle, hist, ptick, top = read_state()
    total, idle = cpu_totals()

    # The sparkline: two numbers, every tick.
    if ptotal is None or total <= ptotal:
        pct = 0.0
    else:
        dt, di = total - ptotal, idle - pidle
        pct = max(0.0, min(100.0, 100.0 * (dt - di) / dt))

    # The tooltip: every process on the machine, every PROC_EVERY ticks. Its
    # delta is measured against the /proc/stat total stored alongside the
    # table, not against the previous tick, so the percentages stay correct
    # over the longer interval.
    tick = ptick + 1
    if tick % PROC_EVERY == 0:
        procs = proc_times()
        proc_total, pprocs = read_procs()
        if proc_total is not None and total > proc_total:
            dtp = total - proc_total
            top = []
            for pid, (t, name) in procs.items():
                pt = pprocs.get(pid)
                if not pt: continue
                d = t - pt[0]
                if d > 0:
                    top.append((100.0 * d / dtp * NCPU, name))
            top.sort(reverse=True)
            top = top[:5]
        write_atomic(PROCS, f'{total}\n' +
                     '\n'.join(f'{p} {t} {n}' for p, (t, n) in procs.items()))

    hist.append(pct)
    hist = hist[-HIST:]
    render(hist, out_svg)

    write_atomic(STATE,
                 f'{total}\n{idle}\n'
                 + ','.join(f'{v:.1f}' for v in hist) + '\n'
                 + f'{tick}\n'
                 + '\x1e'.join(f'{v:.1f}\x1f{n}' for v, n in top) + '\n')

    # Monospace, or the columns will not line up - GTK tooltips otherwise
    # render in a proportional font and space-padding does nothing.
    rows = ''.join(f'\n{n[:16]:<16}{v:>6.1f}%' for v, n in top)
    tip = ('<span font_family="monospace">'
           f'{"CPU":<16}{pct:>6.1f}%{rows}</span>')
    print(f'<img>{out_svg}</img>')
    print(f'<tool>{tip}</tool>')
    print('<click>gnome-system-monitor</click>')

if __name__ == '__main__':
    main()
