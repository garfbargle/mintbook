#!/usr/bin/env python3
"""
CPU sparkline for xfce4-genmon-plugin.

Replaces xfce4-cpugraph-plugin, which draws hard vertical edges and offers no
control over its tooltip. This renders an SVG with the leading and trailing
edges faded out via a gradient mask. The tooltip is the widget name and the
current percentage — the same shape Overview uses — and the process story
lives in the glass menu behind the click.

Hovering the bar colours it. genmon has no hover to offer — it renders an
image and a text tooltip — so bin/cpu-hover watches the plugin's own X window
and drops a flag file when the pointer arrives. This then paints the same
stacked bands the menu paints, in the same icon colours, over the same ~96 s
the resting trace covers; the pointer leaves and it is a plain trace in the
panel foreground again. A run that arrives within MIN_TICK of the last one is
that repaint and not a sample: measuring a 100 ms interval would put a spike
in the history and walk /proc a tick early.

The sparkline samples every 2 s off two numbers in /proc/stat, which is cheap.
The /proc walk is not: it opens /proc/<pid>/stat for every process on the
machine. At 2 s that was 159 s of CPU in a two-hour session. The walk now runs
every PROC_EVERY-th tick into its own state file, so the sparkline keeps its
2 s resolution and the process table costs a third of what it did. That
walk writes cpu.stack: the top processes' share of the machine, RSS, and the
I/O they did in the interval. The menu paints those samples as a stacked
chart. I/O is opened only for the top N, not for every pid — the walk's cost
stays the /proc/stat pass. See docs/desktop.md.
"""
import os, sys
import fcntl
import signal
import subprocess
import time

W, H      = 92, 36          # canvas; height sits inside the 52px bar
HIST      = 46              # samples retained
STATE     = os.path.expanduser('~/.cache/mintbook/cpu.state')
PROCS     = os.path.expanduser('~/.cache/mintbook/cpu.procs')
PROC_EVERY = 3              # walk /proc every Nth tick (2 s tick -> every 6 s)
HOVER     = os.path.expanduser('~/.cache/mintbook/cpu.hover')
WATCH_PID = os.path.expanduser('~/.cache/mintbook/cpu-hover.pid')
MIN_TICK  = 0.6             # a run this soon after the last is a repaint
WATCH_CHILD = None          # reaped by the resident collector on its next tick
WATCH_RETRY = 30            # seconds before trying a failed watcher again
FADE      = 0.16            # fraction of width faded at each edge
NCPU      = os.cpu_count() or 1
CLK       = os.sysconf('SC_CLK_TCK')
PAGE      = os.sysconf('SC_PAGESIZE') or 4096
TOP_N     = 8
MENU      = os.path.expanduser('~/.local/bin/cpu-menu')
WATCHER   = os.path.join(os.path.dirname(os.path.realpath(__file__)), 'cpu-hover')


def appcolor_lib():
    """The colour cache. stdlib-only to read — Gtk is cpu-hover's business."""
    sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
    import mintbook_appcolor
    return mintbook_appcolor


def cpu_lib():
    """Imported only on the process-walk tick. mintbook_cpu is ~8 ms of
    python3 startup, and two of every three ticks never touch it."""
    sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
    import mintbook_cpu
    return mintbook_cpu

def read_state():
    """total, idle, history and tick counter. Small, rewritten every tick."""
    try:
        with open(STATE) as f:
            parts = f.read().split('\n')
        total = int(parts[0]); idle = int(parts[1])
        hist  = [float(x) for x in parts[2].split(',') if x]
        tick  = int(parts[3])
        return total, idle, hist, tick
    except Exception:
        return None, None, [], -1


def read_procs():
    """The process table, and the /proc/stat totals it was taken against.

    Its own file because it is ~200 lines and only rewritten every
    PROC_EVERY ticks — keeping it here is what makes that saving real.
    Line 0 is `total idle` so the stacked sample's busy % covers the same
    interval as the per-process shares. Older files were total-only.
    """
    try:
        with open(PROCS) as f:
            parts = f.read().split('\n')
        head = parts[0].split()
        proc_total = int(head[0])
        proc_idle = int(head[1]) if len(head) > 1 else None
        procs = {}
        for ln in parts[1:]:
            if not ln: continue
            pid, t, name = ln.split(' ', 2)
            procs[pid] = (int(t), name)
        return proc_total, proc_idle, procs
    except Exception:
        return None, None, {}


def write_atomic(path, text):
    tmp = path + '.tmp'
    with open(tmp, 'w') as f:
        f.write(text)
    os.replace(tmp, path)

def cpu_totals():
    with open('/proc/stat') as f:
        v = [int(x) for x in f.readline().split()[1:]]
    idle = v[3] + (v[4] if len(v) > 4 else 0)
    return sum(v), idle

def proc_times():
    out = {}
    for pid in os.listdir('/proc'):
        if not pid.isdigit(): continue
        try:
            with open(f'/proc/{pid}/stat') as f:
                s = f.read()
            name  = s[s.index('(')+1 : s.rindex(')')]
            rest  = s[s.rindex(')')+2:].split()
            # utime + stime, comm, rss pages — rss is already in this file.
            out[pid] = (int(rest[11]) + int(rest[12]), name, int(rest[21]))
        except Exception:
            continue
    return out

def area_path(hist):
    if len(hist) < 2:
        return None
    n = len(hist)
    step = W / (n - 1)
    pts = []
    for i, v in enumerate(hist):
        x = i * step
        y = H - (max(0.0, min(100.0, v)) / 100.0) * (H - 1) - 0.5
        pts.append(f'{x:.1f} {y:.1f}')
    return f'M0 {H} L' + ' L'.join(pts) + f' L{W} {H} Z'

HEX = set('0123456789abcdefABCDEF')


def panel_foreground():
    """The bar's ink, from the file bin/appearance-mode writes.

    That file is shell and used to be written with printf %q, so '#ffffff' was
    stored as '\\#ffffff'. Sourcing it gives the right value back; reading the
    line as text does not, and fill="\\#ffffff" is not a colour — librsvg
    drops it and paints black, which is why this trace stayed black on the dark
    bar. The writer no longer escapes; the backslash is stripped here too so an
    env file left by an older appearance-mode still comes out right, and
    anything that is not a hex colour falls back rather than painting black.
    """
    try:
        for line in open(os.path.expanduser('~/.config/mintbook/system-chrome.env')):
            if line.startswith('PANEL_FOREGROUND='):
                v = line.split('=', 1)[1].strip().strip("'\"").replace('\\', '')
                if v[:1] == '#' and len(v) in (4, 7, 9) and set(v[1:]) <= HEX:
                    return v
    except OSError:
        pass
    return '#ffffff'

def bar_is_dark(color):
    """White ink means a slate bar; the bands need the lighter tints."""
    try:
        value = color.lstrip('#')
        if len(value) == 3:
            value = ''.join(c * 2 for c in value)
        r, g, b = (int(value[i:i + 2], 16) for i in (0, 2, 4))
    except (ValueError, IndexError):
        return True
    return (0.299 * r + 0.587 * g + 0.114 * b) / 255 > 0.5


def band_path(xs, low, high):
    up = ' L'.join(f'{x:.1f} {y:.1f}' for x, y in zip(xs, low))
    down = ' L'.join(f'{x:.1f} {y:.1f}' for x, y in zip(reversed(xs), reversed(high)))
    return f'M{up} L{down} Z'


def stacked_body(fg):
    """The bands, as SVG, or '' when there is no process history to stack.

    Same shape as the menu's chart: everything the top rows do not account for
    sits at the bottom in the panel's own ink, and the named processes stack on
    top of it in their apps' colours.
    """
    mcpu = cpu_lib()
    samples, keys = mcpu.bar_stack()
    if len(samples) < 2:
        return ''
    appcolor = appcolor_lib()
    bases = appcolor.read_cache(
        sig=appcolor.signature(theme=appcolor.icon_theme_name()))
    colors = appcolor.band_colors(keys, bases, bar_is_dark(fg))
    series, other, _busy = mcpu.series_for(samples, keys)
    n = len(samples)
    xs = [i * W / (n - 1) for i in range(n)]

    def ys(values):
        return [H - max(0.0, min(100.0, v)) / 100.0 * (H - 1) - 0.5
                for v in values]

    baseline = [0.0] * n
    out = []
    ranked = sorted(keys, key=lambda key: -sum(series.get(key, ())))
    for color, values, opacity in (
            [(fg, other, 0.22)]
            + [('#%02x%02x%02x' % colors[key], series.get(key, [0] * n), 0.9)
               for key in ranked]):
        top = [b + v for b, v in zip(baseline, values)]
        out.append(f'    <path d="{band_path(xs, ys(baseline), ys(top))}" '
                   f'fill="{color}" fill-opacity="{opacity}"/>')
        baseline = top
    return '  <g mask="url(#fade)">\n' + '\n'.join(out) + '\n  </g>\n'


def render(hist, path_out, hovering=False):
    color = panel_foreground()
    body = ''
    if hovering:
        try:
            body = stacked_body(color)
        except Exception:
            body = ''      # a colourless bar beats no bar
    if not body:
        d = area_path(hist)
        body = '' if not d else (
            f'  <g mask="url(#fade)">\n'
            f'    <path d="{d}" fill="{color}" fill-opacity="0.82"/>\n'
            f'  </g>\n')
    svg = (
f'''<svg width="{W}" height="{H}" viewBox="0 0 {W} {H}" xmlns="http://www.w3.org/2000/svg">
 <defs>
  <linearGradient id="g" x1="0" y1="0" x2="1" y2="0">
   <stop offset="0" stop-color="#fff" stop-opacity="0"/>
   <stop offset="{FADE}" stop-color="#fff" stop-opacity="1"/>
   <stop offset="{1-FADE}" stop-color="#fff" stop-opacity="1"/>
   <stop offset="1" stop-color="#fff" stop-opacity="0"/>
  </linearGradient>
  <mask id="fade"><rect width="{W}" height="{H}" fill="url(#g)"/></mask>
 </defs>
{body}</svg>
''')
    write_atomic(path_out, svg)

def hovering():
    return os.path.exists(HOVER)


def state_age():
    try:
        return time.time() - os.stat(STATE).st_mtime
    except OSError:
        return None


def watcher_matches(pid):
    """A stale pidfile must never signal a different process after PID reuse."""
    if pid <= 1:
        return False
    try:
        with open(f'/proc/{pid}/cmdline', 'rb') as handle:
            args = handle.read().decode().split('\0')
        expected = {os.path.realpath(WATCHER),
                    os.path.realpath(os.path.expanduser('~/.local/bin/cpu-hover'))}
        return (os.path.basename(args[0]) == 'xdotool' and 'behave' in args and
                any(os.path.realpath(a) in expected for a in args if a.startswith('/')))
    except (OSError, UnicodeError, IndexError):
        return False


def wrapper_matches(pid):
    try:
        with open(f'/proc/{pid}/cmdline', 'rb') as handle:
            args = handle.read().decode().split('\0')
        return any('libgenmon.so' in arg for arg in args)
    except (OSError, UnicodeError):
        return False


def ensure_watcher():
    """Keep bin/cpu-hover alive, without an autostart entry to install.

    genmon runs this every two seconds, so the cheapest supervisor is here:
    one stat, one read, a handful of /proc lookups. The watchers are xdotool
    blocked on the X socket — nothing until the pointer arrives. The pidfile
    also names the panel wrapper they are watching, because a panel restart
    leaves them alive and pointed at a window that is gone. Half a watcher is
    no watcher, so a survivor is killed rather than left listening, and a flag
    left behind by a hover that never got its leave goes too.
    """
    global WATCH_CHILD
    if WATCH_CHILD is not None and WATCH_CHILD.poll() is not None:
        WATCH_CHILD = None
    if not os.environ.get('DISPLAY') or not os.access(WATCHER, os.X_OK):
        return
    watchers = []
    stamp = 0
    try:
        stamp = os.stat(WATCH_PID).st_mtime
        with open(WATCH_PID) as f:
            lines = f.read().split('\n')
        watchers = [int(p) for p in lines[0].split()]
        wrappers = [int(p) for p in lines[1].split()]
        if (len(watchers) == 2 and all(watcher_matches(pid) for pid in watchers)
                and len(wrappers) == 1 and wrapper_matches(wrappers[0])):
            return
    except (OSError, ValueError, IndexError):
        pass  # retain the failed attempt timestamp, including an empty pidfile
    for pid in watchers:
        if not watcher_matches(pid):
            continue
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
    if time.time() - stamp < WATCH_RETRY:
        return              # it failed a moment ago; do not spawn once a tick
    try:
        os.remove(HOVER)
    except OSError:
        pass
    # Popen performs the exec without running Python callbacks after fork;
    # the collector also has worker/GIO threads, unlike a genmon one-shot.
    env = {key: value for key, value in os.environ.items() if key not in ('NOTIFY_SOCKET', 'WATCHDOG_USEC', 'WATCHDOG_PID')}
    WATCH_CHILD = subprocess.Popen([WATCHER, 'watch'], start_new_session=True,
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=env)


def emit(pct):
    click = MENU if os.access(MENU, os.X_OK) else 'gnome-system-monitor'
    print(f'<img>{os.path.expanduser("~/.cache/mintbook/cpu.svg")}</img>')
    print(f'<tool>CPU\n{pct:.0f}%</tool>')
    print(f'<click>{click}</click>')
    print(f'<iconclick>{click}</iconclick>')


def main():
    # Hover refreshes and scheduled ticks share files. A nonblocking lock
    # makes a concurrent invocation a display-only read instead of two writers.
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    with open(STATE + '.lock', 'a') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            hist = read_state()[2]
            emit(hist[-1] if hist else 0.0)
            return
        sample_and_render()


def sample_and_render():
    out_svg = os.path.expanduser('~/.cache/mintbook/cpu.svg')
    ensure_watcher()
    age = state_age()
    if age is not None and 0 <= age < MIN_TICK:
        # cpu-hover asked genmon to re-run us so the picture could change.
        # There is nothing to measure in 100 ms: repaint and say nothing new.
        hist = read_state()[2]
        render(hist, out_svg, hovering())
        emit(hist[-1] if hist else 0.0)
        return

    ptotal, pidle, hist, ptick = read_state()
    total, idle = cpu_totals()

    # The sparkline: two numbers, every tick.
    if ptotal is None or total <= ptotal:
        pct = 0.0
    else:
        dt, di = total - ptotal, idle - pidle
        pct = max(0.0, min(100.0, 100.0 * (dt - di) / dt))

    # The stacked history: every process on the machine, every PROC_EVERY
    # ticks. Deltas are measured against the /proc/stat totals stored
    # alongside the table, not against the previous tick, so the percentages
    # stay correct over the longer interval. The tooltip is just the name
    # and this tick's percentage; the process story is in the menu.
    tick = ptick + 1
    if tick % PROC_EVERY == 0:
        procs = proc_times()
        proc_total, proc_idle, pprocs = read_procs()
        if proc_total is not None and total > proc_total:
            dtp = total - proc_total
            ranked = []
            for pid, (t, name, rss) in procs.items():
                pt = pprocs.get(pid)
                if not pt: continue
                d = t - pt[0]
                if d > 0:
                    share = 100.0 * d / dtp
                    ranked.append((share, pid, name, rss))
            ranked.sort(reverse=True)
            if proc_idle is not None:
                busy = max(0.0, min(100.0, 100.0 * (dtp - (idle - proc_idle)) / dtp))
            else:
                busy = pct
            record_stack(ranked[:TOP_N], busy, dtp / (CLK * NCPU))
        write_atomic(PROCS, f'{total} {idle}\n' +
                     '\n'.join(f'{p} {t} {n}' for p, (t, n, _rss) in procs.items()))

    hist.append(pct)
    hist = hist[-HIST:]
    render(hist, out_svg, hovering())

    write_atomic(STATE,
                 f'{total}\n{idle}\n'
                 + ','.join(f'{v:.1f}' for v in hist) + '\n'
                 + f'{tick}\n')

    emit(pct)


def record_stack(ranked, busy, wall_dt):
    """Top-N machine share + the I/O those pids did in this interval.

    /proc/<pid>/io is opened only for the processes already on the chart, not
    for the whole table. A pid we have not seen before contributes 0 this
    sample rather than a since-start flood.
    """
    mcpu = cpu_lib()
    prev_io = mcpu.read_io_table()
    now_io = {}
    entries = []
    for share, pid, name, rss in ranked:
        io = mcpu.pid_io(pid)
        read_d = write_d = 0
        if io is not None:
            now_io[pid] = io
            old = prev_io.get(pid)
            if old:
                read_d = max(0, io[0] - old[0])
                write_d = max(0, io[1] - old[1])
        entries.append({
            'i': int(pid), 'n': name, 's': round(share, 2),
            'm': int(rss) * PAGE, 'r': int(read_d), 'w': int(write_d),
        })
    mcpu.write_io_table(now_io)
    samples = mcpu.read_stack()
    samples.append({'t': time.time(), 'b': round(busy, 2),
                    'd': round(wall_dt, 3), 'p': entries})
    mcpu.write_stack(samples)

if __name__ == '__main__':
    main()
