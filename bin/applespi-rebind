#!/usr/bin/env bash
# applespi-rebind — re-probe the Apple SPI keyboard/trackpad. Must be run as root.
#
# applespi does not survive S3. The controller resumes to D0 fine, but every
# transfer to the device times out and `modeswitch done.` is never reached, so
# the keyboard and trackpad are dead until reboot. See docs/input.md.
#
# Unbind/bind re-runs the same probe path that works at boot. This is what
# mintbook-applespi-resume.service runs on every wake.
#
#   --verify-only   report whether input looks alive; change nothing
set -uo pipefail

DEV=spi-APP000D:00
DRV=/sys/bus/spi/drivers/applespi
TRIES=3

log() { echo "$*"; command -v logger >/dev/null && logger -t applespi-rebind -- "$*"; }

# The touchpad is the tell: on a failed probe the keyboard input device still
# registers but the touchpad never appears. See docs/input.md.
alive() { grep -qF 'Name="Apple SPI Touchpad"' /proc/bus/input/devices 2>/dev/null; }

if [ "${1:-}" = "--verify-only" ]; then
  if alive; then echo "input: alive (touchpad present)"; exit 0
  else echo "input: DEAD (no touchpad)"; exit 1; fi
fi

if [ "$(id -u)" -ne 0 ]; then
  echo "run as root: sudo $0" >&2
  exit 1
fi

modprobe applespi 2>/dev/null || true

if [ ! -d "$DRV" ]; then
  log "applespi driver not bound and module will not load — nothing to rebind"
  exit 1
fi

for i in $(seq 1 "$TRIES"); do
  # A wedged device makes both writes block on SPI timeouts, so cap them: a hung
  # hook would stall the resume transition for every other unit behind it.
  [ -e "$DRV/$DEV" ] && timeout 10 bash -c "echo '$DEV' > '$DRV/unbind'" 2>/dev/null
  sleep 1
  timeout 10 bash -c "echo '$DEV' > '$DRV/bind'" 2>/dev/null
  sleep 1

  if alive; then
    log "rebind ok on attempt $i — touchpad is back"
    exit 0
  fi
  log "attempt $i did not bring the touchpad back"
done

log "rebind FAILED after $TRIES attempts — input is still dead, reboot needed"
exit 1
