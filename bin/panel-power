#!/usr/bin/env bash
# Power-profile indicator for xfce4-genmon-plugin.
#
# xfce4-power-manager 4.18 has no power-profiles-daemon UI. The battery plugin
# is charge only. Click opens a menu (bin/power-menu) that sets PPD + the
# intel_pstate cap. See docs/hardware.md and docs/desktop.md.
#
# This was Python calling `powerprofilesctl get`, which cost 350 ms a run: a
# Python interpreter to start (53 ms) so it could fork a *second* Python
# interpreter, because powerprofilesctl is itself a Python program. At the old
# 3 s period that was 401 s of CPU in a two-hour session — half of everything
# the status bar spent. The value is one D-Bus string property; busctl reads it
# in 15 ms and bash starts in 7. See docs/desktop.md.
DIR="$HOME/.local/share/mintbook/power"
MENU="$HOME/.local/bin/power-menu"

# emitted on every path, including the fallback below
printf '<click>%s</click>\n<iconclick>%s</iconclick>\n' "$MENU" "$MENU"

# busctl prints `s "power-saver"` for a string property.
p=$(busctl --system get-property net.hadess.PowerProfiles \
      /net/hadess/PowerProfiles net.hadess.PowerProfiles ActiveProfile 2>/dev/null)
p=${p#s \"}
p=${p%\"}

case "$p" in
  power-saver) label='Power Saver' ;;
  performance) label='Sustained' ;;
  # Anything unreadable falls back to balanced, the same as the Python did:
  # a missing icon would leave a hole in the bar.
  *) p=balanced; label='Balanced' ;;
esac

ac='unknown'
case "$(cat /sys/class/power_supply/ADP1/online 2>/dev/null)" in
  1) ac='plugged in' ;;
  0) ac='on battery' ;;
esac

printf '<img>%s/%s.svg</img>\n' "$DIR" "$p"
printf '<tool>Power\n%s · %s</tool>\n' "$label" "$ac"
