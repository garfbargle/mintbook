#!/usr/bin/env bash
# Undo the macOS-style XFCE customisation. Pass a backup directory explicitly,
# set MINTBOOK_THEME_BACKUP, or let this choose the newest dated backup.
set -e
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
if [ "${MINTBOOK_PANEL_MAINTENANCE:-}" != 1 ]; then
  exec "$ROOT/bin/panel-session" maintain -- "$0" "$@"
fi
BK=${1:-${MINTBOOK_THEME_BACKUP:-}}
if [ -z "$BK" ]; then
  shopt -s nullglob
  backups=("$HOME"/mac-mint-backup-*)
  for ((i=${#backups[@]} - 1; i >= 0; i--)); do
    if [ -f "${backups[i]}/xfce4-config.tar.gz" ]; then
      BK=${backups[i]}
      break
    fi
  done
fi
[ -n "$BK" ] && [ -f "$BK/xfce4-config.tar.gz" ] || {
  echo "Backup missing; pass its directory as the first argument" >&2
  exit 1
}
echo "Using backup: $BK"
echo "Stopping dock + panel..."
pkill plank 2>/dev/null || true
rm -f ~/.config/autostart/plank.desktop
"$ROOT/bin/panel-session" stop 2>/dev/null || true
sleep 2
echo "Restoring XFCE config..."
pkill xfconfd 2>/dev/null || true
sleep 1
tar xzf "$BK/xfce4-config.tar.gz" -C ~/.config
sleep 1
echo "Restarting..."
"$ROOT/bin/panel-session" start
sleep 3
nohup xfwm4 --replace >/dev/null 2>&1 &
echo "Reverted. Themes remain in ~/.themes and ~/.icons (delete manually if unwanted)."
