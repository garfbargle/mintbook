#!/usr/bin/env bash
# desktop-nice — give the compositor and X server priority over background work.
#
# Read-only with --check, which needs no root. Applying needs root because
# lowering a nice value requires CAP_SYS_NICE, and Xorg is not ours anyway.
# Undo with --undo, which puts every listed process back to nice 0.
#
# See docs/feel.md. Installed as a timer so it survives a logout, which
# restarts Xorg and the panel.
set -euo pipefail

NICE=${NICE:--5}
PROCS=(Xorg xfwm4)
# Launchers pass their nice value to applications. Boosting these gave browser
# renderers the same priority as the compositor, defeating the separation.
LAUNCHERS=(xfsettingsd xfdesktop plank xfce4-panel)

mode=apply
case "${1:-}" in
  --check) mode=check ;;
  --undo)  mode=undo; NICE=0 ;;
  "") ;;
  *) echo "usage: $0 [--check|--undo]" >&2; exit 2 ;;
esac

if [ "$mode" != check ] && [ "$(id -u)" -ne 0 ]; then
  echo "run as root: sudo $0 ${1:-}" >&2
  exit 1
fi

for p in "${PROCS[@]}" "${LAUNCHERS[@]}"; do
  target=$NICE
  case "$p" in xfsettingsd|xfdesktop|plank|xfce4-panel) target=0 ;; esac
  mapfile -t pids < <(pgrep -x "$p" || true)
  if [ ${#pids[@]} -eq 0 ]; then
    printf '%-14s %s\n' "$p" "not running"
    continue
  fi
  for pid in "${pids[@]}"; do
    cur=$(ps -o ni= -p "$pid" | tr -d ' ')
    if [ "$mode" = check ]; then
      printf '%-14s pid %-7s nice %s\n' "$p" "$pid" "$cur"
    else
      renice -n "$target" -p "$pid" >/dev/null
      printf '%-14s pid %-7s nice %s -> %s\n' "$p" "$pid" "$cur" "$target"
    fi
  done
done

[ "$mode" = apply ] && { echo; echo "undo: sudo $0 --undo"; } || true
