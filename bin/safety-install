#!/usr/bin/python3 -I
"""Install only the audited root helper fixes, with a snapshot and file backups."""
import argparse
import grp
import json
import os
from pathlib import Path
import pwd
import shutil
import subprocess
import tempfile
import time

ROOT = Path(__file__).resolve().parent.parent
BACKUPS = Path('/var/lib/mintbook/safety-backups')
TARGETS = {'login-apply': Path('/usr/local/sbin/mintbook-login-apply'),
           'power-apply': Path('/usr/local/sbin/mintbook-power-apply'),
           'power.conf': Path('/etc/tmpfiles.d/mintbook-power.conf')}


def replace(target, source=None, text=None, mode=0o755):
    fd, temporary = tempfile.mkstemp(prefix='.mintbook-safety-', dir=target.parent)
    try:
        with os.fdopen(fd, 'wb') as handle:
            handle.write(source.read_bytes() if source else text.encode())
        os.chmod(temporary, mode)
        os.replace(temporary, target)
    finally:
        if os.path.exists(temporary): os.unlink(temporary)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--dry-run', action='store_true')
    parser.add_argument('--revert', type=Path, metavar='BACKUP')
    args = parser.parse_args()
    if args.dry_run:
        print('Create a Timeshift snapshot, back up and replace:')
        for path in TARGETS.values(): print(path)
        print('Create root-owned policy state and reassert the current power profile.')
        return
    if os.geteuid() != 0:
        parser.error('run through pkexec or sudo; administrator authentication is required')
    if args.revert:
        backup = args.revert.resolve()
        if not backup.is_relative_to(BACKUPS) or backup.stat().st_uid != 0:
            parser.error('backup must be a root-owned directory under ' + str(BACKUPS))
        manifest = json.loads((backup / 'manifest.json').read_text())
        for name, target in TARGETS.items():
            info = manifest[name]
            if info['present']: replace(target, backup / name, mode=info['mode'])
            else: target.unlink(missing_ok=True)
        subprocess.run(['systemd-tmpfiles', '--create', str(TARGETS['power.conf'])], check=True)
        subprocess.run([str(TARGETS['power-apply']), '--reassert'], check=True)
        print('Root helpers restored. Restore the user Input Boost unit from its setup backup too.')
        return
    uid = int(os.environ.get('PKEXEC_UID', os.environ.get('SUDO_UID', '0')))
    if uid < 1000: parser.error('invoke as the desktop user through pkexec or sudo')
    user = pwd.getpwuid(uid)
    group = grp.getgrgid(user.pw_gid).gr_name
    if not group or any(c not in 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.-' for c in group):
        parser.error('unsupported desktop group')
    for name in ('login-apply', 'power-apply'):
        subprocess.run(['bash', '-n', str(ROOT / 'bin' / name)], check=True)
    subprocess.run(['timeshift', '--create', '--comments', 'before mintbook helper safety fixes'], check=True)
    backup = BACKUPS / time.strftime('%Y%m%d-%H%M%S')
    backup.mkdir(parents=True, mode=0o700)
    manifest = {}
    for name, path in TARGETS.items():
        manifest[name] = {'present': path.exists(), 'mode': path.stat().st_mode & 0o777 if path.exists() else 0o755}
        if path.exists(): shutil.copy2(path, backup / name)
    (backup / 'manifest.json').write_text(json.dumps(manifest, indent=2))
    for name in ('login-apply', 'power-apply'): replace(TARGETS[name], ROOT / 'bin' / name)
    conf = (ROOT / 'config/tmpfiles.d/mintbook-power.conf').read_text().replace('@SESSION_GROUP@', group)
    replace(TARGETS['power.conf'], text=conf, mode=0o644)
    subprocess.run(['systemd-tmpfiles', '--create', str(TARGETS['power.conf'])], check=True)
    subprocess.run([str(TARGETS['power-apply']), '--reassert'], check=True)
    print('Installed the safety fixes; current power profile retained.')
    print(f'Undo: sudo {ROOT}/bin/safety-install --revert {backup}')
    print(f'Now run as the desktop user: {ROOT}/bin/input-boost-install')

if __name__ == '__main__':
    main()
