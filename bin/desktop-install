#!/usr/bin/env python3
"""Install a versioned desktop release; activation failure restores the prior release."""
import argparse
import fcntl
import json
import os
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))
from mintbook_deploy import Deployment


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    action = parser.add_mutually_exclusive_group()
    action.add_argument('--rollback', action='store_true', help='activate the previous release')
    action.add_argument('--revert', action='store_true', help='restore the pre-collector baseline')
    action.add_argument('--status', action='store_true', help='show the installed release and local overrides')
    action.add_argument('--feature', nargs=argparse.REMAINDER, help='run an existing feature installer within the activation boundary')
    args = parser.parse_args()
    if os.geteuid() == 0 and not args.status:
        parser.error('run desktop-install as the desktop user, without sudo')
    deployment = Deployment(Path(__file__).resolve().parents[1])
    if args.status:
        if not deployment.current.exists():
            print('No versioned desktop is installed.'); return 1
        manifest = deployment.validate(deployment.current.resolve())
        print(json.dumps({key: manifest[key] for key in ('version', 'commit', 'baseline', 'local_overrides')}, indent=2))
        return 0
    lock = deployment.base / 'install.lock'
    lock.parent.mkdir(parents=True, exist_ok=True)
    with lock.open('a') as handle:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            parser.error('another desktop installation is in progress')
        try:
            release = deployment.rollback(args.revert) if args.rollback or args.revert else deployment.transaction(args.feature)
        except Exception as error:
            print('Desktop installation failed:', error, file=sys.stderr)
            return 1
    print('Active desktop release:', release.name)
    print('Rollback: ~/.local/bin/desktop-install --rollback')
    print('Original desktop behavior: ~/.local/bin/desktop-install --revert')
    return 0


if __name__ == '__main__':
    sys.exit(main())
