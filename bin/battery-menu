#!/usr/bin/env python3
"""Battery menu — the glass popup behind the bar's battery icon.

macOS's battery menu, which is: how much charge, how long it lasts, what is
eating it, and one switch. The switch is the same power profile the Control
Center tile sets, through the same plugin, so the two can never disagree.

Drawn in cairo on one override-redirect window, for the reasons in
docs/control-center.md — genmon spawns a click command with no Gdk event
behind it, and xfwm4 discards a Gtk.Menu grab at time 0.

Unlike the Control Center this is a single DrawingArea rather than a widget
per tile: it is a fixed layout, and one draw handler with a list of rows is
both less code and one allocation instead of nine.
"""
import math
import os
import signal
import subprocess
import sys
import threading
import time

T0 = time.monotonic()

# Before importing Gtk, as in bin/control-center: busctl costs 15 ms and the
# GTK import costs ~220, so the read happens inside the import for free.
try:
    PROFILE_PROC = subprocess.Popen(
        ['busctl', '--system', 'get-property', 'net.hadess.PowerProfiles',
         '/net/hadess/PowerProfiles', 'net.hadess.PowerProfiles', 'ActiveProfile'],
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
except OSError:
    PROFILE_PROC = None

# Adwaita before the Gtk import: Gtk.init parses the GTK theme, WhiteSur's
# gtk.css is 400 KB, and that is ~120 ms of every launch spent on a stylesheet
# this popup never reads a rule from — it is cairo on a DrawingArea, and
# dark/light comes from appearance.applied. See bin/control-center.
os.environ.setdefault('GTK_THEME', 'Adwaita')

# Where the pointer is now, which is where the icon was clicked: this popup
# hangs off that icon, and clicking it is the only way to get here.
#
# Read synchronously, and deliberately *not* hidden behind the GTK import the
# way the readings above are. Hiding it is what broke it. Spawned as a Popen
# the child is descheduled behind this process's own ~500 ms of CPU-bound
# import — on two cores there is nowhere else for it to run — so xdotool
# sampled the pointer after the import rather than before it, and returned the
# same late position the Gdk read did: click the icon, move the mouse away, and
# the popup opened where the mouse had got to. Costs ~12 ms, paid in full.
try:
    _ptr = subprocess.run(['xdotool', 'getmouselocation', '--shell'],
                          capture_output=True, text=True, timeout=3).stdout
    _ptr = dict(p.split('=', 1) for p in _ptr.split() if '=' in p)
    PTR_XY = (int(_ptr['X']), int(_ptr['Y']))
except Exception:
    PTR_XY = None

import gi                                                          # noqa: E402
gi.require_version('Gtk', '3.0')
gi.require_version('PangoCairo', '1.0')
import cairo                                                       # noqa: E402
from gi.repository import Gtk, Gdk, GLib, Pango, PangoCairo        # noqa: E402

