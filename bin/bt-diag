#!/usr/bin/env bash
# bt-diag — MacBook8,1 Bluetooth / SSDC-UART state. Read-only, no sudo.
# See docs/bluetooth.md.
set -uo pipefail

hr() { printf '\n=== %s ===\n' "$1"; }

hr "KERNEL / LOCKDOWN"
uname -r
echo "cmdline: $(cat /proc/cmdline)"
echo "lockdown: $(cat /sys/kernel/security/lockdown 2>/dev/null || echo n/a)"
t="$(cat /proc/sys/kernel/tainted 2>/dev/null || echo 0)"
echo "tainted: $t"
if dmesg 2>/dev/null | grep -q 'Table Upgrade: override'; then
  echo "ACPI table override: YES (dmesg Table Upgrade)"
elif (( (t & 256) != 0 )); then
  echo "ACPI table override: YES (taint bit 8)"
else
  echo "ACPI table override: NO"
fi

hr "UART / SERDEV"
echo "serial0-0 path: $(cat /sys/bus/serial/devices/serial0-0/firmware_node/path 2>/dev/null || echo MISSING)"
echo "serial0-0 modalias: $(cat /sys/bus/serial/devices/serial0-0/modalias 2>/dev/null || echo MISSING)"
if [ -e /sys/bus/serial/devices/serial0-0/driver ]; then
  echo "serial0-0 driver: $(basename "$(readlink -f /sys/bus/serial/devices/serial0-0/driver)")"
else
  echo "serial0-0 driver: (none)"
fi
lspci -nnk -s 00:15.5 2>/dev/null | sed 's/^/  /'

hr "ACPI"
for id in APPLE-UART-SSDC:00 BCM2E7C:00; do
  p="/sys/bus/acpi/devices/$id"
  if [ -d "$p" ]; then
    printf '  %s  path=%s hid=%s cid=%s status=%s\n' \
      "$id" \
      "$(cat "$p/path" 2>/dev/null)" \
      "$(cat "$p/hid" 2>/dev/null)" \
      "$(cat "$p/cid" 2>/dev/null)" \
      "$(cat "$p/status" 2>/dev/null)"
  else
    echo "  $id  (not present)"
  fi
done

hr "BLUETOOTH ADAPTER"
ls /sys/class/bluetooth/ 2>/dev/null | grep . || echo "(no adapter present)"
rfkill list 2>/dev/null || echo "(rfkill unavailable)"

hr "DRIVER"
lsmod | grep -E 'hci_uart|btbcm|bluetooth' | head -10 || echo "(hci_uart not loaded)"
modinfo hci_uart 2>/dev/null | grep -F 'BCM2E7C' >/dev/null \
  && echo "hci_uart ACPI alias BCM2E7C: yes" \
  || echo "hci_uart ACPI alias BCM2E7C: NO"
echo "BTLP/BTPU/BTPD in module: $(
  zstdcat /lib/modules/$(uname -r)/kernel/drivers/bluetooth/hci_uart.ko.zst 2>/dev/null \
    | strings | grep -cE '^(BTLP|BTPU|BTPD)$'
) symbols (expect 3)"

hr "OVERRIDE INSTALL"
if [ -f /boot/acpi_override_ssdc.img ]; then
  ls -l /boot/acpi_override_ssdc.img
else
  echo "/boot/acpi_override_ssdc.img: MISSING"
fi
if [ -x /etc/initramfs/post-update.d/zz-acpi-ssdc-override ]; then
  echo "post-update hook: installed"
else
  echo "post-update hook: MISSING"
fi

hr "DMESG"
dmesg 2>/dev/null | grep -iE \
  'failure adding ACPI serdev|SSDC|BLTH|BCM2E|hci_uart|hci0:|Bluetooth:|found in initrd|Table Upgrade|ACPI OVERRIDE' \
  | grep -vi bluetoothctl \
  | tail -40 || echo "(no matching lines, or dmesg needs root)"
