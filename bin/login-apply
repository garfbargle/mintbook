#!/usr/bin/env bash
# login-apply — the root half of the login screen settings. Installed as
# /usr/local/sbin/mintbook-login-apply and reached through pkexec by
# bin/login-settings. See docs/login.md.
#
#   mintbook-login-apply --background PATH [--appearance light|dark]
#   mintbook-login-apply --appearance dark
#   mintbook-login-apply --sync                 # dconf only, no conf changes
#
# Everything here exists because /etc/lightdm/slick-greeter.conf is root-owned
# and the greeter runs as `lightdm`. Picking a picture in a file chooser is a
# one-click thing; making that picture readable by a user that cannot enter
# your home directory is not, and that is the work this does.
set -euo pipefail

CONF=/etc/lightdm/slick-greeter.conf
SHARE=/usr/share/mintbook/backgrounds
SCHEMA=x.dm.slick-greeter
THEME_LIGHT=WhiteSur-Light; ICONS_LIGHT=WhiteSur-light; COLOR_LIGHT='#e5e7ea'
THEME_DARK=WhiteSur-Dark;   ICONS_DARK=WhiteSur-dark;    COLOR_DARK='#5b6069'

die() { echo "$*" >&2; exit 1; }

# Put the same values into lightdm's own dconf.
#
# The file alone is not enough, and this is the whole reason: slick-greeter
# does not read its settings from the conf and use them. It copies them into
# dconf — "Overriding dconf setting for ..." in its log — and then reads them
# back, with the write going over D-Bus and the read coming straight off the
# mapped database. The read can win. lightdm's dconf already holds the schema
# defaults from every start before this was installed, so the value that
# survives is the default: content-align stayed `left` on a conf that plainly
# says `center`.
#
# Writing them as lightdm means both sides agree and the race stops mattering.
# Best effort: a greeter with the right conf and a stale dconf is the situation
# we were already in, so a failure here is not worth failing an apply over.
sync_dconf() {
  runuser -u lightdm -- env HOME=/var/lib/lightdm \
      dbus-run-session -- /usr/bin/python3 -I - "$CONF" "$SCHEMA" <<'PY' 2>/dev/null ||
import configparser, sys
from gi.repository import Gio, GLib
conf = configparser.ConfigParser(interpolation=None)
conf.read(sys.argv[1])
settings = Gio.Settings.new(sys.argv[2])
schema = settings.props.settings_schema
for key, value in conf.items('Greeter'):
    if not schema.has_key(key):
        continue
    kind = settings.get_value(key).get_type()
    variant = (GLib.Variant('s', value) if kind.dup_string() == 's'
               else GLib.Variant.parse(kind, value, None, None))
    settings.set_value(key, variant)
Gio.Settings.sync()
PY
    echo "note: could not write lightdm's dconf; the conf is still correct" >&2
}

[ "$(id -u)" -eq 0 ] || die 'must run as root, normally through pkexec'
[ -f "$CONF" ] || die "no $CONF — run bin/login-install first"

background=""; appearance=""; sync_only=no
while [ $# -gt 0 ]; do
  case "$1" in
    --background) background=${2:?--background needs a path}; shift 2 ;;
    --appearance) appearance=${2:?--appearance needs light or dark}; shift 2 ;;
    --sync) sync_only=yes; shift ;;
    *) die "usage: $0 [--background PATH] [--appearance light|dark] [--sync]" ;;
  esac
done
[ -n "$background$appearance" ] || [ "$sync_only" = yes ] || die 'nothing to do'
case "${appearance:-light}" in light|dark) ;; *) die 'appearance is light or dark' ;; esac

# The caller, for reading a theme out of their home if this is the first time
# the dark pair has been asked for.
uid=${PKEXEC_UID:-${SUDO_UID:-}}
home=""
if [ -n "$uid" ] && [ "$uid" -ge 1000 ] 2>/dev/null; then
  home=$(getent passwd "$uid" | cut -d: -f6)
fi

if [ "$sync_only" = yes ]; then
  sync_dconf
  echo "synced"
  exit 0
fi

if [ -n "$background" ]; then
  # Resolve first, then judge the resolved path: a symlink into somewhere
  # unreadable is the interesting case, not the link itself.
  background=$(readlink -f -- "$background") || die 'cannot resolve that path'
  [[ "$background" != *$'\n'* && "$background" != *$'\r'* ]] || die 'picture paths cannot contain newlines'
  [ -f "$background" ] || die "not a file: $background"
  if [ -n "$uid" ]; then
    caller=$(getent passwd "$uid" | cut -d: -f1)
    [ -n "$caller" ] && runuser -u "$caller" -- test -r "$background" || die 'the calling user cannot read that picture'
  fi
  case "$(file -Lb --mime-type -- "$background")" in
    image/*) ;;
    *) die "not an image: $background" ;;
  esac

  # Can the greeter read it where it lies? If not, keep a copy somewhere it
  # can. This is a copy, with everything that means: edit the original later
  # and the login screen keeps the version it was given.
  if ! runuser -u lightdm -- test -r "$background" 2>/dev/null; then
    install -dm755 "$SHARE"
    name="mintbook-$(date +%Y%m%d%H%M%S)-$(basename -- "$background")"
    # Read as the caller: replacing a home symlink during the copy must not
    # turn a passwordless background change into a root file-read primitive.
    copy=$(mktemp "$SHARE/mintbook-XXXXXXXX")
    if [ -n "${caller:-}" ]; then
      runuser -u "$caller" -- cat -- "$background" > "$copy" || { rm -f "$copy"; die 'cannot read that picture'; }
    else
      cat -- "$background" > "$copy"
    fi
    chmod 644 "$copy"
    mv -fT -- "$copy" "$SHARE/$name"
    background="$SHARE/$name"
  fi
fi

if [ -n "$appearance" ]; then
  if [ "$appearance" = dark ]; then theme=$THEME_DARK; icons=$ICONS_DARK; color=$COLOR_DARK
  else theme=$THEME_LIGHT; icons=$ICONS_LIGHT; color=$COLOR_LIGHT; fi
  # The greeter reads /usr/share only. Asking for dark having installed light
  # should not mean a trip to the terminal, so fetch the pair if it is absent.
  for pair in "themes/$theme" "icons/$icons"; do
    if [ ! -d "/usr/share/$pair" ]; then
      die "no /usr/share/$pair — install that appearance with bin/login-install first"
    fi
  done
fi

tmp=$(mktemp); trap 'rm -f "$tmp"' EXIT
# Paths are data, never sed programs or shell source. Preserve comments and
# unrelated sections, inserting a missing key in [Greeter] when needed.
/usr/bin/python3 -I - "$CONF" "$tmp" "$background" "$appearance" "${color:-}" "${theme:-}" "${icons:-}" <<'PY'
import pathlib, sys
source, target, background, appearance, color, theme, icons = sys.argv[1:]
values = {}
if background:
    values['background'] = background
if appearance:
    values.update({'background-color': color, 'theme-name': theme, 'icon-theme-name': icons})
out, in_greeter, found = [], False, False
for line in pathlib.Path(source).read_text().splitlines(keepends=True):
    if line.strip().startswith('['):
        if in_greeter:
            out.extend(f'{k}={v}\n' for k, v in values.items()); values.clear()
        in_greeter = line.strip() == '[Greeter]'
        found |= in_greeter
    key = line.partition('=')[0].strip()
    out.append(f'{key}={values.pop(key)}\n' if in_greeter and key in values else line)
if not found:
    out.append('\n[Greeter]\n')
out.extend(f'{k}={v}\n' for k, v in values.items())
pathlib.Path(target).write_text(''.join(out))
PY
install -m644 "$tmp" "$CONF"

# Prune copies nothing points at any more. Only ever files this script made,
# and only the ones the conf has stopped naming.
if [ -d "$SHARE" ]; then
  current=$(sed -n 's/^background=//p' "$CONF" | head -1)
  for old in "$SHARE"/mintbook-*; do
    [ -e "$old" ] || continue
    [ "$old" = "$current" ] || rm -f -- "$old"
  done
fi
sync_dconf
echo "applied"
