#!/usr/bin/env python3
"""Dump CS4208 GPIO, digital-convert, and vendor coefficients.
Needs CAP_SYS_RAWIO (root) because the kernel gates /dev/snd/hwC*D*.
Read-only. See docs/audio.md.
"""
import array
import fcntl
import os
import sys

def _ioc(direction, type_, nr, size):
    return (direction << 30) | (size << 16) | (ord(type_) << 8) | nr

SNDRV_HDA_IOCTL_VERB_WRITE = _ioc(1 | 2, "H", 0x11, 8)

GET_PIN_SENSE = 0xF09
GET_GPIO_DATA = 0xF15
GET_GPIO_MASK = 0xF16
GET_GPIO_DIRECTION = 0xF17
GET_DIGI_CONVERT_1 = 0xF0D
GET_POWER_STATE = 0xF05
GET_CONV = 0xF06
GET_PIN_WIDGET_CONTROL = 0xF07
SET_PROC_STATE = 0x703
SET_COEF_INDEX = 0x500
GET_PROC_COEF = 0xC00

def main():
    fd = os.open("/dev/snd/hwC0D0", os.O_RDWR)

    def verb(nid, v, param=0):
        packed = ((nid & 0xFF) << 24) | ((v & 0xFFFF) << 8) | (param & 0xFF)
        buf = array.array("I", [packed, 0xFFFFFFFF])
        fcntl.ioctl(fd, SNDRV_HDA_IOCTL_VERB_WRITE, buf)
        return buf[1]

    print("HP 0x10 pin-sense:", hex(verb(0x10, GET_PIN_SENSE)))
    print("GPIO mask:", hex(verb(0x01, GET_GPIO_MASK)))
    print("GPIO dir :", hex(verb(0x01, GET_GPIO_DIRECTION)))
    print("GPIO data:", hex(verb(0x01, GET_GPIO_DATA)))
    print("0x0a digi-convert:", hex(verb(0x0A, GET_DIGI_CONVERT_1)))
    print("0x0a power:", hex(verb(0x0A, GET_POWER_STATE)))
    print("0x0a conv :", hex(verb(0x0A, GET_CONV)))
    print("0x1d pin-ctls:", hex(verb(0x1D, GET_PIN_WIDGET_CONTROL)))
    print("0x02 power:", hex(verb(0x02, GET_POWER_STATE)))
    print("0x02 conv :", hex(verb(0x02, GET_CONV)))

    verb(0x24, SET_PROC_STATE, 1)
    print("\n=== vendor coefs nid 0x24 (nonzero) ===")
    zeros = 0
    for i in range(128):
        verb(0x24, SET_COEF_INDEX, i)
        val = verb(0x24, GET_PROC_COEF)
        if val:
            print(f"  [{i:02x}] = 0x{val:04x}")
        else:
            zeros += 1
    print(f"zeros: {zeros}/128")
    os.close(fd)
    return 0

if __name__ == "__main__":
    sys.exit(main())
