#!/usr/bin/env python3
"""A small glass system menu for the MintBook panel.

The menu is deliberately a summary, not another control centre: storage and
machine identity are glanceable, Doctor and Updates open their purpose-built
readers, Keep Awake is the only inline preference, and session actions live in
one quiet footer.  Doctor is still the authority for health checks.
"""
import json
import math
import os
from pathlib import Path
import signal
import subprocess
import threading
import time

HOME = Path.home()
HEALTH_STATE = HOME / '.cache/mintbook/health.json'
UPDATES_STATE = HOME / '.cache/mintbook/updates.state'
UPDATES_CONF = HOME / '.config/mintbook/updates.conf'
APPLIED = HOME / '.config/mintbook/appearance.applied'
PIDFILE = HOME / '.cache/mintbook/system-menu.pid'
HEALTH_APP = HOME / '.local/bin/mintbook-health'
UPDATES_APP = HOME / '.local/bin/updates-menu'
AWAKE_APP = HOME / '.local/bin/keep-awake'


def read_text(path, default=''):
    try:
        return Path(path).read_text().strip() or default
    except OSError:
        return default


def human_size(value):
    value = float(max(0, value))
    for unit in ('B', 'KB', 'MB', 'GB', 'TB'):
        if value < 1000 or unit == 'TB':
            return (f'{value:.0f}' if value >= 10 else f'{value:.1f}') + f' {unit}'
        value /= 1000


def health_snapshot(path=None):
    try:
        state = json.loads(read_text(path or HEALTH_STATE))
        rows = state['rows']
        counts = {key: sum(row.get('status') == key for row in rows)
                  for key in ('ok', 'warn', 'fail')}
        return {**counts, 'checked': float(state.get('checked', 0)),
                'kernel': state.get('kernel', '')}
    except (ValueError, KeyError, TypeError):
        return {'ok': 0, 'warn': 0, 'fail': 0, 'checked': 0, 'kernel': ''}


def updates_snapshot(path=None):
    installed = path is not None or UPDATES_CONF.exists()
    if not installed:
        return {'count': 0, 'security': 0, 'kernel': 0, 'flatpak': 0,
                'checked': 0, 'error': '', 'installed': False}
    values = {}
    for line in read_text(path or UPDATES_STATE).splitlines():
        key, sep, value = line.partition(' = ')
        if sep:
            values[key.strip()] = value.strip()
    def number(key):
        try:
            return int(values.get(key, 0))
        except ValueError:
            return 0
    return {'count': number('count'), 'security': number('security'),
            'kernel': number('kernel'), 'flatpak': number('flatpak'),
            'checked': number('checked'), 'error': values.get('error', ''),
            'installed': True}


def machine_snapshot(root='/'):
    os_values = {}
    for line in read_text('/etc/os-release').splitlines():
        key, sep, value = line.partition('=')
        if sep:
            os_values[key] = value.strip('"')
    model = read_text('/sys/class/dmi/id/product_name', 'MintBook')
    memory = 0
    for line in read_text('/proc/meminfo').splitlines():
        if line.startswith('MemTotal:'):
            memory = int(line.split()[1]) * 1024
            break
    stats = os.statvfs(root)
    total = stats.f_blocks * stats.f_frsize
    free = stats.f_bavail * stats.f_frsize
    return {'host': os.uname().nodename, 'model': model,
            'os': os_values.get('PRETTY_NAME', 'Linux'), 'kernel': os.uname().release,
            'memory': memory, 'disk_total': total, 'disk_free': free}


os.environ.setdefault('GTK_THEME', 'Adwaita')
import cairo                                                       # noqa: E402
import gi                                                          # noqa: E402
gi.require_version('Gtk', '3.0')
gi.require_version('PangoCairo', '1.0')
from gi.repository import Gtk, Gdk, GLib, Pango, PangoCairo        # noqa: E402

LIGHT = {  # generated by bin/palette-generate
    'top': (229, 231, 234, 0.980392),
    'bottom': (202, 205, 210, 0.968627),
    'edge': (255, 255, 255, 0.74902),
    'rim': (65, 68, 74, 0.180392),
    'fg': (45, 48, 54),
    'tile': (255, 255, 255, 0.54902),
    'tile_hi': (255, 255, 255, 0.780392),
    'tile_edge': (255, 255, 255, 0.65098),
    'track': (65, 68, 74, 0.129412),
    'hair': (65, 68, 74, 0.121569),
    'seg': (65, 68, 74, 0.101961),
    'seg_on': (255, 255, 255, 0.94902),
    'green': (52, 199, 89),
    'amber': (255, 159, 10),
    'red': (255, 59, 48),
    'blue': (0, 122, 255),
}
DARK = {  # generated by bin/palette-generate
    'top': (104, 109, 119, 0.976471),
    'bottom': (74, 78, 86, 0.968627),
    'edge': (255, 255, 255, 0.180392),
    'rim': (0, 0, 0, 0.34902),
    'fg': (255, 255, 255),
    'tile': (255, 255, 255, 0.129412),
    'tile_hi': (255, 255, 255, 0.2),
    'tile_edge': (255, 255, 255, 0.101961),
    'track': (255, 255, 255, 0.160784),
    'hair': (255, 255, 255, 0.121569),
    'seg': (0, 0, 0, 0.2),
    'seg_on': (255, 255, 255, 0.278431),
    'green': (48, 209, 88),
    'amber': (255, 214, 10),
    'red': (255, 69, 58),
    'blue': (10, 132, 255),
}

WIDTH, HEIGHT, PAD, GAP, SHADOW, RADIUS, CARD = 372, 438, 14, 10, 16, 18, 12
SC = 1.0
PTR_XY = None


def rgba(cr, color, alpha=None):
    base = color[3] if len(color) > 3 else 1.0
    cr.set_source_rgba(color[0] / 255, color[1] / 255, color[2] / 255,
                       base if alpha is None else base * alpha)


def rrect(cr, x, y, w, h, radius):
    radius = min(radius, w / 2, h / 2)
    cr.new_sub_path()
    cr.arc(x + w - radius, y + radius, radius, -math.pi / 2, 0)
    cr.arc(x + w - radius, y + h - radius, radius, 0, math.pi / 2)
    cr.arc(x + radius, y + h - radius, radius, math.pi / 2, math.pi)
    cr.arc(x + radius, y + radius, radius, math.pi, 3 * math.pi / 2)
    cr.close_path()


def text(cr, value, x, y, size, color, alpha=1, weight='normal', align=None, width=0):
    layout = PangoCairo.create_layout(cr)
    family = 'Inter Semi-Bold' if weight == 'bold' else 'Inter'
    font = Pango.FontDescription(family)
    font.set_absolute_size(size * Pango.SCALE)
    layout.set_font_description(font)
    layout.set_text(str(value), -1)
    layout.set_ellipsize(Pango.EllipsizeMode.END)
    if width:
        layout.set_width(int(width * Pango.SCALE))
        layout.set_alignment({'center': Pango.Alignment.CENTER,
                              'right': Pango.Alignment.RIGHT}.get(align, Pango.Alignment.LEFT))
    rgba(cr, color, alpha)
    cr.move_to(x, y)
    PangoCairo.show_layout(cr, layout)
    return layout.get_pixel_size()


def chevron(cr, x, y, color):
    rgba(cr, color, .35)
    cr.set_line_width(1.5)
    cr.set_line_cap(cairo.LINE_CAP_ROUND)
    cr.move_to(x - 2, y - 4)
    cr.line_to(x + 2, y)
    cr.line_to(x - 2, y + 4)
    cr.stroke()


def glyph(cr, kind, cx, cy, size, color):
    """Small optical-size icons for the six session actions and summary rows."""
    cr.save()
    # Cairo's current path is not part of save/restore. Start every icon from
    # an empty path so an arc cannot inherit a text/card endpoint and draw a
    # diagonal across the footer at non-integer scaling factors.
    cr.new_path()
    rgba(cr, color)
    cr.set_line_width(max(1.35, size * .09))
    cr.set_line_cap(cairo.LINE_CAP_ROUND)
    cr.set_line_join(cairo.LINE_JOIN_ROUND)
    r = size * .34
    if kind == 'disk':
        cr.arc(cx, cy - 3, r, math.pi, 2 * math.pi)
        cr.line_to(cx + r, cy + 5)
        cr.arc(cx, cy + 5, r, 0, math.pi)
        cr.close_path(); cr.stroke()
    elif kind in ('ok', 'warn', 'fail'):
        cr.arc(cx, cy, r, 0, 2 * math.pi); cr.fill()
        cr.set_source_rgba(1, 1, 1, .98); cr.set_line_width(1.6)
        if kind == 'ok':
            cr.move_to(cx - 4, cy); cr.line_to(cx - 1, cy + 3); cr.line_to(cx + 5, cy - 4)
        else:
            cr.move_to(cx, cy - 4); cr.line_to(cx, cy + 1)
            cr.move_to(cx, cy + 4); cr.line_to(cx, cy + 4.1)
        cr.stroke()
    elif kind == 'updates':
        cr.move_to(cx, cy - 7); cr.line_to(cx, cy + 3)
        cr.move_to(cx - 4, cy); cr.line_to(cx, cy + 4); cr.line_to(cx + 4, cy)
        cr.move_to(cx - 7, cy + 7); cr.line_to(cx + 7, cy + 7); cr.stroke()
    elif kind == 'awake':
        cr.arc(cx, cy, 5, 0, 2 * math.pi); cr.stroke()
        for a in range(0, 360, 45):
            angle = math.radians(a)
            cr.move_to(cx + math.cos(angle) * 8, cy + math.sin(angle) * 8)
            cr.line_to(cx + math.cos(angle) * 10, cy + math.sin(angle) * 10)
        cr.stroke()
    elif kind == 'lock':
        cr.arc(cx, cy - 2, 5, math.pi, 2 * math.pi); cr.rectangle(cx - 6, cy - 2, 12, 10); cr.stroke()
    elif kind == 'sleep':
        cr.arc(cx + 2, cy, 8, math.pi / 2, 3 * math.pi / 2)
        cr.new_sub_path()
        cr.arc(cx + 6, cy - 1, 7, 2.2, 4.1); cr.stroke()
    elif kind == 'hibernate':
        cr.move_to(cx - 6, cy - 5); cr.line_to(cx + 6, cy - 5)
        cr.move_to(cx - 4, cy); cr.line_to(cx + 4, cy)
        cr.move_to(cx - 2, cy + 5); cr.line_to(cx + 2, cy + 5); cr.stroke()
    elif kind == 'logout':
        cr.move_to(cx - 1, cy - 7); cr.line_to(cx - 7, cy - 7); cr.line_to(cx - 7, cy + 7); cr.line_to(cx - 1, cy + 7)
        cr.move_to(cx - 2, cy); cr.line_to(cx + 7, cy); cr.move_to(cx + 3, cy - 4); cr.line_to(cx + 7, cy); cr.line_to(cx + 3, cy + 4); cr.stroke()
    elif kind == 'restart':
        cr.arc(cx, cy, 7, .55, 5.55); cr.move_to(cx + 5, cy - 5); cr.line_to(cx + 5, cy); cr.line_to(cx, cy - 2); cr.stroke()
    elif kind == 'power':
        cr.arc(cx, cy + 1, 7, -.75, 3.89); cr.move_to(cx, cy - 9); cr.line_to(cx, cy); cr.stroke()
    cr.restore()


class Menu:
    def __init__(self):
        self.colors = DARK if read_text(APPLIED, 'light') == 'dark' else LIGHT
        self.machine = machine_snapshot()
        self.health = health_snapshot()
        self.updates = updates_snapshot()
        self.awake = self.read_awake()
        self.doctor_running = False
        self.awake_running = False
        self.confirm = None
        self.controls = []
        self.hover = self.pressed = self.keyboard_target = None
        self.closing = False

        self.win = win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
        win.set_title('System')
        win.set_decorated(False); win.set_resizable(False)
        win.set_skip_taskbar_hint(True); win.set_skip_pager_hint(True); win.set_keep_above(True)
        win.set_app_paintable(True); win.set_type_hint(Gdk.WindowTypeHint.POPUP_MENU)
        visual = Gdk.Screen.get_default().get_rgba_visual()
        if visual: win.set_visual(visual)
        win.connect('draw', self.draw_background)
        win.connect('key-press-event', self.on_key)
        win.connect('destroy', lambda *_a: self.close())

        self.area = Gtk.DrawingArea()
        self.area.set_size_request(round(WIDTH * SC), round(HEIGHT * SC))
        self.area.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK |
                             Gdk.EventMask.POINTER_MOTION_MASK | Gdk.EventMask.LEAVE_NOTIFY_MASK)
        self.area.connect('draw', self.on_draw)
        self.area.connect('button-press-event', self.on_press)
        self.area.connect('button-release-event', self.on_release)
        self.area.connect('motion-notify-event', self.on_motion)
        self.area.connect('leave-notify-event', self.on_leave)
        box = Gtk.Box()
        for setter in (box.set_margin_top, box.set_margin_bottom, box.set_margin_start, box.set_margin_end):
            setter(round((SHADOW + PAD) * SC))
        box.pack_start(self.area, False, False, 0); win.add(box); win.show_all()
        GLib.timeout_add_seconds(10, self.refresh)

    def read_awake(self):
        if not os.access(AWAKE_APP, os.X_OK): return 0
        try:
            return int(subprocess.run([str(AWAKE_APP), 'status'], capture_output=True,
                                      text=True, timeout=2).stdout.strip() or 0)
        except (OSError, ValueError, subprocess.SubprocessError): return 0

    def refresh(self):
        if self.closing: return False
        self.health, self.updates, self.awake = health_snapshot(), updates_snapshot(), self.read_awake()
        self.area.queue_draw(); return True

    def card(self, cr, x, y, w, h, hot=False):
        rrect(cr, x, y, w, h, CARD); rgba(cr, self.colors['tile_hi'] if hot else self.colors['tile'])
        cr.fill_preserve(); rgba(cr, self.colors['tile_edge']); cr.set_line_width(1); cr.stroke()

    def control(self, key, rect):
        self.controls.append((key, rect))
        return self.hover == key or self.keyboard_target == key

    def on_draw(self, _area, cr):
        cr.set_antialias(cairo.ANTIALIAS_BEST); cr.scale(SC, SC); self.controls = []
        c, w = self.colors, WIDTH
        text(cr, 'System', 2, 0, 15, c['fg'], .96, 'bold')
        text(cr, self.machine['host'], 0, 3, 9.3, c['fg'], .38, 'normal', 'right', w - 2)
        text(cr, f"{self.machine['model']} · {self.machine['os']}", 2, 22, 9.2,
             c['fg'], .52, width=w - 4)
        text(cr, f"Kernel {self.machine['kernel']} · {human_size(self.machine['memory'])} memory",
             2, 36, 8.7, c['fg'], .36, width=w - 4)

        # Storage: one number and one proportional line are enough at a glance.
        y, h = 58, 64; self.card(cr, 0, y, w, h)
        glyph(cr, 'disk', 24, y + 26, 20, c['fg'])
        text(cr, 'Storage', 45, y + 12, 10.5, c['fg'], .92, 'bold')
        free, total = self.machine['disk_free'], self.machine['disk_total']; used = total - free
        text(cr, f'{human_size(free)} free', 0, y + 11, 14, c['fg'], .94, 'bold', 'right', w - 15)
        rrect(cr, 15, y + 43, w - 30, 7, 3.5); rgba(cr, c['track']); cr.fill()
        rrect(cr, 15, y + 43, (w - 30) * min(1, used / max(1, total)), 7, 3.5)
        rgba(cr, c['blue'], .75); cr.fill()
        text(cr, f'{human_size(used)} of {human_size(total)} used', 15, y + 51, 8.5, c['fg'], .38)

        # Doctor: the three counts are the interface; the full reader is one click away.
        y, h = 132, 88; whole_hot = self.control('doctor:all', (0, y, w, h))
        self.card(cr, 0, y, w, h, whole_hot)
        status = ('unknown' if not self.health['checked'] else 'fail' if self.health['fail']
                  else 'warn' if self.health['warn'] else 'ok')
        if status == 'unknown':
            cr.arc(24, y + 25, 6.8, 0, 2 * math.pi); rgba(cr, c['fg'], .28); cr.set_line_width(1.6); cr.stroke()
        else:
            glyph(cr, status, 24, y + 25, 20, c[{'ok':'green','warn':'amber','fail':'red'}[status]])
        text(cr, 'Doctor', 45, y + 12, 11, c['fg'], .94, 'bold')
        checked = 'Not checked yet' if not self.health['checked'] else 'System checks'
        text(cr, checked, 45, y + 32, 9, c['fg'], .45)
        run_rect = (w - 82, y + 11, 67, 28); hot = self.control('doctor:run', run_rect)
        rrect(cr, *run_rect, 8); rgba(cr, c['seg_on'], .95 if hot else .72); cr.fill()
        text(cr, 'Running…' if self.doctor_running else 'Run', run_rect[0], y + 19, 9.5,
             c['fg'], .82 if not self.doctor_running else .46, 'bold', 'center', run_rect[2])
        counts = [('ok', self.health['ok'], 'passed', c['green']),
                  ('warn', self.health['warn'], 'notes', c['amber']),
                  ('fail', self.health['fail'], 'errors', c['red'])]
        x = 15
        for key, number, label, color in counts:
            title = f'{number} {label}'
            cw = text(cr, title, 0, 0, 9.3, c['fg'], 0, 'bold')[0] + 22
            rect = (x, y + 52, cw, 25); hot = self.control('doctor:' + key, rect)
            rrect(cr, *rect, 7); rgba(cr, color, .16 if hot else .10); cr.fill()
            text(cr, title, x, y + 59, 9.3, color, .95, 'bold', 'center', cw); x += cw + 7

        # Updates is intentionally one line; its existing popup owns the package list.
        y, h = 230, 52; hot = self.control('updates', (0, y, w, h)); self.card(cr, 0, y, w, h, hot)
        glyph(cr, 'updates', 24, y + h / 2, 20, c['fg'])
        text(cr, 'Updates', 45, y + 10, 10.5, c['fg'], .94, 'bold')
        if not self.updates['installed']:
            update_line = 'Open Update Manager'
        elif self.updates['error']:
            update_line = 'Could not check'
        elif self.updates['count']:
            update_line = f"{self.updates['count']} ready" + (f" · {self.updates['security']} security" if self.updates['security'] else '')
        elif self.updates['checked']:
            update_line = 'Up to date'
        else:
            update_line = 'Not checked yet'
        text(cr, update_line, 45, y + 29, 9.2, c['fg'], .46, width=w - 80); chevron(cr, w - 19, y + h / 2, c['fg'])

        # Keep Awake uses a compact duration selector instead of another window.
        y, h = 292, 60; self.card(cr, 0, y, w, h)
        glyph(cr, 'awake', 24, y + h / 2, 20, c['fg'])
        text(cr, 'Keep Awake', 45, y + 12, 10.5, c['fg'], .94, 'bold')
        text(cr, f'{self.awake}m left' if self.awake else 'Off', 45, y + 32, 9, c['fg'], .45)
        options = [('off', 'Off'), ('30', '30m'), ('60', '1h'), ('120', '2h')]
        active_key = 'off' if not self.awake else next(
            (key for key, _label in options[1:] if self.awake <= int(key)), '120')
        x0, sw, sh = 141, (w - 141 - 13) / 4, 30; sy = y + 15
        rrect(cr, x0, sy, sw * 4, sh, 9); rgba(cr, c['seg']); cr.fill()
        for i, (key, label) in enumerate(options):
            x = x0 + i * sw; active = key == active_key
            hot = self.control('awake:' + key, (x, sy, sw, sh))
            if active or hot:
                rrect(cr, x + 2, sy + 2, sw - 4, sh - 4, 7); rgba(cr, c['seg_on'], 1 if active else .5); cr.fill()
            text(cr, label, x, sy + 8, 9.3, c['fg'], .9 if active else .52,
                 'bold' if active else 'normal', 'center', sw)

        y, h = 362, 76; self.card(cr, 0, y, w, h)
        if self.confirm:
            action, label, _command = self.confirm
            text(cr, label + '?', 16, y + 29, 11, c['fg'], .92, 'bold', width=150)
            for key, caption, x, color in (('confirm:cancel', 'Cancel', 174, c['fg']),
                                           ('confirm:go', action, 267, c['red'])):
                rect = (x, y + 20, 89, 36); hot = self.control(key, rect)
                rrect(cr, *rect, 10); rgba(cr, color, .16 if hot else .09); cr.fill()
                text(cr, caption, x, y + 31, 9.5, color, .95, 'bold', 'center', 89)
        else:
            actions = [('lock', 'Lock'), ('sleep', 'Sleep'), ('hibernate', 'Hibernate'),
                       ('logout', 'Log Out'), ('restart', 'Restart'), ('power', 'Shut Down')]
            sw = w / len(actions)
            for i, (key, label) in enumerate(actions):
                x = i * sw; hot = self.control('session:' + key, (x + 2, y + 3, sw - 4, h - 6))
                if hot: rrect(cr, x + 3, y + 4, sw - 6, h - 8, 10); rgba(cr, c['fg'], .07); cr.fill()
                glyph(cr, key, x + sw / 2, y + 27, 20, c['fg'])
                text(cr, label, x, y + 51, 8.1, c['fg'], .58, 'normal', 'center', sw)
        return False

    def hit_at(self, x, y):
        for key, (rx, ry, rw, rh) in reversed(self.controls):
            if rx <= x <= rx + rw and ry <= y <= ry + rh: return key
        return None

    def on_motion(self, _w, event):
        self.keyboard_target = None; hit = self.hit_at(event.x / SC, event.y / SC)
        if hit != self.hover: self.hover = hit; self.area.queue_draw()
        return True

    def on_leave(self, *_a):
        self.hover = None; self.area.queue_draw(); return True

    def on_press(self, _w, event):
        self.pressed = self.hit_at(event.x / SC, event.y / SC); return True

    def on_release(self, _w, event):
        hit = self.hit_at(event.x / SC, event.y / SC)
        if hit and hit == self.pressed: self.activate(hit)
        self.pressed = None; return True

    def on_key(self, _w, event):
        if event.keyval == Gdk.KEY_Escape:
            if self.confirm: self.confirm = None; self.area.queue_draw()
            else: self.close()
            return True
        if event.keyval in (Gdk.KEY_Tab, Gdk.KEY_ISO_Left_Tab, Gdk.KEY_Left, Gdk.KEY_Right,
                            Gdk.KEY_Up, Gdk.KEY_Down):
            keys = [key for key, _rect in self.controls]; current = keys.index(self.keyboard_target) if self.keyboard_target in keys else -1
            reverse = event.keyval in (Gdk.KEY_ISO_Left_Tab, Gdk.KEY_Left, Gdk.KEY_Up) or (event.keyval == Gdk.KEY_Tab and event.state & Gdk.ModifierType.SHIFT_MASK)
            self.keyboard_target = keys[(current + (-1 if reverse else 1)) % len(keys)]
            self.hover = None; self.area.queue_draw(); return True
        if event.keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter, Gdk.KEY_space) and self.keyboard_target:
            self.activate(self.keyboard_target); return True
        return False

    def activate(self, key):
        if key == 'doctor:run': self.run_doctor(); return
        if key.startswith('doctor:'):
            focus = {'ok':'all', 'warn':'notes', 'fail':'errors'}.get(key.split(':', 1)[1], 'all')
            self.open_app(HEALTH_APP, {'MINTBOOK_HEALTH_FILTER': focus}); return
        if key == 'updates':
            if os.access(UPDATES_APP, os.X_OK): self.open_app(UPDATES_APP)
            else:
                subprocess.Popen(['mintupdate'], start_new_session=True,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                self.close()
            return
        if key.startswith('awake:'): self.set_awake(key.split(':', 1)[1]); return
        if key == 'confirm:cancel': self.confirm = None; self.keyboard_target = None; self.area.queue_draw(); return
        if key == 'confirm:go':
            _action, _label, command = self.confirm; subprocess.Popen(command, start_new_session=True)
            self.close(); return
        if key.startswith('session:'):
            action = key.split(':', 1)[1]
            commands = {'lock': ['xflock4'], 'sleep': ['xfce4-session-logout', '--suspend'],
                        'hibernate': ['xfce4-session-logout', '--hibernate'],
                        'logout': ['xfce4-session-logout', '--logout'],
                        'restart': ['xfce4-session-logout', '--reboot'],
                        'power': ['xfce4-session-logout', '--halt']}
            labels = {'logout':'Log out', 'restart':'Restart', 'power':'Shut down'}
            if action in labels:
                self.confirm = (labels[action], labels[action] + ' this computer', commands[action])
                self.keyboard_target = 'confirm:cancel'; self.area.queue_draw()
            else:
                subprocess.Popen(commands[action], start_new_session=True); self.close()

    def run_doctor(self):
        if self.doctor_running or not os.access(HEALTH_APP, os.X_OK): return
        self.doctor_running = True; self.area.queue_draw()
        def work():
            subprocess.run([str(HEALTH_APP), '--check'], stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL, timeout=100)
            GLib.idle_add(self.doctor_done)
        threading.Thread(target=work, daemon=True).start()

    def doctor_done(self):
        self.doctor_running = False; self.health = health_snapshot(); self.nudge_panel(); self.area.queue_draw(); return False

    def set_awake(self, value):
        if self.awake_running or not os.access(AWAKE_APP, os.X_OK): return
        self.awake_running = True; self.awake = 0 if value == 'off' else int(value); self.area.queue_draw()
        def work():
            subprocess.run([str(AWAKE_APP), value], stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL, timeout=10)
            GLib.idle_add(self.awake_done)
        threading.Thread(target=work, daemon=True).start()

    def awake_done(self):
        self.awake_running = False; self.awake = self.read_awake(); self.area.queue_draw(); return False

    def nudge_panel(self):
        panel_id = '28'
        for line in read_text(HOME / '.config/mintbook/system.conf').splitlines():
            if line.startswith('PANEL_ID='):
                panel_id = line.split('=', 1)[1].split()[0]
        subprocess.Popen(['xfce4-panel', f'--plugin-event=plugin-{panel_id}:refresh:bool:true'],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def open_app(self, path, extra=None):
        if not os.access(path, os.X_OK): return
        anchor = getattr(self, 'anchor', PTR_XY or (0, 0))
        env = os.environ.copy(); env['MINTBOOK_ANCHOR'] = f'{anchor[0]},{anchor[1]}'
        if extra: env.update(extra)
        subprocess.Popen([str(path)], env=env, start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL); self.close()

    def draw_background(self, _w, cr):
        a = self.win.get_allocation(); cr.save(); cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.set_source_rgba(0, 0, 0, 0); cr.paint(); cr.set_operator(cairo.OPERATOR_OVER); cr.scale(SC, SC)
        x = y = SHADOW; w, h = a.width / SC - 2 * SHADOW, a.height / SC - 2 * SHADOW
        for i in range(SHADOW, 0, -1):
            rrect(cr, x - i, y - i + 2, w + 2 * i, h + 2 * i, RADIUS + i)
            cr.set_line_width(1.4); cr.set_source_rgba(0, 0, 0, .055 * (1 - i / SHADOW) ** 2); cr.stroke()
        grad = cairo.LinearGradient(0, y, 0, y + h); top, bottom = self.colors['top'], self.colors['bottom']
        grad.add_color_stop_rgba(0, *(v / 255 for v in top[:3]), top[3]); grad.add_color_stop_rgba(1, *(v / 255 for v in bottom[:3]), bottom[3])
        rrect(cr, x, y, w, h, RADIUS); cr.set_source(grad); cr.fill_preserve(); rgba(cr, self.colors['rim']); cr.set_line_width(1); cr.stroke()
        rrect(cr, x + .75, y + .75, w - 1.5, h - 1.5, RADIUS - .75); rgba(cr, self.colors['edge']); cr.stroke()
        cr.restore(); return False

    def place(self, px, py):
        self.anchor = (px, py)
        self.win.realize(); gdk_win = self.win.get_window()
        if gdk_win: gdk_win.set_override_redirect(True)
        alloc = self.win.get_allocation(); w, h = alloc.width, alloc.height
        display = Gdk.Display.get_default()
        monitor = display.get_monitor_at_point(px, py) or display.get_primary_monitor()
        work = monitor.get_workarea()
        edge = round(SHADOW * SC)
        # Clamp the visible glass to the work area, not the whole monitor.
        # With a bottom panel the latter hid exactly one panel-height of this
        # menu; HiDPI made that 52-pixel error especially obvious. The outer
        # window may cross the boundary by `edge`, because that part is only
        # the transparent shadow margin.
        left = work.x - edge + 4
        right = work.x + work.width - w + edge - 4
        x = max(left, min(int(px - w + edge + round(24 * SC)), right))
        top = work.y - edge + 4
        bottom = work.y + work.height - h + edge - 4
        if py < work.y + round(32 * SC):
            y = top
        elif py > work.y + work.height - round(32 * SC):
            y = bottom
        else:
            y = max(top, min(int(py) - edge + 8, bottom))
        self.win.move(x, y); Gtk.Widget.set_opacity(self.win, 0); self.win.present()
        seat = display.get_default_seat(); seat.grab(gdk_win, Gdk.SeatCapabilities.ALL, True, None, None, None)
        def outside(_window, event):
            if event.window != gdk_win: return False
            edge = round(SHADOW * SC)
            if not (edge < event.x < w - edge and edge < event.y < h - edge):
                self.close(); return True
            return False
        self.win.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
        self.win.connect('button-press-event', outside)
        started = time.monotonic()
        def fade():
            if self.closing: return False
            f = min(1, (time.monotonic() - started) / .11); Gtk.Widget.set_opacity(self.win, f * f * (3 - 2 * f)); return f < 1
        GLib.timeout_add(16, fade)

    def close(self):
        if self.closing: return
        self.closing = True
        try: Gdk.Display.get_default().get_default_seat().ungrab()
        except Exception: pass
        Gtk.main_quit()


def pointer_xy():
    if PTR_XY is not None: return PTR_XY
    _screen, x, y = Gdk.Display.get_default().get_default_seat().get_pointer().get_position()
    return int(x), int(y)


def single_instance():
    PIDFILE.parent.mkdir(parents=True, exist_ok=True)
    try: pid = int(read_text(PIDFILE, '0'))
    except ValueError: pid = 0
    if pid and pid != os.getpid():
        try: ours = b'system-menu' in Path(f'/proc/{pid}/cmdline').read_bytes()
        except OSError: ours = False
        if ours:
            try: os.kill(pid, signal.SIGTERM); return False
            except OSError: pass
    PIDFILE.write_text(str(os.getpid())); return True


def main():
    global PTR_XY, SC
    try:
        raw = subprocess.run(['xdotool', 'getmouselocation', '--shell'], capture_output=True,
                             text=True, timeout=3).stdout
        parts = dict(part.split('=', 1) for part in raw.split() if '=' in part)
        PTR_XY = (int(parts['X']), int(parts['Y']))
    except Exception: PTR_XY = None
    if not single_instance(): return
    SC = round((Gdk.Screen.get_default().get_resolution() or 96) / 96, 3) or 1
    menu = Menu(); signal.signal(signal.SIGTERM, lambda *_a: menu.close())
    menu.place(*pointer_xy()); Gtk.main()


if __name__ == '__main__':
    Gdk.set_program_class('mintbook-system-menu')
    try: main()
    finally:
        try:
            if read_text(PIDFILE) == str(os.getpid()): PIDFILE.unlink()
        except OSError: pass
