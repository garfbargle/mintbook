#!/usr/bin/env python3
"""Mintbook Overview — Spotlight-style Cairo glass search launcher for apps and actions."""
import fcntl
import importlib.machinery
import importlib.util
import math
import os
from pathlib import Path
import signal
import subprocess
import sys
import time

os.environ.setdefault('GTK_THEME', 'Adwaita')

HOME = os.path.expanduser('~')
BIN = os.path.dirname(os.path.realpath(__file__))
APPLIED = f'{HOME}/.config/mintbook/appearance.applied'
PIDFILE = f'{HOME}/.cache/mintbook/overview.pid'

WIDTH, SHADOW, RADIUS = 620, 18, 22
INPUT_H, ROW_H, PAD_X, PAD_Y, MAX_ROWS = 64, 48, 14, 10, 8

LIGHT = {  # generated by bin/palette-generate
    'top': (229, 231, 234, 0.980392),
    'bottom': (202, 205, 210, 0.968627),
    'edge': (255, 255, 255, 0.74902),
    'rim': (65, 68, 74, 0.180392),
    'fg': (45, 48, 54),
    'tile': (255, 255, 255, 0.54902),
    'tile_hi': (255, 255, 255, 0.780392),
    'tile_edge': (255, 255, 255, 0.65098),
    'hair': (65, 68, 74, 0.121569),
    'blue': (0, 122, 255),
}
DARK = {  # generated by bin/palette-generate
    'top': (104, 109, 119, 0.976471),
    'bottom': (74, 78, 86, 0.968627),
    'edge': (255, 255, 255, 0.180392),
    'rim': (0, 0, 0, 0.34902),
    'fg': (255, 255, 255),
    'tile': (255, 255, 255, 0.129412),
    'tile_hi': (255, 255, 255, 0.2),
    'tile_edge': (255, 255, 255, 0.101961),
    'hair': (255, 255, 255, 0.121569),
    'blue': (10, 132, 255),
}


def read_file(path, default=''):
    try:
        with open(path) as f:
            return f.read().strip() or default
    except OSError:
        return default


def read_mode():
    preview = os.environ.get('MINTBOOK_PREVIEW_APPEARANCE', '').strip()
    if preview in ('light', 'dark'):
        return preview
    return 'dark' if read_file(APPLIED, 'light') == 'dark' else 'light'


def parse_args(argv):
    if not argv:
        return ''
    if len(argv) == 2 and argv[0] == '--filter':
        return argv[1]
    raise ValueError('usage: overview [--filter text]')


def score_match(query, title, keywords=''):
    """Return a positive relevance score if every query token matches, else 0."""
    q = query.strip().casefold()
    if not q:
        return 1
    t = title.casefold()
    hay = f'{t} {keywords.casefold()}'
    tokens = q.split()
    total = 0
    for tok in tokens:
        if t == tok:
            total += 200
        elif t.startswith(tok):
            total += 120
        elif f' {tok}' in f' {t}':
            total += 95
        elif tok in t:
            total += 70
        elif tok in hay:
            total += 45
        else:
            # Subsequence fuzzy match on title
            it = iter(t)
            if all(ch in it for ch in tok):
                total += 20
            else:
                return 0
    return total


def filter_entries(entries, query):
    q = query.strip()
    if not q:
        return list(entries)
    scored = []
    for index, entry in enumerate(entries):
        s = score_match(q, entry['title'], entry.get('keywords', ''))
        if s > 0:
            # Slight boost for actions when query explicitly matches their keywords
            kind_bonus = 5 if entry['kind'] == 'action' and s >= 45 else 0
            scored.append((-(s + kind_bonus), entry['title'].casefold(), index, entry))
    scored.sort()
    return [item[3] for item in scored]


def load_spotlight_actions():
    path = Path(BIN) / 'spotlight-actions'
    if not path.exists():
        path = Path(HOME) / '.local/bin/spotlight-actions'
    if not path.exists():
        return None
    loader = importlib.machinery.SourceFileLoader('spotlight_actions', str(path))
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
    loader.exec_module(mod)
    return mod


def collect_entries(gio_module=None, actions_mod=None):
    entries = []
    if gio_module is not None:
        seen = set()
        for app in gio_module.AppInfo.get_all():
            if not app.should_show():
                continue
            name = (app.get_display_name() or '').strip()
            if not name or name.casefold() in seen:
                continue
            seen.add(name.casefold())
            desc = app.get_description() or ''
            cats = (app.get_categories() or '').replace(';', ' ')
            exe = app.get_executable() or ''
            entries.append({
                'kind': 'app',
                'title': name,
                'subtitle': 'Application',
                'keywords': f'{desc} {cats} {exe}',
                'gicon': app.get_icon(),
                'icon_name': None,
                'app': app,
            })
        entries.sort(key=lambda e: e['title'].casefold())

    if actions_mod is not None:
        local_bin = Path(HOME) / '.local/bin'
        repo_bin = Path(BIN)
        for key, (label, icon_name, keywords, argv) in actions_mod.ACTIONS.items():
            if key == 'sleep-normal':
                keep_awake = local_bin / 'keep-awake'
                if not keep_awake.exists():
                    keep_awake = repo_bin / 'keep-awake'
                try:
                    if int(subprocess.check_output([str(keep_awake), 'status'], timeout=1)) == 0:
                        continue
                except Exception:
                    continue
            if argv[0] != '@folder':
                if not (os.access(local_bin / argv[0], os.X_OK) or os.access(repo_bin / argv[0], os.X_OK)):
                    continue
            entries.append({
                'kind': 'action',
                'title': label,
                'subtitle': 'Mintbook Action',
                'keywords': f'{key} {keywords}',
                'gicon': None,
                'icon_name': icon_name,
                'action_key': key,
            })
    return entries


class StartGuardBusy(Exception):
    """Another launch is already building the first window."""


def take_start_guard(path):
    """Take the launch guard, or raise StartGuardBusy if one is already held.

    None means the cache is not writable; the launcher still opens, and the
    pidfile claim below remains the fallback serialization.
    """
    try:
        Path(path).parent.mkdir(parents=True, exist_ok=True)
        fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    except OSError:
        return None
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(fd)
        raise StartGuardBusy
    except OSError:
        os.close(fd)
        return None
    return fd


class GrabRetry:
    """Retry a seat grab until it succeeds or the popup closes.

    XFCE holds the keyboard for as long as Cmd+Space is down, so the grab
    that arrives with the launch can come back ALREADY_GRABBED. Keep asking;
    once the shortcut releases the keyboard, the popup owns it for the rest
    of its life. The first 40 tries are fast (25 ms); after that there is no
    hurry and 200 ms keeps an unlucky popup out of a busy loop.
    """

    def __init__(self, grab, schedule, closed=lambda: False):
        self.grab = grab
        self.schedule = schedule
        self.closed = closed
        self.done = False
        self.tries = 0

    def attempt(self):
        if self.done or self.closed():
            return False
        self.tries += 1
        try:
            self.done = bool(self.grab())
        except Exception:
            self.done = False
        if not self.done:
            self.schedule(25 if self.tries < 40 else 200, self.attempt)
        return False


def run_overview(initial_query=''):
    # Cmd+Space auto-repeats while it is held, and XFCE launches this command
    # on every repeat. Claiming the pidfile is not enough to serialize those
    # starts: the repeats race the first process before it has shown anything,
    # and the last one signals the one that was still coming up. Hold a start
    # guard until the keyboard grab succeeds (or a short timeout) so a held
    # shortcut opens one Overview instead of a storm of them. The app-grid
    # handoff deliberately skips the guard: it must be able to replace an
    # Overview that is already open.
    start_fd = None
    if not initial_query:
        try:
            start_fd = take_start_guard(PIDFILE + '.start')
        except StartGuardBusy:
            return 0

    def release_start():
        nonlocal start_fd
        if start_fd is not None:
            fd, start_fd = start_fd, None
            try:
                os.close(fd)
            except OSError:
                pass

    import cairo
    import gi
    gi.require_version('Gtk', '3.0')
    gi.require_version('Gdk', '3.0')
    gi.require_version('Gio', '2.0')
    gi.require_version('PangoCairo', '1.0')
    from gi.repository import Gtk, Gdk, Gio, GLib, Pango, PangoCairo

    screen = Gdk.Screen.get_default()
    if screen is None:
        release_start()
        return 1

    sys.path.insert(0, BIN)
    from mintbook_instance import claim
    if initial_query:
        # When app-grid hands off a typed character, replace any open Overview
        for _ in range(15):
            if claim(PIDFILE, 'overview', signal.SIGTERM):
                break
            time.sleep(0.02)
    else:
        if not claim(PIDFILE, 'overview', signal.SIGTERM):
            release_start()
            return 0
    for extra in ('rofi',):
        subprocess.run(['pkill', '-x', extra], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    sc = float(os.environ.get('MINTBOOK_SCALE', 0)) or round((screen.get_resolution() or 96) / 96.0, 3) or 1.0
    mode = read_mode()
    colors = DARK if mode == 'dark' else LIGHT
    actions_mod = load_spotlight_actions()
    all_entries = collect_entries(Gio, actions_mod)
    icon_theme = Gtk.IconTheme.get_default()
    icon_cache = {}

    def surface_for_entry(entry):
        cache_key = (entry['kind'], entry['title'])
        if cache_key in icon_cache:
            return icon_cache[cache_key]
        px = round(30 * sc)
        surf = None
        try:
            info = None
            if entry.get('gicon') is not None:
                info = icon_theme.lookup_by_gicon(entry['gicon'], px, Gtk.IconLookupFlags.FORCE_SIZE)
            elif entry.get('icon_name'):
                info = icon_theme.lookup_icon(entry['icon_name'], px, Gtk.IconLookupFlags.FORCE_SIZE)
            if info is not None:
                pix = info.load_icon()
                if pix is not None:
                    surf = Gdk.cairo_surface_create_from_pixbuf(pix, 1, None)
        except Exception:
            surf = None
        icon_cache[cache_key] = surf
        return surf

    def rrect(cr, x, y, w, h, r):
        r = max(0, min(r, w / 2, h / 2))
        cr.new_sub_path()
        cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
        cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
        cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
        cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
        cr.close_path()

    def rgba(cr, c, a=None):
        cr.set_source_rgba(c[0] / 255, c[1] / 255, c[2] / 255,
                           c[3] if a is None and len(c) > 3 else (1.0 if a is None else a))

    def draw_text(cr, s, x, y, size, color, alpha=1.0, weight='normal', align='left', width=None):
        layout = PangoCairo.create_layout(cr)
        desc = Pango.FontDescription(f'Inter {size}')
        desc.set_weight(Pango.Weight.BOLD if weight == 'bold' else Pango.Weight.MEDIUM if weight == 'medium' else Pango.Weight.NORMAL)
        layout.set_font_description(desc)
        if width:
            layout.set_width(int(width * Pango.SCALE))
            layout.set_ellipsize(Pango.EllipsizeMode.END)
        if align == 'right' and width:
            layout.set_alignment(Pango.Alignment.RIGHT)
        layout.set_text(str(s), -1)
        ext = layout.get_pixel_extents()[1]
        cr.move_to(x, y)
        rgba(cr, color, alpha)
        PangoCairo.show_layout(cr, layout)
        return ext.width

    state = {
        'query': initial_query,
        'results': filter_entries(all_entries, initial_query),
        'selected': 0,
        'top': 0,
        'hover': -1,
        'caret': True,
        'closing': False,
    }

    def card_height():
        n = min(MAX_ROWS, max(1, len(state['results'])))
        return INPUT_H + 1 + PAD_Y * 2 + n * ROW_H

    win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
    win.set_title('Overview')
    win.set_decorated(False)
    win.set_skip_taskbar_hint(True)
    win.set_skip_pager_hint(True)
    win.set_keep_above(True)
    win.set_resizable(False)
    win.set_app_paintable(True)
    win.set_type_hint(Gdk.WindowTypeHint.POPUP_MENU)
    visual = screen.get_rgba_visual()
    if visual:
        win.set_visual(visual)

    area = Gtk.DrawingArea()
    area.add_events(Gdk.EventMask.BUTTON_PRESS_MASK
                    | Gdk.EventMask.BUTTON_RELEASE_MASK
                    | Gdk.EventMask.POINTER_MOTION_MASK
                    | Gdk.EventMask.SCROLL_MASK
                    | Gdk.EventMask.LEAVE_NOTIFY_MASK)
    win.add(area)

    display = Gdk.Display.get_default()
    monitor = display.get_primary_monitor() or display.get_monitor(0)
    work = monitor.get_workarea()

    def update_geometry():
        h = card_height()
        w_px = round((WIDTH + 2 * SHADOW) * sc)
        h_px = round((h + 2 * SHADOW) * sc)
        area.set_size_request(w_px, h_px)
        win.set_size_request(w_px, h_px)
        win.resize(w_px, h_px)
        x = work.x + (work.width - w_px) // 2
        y = work.y + round(work.height * 0.14) - round(SHADOW * sc)
        win.move(x, max(work.y, y))

    def close():
        if state['closing']:
            return
        state['closing'] = True
        release_start()
        try:
            display.get_default_seat().ungrab()
        except Exception:
            pass
        Gtk.main_quit()

    def activate(entry):
        if entry is None:
            return
        try:
            display.get_default_seat().ungrab()
        except Exception:
            pass
        win.hide()
        if entry['kind'] == 'app':
            ctx = display.get_app_launch_context()
            try:
                entry['app'].launch([], ctx)
            except Exception:
                pass
        elif entry['kind'] == 'action' and actions_mod is not None:
            script = Path(BIN) / 'spotlight-actions'
            if not script.exists():
                script = Path(HOME) / '.local/bin/spotlight-actions'
            subprocess.Popen([sys.executable, str(script), '--execute', entry['action_key']],
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)
        close()

    def refilter():
        state['results'] = filter_entries(all_entries, state['query'])
        state['selected'] = 0
        state['top'] = 0
        state['hover'] = -1
        update_geometry()
        area.queue_draw()

    def ensure_visible():
        sel = state['selected']
        if sel < state['top']:
            state['top'] = sel
        elif sel >= state['top'] + MAX_ROWS:
            state['top'] = sel - MAX_ROWS + 1

    def clear_win(_w, cr):
        cr.save()
        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.set_source_rgba(0, 0, 0, 0)
        cr.paint()
        cr.restore()
        return False

    def on_draw(_w, cr):
        cr.set_antialias(cairo.ANTIALIAS_BEST)
        cr.scale(sc, sc)
        ox, oy = SHADOW, SHADOW
        h = card_height()

        for i in range(SHADOW, 0, -1):
            rrect(cr, ox - i, oy - i + 2, WIDTH + 2 * i, h + 2 * i, RADIUS + i)
            cr.set_line_width(1.4)
            cr.set_source_rgba(0, 0, 0, 0.055 * (1 - i / SHADOW) ** 2)
            cr.stroke()

        grad = cairo.LinearGradient(0, oy, 0, oy + h)
        top, bot = colors['top'], colors['bottom']
        grad.add_color_stop_rgba(0, top[0] / 255, top[1] / 255, top[2] / 255, top[3])
        grad.add_color_stop_rgba(1, bot[0] / 255, bot[1] / 255, bot[2] / 255, bot[3])
        rrect(cr, ox, oy, WIDTH, h, RADIUS)
        cr.set_source(grad)
        cr.fill_preserve()
        rgba(cr, colors['rim'])
        cr.set_line_width(1)
        cr.stroke()
        rrect(cr, ox + 0.75, oy + 0.75, WIDTH - 1.5, h - 1.5, RADIUS - 0.75)
        rgba(cr, colors['edge'])
        cr.set_line_width(1)
        cr.stroke()

        cr.save()
        rrect(cr, ox, oy, WIDTH, h, RADIUS)
        cr.clip()
        cr.translate(ox, oy)

        # Magnifier glyph
        rgba(cr, colors['fg'], 0.55)
        cr.set_line_width(2.0)
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.arc(28, INPUT_H / 2 - 2, 7.5, 0, 2 * math.pi)
        cr.stroke()
        cr.move_to(33.5, INPUT_H / 2 + 3.5)
        cr.line_to(39.5, INPUT_H / 2 + 9.5)
        cr.stroke()

        # Query or placeholder
        q = state['query']
        if q:
            tw = draw_text(cr, q, 52, 18, 17, colors['fg'], 0.96, 'medium', width=WIDTH - 130)
            if state['caret']:
                cx = min(WIDTH - 75, 52 + tw + 2)
                cr.move_to(cx, 20)
                cr.line_to(cx, 44)
                rgba(cr, colors['blue'], 0.95)
                cr.set_line_width(1.8)
                cr.stroke()
        else:
            if state['caret']:
                cr.move_to(52, 20)
                cr.line_to(52, 44)
                rgba(cr, colors['blue'], 0.95)
                cr.set_line_width(1.8)
                cr.stroke()
            draw_text(cr, 'Search apps and actions', 56, 18, 17, colors['fg'], 0.42, 'normal')

        # Subtle Esc badge on the right of the input bar
        rrect(cr, WIDTH - 54, (INPUT_H - 22) / 2, 36, 22, 6)
        rgba(cr, colors['tile'])
        cr.fill_preserve()
        rgba(cr, colors['tile_edge'])
        cr.set_line_width(0.8)
        cr.stroke()
        draw_text(cr, 'esc', WIDTH - 54, (INPUT_H - 22) / 2 + 4, 8.5, colors['fg'], 0.48, 'medium', 'right', 26)

        # Hairline divider
        cr.move_to(0, INPUT_H + 0.5)
        cr.line_to(WIDTH, INPUT_H + 0.5)
        rgba(cr, colors['hair'])
        cr.set_line_width(1)
        cr.stroke()

        results = state['results']
        if not results:
            draw_text(cr, 'No matching apps or actions', 52, INPUT_H + PAD_Y + 14, 11.5, colors['fg'], 0.45)
        else:
            vis = results[state['top']:state['top'] + MAX_ROWS]
            for i, entry in enumerate(vis):
                idx = state['top'] + i
                ry = INPUT_H + 1 + PAD_Y + i * ROW_H
                sel = idx == state['selected']
                hot = idx == state['hover'] and not sel
                if sel:
                    rrect(cr, PAD_X, ry + 2, WIDTH - 2 * PAD_X, ROW_H - 4, 11)
                    rgba(cr, colors['blue'], 0.92)
                    cr.fill()
                elif hot:
                    rrect(cr, PAD_X, ry + 2, WIDTH - 2 * PAD_X, ROW_H - 4, 11)
                    rgba(cr, colors['tile_hi'])
                    cr.fill()

                surf = surface_for_entry(entry)
                ix, iy = PAD_X + 12, ry + (ROW_H - 30) / 2
                if surf is not None:
                    cr.save()
                    cr.scale(1.0 / sc, 1.0 / sc)
                    cr.set_source_surface(surf, round(ix * sc), round(iy * sc))
                    cr.paint()
                    cr.restore()
                else:
                    rrect(cr, ix + 2, iy + 2, 26, 26, 7)
                    rgba(cr, (255, 255, 255) if sel else colors['blue'], 0.22)
                    cr.fill()

                fg = (255, 255, 255) if sel else colors['fg']
                draw_text(cr, entry['title'], PAD_X + 54, ry + 8, 11.5, fg,
                          0.98 if sel else 0.92, 'bold' if sel else 'medium', width=WIDTH - 190)
                draw_text(cr, entry['subtitle'], PAD_X + 54, ry + 26, 8.8, fg,
                          0.78 if sel else 0.44, 'normal', width=WIDTH - 190)

                if sel:
                    draw_text(cr, '↵', WIDTH - PAD_X - 36, ry + 14, 11.5, fg, 0.85, 'bold', 'right', 24)

        cr.restore()
        return False

    def row_at(ex, ey):
        x, y = ex / sc - SHADOW, ey / sc - SHADOW
        if not (PAD_X <= x <= WIDTH - PAD_X):
            return -1
        ry = y - (INPUT_H + 1 + PAD_Y)
        if ry < 0:
            return -1
        i = int(ry // ROW_H)
        idx = state['top'] + i
        if 0 <= i < MAX_ROWS and 0 <= idx < len(state['results']):
            return idx
        return -1

    def on_motion(_w, e):
        r = row_at(e.x, e.y)
        if r != state['hover']:
            state['hover'] = r
            area.queue_draw()
        return True

    def on_leave(_w, _e):
        if state['hover'] != -1:
            state['hover'] = -1
            area.queue_draw()
        return True

    def on_scroll(_w, e):
        if not state['results']:
            return False
        if e.direction == Gdk.ScrollDirection.SMOOTH:
            dy = e.get_scroll_deltas()[2]
        else:
            dy = 1 if e.direction == Gdk.ScrollDirection.DOWN else -1
        if dy > 0 and state['selected'] + 1 < len(state['results']):
            state['selected'] += 1
            ensure_visible()
            area.queue_draw()
        elif dy < 0 and state['selected'] > 0:
            state['selected'] -= 1
            ensure_visible()
            area.queue_draw()
        return True

    def on_press(_w, e):
        if e.button != 1:
            return False
        x, y = e.x / sc - SHADOW, e.y / sc - SHADOW
        h = card_height()
        if not (0 <= x <= WIDTH and 0 <= y <= h):
            close()
            from mintbook_instance import bar_handoff
            bar_handoff(e, 'overview')
            return True
        if WIDTH - 58 <= x <= WIDTH - 14 and 14 <= y <= INPUT_H - 14:
            close()
            return True
        r = row_at(e.x, e.y)
        if r >= 0:
            state['selected'] = r
            area.queue_draw()
        return True

    def on_release(_w, e):
        if e.button != 1:
            return False
        r = row_at(e.x, e.y)
        if r >= 0 and r == state['selected']:
            activate(state['results'][r])
        return True

    def on_key(_w, e):
        ctrl = bool(e.state & Gdk.ModifierType.CONTROL_MASK)
        if e.keyval == Gdk.KEY_Escape:
            close()
            return True
        if e.keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            if state['results'] and 0 <= state['selected'] < len(state['results']):
                activate(state['results'][state['selected']])
            return True
        if e.keyval in (Gdk.KEY_Down, Gdk.KEY_Tab) or (ctrl and e.keyval in (Gdk.KEY_n, Gdk.KEY_N, Gdk.KEY_j, Gdk.KEY_J)):
            if state['results']:
                state['selected'] = (state['selected'] + 1) % len(state['results'])
                ensure_visible()
                area.queue_draw()
            return True
        if e.keyval in (Gdk.KEY_Up, Gdk.KEY_ISO_Left_Tab) or (ctrl and e.keyval in (Gdk.KEY_p, Gdk.KEY_P, Gdk.KEY_k, Gdk.KEY_K)):
            if state['results']:
                state['selected'] = (state['selected'] - 1) % len(state['results'])
                ensure_visible()
                area.queue_draw()
            return True
        if e.keyval == Gdk.KEY_Page_Down:
            if state['results']:
                state['selected'] = min(len(state['results']) - 1, state['selected'] + MAX_ROWS)
                ensure_visible()
                area.queue_draw()
            return True
        if e.keyval == Gdk.KEY_Page_Up:
            if state['results']:
                state['selected'] = max(0, state['selected'] - MAX_ROWS)
                ensure_visible()
                area.queue_draw()
            return True
        if e.keyval == Gdk.KEY_BackSpace:
            if state['query']:
                if ctrl:
                    state['query'] = ''
                else:
                    state['query'] = state['query'][:-1]
                refilter()
            return True
        if ctrl and e.keyval in (Gdk.KEY_u, Gdk.KEY_U):
            if state['query']:
                state['query'] = ''
                refilter()
            return True
        if ctrl and e.keyval in (Gdk.KEY_w, Gdk.KEY_W):
            if state['query']:
                state['query'] = state['query'].rstrip()
                idx = state['query'].rfind(' ')
                state['query'] = state['query'][:idx + 1] if idx >= 0 else ''
                refilter()
            return True
        if ctrl and e.keyval in (Gdk.KEY_v, Gdk.KEY_V):
            clip = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).wait_for_text()
            if clip:
                state['query'] += clip.strip().replace('\n', ' ')
                refilter()
            return True
        if not (e.state & (Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.MOD1_MASK | Gdk.ModifierType.SUPER_MASK)):
            ch = Gdk.keyval_to_unicode(e.keyval)
            if ch >= 32:
                state['query'] += chr(ch)
                refilter()
                return True
        return False

    win.connect('draw', clear_win)
    win.connect('key-press-event', on_key)
    win.connect('destroy', lambda *_: close())
    area.connect('draw', on_draw)
    area.connect('motion-notify-event', on_motion)
    area.connect('leave-notify-event', on_leave)
    area.connect('scroll-event', on_scroll)
    area.connect('button-press-event', on_press)
    area.connect('button-release-event', on_release)

    update_geometry()
    win.realize()
    gdk_win = win.get_window()
    if gdk_win is not None:
        gdk_win.set_override_redirect(True)
    update_geometry()
    Gtk.Widget.set_opacity(win, 0.0)
    win.set_can_focus(True)
    win.show_all()
    win.present()
    win.grab_focus()

    # Cmd+Space is still held when XFCE launches this command. XFCE owns the
    # keyboard grab for as long as the chord is down, so the first seat grab
    # can come back ALREADY_GRABBED. xfwm4 never focuses an override-redirect
    # window on its own, which would leave every following keystroke in the
    # app underneath. Retry until the shortcut releases the keyboard; after
    # that the grab holds for the life of the popup, as it does when opened
    # from the bar.
    seat = display.get_default_seat()

    def grab_keyboard_once():
        try:
            owned = seat.grab(gdk_win, Gdk.SeatCapabilities.ALL, True,
                              None, None, None) == Gdk.GrabStatus.SUCCESS
        except Exception:
            owned = False
        if owned:
            release_start()
        return owned

    if gdk_win is None:
        release_start()
    else:
        # Never let a keyboard another client refuses to release block the
        # bar icon from closing a popup that could not take the keys.
        GLib.timeout_add(5000, release_start)
        GrabRetry(grab_keyboard_once, GLib.timeout_add,
                  closed=lambda: state['closing']).attempt()

    t0 = time.monotonic()

    def fade_in():
        if state['closing']:
            return False
        f = min(1.0, (time.monotonic() - t0) / 0.095)
        Gtk.Widget.set_opacity(win, f * f * (3 - 2 * f))
        return f < 1.0

    def tick_caret():
        if state['closing']:
            return False
        state['caret'] = not state['caret']
        area.queue_draw()
        return True

    GLib.timeout_add(16, fade_in)
    GLib.timeout_add(530, tick_caret)
    signal.signal(signal.SIGTERM, lambda *_: GLib.idle_add(close))
    try:
        Gtk.main()
    finally:
        release_start()
        try:
            if read_file(PIDFILE) == str(os.getpid()):
                os.unlink(PIDFILE)
        except OSError:
            pass
    return 0


def main():
    try:
        initial = parse_args(sys.argv[1:])
    except ValueError as err:
        print(err, file=sys.stderr)
        return 2
    return run_overview(initial)


if __name__ == '__main__':
    sys.exit(main())
