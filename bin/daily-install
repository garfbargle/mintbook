#!/usr/bin/env python3
"""Install Mintbook daily-use improvements, with a persistent undo snapshot."""
import json
import os
from pathlib import Path
import shlex
import shutil
import subprocess
import sys
import time

ROOT = Path(__file__).resolve().parent.parent
HOME = Path.home()
SAVED = HOME / '.config/mintbook/daily-install.json'
BIN = HOME / '.local/bin'
UNIT_DIR = HOME / '.config/systemd/user'
SCRIPTS = ('overview', 'spotlight', 'spotlight-actions', 'keep-awake', 'screenshot', 'screenshot-notify',
           'window-place', 'mintbook-health', 'doctor', 'control-center', 'system-menu', 'wifi-menu', 'bt-menu',
           'battery-menu', 'battery-history', 'sleep-report', 'updates-menu',
           'cpu-menu', 'panel-cpu', 'mintbook_cpu.py', 'mintbook_keys.py')
PLUGINS = ()
UNIT = 'mintbook-health.timer'
KEYS = {'<Super>Left': 'left', '<Super>Right': 'right', '<Super>Down': 'restore'}
SETTINGS = (
    ('xfce4-power-manager', '/xfce4-power-manager/lid-action-on-ac', 'uint', '1'),
    ('xfce4-power-manager', '/xfce4-power-manager/lid-action-on-battery', 'uint', '1'),
)


def run(*argv, check=True):
    return subprocess.run(argv, check=check, text=True, capture_output=True)


def targets():
    result = [(ROOT / 'bin' / name, BIN / name) for name in SCRIPTS]
    result += [(ROOT / 'control-center/plugins' / name,
                HOME / '.local/share/mintbook/control-center/plugins' / name) for name in PLUGINS]
    result += [(ROOT / 'config/systemd' / name, UNIT_DIR / name)
               for name in ('mintbook-health.service', UNIT)]
    return result


def snapshot():
    if SAVED.exists():
        data = json.loads(SAVED.read_text())
        # A rerun can install scripts introduced after the original snapshot.
        # Add their pre-install state now so --revert still removes/restores
        # everything, while retaining every older backup unchanged.
        known = {entry['path'] for entry in data['files']}
        added = [(source, dest) for source, dest in targets()
                 if str(dest) not in known]
        settings = data.setdefault('settings', {})
        added_settings = []
        for channel, prop, _kind, _value in SETTINGS:
            key = channel + '\n' + prop
            if key not in settings:
                result = run('xfconf-query', '-c', channel, '-p', prop, check=False)
                settings[key] = result.stdout.rstrip('\n') if result.returncode == 0 else None
                added_settings.append(key)
        if not added and not added_settings:
            return data
        if added:
            backup = (HOME / '.local/state/mintbook' /
                      ('daily-added-' + time.strftime('%Y%m%d-%H%M%S') + '-'
                       + str(time.time_ns() % 1000000000)))
            backup.mkdir(parents=True)
            for i, (_source, dest) in enumerate(added):
                entry = dict(path=str(dest), backup=None)
                if dest.exists() or dest.is_symlink():
                    copy = backup / str(i)
                    shutil.copy2(dest, copy, follow_symlinks=False)
                    entry['backup'] = str(copy)
                data['files'].append(entry)
        SAVED.write_text(json.dumps(data, indent=2))
        return data
    backup = HOME / '.local/state/mintbook' / ('daily-before-' + time.strftime('%Y%m%d-%H%M%S') + '-' + str(time.time_ns() % 1000000000))
    backup.mkdir(parents=True)
    data = dict(files=[], keys={}, settings={},
                timer=run('systemctl', '--user', 'is-enabled', UNIT, check=False).returncode == 0)
    for i, (_, dest) in enumerate(targets()):
        entry = dict(path=str(dest), backup=None)
        if dest.exists() or dest.is_symlink():
            copy = backup / str(i)
            shutil.copy2(dest, copy, follow_symlinks=False)
            entry['backup'] = str(copy)
        data['files'].append(entry)
    for key in KEYS:
        for kind in ('commands', 'xfwm4'):
            prop = f'/{kind}/custom/{key}'
            result = run('xfconf-query', '-c', 'xfce4-keyboard-shortcuts', '-p', prop, check=False)
            data['keys'][prop] = result.stdout.rstrip('\n') if result.returncode == 0 else None
    for channel, prop, _kind, _value in SETTINGS:
        result = run('xfconf-query', '-c', channel, '-p', prop, check=False)
        data['settings'][channel + '\n' + prop] = (result.stdout.rstrip('\n')
                                                    if result.returncode == 0 else None)
    SAVED.parent.mkdir(parents=True, exist_ok=True)
    SAVED.write_text(json.dumps(data, indent=2))
    return data


def restore():
    data = json.loads(SAVED.read_text())
    run('systemctl', '--user', 'stop', 'mintbook-awake.service', check=False)
    run('systemctl', '--user', 'disable', '--now', UNIT, check=False)
    for entry in data['files']:
        dest = Path(entry['path'])
        dest.unlink(missing_ok=True)
        if entry['backup']:
            shutil.copy2(entry['backup'], dest, follow_symlinks=False)
    for prop, value in data['keys'].items():
        run('xfconf-query', '-c', 'xfce4-keyboard-shortcuts', '-p', prop, '-r', check=False)
        if value is not None:
            run('xfconf-query', '-c', 'xfce4-keyboard-shortcuts', '-p', prop, '-n', '-t', 'string', '-s', value)
    kinds = {channel + '\n' + prop: kind for channel, prop, kind, _value in SETTINGS}
    for key, value in data.get('settings', {}).items():
        channel, prop = key.split('\n', 1)
        run('xfconf-query', '-c', channel, '-p', prop, '-r', check=False)
        if value is not None:
            run('xfconf-query', '-c', channel, '-p', prop, '-n', '-t', kinds[key], '-s', value)
    run('systemctl', '--user', 'daemon-reload')
    if data['timer']:
        run('systemctl', '--user', 'enable', '--now', UNIT)
    SAVED.unlink()
    print('Restored the previous scripts, tiles, timer and window shortcuts. Backup files retained.')


def install():
    for command in ('rofi', 'xfconf-query', 'systemctl', 'systemd-run', 'xdotool', 'wmctrl', 'notify-send'):
        if not shutil.which(command):
            sys.exit(f'Missing dependency: {command}')
    if not os.environ.get('DISPLAY'):
        sys.exit('Run this in the desktop session (DISPLAY is unset).')
    import gi
    gi.require_version('Gtk', '3.0')
    gi.require_version('GdkX11', '3.0')
    run(sys.executable, str(ROOT / 'bin/palette-generate'), '--check')
    snapshot()
    for source, dest in targets():
        dest.parent.mkdir(parents=True, exist_ok=True)
        dest.unlink(missing_ok=True)
        dest.symlink_to(source)
    # These daily conveniences now live in the System tray menu. Remove old
    # installed copies left by an earlier daily-install without putting them
    # back into the Control Center on a rerun.
    plugin_dir = HOME / '.local/share/mintbook/control-center/plugins'
    for name in ('65-awake', '75-health'):
        (plugin_dir / name).unlink(missing_ok=True)
    for key, mode in KEYS.items():
        run('xfconf-query', '-c', 'xfce4-keyboard-shortcuts', '-p', f'/xfwm4/custom/{key}', '-r', check=False)
        prop = f'/commands/custom/{key}'
        run('xfconf-query', '-c', 'xfce4-keyboard-shortcuts', '-p', prop, '-r', check=False)
        run('xfconf-query', '-c', 'xfce4-keyboard-shortcuts', '-p', prop, '-n', '-t', 'string',
            '-s', shlex.quote(str(BIN / 'window-place')) + ' ' + mode)
    for channel, prop, kind, value in SETTINGS:
        current = run('xfconf-query', '-c', channel, '-p', prop, check=False)
        args = ('-s', value) if current.returncode == 0 else ('-n', '-t', kind, '-s', value)
        run('xfconf-query', '-c', channel, '-p', prop, *args)
    run('systemctl', '--user', 'daemon-reload')
    run('systemctl', '--user', 'enable', '--now', UNIT)
    print('Installed. Cmd+Space opens Overview; Cmd+Left/Right places windows; Cmd+Down restores.')
    print('Keep Awake and Doctor are available from the System tray menu.')
    print(f'Undo: {ROOT}/bin/daily-install --revert')


if __name__ == '__main__':
    if sys.argv[1:] == ['--revert']:
        restore()
    elif not sys.argv[1:]:
        install()
    else:
        sys.exit('usage: daily-install [--revert]')
