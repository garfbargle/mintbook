#!/usr/bin/env python3
"""Route MacBook8,1 audio when the headphone-jack state changes.

The speaker DSP sink holds the HDA stream while it exists. Plugging
headphones therefore removes that raw node before selecting the analog sink;
unplugging restarts the user audio services so the speaker graph is rebuilt.
"""

import os
import re
import subprocess
import sys
import time
from pathlib import Path


CARD_ID = os.environ.get("MB81_CARD_ID", "PCH")
HEADPHONE_SINK = os.environ.get(
    "MB81_HP_SINK", "alsa_output.pci-0000_00_1b.0.analog-stereo"
)
SPEAKER_SINK = os.environ.get("MB81_SPK_SINK", "input.MacBook_Speaker")
CARD_NAME = os.environ.get("MB81_CARD_NAME", "alsa_card.pci-0000_00_1b.0")
HEADPHONE_PROFILE = os.environ.get(
    "MB81_HP_PROFILE", "output:analog-stereo+input:analog-stereo"
)
RAW_NODE = "MacBook_Speaker_Raw"
# Bounded wait for the card at startup. Resume destroys and re-creates the
# card, and systemd restarts this unit as soon as the user audio services
# return — which can be seconds before ALSA has re-registered the controls.
STARTUP_TIMEOUT = float(os.environ.get("MB81_STARTUP_TIMEOUT", "15"))


def log(message):
    print(f"mb81-jack-switch: {message}", flush=True)


def capture(*argv):
    try:
        return subprocess.run(
            argv,
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
        ).stdout
    except OSError:
        return ""


def call(*argv):
    try:
        return subprocess.run(
            argv, check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
        ).returncode
    except OSError:
        return 127


def find_card():
    for card_dir in sorted(Path("/sys/class/sound").glob("card[0-9]*")):
        try:
            if (card_dir / "id").read_text().strip() == CARD_ID:
                return card_dir.name.removeprefix("card")
        except OSError:
            continue
    return None


def find_jack_control(card):
    controls = capture("amixer", "-c", card, "controls")
    match = re.search(r"numid=(\d+).*name='Headphone Jack'", controls)
    return match.group(1) if match else None


def jack_state(card, numid):
    value = capture("amixer", "-c", card, "cget", f"numid={numid}")
    match = re.search(r"\bvalues=(on|off)\b", value)
    return match.group(1) if match else None


def pipewire_nodes():
    """Return {node name: numeric id} from pw-cli's record-oriented output."""
    nodes = {}
    current_id = None
    for line in capture("pw-cli", "ls", "Node").splitlines():
        match = re.match(r"\s*id\s+(\d+),", line)
        if match:
            current_id = match.group(1)
            continue
        match = re.search(r'node\.name\s*=\s*"([^"]+)"', line)
        if current_id is not None and match:
            nodes[match.group(1)] = current_id
    return nodes


def wait_for(probe, deadline, interval=0.25):
    """Poll probe() until it returns a value, or the shared deadline expires.

    Exiting on the first miss made resume a lottery: on the 2026-09-09 cycle
    this unit burned three of systemd's five permitted starts in four seconds
    ("Headphone Jack control not found on card 0") before the controls showed
    up. A slower re-enumeration exhausts that budget and leaves the unit failed
    until someone notices it in bin/doctor. Probes at least once, so a caller
    passing an already-expired deadline still gets one attempt.
    """
    while True:
        result = probe()
        if result is not None:
            return result
        if time.monotonic() >= deadline:
            return None
        time.sleep(interval)


def wait_for_node(name, timeout=8.0):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if name in pipewire_nodes():
            return True
        time.sleep(0.25)
    return False


def destroy_node(name):
    node_id = pipewire_nodes().get(name)
    if node_id is not None:
        call("pw-cli", "destroy", node_id)


def set_default_sink(name):
    call(
        "pw-metadata",
        "-n",
        "default",
        "0",
        "default.configured.audio.sink",
        f'{{ "name": "{name}" }}',
    )
    call("pactl", "set-default-sink", name)


def move_application_streams(destination):
    for line in capture("pactl", "list", "short", "sink-inputs").splitlines():
        fields = line.split()
        if len(fields) >= 3 and fields[2] != "-":
            call("pactl", "move-sink-input", fields[0], destination)


def route_headphones():
    log(f"headphones plugged -> {HEADPHONE_SINK}")
    destroy_node(RAW_NODE)
    call("pactl", "set-card-profile", CARD_NAME, HEADPHONE_PROFILE)
    if wait_for_node(HEADPHONE_SINK):
        set_default_sink(HEADPHONE_SINK)
        move_application_streams(HEADPHONE_SINK)
    else:
        log(f"headphone sink {HEADPHONE_SINK} did not appear")


def route_speakers():
    log(f"headphones unplugged -> recreate speaker + {SPEAKER_SINK}")
    call("systemctl", "--user", "restart", "pipewire", "pipewire-pulse", "wireplumber")
    if wait_for_node(SPEAKER_SINK):
        set_default_sink(SPEAKER_SINK)
    else:
        log(f"speaker sink {SPEAKER_SINK} did not appear")


def monitor(card, numid, initial_state):
    try:
        process = subprocess.Popen(
            ["alsactl", "monitor", f"hw:{card}"],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            bufsize=1,
        )
    except OSError as error:
        log(f"cannot start alsactl monitor: {error}")
        return 1

    previous = initial_state
    assert process.stdout is not None
    for _event in process.stdout:
        current = jack_state(card, numid)
        if current is None or current == previous:
            continue
        previous = current
        route_headphones() if current == "on" else route_speakers()

    log("alsactl monitor exited")
    return 1


def main():
    # One deadline across all three probes, so a slow resume cannot stack three
    # separate waits into a startup long enough to look like a hang.
    deadline = time.monotonic() + STARTUP_TIMEOUT
    waited = f"after {STARTUP_TIMEOUT:g}s"

    card = wait_for(find_card, deadline)
    if card is None:
        log(f"CS4208 card ({CARD_ID}) not found {waited}; exiting")
        return 1

    numid = wait_for(lambda: find_jack_control(card), deadline)
    if numid is None:
        log(f"Headphone Jack control not found on card {card} {waited}; exiting")
        return 1

    state = wait_for(lambda: jack_state(card, numid), deadline)
    if state is None:
        log(f"cannot read Headphone Jack control on card {card} {waited}; exiting")
        return 1

    log(f"watching card {card} 'Headphone Jack' (numid={numid})")
    if state == "on":
        route_headphones()
    else:
        log(f"startup: speakers -> {SPEAKER_SINK}")
        set_default_sink(SPEAKER_SINK)
    return monitor(card, numid, state)


if __name__ == "__main__":
    sys.exit(main())
