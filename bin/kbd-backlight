#!/usr/bin/env python3
"""Perceived-brightness curve and HUD feedback for keyboard illumination."""
import argparse
import fcntl
import os
from pathlib import Path
import subprocess
import sys
import tempfile

LED = Path('/sys/class/leds/spi::kbd_backlight')
CONFIG = Path(os.environ.get('XDG_CONFIG_HOME', Path.home() / '.config'))
STATE_DIR = CONFIG / 'mintbook'
STATE = STATE_DIR / 'kbd-backlight.state'
LOCK = Path.home() / '.cache/mintbook/kbd-backlight.lock'


def atomic(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temp = tempfile.mkstemp(prefix='.' + path.name, dir=path.parent)
    try:
        with os.fdopen(fd, 'w') as handle:
            handle.write(text)
        os.replace(temp, path)
    finally:
        if os.path.exists(temp):
            os.unlink(temp)


def read_state(path=None):
    target = STATE if path is None else path
    try:
        return dict(line.split('=', 1) for line in target.read_text().splitlines() if '=' in line)
    except OSError:
        return {}


def curve(percent, maximum, gamma=1.7):
    percent = max(0, min(100, int(percent)))
    if percent == 0:
        return 0
    return max(1, min(maximum, round(maximum * (percent / 100.0) ** gamma)))


def level(hardware, maximum, state, gamma=1.7):
    try:
        requested = int(state['req_pct'])
        if int(state['hw']) == hardware and 0 <= requested <= 100:
            return requested
    except (KeyError, ValueError):
        pass
    if hardware <= 0 or maximum <= 0:
        return 0
    return max(1, min(100, round(100.0 * (hardware / maximum) ** (1.0 / gamma))))


def set_hardware(want, led=LED):
    subprocess.run(['busctl', '--system', 'call', 'org.freedesktop.login1',
                    '/org/freedesktop/login1/session/auto', 'org.freedesktop.login1.Session',
                    'SetBrightness', 'ssu', 'leds', led.name, str(int(want))],
                   check=True, capture_output=True, timeout=3)


def apply(percent=None, step=None, toggle=False):
    LOCK.parent.mkdir(parents=True, exist_ok=True)
    with LOCK.open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        maximum = int((LED / 'max_brightness').read_text())
        hardware = int((LED / 'brightness').read_text())
        state = read_state()
        current = level(hardware, maximum, state)
        last_on = int(state.get('last_on', 50) or 50)
        if not 1 <= last_on <= 100:
            last_on = 50
        if toggle:
            requested = 0 if current > 0 else last_on
        elif percent is not None:
            requested = max(0, min(100, int(percent)))
        else:
            requested = max(0, min(100, current + int(step or 0)))
        if requested > 0:
            last_on = requested
        want = curve(requested, maximum)
        if hardware != want:
            set_hardware(want, LED)
        actual = int((LED / 'brightness').read_text())
        if actual != want:
            raise RuntimeError('the hardware did not apply the requested keyboard backlight')
        atomic(STATE, f'req_pct={requested}\nhw={actual}\nlast_on={last_on}\n')
        return requested


def notify_hud(pct):
    if not os.environ.get('DISPLAY'):
        return
    hud = Path.home() / '.local/bin/hud-notify'
    if not os.access(hud, os.X_OK):
        hud = Path(__file__).resolve().parent / 'hud-notify'
    if os.access(hud, os.X_OK):
        subprocess.run([str(hud), 'keyboard', 'Keyboard', str(pct)],
                       check=False, timeout=2, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('mode', choices=('apply', 'step', 'toggle', 'status'), nargs='?', default='status')
    parser.add_argument('value', type=int, nargs='?')
    args = parser.parse_args()
    if args.mode == 'status':
        print(level(int((LED / 'brightness').read_text()),
                    int((LED / 'max_brightness').read_text()), read_state()))
        return 0
    if args.mode in ('apply', 'step') and args.value is None:
        parser.error(f'{args.mode} requires an integer percentage')
    pct = apply(percent=args.value if args.mode == 'apply' else None,
                step=args.value if args.mode == 'step' else None,
                toggle=args.mode == 'toggle')
    if args.mode in ('step', 'toggle'):
        notify_hud(pct)
    print(pct)
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except Exception as exc:
        detail = getattr(exc, 'stderr', None)
        if isinstance(detail, bytes):
            detail = detail.decode(errors='replace')
        print('Keyboard Backlight: ' + (detail.strip() if detail else str(exc)), file=sys.stderr)
        sys.exit(1)
