#!/usr/bin/env python3
"""Software Update — the glass popup behind the bar's update icon.

macOS's Software Update pane, at menu-bar size: what is waiting, what each one
is, one button per update and one button for all of them. Linux Mint's own
Update Manager is a window, and a window is the wrong shape for "install the
three security updates and get on with it" — it is still one click away in the
footer for everything a popup should not try to be (history, kernels,
sources, automation).

Drawn the way bin/wifi-menu and bin/battery-menu are — cairo on one
override-redirect window, one DrawingArea, a list of rows — for the reasons in
docs/control-center.md: genmon spawns a click command with no Gdk event behind
it, and xfwm4 discards a Gtk.Menu grab at time 0.

Two things it does that the Wi-Fi menu does not:

  * it does privileged work. Installing is aptkit — the same backend the
    Update Manager uses, the same `org.aptkit.install-or-remove-packages`
    polkit action, the same daemon doing the dpkg run. Nothing here is root
    and nothing here shells out to apt. Refreshing the package lists is
    aptkit's update-cache action, which is `allow_active=yes` and so costs no
    password at all.

  * it lets go of the seat while it works. The popup normally holds a pointer
    grab so a click outside dismisses it; the polkit agent needs the keyboard
    to ask for a password, and a grabbed seat would have left that dialog
    unable to take a single keystroke. The grab is dropped when a transaction
    starts and taken again when it ends. A click on the bar can hide the window
    while it works; reopening shows the same process and live progress.

Both apt and Flatpak transactions are covered; see docs/updates.md.
"""
import json
import math
import os
import signal
import subprocess
import sys
import threading
import time

T0 = time.monotonic()

HOME = os.path.expanduser('~')
APPLIED = f'{HOME}/.config/mintbook/appearance.applied'
CONF = f'{HOME}/.config/mintbook/updates.conf'
CACHE = f'{HOME}/.cache/mintbook'
LIST = f'{CACHE}/updates.json'
PIDFILE = f'{CACHE}/updates-menu.pid'
CHECK = f'{HOME}/.local/bin/updates-check'
MANAGER = 'mintupdate'

if not os.path.exists(CHECK):
    CHECK = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                         'updates-check')


def read_file(path, default=''):
    try:
        with open(path) as f:
            return f.read().strip() or default
    except OSError:
        return default


TOGGLE_PENDING = False


def remember_toggle(*_args):
    """Catch a very early second click while the primary is importing GTK."""
    global TOGGLE_PENDING
    TOGGLE_PENDING = True


signal.signal(signal.SIGUSR1, remember_toggle)


def claim_instance():
    """Claim the pidfile, or ask the existing popup to toggle visibility.

    This happens before the automatic update check and the GTK import. A click
    that merely reopens a hidden, working popup must not start a second cache
    check alongside the package transaction.
    """
    os.makedirs(os.path.dirname(PIDFILE), exist_ok=True)
    try:
        pid = int(read_file(PIDFILE, '0'))
    except ValueError:
        pid = 0
    if pid and pid != os.getpid():
        try:
            with open(f'/proc/{pid}/cmdline', 'rb') as f:
                ours = b'updates-menu' in f.read()
        except OSError:
            ours = False
        if ours:
            try:
                os.kill(pid, signal.SIGUSR1)
                return False
            except OSError:
                pass
    with open(PIDFILE, 'w') as f:
        f.write(str(os.getpid()))
    return True


if not claim_instance():
    sys.exit(0)


def read_cache():
    """The list bin/updates-check left behind. Missing or unreadable is not an
    error here — it is "we have not looked yet", and the popup says so.

    The flatpak half comes back separately because it can be older than the
    rest: it needs the network, so it is skipped offline and carries the
    previous answer forward. A list that is half fresh should not be presented
    as a fresh list.
    """
    try:
        with open(LIST) as f:
            data = json.load(f)
        return (data.get('updates', []), int(data.get('checked', 0)),
                data.get('error', ''), int(data.get('flatpak_checked', 0) or 0),
                data.get('flatpak_error', ''))
    except (OSError, ValueError, TypeError):
        return [], 0, '', 0, ''


def conf():
    values = {}
    for line in read_file(CONF).splitlines():
        line = line.split('#', 1)[0].strip()
        if '=' in line:
            key, _, value = line.partition('=')
            values[key.strip()] = value.strip()
    return values


# Before importing Gtk, as in bin/wifi-menu: the re-check is 2.5 s in a
# subprocess and the GTK import is ~220 ms, so starting it on the first line of
# the file puts the import inside it for free. The cached list is on screen
# long before this lands.
def spawn_check():
    try:
        return subprocess.Popen([CHECK], stdout=subprocess.DEVNULL,
                                stderr=subprocess.DEVNULL)
    except OSError:
        return None


CHECK_P = spawn_check()

# Where the pointer is now, which is where the icon was clicked: this popup
# hangs off that icon, and clicking it is the only way to get here.
#
# Unless MINTBOOK_ANCHOR says otherwise. The Control Center chevron opens this
# popup in place of itself, and by then the pointer is somewhere down that
# panel's own tile list rather than up on the bar — so it hands over the
# anchor it was opened with, and this popup lands exactly where the panel it
# replaced was standing. It also skips the xdotool call below.
#
# Read synchronously, and deliberately *not* hidden behind the GTK import the
# way the readings above are. Hiding it is what broke it. Spawned as a Popen
# the child is descheduled behind this process's own ~500 ms of CPU-bound
# import — on two cores there is nowhere else for it to run — so xdotool
# sampled the pointer after the import rather than before it, and returned the
# same late position the Gdk read did: click the icon, move the mouse away, and
# the popup opened where the mouse had got to. Costs ~12 ms, paid in full.
PTR_XY = None
try:
    _ax, _ay = os.environ['MINTBOOK_ANCHOR'].split(',')
    PTR_XY = (int(_ax), int(_ay))
except (KeyError, ValueError):
    try:
        _ptr = subprocess.run(['xdotool', 'getmouselocation', '--shell'],
                              capture_output=True, text=True, timeout=3).stdout
        _ptr = dict(p.split('=', 1) for p in _ptr.split() if '=' in p)
        PTR_XY = (int(_ptr['X']), int(_ptr['Y']))
    except Exception:
        pass

