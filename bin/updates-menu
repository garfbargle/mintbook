# ------------------------------------------------------------------- reading

def human(n):
    """Download sizes. kB below a megabyte, one decimal above it — the same
    shape bin/panel-updates prints into the tooltip."""
    n = float(n or 0)
    if n < 1024:
        return f'{n:.0f} B'
    if n < 1024 * 1024:
        return f'{n / 1024:.0f} kB'
    if n < 1024 * 1024 * 1024:
        return f'{n / 1048576:.1f} MB'
    return f'{n / 1073741824:.2f} GB'


def ago(then):
    if not then:
        return 'never checked'
    seconds = max(0, int(time.time()) - int(then))
    if seconds < 90:
        return 'checked just now'
    if seconds < 5400:
        return f'checked {seconds // 60} minutes ago'
    if seconds < 172800:
        return f'checked {seconds // 3600} hours ago'
    return f'checked {seconds // 86400} days ago'


def resolve(names):
    """What installing these packages actually entails, worked out by apt's own
    resolver — the one the Update Manager trusts too.

    Runs in a thread: apt.Cache() is a second or so, and this is a plain read
    of files the user can already read. Nothing here is privileged and nothing
    here writes. Returns the full set of packages to hand aptkit, the ones that
    are new rather than upgrades, the ones apt wants to take away, and an error
    string if the cache would not open.
    """
    try:
        import apt
        cache = apt.Cache()
    except Exception as exc:
        return [], [], [], f'{type(exc).__name__}: {exc}'

    asked = set(names)
    missing = []
    for name in names:
        try:
            cache[name].mark_install()
        except Exception:
            missing.append(name)

    full, extra, removals = [], [], []
    try:
        changes = cache.get_changes()
    except Exception as exc:
        return [], [], [], f'{type(exc).__name__}: {exc}'
    for pkg in changes:
        if pkg.marked_delete:
            removals.append(pkg.name)
            continue
        if pkg.marked_install or pkg.marked_upgrade or pkg.marked_downgrade:
            full.append(pkg.name)
            # "Extra" means a package that is not on this machine yet. A
            # dependency that is merely being upgraded alongside is not news.
            if pkg.name not in asked and not pkg.is_installed:
                extra.append(pkg.name)
    if missing and not full:
        return [], [], [], 'not in the APT cache: ' + ', '.join(missing[:4])
    return full, extra, removals, ''


def humanise(error):
    """An aptkit failure, as a line and whether it is one. A dismissed
    password prompt comes back as a raw D-Bus name — `NotAuthorized` — and
    putting that on screen under a red dot calls the user's own "no" a fault.
    """
    err = str(error or '')
    if 'NotAuthorized' in err or 'not-authorized' in err:
        return 'Not authorised', False
    if 'Cancel' in err or 'cancel' in err:
        return 'Cancelled', False
    if 'Operation was cancelled' in err or 'G_IO_ERROR_CANCELLED' in err:
        return 'Cancelled', False
    if 'dpkg' in err and 'lock' in err.lower():
        return 'Something else is using apt right now', True
    err = err.split('\n')[0].strip()
    return (err[:90] or 'The install failed'), True


def version_line(row):
    """`old → new` for apt. A flatpak has no knowable new version — see
    bin/updates-check — so its row shows what is installed and where it comes
    from, rather than an arrow pointing at a blank."""
    old, new = row.get('old', ''), row.get('new', '')
    if old and new:
        return f'{old} → {new}'
    if row.get('type') == 'flatpak':
        return ' · '.join(b for b in (old, row.get('origin', '')) if b)
    return new or old or ''


# ------------------------------------------------------------------- drawing

def rgba(cr, c, alpha=None):
    a = c[3] if len(c) > 3 else 1.0
    cr.set_source_rgba(c[0] / 255, c[1] / 255, c[2] / 255,
                       a if alpha is None else a * alpha)


def rrect(cr, x, y, w, h, r):
    r = max(0, min(r, w / 2, h / 2))
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


def text(cr, s, x, y, size, color, alpha=1.0, weight='normal',
         align=None, width=0, tnum=False):
    layout = PangoCairo.create_layout(cr)
    font = Pango.FontDescription('Inter Semi-Bold' if weight == 'bold' else 'Inter')
    font.set_absolute_size(size * Pango.SCALE)   # SC already carries the DPI
    layout.set_font_description(font)
    if tnum:
        attrs = Pango.AttrList()
        attrs.insert(Pango.attr_font_features_new('tnum=1'))
        layout.set_attributes(attrs)
    layout.set_text(str(s), -1)
    layout.set_ellipsize(Pango.EllipsizeMode.END)
    if width:
        layout.set_width(int(width * Pango.SCALE))
        layout.set_alignment({'center': Pango.Alignment.CENTER,
                              'right': Pango.Alignment.RIGHT}.get(
                                  align, Pango.Alignment.LEFT))
    rgba(cr, color, alpha)
    cr.move_to(x, y)
    PangoCairo.show_layout(cr, layout)
    return layout.get_pixel_size()


def measure(cr, s, size, weight='normal'):
    layout = PangoCairo.create_layout(cr)
    font = Pango.FontDescription('Inter Semi-Bold' if weight == 'bold' else 'Inter')
    font.set_absolute_size(size * Pango.SCALE)
    layout.set_font_description(font)
    layout.set_text(str(s), -1)
    return layout.get_pixel_size()[0]


def update_glyph(cr, x, y, s, color, alpha=1.0):
    """An arrow coming down into an open tray. The fractions are shared with
    icons/generate-updates-genmon.py, which draws the bar's icon from them —
    keep the two in step."""
    cr.save()
    cr.translate(x, y)
    rgba(cr, color, alpha)
    cr.set_line_width(.092 * s)
    cr.set_line_cap(cairo.LINE_CAP_ROUND)
    cr.set_line_join(cairo.LINE_JOIN_ROUND)
    cr.move_to(.50 * s, .08 * s)
    cr.line_to(.50 * s, .56 * s)
    cr.stroke()
    cr.move_to(.27 * s, .33 * s)
    cr.line_to(.50 * s, .56 * s)
    cr.line_to(.73 * s, .33 * s)
    cr.stroke()
    cr.move_to(.16 * s, .64 * s)
    cr.line_to(.16 * s, .88 * s)
    cr.line_to(.84 * s, .88 * s)
    cr.line_to(.84 * s, .64 * s)
    cr.stroke()
    cr.restore()


def shield_glyph(cr, x, y, s, color, alpha=1.0):
    cr.save()
    cr.translate(x, y)
    rgba(cr, color, alpha)
    cr.set_line_width(.10 * s)
    cr.set_line_join(cairo.LINE_JOIN_ROUND)
    cr.move_to(.50 * s, .08 * s)
    cr.line_to(.87 * s, .24 * s)
    cr.line_to(.87 * s, .52 * s)
    cr.curve_to(.87 * s, .74 * s, .71 * s, .88 * s, .50 * s, .94 * s)
    cr.curve_to(.29 * s, .88 * s, .13 * s, .74 * s, .13 * s, .52 * s)
    cr.line_to(.13 * s, .24 * s)
    cr.close_path()
    cr.stroke()
    cr.restore()


def chip_glyph(cr, x, y, s, color, alpha=1.0):
    """The Control Center's `cpu` glyph — a kernel update is the one that
    changes the thing that talks to the hardware."""
    cr.save()
    cr.translate(x, y)
    rgba(cr, color, alpha)
    cr.set_line_width(.075 * s)
    cr.set_line_cap(cairo.LINE_CAP_ROUND)
    rrect(cr, .22 * s, .22 * s, .56 * s, .56 * s, .08 * s)
    cr.stroke()
    rrect(cr, .40 * s, .40 * s, .20 * s, .20 * s, .04 * s)
    cr.fill()
    for f in (.34, .5, .66):
        cr.move_to(f * s, .22 * s); cr.line_to(f * s, .06 * s)
        cr.move_to(f * s, .78 * s); cr.line_to(f * s, .94 * s)
        cr.move_to(.22 * s, f * s); cr.line_to(.06 * s, f * s)
        cr.move_to(.78 * s, f * s); cr.line_to(.94 * s, f * s)
    cr.stroke()
    cr.restore()


def box_glyph(cr, x, y, s, color, alpha=1.0):
    """A parcel: a box, a lid seam, and the tape running over it. Narrower
    than a square, or at this size it reads as a window rather than a box."""
    cr.save()
    cr.translate(x, y)
    rgba(cr, color, alpha)
    cr.set_line_width(.085 * s)
    cr.set_line_join(cairo.LINE_JOIN_ROUND)
    rrect(cr, .17 * s, .17 * s, .66 * s, .70 * s, .09 * s)
    cr.stroke()
    cr.set_line_cap(cairo.LINE_CAP_BUTT)
    cr.move_to(.17 * s, .42 * s); cr.line_to(.83 * s, .42 * s)
    cr.move_to(.50 * s, .17 * s); cr.line_to(.50 * s, .42 * s)
    cr.stroke()
    cr.restore()


def sandbox_glyph(cr, x, y, s, color, alpha=1.0):
    """An app inside a box it cannot get out of — which is the whole of what a
    flatpak is, and the one thing that has to distinguish it from the parcel
    sitting next to it in the same list. Flatpak's own mark is a cube of
    rhombi and does not survive being drawn at 22 px."""
    cr.save()
    cr.translate(x, y)
    rgba(cr, color, alpha)
    cr.set_line_width(.085 * s)
    rrect(cr, .12 * s, .12 * s, .76 * s, .76 * s, .18 * s)
    cr.stroke()
    rrect(cr, .34 * s, .34 * s, .32 * s, .32 * s, .08 * s)
    cr.fill()
    cr.restore()


TYPE_GLYPH = {'security': shield_glyph, 'kernel': chip_glyph,
              'flatpak': sandbox_glyph}


def refresh_glyph(cr, cx, cy, r, color, alpha=1.0):
    """A circular arrow with a gap at the top and a solid head on the end of
    the sweep, pointing into the gap. The head is drawn in the arc's own
    tangent frame — placed by hand it reads as a blob stuck to a circle."""
    cr.save()
    rgba(cr, color, alpha)
    cr.set_line_width(r * .30)
    cr.set_line_cap(cairo.LINE_CAP_BUTT)
    a0, a1 = -math.pi * .25, math.pi * 1.30
    cr.new_sub_path()
    cr.arc(cx, cy, r, a0, a1)
    cr.stroke()
    head = r * .52
    cr.save()
    cr.translate(cx + r * math.cos(a1), cy + r * math.sin(a1))
    cr.rotate(a1 + math.pi / 2)          # +x is now the direction of travel
    cr.move_to(-head * .45, -head)
    cr.line_to(head * 1.15, 0)
    cr.line_to(-head * .45, head)
    cr.close_path()
    cr.fill()
    cr.restore()
    cr.restore()


def tick(cr, x, y, s, color, alpha=1.0):
    cr.save()
    cr.translate(x, y)
    rgba(cr, color, alpha)
    cr.set_line_width(.15 * s)
    cr.set_line_cap(cairo.LINE_CAP_ROUND)
    cr.set_line_join(cairo.LINE_JOIN_ROUND)
    cr.move_to(.14 * s, .52 * s)
    cr.line_to(.40 * s, .78 * s)
    cr.line_to(.86 * s, .22 * s)
    cr.stroke()
    cr.restore()


def chevron(cr, cx, cy, color, alpha):
    rgba(cr, color, alpha)
    cr.set_line_width(1.6)
    cr.set_line_cap(cairo.LINE_CAP_ROUND)
    cr.move_to(cx - 2, cy - 4)
    cr.line_to(cx + 2.5, cy)
    cr.line_to(cx - 2, cy + 4)
    cr.stroke()


def spinner(cr, cx, cy, r, color, phase):
    cr.save()
    cr.set_line_cap(cairo.LINE_CAP_ROUND)
    cr.set_line_width(r * .34)
    for i in range(8):
        a = i * math.pi / 4
        rgba(cr, color, .12 + .5 * (((i - phase) % 8) / 8.0))
        cr.move_to(cx + math.cos(a) * r * .5, cy + math.sin(a) * r * .5)
        cr.line_to(cx + math.cos(a) * r, cy + math.sin(a) * r)
        cr.stroke()
    cr.restore()


def pill(cr, x, y, w, h, label, colors, kind='plain', lit=False, alpha=1.0):
    """The one button shape in this popup. `filled` is the blue one you press
    to start something; `plain` is the outlined one beside it."""
    rrect(cr, x, y, w, h, h / 2)
    if kind == 'filled':
        rgba(cr, colors['blue'], alpha * (0.86 if lit else 1.0))
        cr.fill()
        text(cr, label, x, y + h / 2 - 8, 10, (255, 255, 255), alpha * .98,
             'bold', align='center', width=w)
    else:
        rgba(cr, colors['fg'], alpha * (.12 if lit else .06))
        cr.fill_preserve()
        rgba(cr, colors['tile_edge'], alpha)
        cr.set_line_width(1)
        cr.stroke()
        text(cr, label, x, y + h / 2 - 8, 10, colors['fg'], alpha * .9,
             'bold', align='center', width=w)


def bar(cr, x, y, w, h, fraction, colors, indeterminate=False, phase=0):
    rrect(cr, x, y, w, h, h / 2)
    rgba(cr, colors['track'])
    cr.fill()
    if indeterminate:
        # A 30% lozenge sliding back and forth. apt reports 101 for "no idea",
        # and a bar frozen at 0 while dpkg works looks like a hang.
        run = w * .30
        travel = (w - run) * (1 - abs(1 - (phase % 40) / 20.0))
        rrect(cr, x + travel, y, run, h, h / 2)
    else:
        span = max(h, w * max(0.0, min(1.0, fraction)))
        rrect(cr, x, y, span, h, h / 2)
    rgba(cr, colors['blue'])
    cr.fill()


# ---------------------------------------------------------------------- rows

import mintbook_keys

class Row:
    h = 0
    interactive = False

    def __init__(self, panel):
        self.panel = panel
        self.hit = None

    @property
    def c(self):
        return self.panel.colors

    def card(self, cr, w, h):
        rrect(cr, 0, 0, w, h, CARD)
        rgba(cr, self.c['tile'])
        cr.fill_preserve()
        rgba(cr, self.c['tile_edge'])
        cr.set_line_width(1)
        cr.stroke()

    def lit(self, cr, w, y, h):
        cr.save()
        rrect(cr, 0, 0, w, self.h, CARD)
        cr.clip()
        cr.rectangle(0, y, w, h)
        rgba(cr, self.c['fg'], .06)
        cr.fill()
        cr.restore()

    def draw(self, cr, w):
        pass

    def test(self, x, y):
        return None

    def release(self, x, y):
        pass


class HeaderRow(Row):
    """What is waiting, and the button that goes and asks again."""
    h = 58
    interactive = True
    BTN = 30

    def draw(self, cr, w):
        p = self.panel
        self.card(cr, w, self.h)
        update_glyph(cr, 15, 14, 30, self.c['fg'], .9)
        text(cr, 'Software Update', 54, 13, 12, self.c['fg'], .95, 'bold')
        text(cr, p.headline, 54, 31, 9.5, self.c['fg'], .55, width=w - 54 - 46)

        bx, by = w - 15 - self.BTN, (self.h - self.BTN) / 2
        if p.checking:
            spinner(cr, bx + self.BTN / 2, by + self.BTN / 2, 8,
                    self.c['fg'], p.phase)
        else:
            if self.hit == 'check':
                rrect(cr, bx, by, self.BTN, self.BTN, self.BTN / 2)
                rgba(cr, self.c['fg'], .10)
                cr.fill()
            refresh_glyph(cr, bx + self.BTN / 2, by + self.BTN / 2, 8,
                          self.c['fg'], .75 if self.hit == 'check' else .55)

    def test(self, x, y):
        if self.panel.checking or self.panel.busy:
            return None
        return 'check' if x > WIDTH - 15 - self.BTN - 6 else None

    def release(self, x, y):
        if self.test(x, y):
            self.panel.recheck()


class ActionRow(Row):
    """The total, and the one button most people want."""
    h = 52
    interactive = True
    BW, BH = 104, 30

    def draw(self, cr, w):
        p = self.panel
        self.card(cr, w, self.h)
        count = len(p.updates)
        text(cr, f'{count} update' + ('' if count == 1 else 's'),
             15, 11, 11, self.c['fg'], .92, 'bold')
        text(cr, human(sum(u['size'] for u in p.updates)) + ' to download',
             15, 28, 9.5, self.c['fg'], .5)
        pill(cr, w - 15 - self.BW, (self.h - self.BH) / 2, self.BW, self.BH,
             'Update All', self.c, 'filled', lit=self.hit == 'all')

    def test(self, x, y):
        return 'all' if x > WIDTH - 15 - self.BW else None

    def release(self, x, y):
        if self.test(x, y):
            self.panel.install(list(self.panel.updates))


class ListRow(Row):
    """The updates themselves. Security first, then kernel, then by name —
    bin/updates-check sorts them, so the order the popup shows is the order
    the cache on disk is in and the two cannot drift."""
    LEAD, LINE, MAX = 26, 48, 6
    BW, BH = 68, 26
    interactive = True

    def __init__(self, panel):
        super().__init__(panel)
        self.top = 0
        self.n = min(len(panel.updates), self.MAX)
        self.h = self.LEAD + self.LINE * max(1, self.n) + 8

    @property
    def visible(self):
        return self.panel.updates[self.top:self.top + self.MAX]

    def button_x(self, w):
        return w - 15 - self.BW

    def draw(self, cr, w):
        p = self.panel
        self.card(cr, w, self.h)
        text(cr, 'Available', 15, 8, 9.5, self.c['fg'], .5)
        if len(p.updates) > self.MAX:
            text(cr, f'{self.top + 1}–{self.top + self.n} of {len(p.updates)}',
                 0, 8, 9.5, self.c['fg'], .35, align='right', width=w - 15)

        for i, row in enumerate(self.visible):
            y = self.LEAD + i * self.LINE
            working = row['name'] in p.working
            dim = 1.0 if (not p.busy or working) else .45
            if self.hit == i and not p.busy:
                self.lit(cr, w, y, self.LINE)
            glyph = TYPE_GLYPH.get(row['type'], box_glyph)
            glyph(cr, 16, y + 12, 22, self.c['fg'], .75 * dim)

            right = self.button_x(w) - 10
            text(cr, row['name'], 48, y + 6, 11, self.c['fg'], .95 * dim,
                 'bold', width=right - 48)
            # The size is the short half and it is the half you compare
            # between rows, so it gets the right edge and the version string
            # ellipsises into whatever is left of the line.
            size = human(row['size'])
            text(cr, size, 48, y + 24, 9, self.c['fg'], .48 * dim,
                 align='right', width=right - 48)
            text(cr, version_line(row), 48, y + 24, 9, self.c['fg'], .48 * dim,
                 width=right - 48 - measure(cr, size, 9) - 10)

            if working:
                spinner(cr, self.button_x(w) + self.BW / 2, y + self.LINE / 2 - 2,
                        8, self.c['fg'], p.phase)
            elif row['name'] in p.installed:
                tick(cr, self.button_x(w) + self.BW / 2 - 8,
                     y + self.LINE / 2 - 10, 16, self.c['green'], .95)
            elif not p.busy:
                pill(cr, self.button_x(w), y + (self.LINE - self.BH) / 2 - 2,
                     self.BW, self.BH, 'Update', self.c, lit=self.hit == i)

    def test(self, x, y):
        if self.panel.busy or y < self.LEAD:
            return None
        i = int((y - self.LEAD) // self.LINE)
        if not (0 <= i < len(self.visible)):
            return None
        # The button, not the row. A whole row that installs software is a row
        # you can hit by accident on the way to the scroll wheel.
        return i if x >= self.button_x(WIDTH) else None

    def release(self, x, y):
        i = self.test(x, y)
        if i is None:
            return
        row = self.visible[i]
        if row['name'] not in self.panel.installed:
            self.panel.install([row])

    def scroll(self, direction):
        extra = len(self.panel.updates) - self.MAX
        if extra <= 0:
            return False
        top = min(extra, max(0, self.top + (1 if direction > 0 else -1)))
        if top == self.top:
            return False
        self.top = top
        return True


class WorkRow(Row):
    """What aptkit is doing, while it does it."""
    h = 66
    interactive = True
    BW, BH = 76, 26

    def draw(self, cr, w):
        p = self.panel
        self.card(cr, w, self.h)
        text(cr, p.status or 'Working…', 15, 11, 10.5, self.c['fg'], .9,
             width=w - 30 - self.BW)
        if p.detail:
            text(cr, p.detail, 15, 27, 9, self.c['fg'], .5,
                 width=w - 30 - self.BW)
        unknown = p.progress is None or p.progress > 100
        bar(cr, 15, self.h - 22, w - 30, 8, (p.progress or 0) / 100.0,
            self.c, indeterminate=unknown, phase=p.phase)
        if p.cancellable:
            pill(cr, w - 15 - self.BW, 12, self.BW, self.BH, 'Cancel',
                 self.c, lit=self.hit == 'cancel')

    def test(self, x, y):
        if not self.panel.cancellable:
            return None
        return 'cancel' if x > WIDTH - 15 - self.BW and y < 44 else None

    def release(self, x, y):
        if self.test(x, y):
            self.panel.cancel()


class ConfirmRow(Row):
    """apt wants to touch packages you did not ask about. A dependency being
    pulled in is normal; something being removed is not, and both are shown
    rather than either being assumed."""
    interactive = True
    BW, BH = 84, 28

    def __init__(self, panel):
        super().__init__(panel)
        self.groups = [g for g in panel.pending_extra if g[1]]
        self.h = 30 + 30 * len(self.groups) + 14 + self.BH

    def draw(self, cr, w):
        self.card(cr, w, self.h)
        text(cr, 'This changes more than you picked', 15, 11, 11,
             self.c['fg'], .95, 'bold', width=w - 30)
        y = 32
        for label, names, colour in self.groups:
            shown = ', '.join(names[:5]) + (f' and {len(names) - 5} more'
                                            if len(names) > 5 else '')
            text(cr, label, 15, y, 9, colour, .85, 'bold')
            text(cr, shown, 15, y + 12, 9.5, self.c['fg'], .6, width=w - 30)
            y += 30
        for key, label, x0, bw, kind in self.buttons(w):
            pill(cr, x0, self.h - 14 - self.BH, bw, self.BH, label, self.c,
                 kind, lit=self.hit == key)

    def buttons(self, w):
        return [('cancel', 'Cancel', w - 15 - 2 * self.BW - 8, self.BW, 'plain'),
                ('go', 'Continue', w - 15 - self.BW, self.BW, 'filled')]

    def test(self, x, y):
        if y < self.h - 14 - self.BH - 6:
            return None
        for key, _l, x0, bw, _k in self.buttons(WIDTH):
            if x0 <= x <= x0 + bw:
                return key
        return None

    def release(self, x, y):
        key = self.test(x, y)
        if key == 'go':
            self.panel.confirm(True)
        elif key == 'cancel':
            self.panel.confirm(False)


class EmptyRow(Row):
    """One line. The header above already says when it was last checked, and
    saying it twice on a card whose whole content is "nothing to do" is the
    kind of filler a popup this small cannot afford."""
    h = 54

    def draw(self, cr, w):
        p = self.panel
        self.card(cr, w, self.h)
        if p.error:
            rrect(cr, 18, self.h / 2 - 4, 8, 8, 4)
            rgba(cr, self.c['red'])
            cr.fill()
            text(cr, 'Could not read the APT cache', 50, 10, 11,
                 self.c['fg'], .9, width=w - 66)
            text(cr, p.error, 50, 28, 9, self.c['red'], .9, width=w - 66)
            return
        if p.checking and not p.checked:
            spinner(cr, 26, self.h / 2, 8, self.c['fg'], p.phase)
            text(cr, 'Looking for updates…', 50, self.h / 2 - 9, 11,
                 self.c['fg'], .85)
            return
        tick(cr, 16, self.h / 2 - 11, 22, self.c['green'], .95)
        text(cr, 'Your system is up to date', 50, self.h / 2 - 9, 11,
             self.c['fg'], .9)


class NoticeRow(Row):
    """One line that is not a list and not a button: the result of the last
    thing you pressed, the restart a new kernel is waiting for, or a reason
    not to trust part of the list above it."""
    h = 42

    def __init__(self, panel, notice=None):
        super().__init__(panel)
        self.notice = notice

    def draw(self, cr, w):
        p = self.panel
        self.card(cr, w, self.h)
        colour, message = self.notice or p.notice
        rrect(cr, 15, self.h / 2 - 3.5, 7, 7, 3.5)
        rgba(cr, colour)
        cr.fill()
        text(cr, message, 30, self.h / 2 - 8, 10, self.c['fg'], .85,
             width=w - 46)


class FooterRow(Row):
    h = 44
    interactive = True

    def draw(self, cr, w):
        self.card(cr, w, self.h)
        active = not self.panel.busy
        if active and self.hit is not None:
            self.lit(cr, w, 0, self.h)
        text(cr, 'Update Manager…', 15, self.h / 2 - 8, 10.5,
             self.c['fg'], .92 if active else .4)
        chevron(cr, w - 19, self.h / 2, self.c['fg'],
                (.55 if self.hit else .3) if active else .16)

    def test(self, x, y):
        return None if self.panel.busy else 'manager'

    def release(self, x, y):
        if self.panel.busy:
            return
        subprocess.Popen([MANAGER], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.panel.close()


# --------------------------------------------------------------------- panel

class Menu:
    def __init__(self):
        self.mode = 'dark' if read_file(APPLIED, 'light') == 'dark' else 'light'
        self.colors = DARK if self.mode == 'dark' else LIGHT
        self.cfg = conf()
        self.closing = False
        self.hidden = False
        self.press_row = None
        self.phase = 0

        self.checking = CHECK_P is not None
        self.busy = False
        self.cancellable = False
        self.status = ''
        self.detail = ''
        self.progress = None
        self.working = set()       # update names in the running transaction
        self.installed = set()     # names this session has finished
        self.notice = None         # (colour, message)
        self.pending = None        # the resolved package list awaiting a yes
        self.pending_extra = []    # what a ConfirmRow would list
        self.trans = None
        self.trans_error = ''
        self.reboot = False
        self.queue = []            # the backends still to run for this job
        self.fp_cancel = None      # Gio.Cancellable, while flatpak is running
        self.grabbed = None
        self.gdk_win = None
        self.geo = None
        self.x = self.y = 0

        (self.updates, self.checked, self.error,
         self.fp_checked, self.fp_error) = read_cache()

        self.win = win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
        win.set_decorated(False)
        win.set_skip_taskbar_hint(True)
        win.set_skip_pager_hint(True)
        win.set_keep_above(True)
        win.set_resizable(False)
        win.set_app_paintable(True)
        win.set_type_hint(Gdk.WindowTypeHint.POPUP_MENU)
        visual = Gdk.Screen.get_default().get_rgba_visual()
        if visual:
            win.set_visual(visual)
        win.connect('draw', self.draw_background)
        win.connect('key-press-event', self.on_key)
        win.connect('destroy', lambda *_a: self.close())

        self.area = Gtk.DrawingArea()
        self.area.add_events(Gdk.EventMask.BUTTON_PRESS_MASK
                             | Gdk.EventMask.BUTTON_RELEASE_MASK
                             | Gdk.EventMask.POINTER_MOTION_MASK
                             | Gdk.EventMask.SCROLL_MASK
                             | Gdk.EventMask.LEAVE_NOTIFY_MASK)
        self.area.connect('draw', self.on_draw)
        self.area.connect('button-press-event', self.on_press)
        self.area.connect('button-release-event', self.on_release)
        self.area.connect('motion-notify-event', self.on_motion)
        self.area.connect('scroll-event', self.on_scroll)
        self.area.connect('leave-notify-event', self.on_leave)

        box = Gtk.Box()
        for setter in (box.set_margin_top, box.set_margin_bottom,
                       box.set_margin_start, box.set_margin_end):
            setter(round((SHADOW + PAD) * SC))
        box.pack_start(self.area, False, False, 0)
        win.add(box)

        self.rows = []
        self.rebuild()
        win.show_all()

    # ---- derived readings

    @property
    def headline(self):
        if self.busy:
            return self.status or 'Working…'
        if self.checking:
            return self.status or 'Checking for updates…'
        if self.error:
            return 'Could not check'
        if not self.updates:
            return ago(self.checked)   # the row below has no room for it
        # Not the count — the row below is nothing but the count. What belongs
        # here is the part of the answer that changes what you do about it.
        sec = sum(1 for u in self.updates if u['type'] == 'security')
        ker = sum(1 for u in self.updates if u['type'] == 'kernel')
        bits = []
        if sec:
            bits.append(f'{sec} security')
        if ker:
            bits.append(f'{ker} kernel')
        return ' · '.join(bits) if bits else ago(self.checked)

    # ---- layout

    def build_rows(self):
        rows = [HeaderRow(self)]
        if self.pending:
            rows.append(ConfirmRow(self))
        elif self.busy:
            rows.append(WorkRow(self))
        elif self.updates:
            rows.append(ActionRow(self))
        if self.updates:
            rows.append(ListRow(self))
        elif not self.pending and not self.busy:
            rows.append(EmptyRow(self))
        if self.notice:
            rows.append(NoticeRow(self))
        elif self.flatpak_gripe:
            rows.append(NoticeRow(self, self.flatpak_gripe))
        rows.append(FooterRow(self))
        return rows

    @property
    def flatpak_gripe(self):
        """Why the flatpak half of this list might not be true, or nothing.

        Only ever shown when it is actually load-bearing: an error we were
        told about, or an answer old enough that "no flatpak updates" has
        stopped being evidence of anything."""
        if self.busy or self.checking:
            return None
        if self.fp_error:
            return (self.colors['amber'],
                    'Flatpaks not checked: ' + self.fp_error[:56])
        if not self.fp_checked:
            return (self.colors['amber'], 'Flatpaks have not been checked yet')
        days = (int(time.time()) - self.fp_checked) // 86400
        if days >= 2:
            return (self.colors['amber'],
                    f'Flatpaks last checked {days} days ago')
        return None

    def rebuild(self):
        """The row set changes under the pointer — a check lands, an install
        starts, a confirmation is needed — so the window is re-sized rather
        than built once. It hangs off the top bar, so growing downward is free
        and the placement holds."""
        old = next((r for r in self.rows if isinstance(r, ListRow)), None)
        self.rows = self.build_rows()
        for row in self.rows:                 # carry the scroll position over
            if isinstance(row, ListRow) and old is not None:
                row.top = min(old.top, max(0, len(self.updates) - row.MAX))
        self.height = (sum(r.h for r in self.rows) + GAP * (len(self.rows) - 1)
                       + 2 * PAD)
        self.area.set_size_request(round(WIDTH * SC),
                                   round((self.height - 2 * PAD) * SC))
        self.reposition()
        self.area.queue_draw()

    # ---- drawing

    def on_draw(self, _w, cr):
        cr.set_antialias(cairo.ANTIALIAS_BEST)
        cr.scale(SC, SC)
        y = 0
        for row in self.rows:
            cr.save()
            cr.translate(0, y)
            cr.rectangle(0, 0, WIDTH, row.h)
            cr.clip()
            row.draw(cr, WIDTH)
            mintbook_keys.draw(self, row, cr, WIDTH)
            cr.restore()
            y += row.h + GAP
        return False

    def draw_background(self, _w, cr):
        a = self.win.get_allocation()
        cr.save()
        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.set_source_rgba(0, 0, 0, 0)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)
        cr.scale(SC, SC)
        x = y = SHADOW
        w, h = a.width / SC - 2 * SHADOW, a.height / SC - 2 * SHADOW
        for i in range(SHADOW, 0, -1):     # a soft edge, without a blur pass
            rrect(cr, x - i, y - i + 2, w + 2 * i, h + 2 * i, RADIUS + i)
            cr.set_line_width(1.4)
            cr.set_source_rgba(0, 0, 0, .055 * (1 - i / SHADOW) ** 2)
            cr.stroke()
        grad = cairo.LinearGradient(0, y, 0, y + h)
        top, bot = self.colors['top'], self.colors['bottom']
        grad.add_color_stop_rgba(0, top[0] / 255, top[1] / 255, top[2] / 255, top[3])
        grad.add_color_stop_rgba(1, bot[0] / 255, bot[1] / 255, bot[2] / 255, bot[3])
        rrect(cr, x, y, w, h, RADIUS)
        cr.set_source(grad)
        cr.fill_preserve()
        rgba(cr, self.colors['rim'])
        cr.set_line_width(1)
        cr.stroke()
        rrect(cr, x + .75, y + .75, w - 1.5, h - 1.5, RADIUS - .75)
        rgba(cr, self.colors['edge'])
        cr.set_line_width(1)
        cr.stroke()
        cr.restore()
        return False

    # ---- input

    def locate(self, ex, ey):
        x, y = ex / SC, ey / SC
        for row in self.rows:
            if y < row.h:
                return row, x, y
            y -= row.h + GAP
        return None, x, y

    def on_motion(self, _w, e):
        self.keyboard_target = None
        for row in self.rows:
            row.hit = None
        row, x, y = self.locate(e.x, e.y)
        if row is not None and row.interactive:
            row.hit = row.test(x, y)
        self.area.queue_draw()
        return True

    def on_leave(self, *_a):
        for row in self.rows:
            row.hit = None
        self.area.queue_draw()
        return True

    def on_scroll(self, _w, e):
        row = self.locate(e.x, e.y)[0]
        if not isinstance(row, ListRow):
            return False
        if e.direction == Gdk.ScrollDirection.SMOOTH:
            dy = e.get_scroll_deltas()[2]
        else:
            dy = 1 if e.direction == Gdk.ScrollDirection.DOWN else -1
        if dy and row.scroll(dy):
            self.area.queue_draw()
        return True

    def on_press(self, _w, e):
        # Left button only. Every action here installs software or spends the
        # network, and a middle-click or a stray button 4/5 from a synthetic
        # event should not be able to reach one.
        if e.button != 1:
            return False
        self.press_row = self.locate(e.x, e.y)[0]
        return True

    def on_release(self, _w, e):
        if e.button != 1:
            return False
        row, x, y = self.locate(e.x, e.y)
        if row is not None and row is self.press_row and row.interactive:
            row.release(x, y)
        self.press_row = None
        return True

    def on_key(self, _w, e):
        if e.keyval == Gdk.KEY_Escape and not self.busy:
            self.close()
            return True
        if mintbook_keys.key(self, e, WIDTH):
            return True
        return False

    # ---- checking

    def recheck(self):
        """The button in the header. Refreshing the package lists is aptkit's
        update-cache action, which is `allow_active=yes` — no password, which
        is why this is a button and not a trip to the Update Manager. If
        aptkit is not there, fall back to re-reading the lists we have."""
        if self.checking or self.busy:
            return
        self.checking = True
        self.notice = None
        self.trans_error = ''
        self.status = 'Refreshing package lists…'
        self.rebuild()
        self.tick_spinner()

        def done(*_a):
            self.run_check()
            return False

        try:
            import aptkit.client
            client = aptkit.client.AptClient()
            client.update_cache(
                reply_handler=lambda trans: self.run_cache_update(trans),
                error_handler=lambda _e: done())
        except Exception:
            done()

    def run_cache_update(self, trans):
        self.trans = trans
        trans.connect('status-changed', self.on_status)
        trans.connect('finished', self.cache_updated)
        trans.connect('error', self.on_trans_error)
        # Both handlers or neither: aptkit raises MissingReplyHandlerException
        # if you give it only an error_handler, and the exception comes out of
        # run() rather than reaching the handler you did give it.
        trans.run(reply_handler=lambda: None,
                  error_handler=lambda _e: self.run_check())

    def cache_updated(self, _t, exit_state):
        """A refresh can fail on one broken source and still be useful for
        every other one — apt goes on with the lists it did get. Say so rather
        than swallow it: a repository that has been failing for a month is
        exactly the thing an indicator is supposed to surface."""
        if exit_state != 'exit-success' and self.trans_error:
            first = self.trans_error.replace('W:', '').replace('E:', '').strip()
            self.notice = (self.colors['amber'],
                           'Some sources did not refresh: ' + first[:64])
        self.run_check()

    def run_check(self):
        """bin/updates-check, in a thread. It is the only thing that decides
        what an update is; the popup never forms its own opinion."""
        self.checking = True
        self.status = ''          # aptkit's last word was about the refresh
        self.rebuild()
        self.tick_spinner()

        def work():
            try:
                subprocess.run([CHECK], capture_output=True, timeout=180)
            except Exception:
                pass
            GLib.idle_add(self.landed)
        threading.Thread(target=work, daemon=True).start()
        return False

    def landed(self):
        self.checking = False
        (self.updates, self.checked, self.error,
         self.fp_checked, self.fp_error) = read_cache()
        # Anything this session installed is gone from the fresh list, so the
        # ticks have nothing left to sit on. Drop them rather than keep a row
        # that no longer exists.
        self.installed &= {u['name'] for u in self.updates}
        self.nudge_panel()
        self.rebuild()
        return False

    def collect_check(self):
        """The check started before `import gi`. Reap it once the window is
        up, and take what it wrote."""
        if CHECK_P is None:
            self.checking = False
            self.rebuild()
            return False

        def work():
            try:
                CHECK_P.wait(timeout=180)
            except Exception:
                pass
            GLib.idle_add(self.landed)
        threading.Thread(target=work, daemon=True).start()
        return False

    # ---- installing

    def install(self, rows):
        """One update, or all of them, apt and flatpak together.

        The two backends have nothing in common and are run one after the
        other rather than interleaved — apt first, because a kernel or a
        library is the half that other things depend on, and because a failure
        there is a reason not to start the second half at all. `self.queue` is
        that running order; `next_phase()` walks it.
        """
        if self.busy or not rows:
            return
        apt_rows = [r for r in rows if r['type'] != 'flatpak']
        fp_rows = [r for r in rows if r['type'] == 'flatpak']

        self.queue = []
        if apt_rows:
            self.queue.append(('apt', apt_rows))
        if fp_rows:
            self.queue.append(('flatpak', fp_rows))
        if not self.queue:
            return

        self.busy = True
        self.cancellable = False
        # Everything selected spins, not just the phase in flight. They are all
        # queued, and a row that sits inert for two minutes while apt works
        # looks like a row that was ignored.
        self.working = {r['name'] for r in rows}
        self.reboot = any(r['type'] == 'kernel' for r in rows)
        self.status = 'Preparing…'
        self.detail = ''
        self.progress = None
        self.notice = None
        self.rebuild()
        self.tick_spinner()
        self.next_phase()

    def next_phase(self):
        """The next backend in the queue, or the end of the job."""
        if not self.queue:
            done = len(self.working)
            message = ('Installed 1 update' if done == 1
                       else f'Installed {done} updates')
            colour = self.colors['green']
            if self.reboot:
                message += ' · restart to finish the kernel'
                colour = self.colors['amber']
            self.installed |= self.working
            self.finish(message, colour)
            self.run_check()
            return False
        kind, rows = self.queue.pop(0)
        (self.start_apt if kind == 'apt' else self.start_flatpak)(rows)
        return False

    def start_apt(self, rows):
        """apt, in two steps, and the split matters. First python-apt works out
        what the request actually entails — a read of the cache this user can
        already read, needing no password, and the only way to show the
        removals *before* a polkit prompt rather than after. Then aptkit does
        the privileged half: it owns the polkit action, the dpkg run and the
        progress, and it keeps going in its own daemon even if this popup
        dies."""
        names = []
        for row in rows:
            for name in row['packages']:
                if name not in names:
                    names.append(name)
        if not names:
            self.next_phase()
            return
        self.status = 'Working out what that needs…'
        self.progress = None
        self.rebuild()

        def work():
            GLib.idle_add(self.resolved, *resolve(names))
        threading.Thread(target=work, daemon=True).start()

    def resolved(self, full, extra, removals, error):
        if error:
            self.finish(error[:90], self.colors['red'])
            return False
        if not full:
            self.finish('Nothing left to install', self.colors['fg'])
            return False
        groups = []
        if extra:
            groups.append(('Also installs', sorted(extra), self.colors['fg']))
        if removals:
            groups.append(('Removes', sorted(removals), self.colors['red']))
        if groups:
            self.pending = full
            self.pending_extra = groups
            self.status = 'Waiting for you'
            self.rebuild()
            return False
        self.launch(full)
        return False

    def confirm(self, go):
        full, self.pending, self.pending_extra = self.pending, None, []
        if not full:
            return
        if go:
            self.launch(full)
        else:
            self.finish('Cancelled', self.colors['fg'])

    def launch(self, packages):
        self.status = 'Starting…'
        # The polkit agent is about to ask for a password, and it cannot take
        # a keystroke while this popup holds the seat.
        self.grab(False)
        self.rebuild()
        try:
            import aptkit.client
            client = aptkit.client.AptClient()
            client.install_packages(packages, reply_handler=self.on_transaction,
                                    error_handler=self.on_apt_error)
        except Exception as exc:
            self.on_apt_error(exc)

    def on_transaction(self, trans):
        self.trans = trans
        self.trans_error = ''
        try:
            trans.set_debconf_frontend('gnome')
        except Exception:
            pass
        trans.connect('progress-changed', self.on_progress)
        trans.connect('status-changed', self.on_status)
        trans.connect('status-details-changed', self.on_detail)
        trans.connect('cancellable-changed', self.on_cancellable)
        trans.connect('finished', self.on_finished)
        trans.connect('error', self.on_trans_error)
        # No simulate(): python-apt already resolved this against the same
        # cache, and a second resolution only buys a second answer to compare
        # against. aptkit resolves again on its own side before it commits.
        #
        # Both handlers or neither — aptkit raises MissingReplyHandlerException
        # when it is given only an error_handler, and that exception comes out
        # of run() instead of reaching the handler.
        trans.run(reply_handler=lambda: None, error_handler=self.on_apt_error)

    # ---- flatpak

    def start_flatpak(self, rows):
        """Flatpak's own Transaction, in a thread.

        Nothing here is aptkit and nothing here is apt. A user-scope update
        needs no password at all — the files belong to this user — so the
        common case on this machine is a progress bar and no prompt. A
        system-scope one goes through flatpak's own polkit action, which is
        why the seat is dropped for this phase too even though most of the
        time nothing asks for it.

        Transaction.run() blocks until the whole thing is done, so it runs off
        the main loop and every signal it raises is marshalled back with
        GLib.idle_add. A Gio.Cancellable is what the Cancel button holds.
        """
        self.status = 'Preparing…'
        self.detail = ''
        self.progress = None
        self.grab(False)
        self.rebuild()

        try:
            import gi
            gi.require_version('Flatpak', '1.0')
            from gi.repository import Flatpak, Gio
        except Exception as exc:
            self.queue = []
            self.finish(f'No flatpak support: {exc}'[:90], self.colors['red'])
            return

        # One transaction per installation. A user ref and a system ref cannot
        # share one, and mixing them would also mix one prompt with none.
        groups = {}
        # Flatpak talks in refs and the list talks in names. Keep the mapping,
        # or the status line reads "Updating com.github.tchx84.Flatseal…" over
        # a row that says Flatseal.
        titles = {}
        for row in rows:
            info = row.get('flatpak') or {}
            ref = info.get('ref', '')
            groups.setdefault(info.get('scope', 'user'), []).append(ref)
            titles[ref] = row['name']

        self.fp_cancel = Gio.Cancellable()
        cancel = self.fp_cancel

        def work():
            # No `failures = []` here: on_operation_error appends to the list
            # below from a signal, and a local one would shadow it so every
            # per-operation failure vanished and the job reported success.
            for scope, refs in groups.items():
                if cancel.is_cancelled():
                    break
                try:
                    inst = (Flatpak.Installation.new_user() if scope == 'user'
                            else Flatpak.Installation.new_system())
                    trans = Flatpak.Transaction.new_for_installation(inst, cancel)
                except Exception as exc:
                    failures.append(f'{scope}: {exc}')
                    continue
                trans.connect('new-operation', on_operation)
                trans.connect('operation-error', on_operation_error)
                added = 0
                for ref in refs:
                    if not ref:
                        continue
                    try:
                        trans.add_update(ref, None, None)
                        added += 1
                    except Exception as exc:
                        failures.append(f'{ref}: {exc}')
                if not added:
                    continue
                try:
                    trans.run(cancel)
                except Exception as exc:
                    # A cancel comes back as an exception too. It is an answer,
                    # not a fault, and humanise() is what knows the difference.
                    failures.append(str(exc))
            GLib.idle_add(self.flatpaks_done, failures,
                          bool(cancel.is_cancelled()))

        def on_operation(_trans, operation, progress):
            ref = operation.get_ref() or ''
            name = titles.get(ref)
            if not name:            # a dependency we did not ask for by name
                name = ref.split('/')[1] if '/' in ref else ref
            GLib.idle_add(self.fp_status, name)
            progress.connect('changed', on_progress, progress)

        def on_progress(_p, progress):
            GLib.idle_add(self.fp_progress, progress.get_progress(),
                          progress.get_status() or '')

        def on_operation_error(_trans, operation, error, _details):
            ref = operation.get_ref() or ''
            failures.append(f'{ref}: {error.message}')
            return True             # keep going; the rest may still be fine

        failures = []
        threading.Thread(target=work, daemon=True).start()

    def fp_status(self, name):
        self.status = f'Updating {name}…' if name else 'Updating…'
        self.progress = None
        self.area.queue_draw()
        return False

    def fp_progress(self, value, detail):
        self.progress = value
        self.detail = detail
        self.cancellable = True
        self.area.queue_draw()
        return False

    def flatpaks_done(self, failures, cancelled):
        self.cancellable = False
        if cancelled:
            self.queue = []
            self.finish('Cancelled', self.colors['fg'])
            self.run_check()
            return False
        if failures:
            self.queue = []
            message, bad = humanise(failures[0])
            self.finish(message, self.colors['red'] if bad else self.colors['fg'])
            self.run_check()
            return False
        self.next_phase()
        return False

    def cancel(self):
        cancellable = getattr(self, 'fp_cancel', None)
        if cancellable is not None and not cancellable.is_cancelled():
            try:
                cancellable.cancel()
                return
            except Exception:
                pass
        try:
            self.trans.cancel()
        except Exception:
            pass

    def stale(self, trans):
        """The finished refresh transaction stays alive and keeps emitting for
        a moment after the next one starts, and its last words landed in the
        header while an install was already preparing. Only the current
        transaction gets to write here."""
        return trans is not self.trans

    def on_progress(self, _t, value):
        if self.stale(_t):
            return
        self.progress = value
        self.area.queue_draw()

    def on_status(self, _t, status):
        if self.stale(_t):
            return
        try:
            import aptkit.enums
            self.status = aptkit.enums.get_status_string_from_enum(status)
        except Exception:
            self.status = status.replace('status-', '').replace('-', ' ').capitalize()
        self.area.queue_draw()

    def on_detail(self, _t, detail):
        if self.stale(_t):
            return
        self.detail = detail
        self.area.queue_draw()

    def on_cancellable(self, _t, value):
        if self.stale(_t):
            return
        self.cancellable = bool(value)
        self.area.queue_draw()

    def on_trans_error(self, _t, code, details):
        if self.stale(_t):
            return
        self.trans_error = (details or code or '').strip()

    def on_apt_error(self, error):
        """Everything that goes wrong before or instead of a dpkg run."""
        message, bad = humanise(f'{type(error).__name__}: {error}')
        self.finish(message, self.colors['red'] if bad else self.colors['fg'])

    def on_finished(self, _t, exit_state):
        if exit_state == 'exit-success':
            self.next_phase()       # the flatpaks, if there are any, or done
            return
        if exit_state == 'exit-cancelled':
            self.queue = []
            self.finish('Cancelled', self.colors['fg'])
            return                # nothing ran, so nothing on disk changed
        self.queue = []           # apt failed; do not go on to the flatpaks
        message, bad = humanise(self.trans_error)
        self.finish(message, self.colors['red'] if bad else self.colors['fg'])
        if not bad:
            return                # a refused password installed nothing
        # dpkg either finished or stopped part way. Either way the list on
        # disk is now a guess, so ask again rather than keep showing it.
        self.run_check()

    def finish(self, message, colour):
        self.busy = False
        self.cancellable = False
        self.fp_cancel = None
        self.working = set()
        self.progress = None
        self.status = self.detail = ''
        self.notice = (colour, message)
        if not self.hidden:
            self.grab(True)
        self.rebuild()

    def nudge_panel(self):
        """genmon only re-reads on its own timer, and that timer is minutes
        long here on purpose. Tell it now."""
        plugin = self.cfg.get('PANEL_ID', '')
        if not plugin:
            return
        try:
            subprocess.Popen(
                ['xfce4-panel', f'--plugin-event=plugin-{plugin}:refresh:bool:true'],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError:
            pass


    # ---- animation

    def tick_spinner(self):
        if getattr(self, '_spinning', False):
            return
        self._spinning = True

        def step():
            if self.closing or not (self.checking or self.busy):
                self._spinning = False
                return False
            self.phase += 1
            self.area.queue_draw()
            return True
        GLib.timeout_add(90, step)

    # ---- window

    def place(self, px, py):
        win = self.win
        win.realize()
        self.gdk_win = gdk_win = win.get_window()
        if gdk_win is not None:
            gdk_win.set_override_redirect(True)
        w = self.pixel_width
        display = Gdk.Display.get_default()
        monitor = (display.get_monitor_at_point(px, py)
                   or display.get_primary_monitor())
        self.geo = geo = monitor.get_geometry()
        edge = round(SHADOW * SC)
        x = int(px - w + edge + round(24 * SC))
        self.x = max(geo.x + 2, min(x, geo.x + geo.width - w + edge - 4))
        self.y = 52 - edge + 4 if py < 64 else int(py) - edge + 8
        self.reposition()
        # Gtk.Widget.set_opacity, not win.set_opacity: Gtk.Window overrides it
        # with a deprecated variant, and PyGObject picks the override, so every
        # popup open wrote a DeprecationWarning to stderr. genmon discards that
        # stream; a terminal does not.
        Gtk.Widget.set_opacity(win, 0.0)
        win.present()
        self.hidden = False
        self.grab(True)
        self.t0 = time.monotonic()

        def step():
            if self.closing:
                return False
            f = min(1.0, (time.monotonic() - self.t0) / 0.11)
            Gtk.Widget.set_opacity(win, f * f * (3 - 2 * f))
            return f < 1.0
        GLib.timeout_add(16, step)
        self.tick_spinner()
        GLib.idle_add(self.collect_check)

    @property
    def pixel_width(self):
        return round(WIDTH * SC) + 2 * round((SHADOW + PAD) * SC)

    @property
    def pixel_height(self):
        return (round((self.height - 2 * PAD) * SC)
                + 2 * round((SHADOW + PAD) * SC))

    def reposition(self):
        """Run again after every rebuild. The popup hangs off the top bar and
        grows downward when a check lands, and this screen is 1440 tall — a
        long list would otherwise walk off the bottom edge."""
        if self.geo is None:
            return
        y, bottom = self.y, self.geo.y + self.geo.height
        h = self.pixel_height
        if y + h > bottom:
            y = max(self.geo.y, bottom - h)
        self.win.move(self.x, y)

    def grab(self, want):
        """The pointer, so a click outside dismisses the popup. Dropped for the
        length of a transaction: the polkit agent has to be able to take a
        password, and it cannot while this window holds the seat. Nothing
        closes the popup while an install runs, which is also where you want
        to be watching it from."""
        if self.gdk_win is None or want == self.grabbed:
            return
        seat = Gdk.Display.get_default().get_default_seat()
        try:
            seat.ungrab()
        except Exception:
            pass
        self.grabbed = want
        if not want:
            return
        try:
            seat.grab(self.gdk_win, Gdk.SeatCapabilities.ALL, True,
                      None, None, None)
        except Exception:
            self.grabbed = None

    def outside(self, e):
        alloc = self.win.get_allocation()
        edge = round(SHADOW * SC)
        return not (edge < e.x < alloc.width - edge
                    and edge < e.y < alloc.height - edge)

    def close(self):
        if self.closing:
            return
        self.closing = True
        try:
            Gdk.Display.get_default().get_default_seat().ungrab()
        except Exception:
            pass
        Gtk.main_quit()

    def toggle(self):
        """A bar click dismisses an idle popup, but only hides active work.

        Keeping this process alive preserves aptkit's progress callbacks and
        is required for Flatpak.Transaction, which runs in one of our threads.
        A second click shows this same window and its current progress again.
        """
        if self.win.get_visible():
            if not self.busy:
                self.close()
                return False
            self.grab(False)
            self.win.hide()
            self.hidden = True
            return False

        self.hidden = False
        self.win.show_all()
        self.reposition()
        self.win.present()
        if not self.busy:
            self.grab(True)
        self.area.queue_draw()
        return False


def pointer_xy():
    """The anchor this popup hangs off: MINTBOOK_ANCHOR if the Control
    Center handed one over, else where the pointer was at startup — not where
    it is now. See PTR_XY.

    Falls back to asking Gdk, which is the old behaviour, drift and all, and is
    where this lands if xdotool is not installed.
    """
    if PTR_XY is not None:
        return PTR_XY
    _s, x, y = (Gdk.Display.get_default().get_default_seat()
                .get_pointer().get_position())
    return int(x), int(y)


def main():
    px, py = pointer_xy()
    menu = Menu()
    signal.signal(signal.SIGUSR1,
                  lambda *_a: GLib.idle_add(menu.toggle))
    signal.signal(signal.SIGTERM,
                  lambda *_a: GLib.idle_add(menu.close))
    if TOGGLE_PENDING:
        GLib.idle_add(menu.toggle)
    menu.win.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
    menu.win.connect(
        'button-press-event',
        lambda _w, e: menu.close() or True if menu.outside(e) else False)
    menu.place(int(px), int(py))
    if os.environ.get('MINTBOOK_UPDATES_TIME'):
        print(f'{(time.monotonic() - T0) * 1000:.0f} ms to on screen',
              file=sys.stderr)
    Gtk.main()


if __name__ == '__main__':
    Gdk.set_program_class('mintbook-updates-menu')
    try:
        main()
    finally:
        try:
            if read_file(PIDFILE) == str(os.getpid()):
                os.remove(PIDFILE)
        except OSError:
            pass
    sys.exit(0)
