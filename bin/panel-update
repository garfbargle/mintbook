#!/usr/bin/env bash
# Update-manager indicator for xfce4-genmon-plugin.
# Reads mintupdate's own cached state file rather than invoking mintupdate-cli,
# which would hit apt metadata on every refresh.
DIR="$HOME/.local/share/mintbook/update"
JSON="$HOME/.linuxmint/mintupdate/updates.json"

printf '<click>mintupdate</click>\n'

n=$(python3 - "$JSON" <<'PY' 2>/dev/null
import json,sys
try:
    print(len(json.load(open(sys.argv[1])).get('updates') or {}))
except Exception:
    print(-1)
PY
)

if [ "$n" = "-1" ] || [ -z "$n" ]; then
    printf '<img>%s/update-ok.svg</img>\n<tool>Update status unknown</tool>\n' "$DIR"
elif [ "$n" -gt 0 ]; then
    s=""; [ "$n" -ne 1 ] && s="s"
    printf '<img>%s/update-pending.svg</img>\n<tool>%s update%s available</tool>\n' "$DIR" "$n" "$s"
else
    printf '<img>%s/update-ok.svg</img>\n<tool>Your system is up to date</tool>\n' "$DIR"
fi
