#!/usr/bin/env bash
# input-install — libinput DWT/palm quirk, the DMA blacklist if missing, and
# working suspend for the MacBook8,1. Must be run as root. See docs/input.md.
#
# Does not reboot. The quirk is visible to `libinput quirks list` immediately;
# disable-while-typing only applies after Xorg reopens the devices (log out).
# Suspend-to-idle is selected immediately and again at every boot.
set -euo pipefail

if [ "$(id -u)" -ne 0 ]; then
  echo "run as root: sudo $0" >&2
  exit 1
fi

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
QUIRKS_SRC="$ROOT/config/libinput/local-overrides.quirks"
QUIRKS_DST=/etc/libinput/local-overrides.quirks
BLACKLIST=/etc/modprobe.d/blacklist-dw-dmac.conf
LEGACY_UNIT=/etc/systemd/system/mintbook-applespi-resume.service
LEGACY_REBIND=/usr/local/sbin/mintbook-applespi-rebind
SLEEP_UNIT_SRC="$ROOT/config/systemd/mintbook-s2idle.service"
SLEEP_UNIT_DST=/etc/systemd/system/mintbook-s2idle.service

for f in "$QUIRKS_SRC" "$SLEEP_UNIT_SRC"; do
  if [ ! -f "$f" ]; then
    echo "missing $f" >&2
    exit 1
  fi
done

echo "==> $QUIRKS_DST"
install -dm755 /etc/libinput
install -m644 "$QUIRKS_SRC" "$QUIRKS_DST"
ls -l "$QUIRKS_DST"

if [ -f "$BLACKLIST" ]; then
  echo "==> $BLACKLIST already present"
else
  echo "==> $BLACKLIST"
  tee "$BLACKLIST" >/dev/null <<'EOF'
# The Apple SPI keyboard/trackpad (applespi @ pxa2xx_spi_pci 00:15.4) times out on
# every DMA transfer on this hardware. Whether SPI gets DMA is a boot race against
# dw_dmac_pci; losing it leaves the machine with no keyboard or trackpad.
# Removing the DMA provider forces the working PIO path deterministically.
# Nothing else here uses this DMA engine (all channels in_use=0).
# Undo: delete this file.
blacklist dw_dmac_pci
install dw_dmac_pci /bin/false
EOF
fi

echo "==> $SLEEP_UNIT_DST"
install -m644 "$SLEEP_UNIT_SRC" "$SLEEP_UNIT_DST"
# The old S3 recovery hook was measured on 2026-09-08: it retried the same
# wedged endpoint three times and left input dead. Keep the manual diagnostic
# script, but retire the ineffective automatic hook.
systemctl disable --now mintbook-applespi-resume.service 2>/dev/null || true
rm -f "$LEGACY_UNIT" "$LEGACY_REBIND"
systemctl daemon-reload
systemctl enable --now mintbook-s2idle.service

echo
echo "quirk is on disk. log out once for disable-while-typing to take effect."
echo "sleep mode is $(cat /sys/power/mem_sleep) — [s2idle] preserves built-in input."
echo "then: bin/input-check"
echo
echo "undo: systemctl disable mintbook-s2idle.service && rm $SLEEP_UNIT_DST"
