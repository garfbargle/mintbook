#!/usr/bin/env python3
"""idle-probe — where the idle watts go, and whether a knob actually moves them.

    bin/idle-probe                 # inventory (no root; watts need root)
    sudo bin/idle-probe            # + RAPL watts and the real FBC/PSR state
    sudo bin/idle-probe --try BDF  # A/B one device's runtime PM, then restore
    sudo bin/idle-probe --try BDF --cycles 8 --seconds 4

RAPL, the i915 parameters and debugfs are all root-only on this kernel, so the
interesting half needs sudo. Nothing here is persistent: --try restores the
original value on the way out, including on Ctrl-C.

Why this exists: three of the four "obvious" tunings on this machine turned out
to be wrong when checked (see docs/hardware.md). The remaining ones — PCI
runtime PM and framebuffer compression — are worth exactly what they measure,
and on a fanless chassis idle watts are thermal budget. So measure them.
"""
import os
import signal
import sys
import time

RAPL = '/sys/class/powercap'
PCI = '/sys/bus/pci/devices'

# Devices where a runtime-PM experiment can cost you the session. Each one has
# a history in this repo. --try refuses them without --force.
RISKY = {
    '0000:00:15.4': 'applespi — the keyboard and trackpad (docs/input.md)',
    '0000:00:15.5': 'the Bluetooth UART (docs/bluetooth.md)',
    '0000:01:00.0': 'Wi-Fi (brcmfmac runtime PM is known flaky)',
    '0000:02:00.0': 'the FaceTime camera (out-of-tree DKMS, docs/camera.md)',
    '0000:03:00.0': 'the NVMe controller — and APST already power-manages it',
}


def read1(p, d='?'):
    try:
        with open(p) as f:
            return ' '.join(f.read().split())
    except OSError:
        return d


def rapl_domains():
    out = []
    for n in sorted(os.listdir(RAPL)):
        if not n.startswith('intel-rapl:'):
            continue
        d = os.path.join(RAPL, n)
        name = read1(os.path.join(d, 'name'), n)
        if os.access(os.path.join(d, 'energy_uj'), os.R_OK):
            out.append((name, os.path.join(d, 'energy_uj')))
    return out


def battery_source():
    """Whole-system draw, but only while discharging.

    On AC, current_now is the *charge* current and says nothing about draw.
    This is world-readable, so unlike RAPL it needs no root — and unlike RAPL
    it sees devices on their own rails, which is the entire reason to measure
    runtime PM on battery.
    """
    b = '/sys/class/power_supply/BAT0'
    if read1(b + '/status') != 'Discharging':
        return None
    try:
        c = int(read1(b + '/current_now', '0'))
        v = int(read1(b + '/voltage_now', '0'))
    except ValueError:
        return None
    return (c / 1e6) * (v / 1e6) if c and v else None


def mean_sem(xs):
    """Mean and standard error. The spread of one arm is not the uncertainty
    of its mean — averaging n samples shrinks that by sqrt(n), which is the
    only reason a sub-watt effect is detectable against a 2.7 W sensor."""
    n = len(xs)
    if n == 0:
        return 0.0, float('inf')
    m = sum(xs) / n
    if n < 2:
        return m, float('inf')
    var = sum((x - m) ** 2 for x in xs) / (n - 1)
    return m, (var ** 0.5) / (n ** 0.5)


def sample_battery(seconds):
    """One reading per second; returns the individual readings, not a mean."""
    out = []
    for _ in range(max(1, int(seconds))):
        w = battery_source()
        if w is not None:
            out.append(w)
        time.sleep(1)
    return out


def sample_watts(domains, seconds):
    """Energy counters are microjoules and wrap; a delta over a window is watts."""
    if not domains:
        return None
    a = {n: int(read1(p, '0')) for n, p in domains}
    t0 = time.perf_counter()
    time.sleep(seconds)
    el = time.perf_counter() - t0
    b = {n: int(read1(p, '0')) for n, p in domains}
    out = {}
    for n, _ in domains:
        d = b[n] - a[n]
        if d < 0:                      # counter wrapped
            continue
        out[n] = d / 1e6 / el
    return out


def show_power(seconds=5):
    doms = rapl_domains()
    if not doms:
        print('  RAPL not readable — run as root '
              '(energy_uj is 0400 since the Platypus side-channel)')
        return None
    w = sample_watts(doms, seconds)
    for n in ('package-0', 'core', 'uncore', 'dram'):
        if n in w:
            print(f'  {n:<12} {w[n]:6.2f} W')
    return w


def show_display():
    print('display (i915)')
    for p in ('enable_fbc', 'enable_psr', 'enable_dc', 'enable_ips'):
        v = read1(f'/sys/module/i915/parameters/{p}', 'root only')
        note = '  (-1 = per-chip default: the driver decides)' if v == '-1' else ''
        print(f'  {p:<12} {v}{note}')
    fbc = read1('/sys/kernel/debug/dri/0/i915_fbc_status', '')
    if fbc:
        print(f'  FBC status   {fbc[:100]}')
    else:
        print('  FBC status   debugfs not readable — run as root')


def show_runtime_pm():
    print('PCI runtime power management')
    import subprocess
    try:
        names = {}
        for ln in subprocess.run(['lspci'], capture_output=True, text=True,
                                 timeout=5).stdout.splitlines():
            bdf, _, rest = ln.partition(' ')
            names['0000:' + bdf] = rest[:52]
    except Exception:
        names = {}
    on = []
    for n in sorted(os.listdir(PCI)):
        c = read1(os.path.join(PCI, n, 'power', 'control'), '?')
        st = read1(os.path.join(PCI, n, 'power', 'runtime_status'), '?')
        if c == 'on':
            on.append(n)
        flag = 'RISKY' if n in RISKY else ''
        print(f'  {c:<5} {st:<10} {n}  {names.get(n, "")[:44]:<44} {flag}')
    print(f'\n  {len(on)} device(s) pinned to "on" — they never enter D3.')
    print('  "auto" is what powertop calls a Good tunable. Measure before keeping:')
    print('    sudo bin/idle-probe --try 0000:00:16.0')


def try_device(bdf, force, seconds, cycles):
    ctl = os.path.join(PCI, bdf, 'power', 'control')
    if not os.path.exists(ctl):
        print(f'no such device: {bdf}', file=sys.stderr)
        return 1
    if bdf in RISKY and not force:
        print(f'{bdf} is {RISKY[bdf]}\n'
              f'A runtime-PM experiment here can cost you the session. '
              f'Re-run with --force if you mean it.', file=sys.stderr)
        return 1

    # Prefer the battery. RAPL only sees the SoC package, and every device
    # worth testing here (Wi-Fi, the SSD, the camera) is on its own rail.
    on_battery = battery_source() is not None
    doms = rapl_domains()
    if not on_battery and not doms:
        print('No power source to measure: not discharging, and RAPL needs '
              'root.\nUnplug, or run as root.', file=sys.stderr)
        return 1
    src = 'BAT0 (whole system)' if on_battery else 'RAPL package-0 (SoC only)'

    orig = read1(ctl)
    restored = False

    def restore(*_a):
        nonlocal restored
        if not restored:
            with open(ctl, 'w') as f:
                f.write(orig)
            restored = True
            print(f'\nrestored {bdf} power/control={orig}')

    signal.signal(signal.SIGINT, lambda *a: (restore(), sys.exit(130)))

    def take(n):
        if on_battery:
            return sample_battery(n)
        w = sample_watts(doms, n)
        return [w.get('package-0', 0.0)]

    runs = {orig: [], 'auto': []}
    est = cycles * seconds * 2
    print(f'{bdf}  {RISKY.get(bdf, "")}')
    print(f'  source   {src}')
    print(f'  plan     {cycles} cycles x {seconds}s per arm, alternating '
          f'{orig}/auto  (~{est // 60}m{est % 60:02d}s)')
    if on_battery:
        print('  note     the battery sensor is noisy — a single 12 W reading '
              'wanders +/-1.3 W.\n           Only the mean of many samples '
              'can see a sub-watt device.')
    print()
    try:
        for i in range(cycles):
            for state in (orig, 'auto'):
                with open(ctl, 'w') as f:
                    f.write(state)
                runs[state].extend(take(seconds))
            ma, _ = mean_sem(runs[orig])
            mb, _ = mean_sem(runs['auto'])
            print(f'    cycle {i + 1}/{cycles}: running mean  '
                  f'{orig}={ma:.2f} W  auto={mb:.2f} W')
        st = read1(os.path.join(PCI, bdf, 'power', 'runtime_status'))
    finally:
        restore()

    a, b = runs[orig], runs['auto']
    ma, sea = mean_sem(a)
    mb, seb = mean_sem(b)
    diff = mb - ma
    sed = (sea ** 2 + seb ** 2) ** 0.5     # standard error of the difference
    resolve = 2 * sed                      # ~95%: what this run could detect

    print(f'\n  {orig:<4} mean {ma:6.2f} W  +/- {sea:.3f}  (n={len(a)})')
    print(f'  auto  mean {mb:6.2f} W  +/- {seb:.3f}  (n={len(b)})')
    print(f'  difference {diff:+6.2f} W')
    print(f'  this run could resolve about {resolve:.2f} W')
    print(f'  runtime_status while on auto: {st}')

    if abs(diff) > resolve:
        verdict = ('MEASURABLE. The difference is larger than this run can '
                   'explain by noise.\n  Repeat with more --cycles before '
                   'making it permanent.')
    else:
        verdict = (f'NOT MEASURABLE. Any real effect is smaller than '
                   f'{resolve:.2f} W, which is all\n  this run could see. '
                   f'Do not keep it on the strength of this. More --cycles\n'
                   f'  narrows the window — it shrinks with the square root '
                   f'of the samples.')
    print(f'\n  VERDICT: {verdict}')
    if not on_battery:
        print('\n  RAPL covers the SoC package only. A device on its own rail '
              'can save real\n  power without moving it — measure on battery '
              'for those.')
    return 0


def main():
    args = sys.argv[1:]
    force = '--force' in args

    def opt(name, default):
        if name in args:
            i = args.index(name)
            if i + 1 < len(args):
                try:
                    return int(args[i + 1])
                except ValueError:
                    pass
        return default

    # Battery sampling is one reading per second and noisy, so the
    # defaults are deliberately long enough to mean something.
    on_bat = battery_source() is not None
    seconds = opt('--seconds', 20 if on_bat else 4)
    cycles = opt('--cycles', 6)
    if '--try' in args:
        i = args.index('--try')
        if i + 1 >= len(args):
            print('--try needs a PCI address, e.g. 0000:00:16.0', file=sys.stderr)
            return 2
        return try_device(args[i + 1], force, seconds, cycles)

    bw = battery_source()
    if bw is not None:
        print('whole-system power (battery, no root needed)')
        xs = sample_battery(8)
        m, se = mean_sem(xs)
        print(f'  BAT0         {m:6.2f} W  +/- {se:.2f} '
              f'(min {min(xs):.2f}, max {max(xs):.2f}, n={len(xs)})')
        print('  This is the number that sees Wi-Fi and the SSD. RAPL below '
              'does not.')
        print()
    print('package power')
    show_power(seconds)
    print()
    show_display()
    print()
    show_runtime_pm()
    return 0


if __name__ == '__main__':
    sys.exit(main())
