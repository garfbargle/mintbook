#!/usr/bin/env bash
# runaway-install — put bin/runaway-watch on a five-minute user timer.
#
# No root: it is a user unit, it reads /proc and it signals only processes the
# user already owns. See docs/feel.md.
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
BIN="$HOME/.local/bin"
UNITS="$HOME/.config/systemd/user"

if [ "${1:-}" = --revert ]; then
  echo "==> removing the timer"
  systemctl --user disable --now mintbook-runaway-watch.timer 2>/dev/null || true
  rm -f "$UNITS/mintbook-runaway-watch.timer" "$UNITS/mintbook-runaway-watch.service"
  systemctl --user daemon-reload
  echo "the script stays at $BIN/runaway-watch; nothing calls it now"
  exit 0
fi

echo "==> $BIN"
install -dm755 "$BIN"
install -m755 "$ROOT/bin/runaway-watch" "$BIN/runaway-watch"

echo "==> $UNITS"
install -dm755 "$UNITS"
install -m644 "$ROOT/config/systemd/mintbook-runaway-watch.service" "$UNITS/"
install -m644 "$ROOT/config/systemd/mintbook-runaway-watch.timer" "$UNITS/"
systemctl --user daemon-reload
systemctl --user enable --now mintbook-runaway-watch.timer

echo
systemctl --user list-timers mintbook-runaway-watch.timer --no-pager 2>/dev/null | head -3
echo
echo "see what it sees:  runaway-watch --check"
echo "never ask again:   runaway-watch --ignore PID   (or edit ~/.config/mintbook/runaway.ignore)"
echo "undo:              $(basename "$0") --revert"
