#!/usr/bin/env python3
"""Wi-Fi menu — the glass popup behind the bar's Wi-Fi icon.

macOS's Wi-Fi menu: the radio switch, what you are on and what that link
actually is, the networks in range, and somewhere to type a password. Until
now the bar icon opened nm-connection-editor, which is a window, and a window
is the wrong shape for "join the other network".

Drawn the way bin/battery-menu is — cairo on one override-redirect window,
one DrawingArea, a list of rows — for the reasons in docs/control-center.md:
genmon spawns a click command with no Gdk event behind it, and xfwm4 discards
a Gtk.Menu grab at time 0.

Two things it does that the battery menu does not:

  * the row set changes while it is open. The cached scan is on screen in
    ~120 ms; the rescan behind it takes four and a half seconds, and the list
    grows when it lands. rebuild() re-sizes the window in place, downward,
    which is free because the popup hangs off the top bar.

  * it takes the keyboard. A password field needs one, so the seat grab goes
    from ALL_POINTING to ALL when the join pane opens and back when it
    closes. The field itself is drawn here rather than being a Gtk.Entry:
    this display is at 168 dpi and everything else on the panel is scaled by
    hand, so a themed GTK widget would have been the only thing in the popup
    that did not match.

The password reaches NetworkManager on nmcli's stdin, not its argv — see
connect() for why that works and how it was checked.
"""
import math
import os
import signal
import subprocess
import sys
import threading
import time

T0 = time.monotonic()

HOME = os.path.expanduser('~')
APPLIED = f'{HOME}/.config/mintbook/appearance.applied'
PIDFILE = f'{HOME}/.cache/mintbook/wifi-menu.pid'
PLUGIN = f'{HOME}/.local/share/mintbook/control-center/plugins/10-wifi'
EDITOR = 'nm-connection-editor'


def read_file(path, default=''):
    try:
        with open(path) as f:
            return f.read().strip() or default
    except OSError:
        return default


def wireless():
    """Interface name and signal in dBm, from /proc/net/wireless. Two forkless
    readings, and the dBm is the honest number — nmcli's SIGNAL is a 0-100
    remap of it that no radio ever reports."""
    for line in read_file('/proc/net/wireless').splitlines()[2:]:
        name, _, rest = line.partition(':')
        name = name.strip()
        if not name:
            continue
        parts = rest.split()
        dbm = None
        if len(parts) > 2:
            try:
                dbm = int(float(parts[2].rstrip('.')))
            except ValueError:
                dbm = None
        return name, dbm
    return '', None


IFACE, DBM = wireless()


def spawn(args):
    try:
        return subprocess.Popen(args, stdout=subprocess.PIPE,
                                stderr=subprocess.DEVNULL, text=True)
    except OSError:
        return None


# Before importing Gtk, as in bin/control-center and bin/battery-menu: the
# cached scan costs 90 ms and the GTK import costs ~220, so all four readings
# happen inside the import for free. --rescan no is the whole point of doing
# it here — an actual rescan is 4.5 s and belongs in a thread, not on the path
# between the click and the window.
SCAN_P = spawn(['nmcli', '-t', '-f', 'IN-USE,SSID,SIGNAL,SECURITY,FREQ',
                'device', 'wifi', 'list', '--rescan', 'no'])
SAVED_P = spawn(['nmcli', '-t', '-f', 'NAME,TYPE', 'connection', 'show'])
RADIO_P = spawn(['nmcli', '-t', 'radio', 'wifi'])
LINK_P = spawn(['nmcli', '-t', '-f',
                'GENERAL.CONNECTION,GENERAL.STATE,IP4.ADDRESS,IP4.GATEWAY',
                'device', 'show', IFACE]) if IFACE else None
CONN_P = spawn(['busctl', '--system', 'get-property',
                'org.freedesktop.NetworkManager',
                '/org/freedesktop/NetworkManager',
                'org.freedesktop.NetworkManager', 'Connectivity'])

# Adwaita before the Gtk import: Gtk.init parses the GTK theme, WhiteSur's
# gtk.css is 400 KB, and that is ~120 ms of every launch spent on a stylesheet
# this popup never reads a rule from — it is cairo on a DrawingArea, and
# dark/light comes from appearance.applied. See bin/control-center.
os.environ.setdefault('GTK_THEME', 'Adwaita')

# Where the pointer is now, which is where the icon was clicked: this popup
# hangs off that icon, and clicking it is the only way to get here.
#
# Unless MINTBOOK_ANCHOR says otherwise. The Control Center chevron opens this
# popup in place of itself, and by then the pointer is somewhere down that
# panel's own tile list rather than up on the bar — so it hands over the
# anchor it was opened with, and this popup lands exactly where the panel it
# replaced was standing. It also skips the xdotool call below.
#
# Read synchronously, and deliberately *not* hidden behind the GTK import the
# way the readings above are. Hiding it is what broke it. Spawned as a Popen
# the child is descheduled behind this process's own ~500 ms of CPU-bound
# import — on two cores there is nowhere else for it to run — so xdotool
# sampled the pointer after the import rather than before it and returned the
# same late position the Gdk read did. Clicking the icon and moving the mouse
# away put the popup where the mouse had got to. Costs ~12 ms, paid in full.
PTR_XY = None
try:
    _ax, _ay = os.environ['MINTBOOK_ANCHOR'].split(',')
    PTR_XY = (int(_ax), int(_ay))
except (KeyError, ValueError):
    try:
        _ptr = subprocess.run(['xdotool', 'getmouselocation', '--shell'],
                              capture_output=True, text=True, timeout=3).stdout
        _ptr = dict(p.split('=', 1) for p in _ptr.split() if '=' in p)
        PTR_XY = (int(_ptr['X']), int(_ptr['Y']))
    except Exception:
        pass

import gi                                                          # noqa: E402
gi.require_version('Gtk', '3.0')
gi.require_version('PangoCairo', '1.0')
import cairo                                                       # noqa: E402
from gi.repository import Gtk, Gdk, GLib, Pango, PangoCairo        # noqa: E402

SC = round((Gdk.Screen.get_default().get_resolution() or 96) / 96.0, 3) or 1.0
WIDTH, PAD, GAP, SHADOW, RADIUS, CARD = 320, 14, 10, 16, 18, 12

# The popup glass. Canonical values live in config/theme/mintbook-glass.ini
# under [PopupLight] / [PopupDark], and are hardcoded here the way
# config/firefox/userChrome.css and the rofi palettes hardcode theirs: a popup
# that has to find and parse a file before it can paint is a popup that can
# fail to paint. Alphas are the same numbers, as 0-1 rather than 0-255.
LIGHT = {
    'top': (229, 231, 234, .980), 'bottom': (202, 205, 210, .970),
    'edge': (255, 255, 255, .75), 'rim': (65, 68, 74, .18),
    'fg': (45, 48, 54), 'tile': (255, 255, 255, .55),
    'tile_hi': (255, 255, 255, .78), 'tile_edge': (255, 255, 255, .65),
    'track': (65, 68, 74, .13), 'hair': (65, 68, 74, .12),
    'field': (255, 255, 255, .80), 'field_edge': (65, 68, 74, .18),
    'blue': (0, 122, 255), 'green': (52, 199, 89), 'red': (255, 59, 48),
}
DARK = {
    'top': (104, 109, 119, .975), 'bottom': (74, 78, 86, .968),
    'edge': (255, 255, 255, .18), 'rim': (0, 0, 0, .35),
    'fg': (255, 255, 255), 'tile': (255, 255, 255, .13),
    'tile_hi': (255, 255, 255, .20), 'tile_edge': (255, 255, 255, .10),
    'track': (255, 255, 255, .16), 'hair': (255, 255, 255, .12),
    'field': (0, 0, 0, .22), 'field_edge': (255, 255, 255, .16),
    'blue': (10, 132, 255), 'green': (48, 209, 88), 'red': (255, 69, 58),
}


# ------------------------------------------------------------------- reading

def tsplit(line):
    """nmcli -t escapes a ':' inside a value as '\\:', so str.split(':') tears
    BSSIDs and any SSID with a colon in it into pieces."""
    out, cur, esc = [], [], False
    for ch in line:
        if esc:
            cur.append(ch)
            esc = False
        elif ch == '\\':
            esc = True
        elif ch == ':':
            out.append(''.join(cur))
            cur = []
        else:
            cur.append(ch)
    out.append(''.join(cur))
    return out


def reap(proc, timeout=6):
    if proc is None:
        return ''
    try:
        return (proc.communicate(timeout=timeout)[0] or '').strip()
    except Exception:
        try:
            proc.kill()
        except Exception:
            pass
        return ''


def band(mhz):
    if mhz >= 5900:
        return '6 GHz'
    if mhz >= 4900:
        return '5 GHz'
    if mhz:
        return '2.4 GHz'
    return ''


def parse_scan(text):
    """One row per SSID, not per BSS. A mesh puts the same name on five radios
    and macOS shows it once; the row kept is the one the card is actually
    associated with, and failing that the loudest."""
    nets = {}
    for line in text.splitlines():
        f = tsplit(line)
        if len(f) < 5:
            continue
        ssid = f[1]
        if not ssid:
            continue                      # hidden; macOS does not list it
        try:
            sig = int(f[2])
        except ValueError:
            sig = 0
        try:
            mhz = int(f[4].split()[0])
        except (ValueError, IndexError):
            mhz = 0
        row = {'ssid': ssid, 'signal': sig, 'security': f[3].strip(),
               'mhz': mhz, 'inuse': f[0] == '*'}
        cur = nets.get(ssid)
        if (cur is None or (row['inuse'] and not cur['inuse'])
                or (not cur['inuse'] and sig > cur['signal'])):
            nets[ssid] = row
    return nets


def parse_saved(text):
    """Saved Wi-Fi profiles, by name. NetworkManager names a profile after the
    SSID it was created from, so the name is the match — a profile that has
    since been renamed simply loses its 'known' mark, which is cosmetic. The
    join path does not depend on this."""
    out = set()
    for line in text.splitlines():
        f = tsplit(line)
        if len(f) >= 2 and f[1] == '802-11-wireless':
            out.add(f[0])
    return out


def parse_link(text):
    d = {}
    for line in text.splitlines():
        k, _, v = line.partition(':')
        d[k] = v
    conn = d.get('GENERAL.CONNECTION', '')
    return {'conn': '' if conn in ('', '--') else conn,
            'state': d.get('GENERAL.STATE', ''),
            'ip': d.get('IP4.ADDRESS[1]', '').split('/')[0],
            'gw': d.get('IP4.GATEWAY', '')}


# NetworkManager's cached Connectivity, the same reading bin/panel-wifi puts
# the exclamation on the bar for. Associated is not online.
CONNECTIVITY = {'1': 'No internet', '2': 'Sign-in required',
                '3': 'Limited connection'}


def parse_conn(text):
    """`u 4` -> '' (online). Anything NM is unsure about gets a name."""
    return CONNECTIVITY.get(text.strip().split()[-1] if text.strip() else '', '')


def bitrate():
    """The link rate, which only NetworkManager knows — `iw` is not installed
    here and /proc/net/wireless does not carry it. Two D-Bus round trips, so
    it runs in the refresh thread rather than on the open path."""
    if not IFACE:
        return 0
    try:
        out = subprocess.run(
            ['busctl', '--system', 'call', 'org.freedesktop.NetworkManager',
             '/org/freedesktop/NetworkManager', 'org.freedesktop.NetworkManager',
             'GetDeviceByIpIface', 's', IFACE],
            capture_output=True, text=True, timeout=4).stdout.strip()
        path = out.split('"')[1] if '"' in out else ''
        if not path:
            return 0
        out = subprocess.run(
            ['busctl', '--system', 'get-property',
             'org.freedesktop.NetworkManager', path,
             'org.freedesktop.NetworkManager.Device.Wireless', 'Bitrate'],
            capture_output=True, text=True, timeout=4).stdout.strip()
        return int(out.split()[1]) // 1000        # kb/s -> Mbit/s
    except Exception:
        return 0


def set_radio(on):
    """Through the Control Center's own tile, so the switch here and the tile
    there can never disagree — the same rule bin/battery-menu follows for the
    power profile."""
    value = 'on' if on else 'off'
    if os.access(PLUGIN, os.X_OK):
        subprocess.run([PLUGIN, 'set', value], timeout=10, capture_output=True)
    else:
        subprocess.run(['nmcli', 'radio', 'wifi', value], timeout=10,
                       capture_output=True)


# ------------------------------------------------------------------- drawing

def rgba(cr, c, alpha=None):
    a = c[3] if len(c) > 3 else 1.0
    cr.set_source_rgba(c[0] / 255, c[1] / 255, c[2] / 255,
                       a if alpha is None else a * alpha)


def rrect(cr, x, y, w, h, r):
    r = max(0, min(r, w / 2, h / 2))
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


def text(cr, s, x, y, size, color, alpha=1.0, weight='normal',
         align=None, width=0, tnum=False):
    layout = PangoCairo.create_layout(cr)
    font = Pango.FontDescription('Inter Semi-Bold' if weight == 'bold' else 'Inter')
    font.set_absolute_size(size * Pango.SCALE)   # SC already carries the DPI
    layout.set_font_description(font)
    if tnum:
        attrs = Pango.AttrList()
        attrs.insert(Pango.attr_font_features_new('tnum=1'))
        layout.set_attributes(attrs)
    layout.set_text(str(s), -1)
    layout.set_ellipsize(Pango.EllipsizeMode.END)
    if width:
        layout.set_width(int(width * Pango.SCALE))
        layout.set_alignment({'center': Pango.Alignment.CENTER,
                              'right': Pango.Alignment.RIGHT}.get(
                                  align, Pango.Alignment.LEFT))
    rgba(cr, color, alpha)
    cr.move_to(x, y)
    PangoCairo.show_layout(cr, layout)
    return layout.get_pixel_size()


def bars(signal):
    """nmcli's 0-100 to the number of lit arcs. The same thresholds
    bin/panel-wifi uses on link quality, so the bar and the menu agree."""
    if signal >= 70:
        return 3
    if signal >= 40:
        return 2
    if signal >= 15:
        return 1
    return 0


def wifi_glyph(cr, x, y, s, color, level, alpha=1.0):
    """The Control Center's fan, with the arcs past `level` dimmed. The dot
    stays lit at level 0: it is the radio, not the first bar."""
    cr.save()
    cr.translate(x, y)
    cr.set_line_width(.085 * s)
    cr.set_line_cap(cairo.LINE_CAP_ROUND)
    for i, r in enumerate((.16, .31, .46)):
        rgba(cr, color, alpha if i < level else alpha * .22)
        cr.new_sub_path()
        cr.arc(.5 * s, .78 * s, r * s, math.pi * 1.22, math.pi * 1.78)
        cr.stroke()
    rgba(cr, color, alpha)
    cr.arc(.5 * s, .77 * s, .055 * s, 0, 2 * math.pi)
    cr.fill()
    cr.restore()


def lock_glyph(cr, x, y, s, color, alpha=1.0):
    cr.save()
    cr.translate(x, y)
    rgba(cr, color, alpha)
    rrect(cr, .16 * s, .44 * s, .68 * s, .48 * s, .14 * s)
    cr.fill()
    cr.set_line_width(.11 * s)
    cr.new_sub_path()
    cr.arc(.5 * s, .46 * s, .22 * s, math.pi, 2 * math.pi)
    cr.stroke()
    cr.restore()


def tick(cr, x, y, s, color, alpha=1.0):
    cr.save()
    cr.translate(x, y)
    rgba(cr, color, alpha)
    cr.set_line_width(.15 * s)
    cr.set_line_cap(cairo.LINE_CAP_ROUND)
    cr.set_line_join(cairo.LINE_JOIN_ROUND)
    cr.move_to(.14 * s, .52 * s)
    cr.line_to(.40 * s, .78 * s)
    cr.line_to(.86 * s, .22 * s)
    cr.stroke()
    cr.restore()


def chevron(cr, cx, cy, color, alpha):
    rgba(cr, color, alpha)
    cr.set_line_width(1.6)
    cr.set_line_cap(cairo.LINE_CAP_ROUND)
    cr.move_to(cx - 2, cy - 4)
    cr.line_to(cx + 2.5, cy)
    cr.line_to(cx - 2, cy + 4)
    cr.stroke()


def switch(cr, x, y, on, colors):
    w, h = 38, 22
    rrect(cr, x, y, w, h, h / 2)
    rgba(cr, colors['green'] if on else colors['track'])
    cr.fill()
    cr.arc(x + (w - h / 2 - 2 if on else h / 2 + 2), y + h / 2, h / 2 - 2,
           0, 2 * math.pi)
    cr.set_source_rgba(1, 1, 1, .98)
    cr.fill()


def spinner(cr, cx, cy, r, color, phase):
    cr.save()
    cr.set_line_cap(cairo.LINE_CAP_ROUND)
    cr.set_line_width(r * .34)
    for i in range(8):
        a = i * math.pi / 4
        rgba(cr, color, .12 + .5 * (((i - phase) % 8) / 8.0))
        cr.move_to(cx + math.cos(a) * r * .5, cy + math.sin(a) * r * .5)
        cr.line_to(cx + math.cos(a) * r, cy + math.sin(a) * r)
        cr.stroke()
    cr.restore()


# ---------------------------------------------------------------------- rows

class Row:
    h = 0
    interactive = False

    def __init__(self, panel):
        self.panel = panel
        self.hit = None

    @property
    def c(self):
        return self.panel.colors

    def card(self, cr, w, h):
        rrect(cr, 0, 0, w, h, CARD)
        rgba(cr, self.c['tile'])
        cr.fill_preserve()
        rgba(cr, self.c['tile_edge'])
        cr.set_line_width(1)
        cr.stroke()

    def lit(self, cr, w, y, h):
        cr.save()
        rrect(cr, 0, 0, w, self.h, CARD)
        cr.clip()
        cr.rectangle(0, y, w, h)
        rgba(cr, self.c['fg'], .06)
        cr.fill()
        cr.restore()

    def draw(self, cr, w):
        pass

    def test(self, x, y):
        return None

    def release(self, x, y):
        pass


class HeaderRow(Row):
    """The radio switch, and what the radio is doing."""
    h = 54
    interactive = True

    def draw(self, cr, w):
        p = self.panel
        self.card(cr, w, self.h)
        if self.hit is not None:
            self.lit(cr, w, 0, self.h)
        wifi_glyph(cr, 14, 15, 26, self.c['fg'], p.level if p.radio else 0,
                   .9 if p.radio else .35)
        text(cr, 'Wi-Fi', 50, 12, 11.5, self.c['fg'], .95, 'bold')
        text(cr, p.status, 50, 30, 9.5, self.c['fg'], .55, width=w - 118)
        switch(cr, w - 15 - 38, self.h / 2 - 11, p.radio, self.c)

    def test(self, x, y):
        return 'radio' if IFACE and x > WIDTH - 84 else None

    def release(self, x, y):
        if self.test(x, y):
            self.panel.toggle_radio()


class LinkRow(Row):
    """The connection you have, and what it actually is. Everything here is a
    reading, not a setting — the two lines are the ones you would otherwise
    open a terminal for."""
    h = 66

    def draw(self, cr, w):
        p = self.panel
        self.card(cr, w, self.h)
        wifi_glyph(cr, 14, 18, 30, self.c['fg'], p.level, .95)
        text(cr, p.link['conn'], 56, 12, 12, self.c['fg'], .95, 'bold',
             width=w - 56 - 34)
        text(cr, p.link_where, 56, 31, 9.5, self.c['fg'], .55, width=w - 70)
        # No tnum here: this line does not line up with anything, and tabular
        # figures give the minus in "-47 dBm" a digit's worth of advance.
        text(cr, p.link_quality, 56, 45, 9.5, self.c['fg'], .42, width=w - 70)
        tick(cr, w - 30, self.h / 2 - 8, 16, self.c['green'], .95)


class NetworkRow(Row):
    """The networks in range. Known ones first, then by signal — which is the
    order you want them in and not the order nmcli hands them over."""
    LEAD, LINE, MAX = 26, 30, 7
    interactive = True

    def __init__(self, panel):
        super().__init__(panel)
        self.top = 0
        self.n = min(len(panel.others), self.MAX)
        self.h = self.LEAD + self.LINE * max(1, self.n) + 8

    @property
    def visible(self):
        return self.panel.others[self.top:self.top + self.MAX]

    def draw(self, cr, w):
        p = self.panel
        self.card(cr, w, self.h)
        label = 'Networks'
        if p.scanning:
            label = 'Looking for networks…'
        text(cr, label, 15, 8, 9.5, self.c['fg'], .5)
        if p.scanning:
            spinner(cr, w - 24, 14, 6, self.c['fg'], p.phase)
        elif len(p.others) > self.MAX:
            text(cr, f'{self.top + 1}–{self.top + self.n} of {len(p.others)}',
                 0, 8, 9.5, self.c['fg'], .35, align='right', width=w - 15)

        if not p.others:
            text(cr, 'Looking…' if (p.scanning or not p.retried)
                 else 'No other networks',
                 15, self.LEAD + 6, 10.5, self.c['fg'], .4)
            return

        for i, net in enumerate(self.visible):
            y = self.LEAD + i * self.LINE
            busy = p.connecting == net['ssid']
            if self.hit == i and not p.connecting:
                self.lit(cr, w, y, self.LINE)
            wifi_glyph(cr, 15, y + 3, 22, self.c['fg'], bars(net['signal']),
                       .9 if not p.connecting or busy else .4)
            known = net['ssid'] in p.saved
            text(cr, net['ssid'], 46, y + 6, 10.5, self.c['fg'],
                 .95 if known else .8, 'bold' if known else 'normal',
                 width=w - 46 - 46)
            if busy:
                spinner(cr, w - 26, y + self.LINE / 2, 7, self.c['fg'], p.phase)
            elif net['security']:
                lock_glyph(cr, w - 32, y + 7, 15, self.c['fg'], .45)

    def test(self, x, y):
        if not self.panel.others or y < self.LEAD:
            return None
        i = int((y - self.LEAD) // self.LINE)
        return i if 0 <= i < len(self.visible) else None

    def release(self, x, y):
        i = self.test(x, y)
        if i is None or self.panel.connecting:
            return
        self.panel.choose(self.visible[i])

    def scroll(self, direction):
        extra = len(self.panel.others) - self.MAX
        if extra <= 0:
            return False
        top = min(extra, max(0, self.top + (1 if direction > 0 else -1)))
        if top == self.top:
            return False
        self.top = top
        return True


class OffRow(Row):
    """What sits where the network list would be when the radio is off, or
    when there is no radio at all."""
    h = 62

    def draw(self, cr, w):
        self.card(cr, w, self.h)
        msg = ('Wi-Fi is off' if IFACE else 'No Wi-Fi adapter')
        sub = ('Turn Wi-Fi on to see networks' if IFACE
               else 'Nothing in /proc/net/wireless')
        text(cr, msg, 15, 14, 10.5, self.c['fg'], .8)
        text(cr, sub, 15, 33, 9.5, self.c['fg'], .45)


class JoinRow(Row):
    """The password field. Drawn, not a Gtk.Entry — see the module docstring.

    It handles exactly what a password field on a popup needs: printable
    characters, backspace, ctrl+u, paste, Return and Escape. No selection and
    no cursor movement, because there is nothing here to move around in."""
    h = 124
    interactive = True
    FIELD_Y, FIELD_H = 40, 30

    def draw(self, cr, w):
        p = self.panel
        self.card(cr, w, self.h)
        text(cr, 'Enter the password for', 15, 10, 9.5, self.c['fg'], .5)
        text(cr, p.joining, 15, 22, 11.5, self.c['fg'], .95, 'bold',
             width=w - 30)

        rrect(cr, 15, self.FIELD_Y, w - 30, self.FIELD_H, 8)
        rgba(cr, self.c['field'])
        cr.fill_preserve()
        rgba(cr, self.c['blue'] if not p.error else self.c['red'], .85)
        cr.set_line_width(1.5)
        cr.stroke()
        if p.password:
            dots = '•' * len(p.password)
            tw = text(cr, dots, 26, self.FIELD_Y + 8, 12, self.c['fg'], .9)[0]
        else:
            text(cr, 'Password', 26, self.FIELD_Y + 8, 10.5, self.c['fg'], .35)
            tw = 0
        if p.caret:                          # a caret, so the field looks live
            cr.rectangle(26 + tw + 1.5, self.FIELD_Y + 8, 1.5, 15)
            rgba(cr, self.c['fg'], .8)
            cr.fill()

        if p.error:
            text(cr, p.error, 15, self.FIELD_Y + self.FIELD_H + 3, 9,
                 self.c['red'], .95, width=w - 30)

        by, bh = self.h - 36, 28
        for key, label, x0, bw in self.buttons(w):
            rrect(cr, x0, by, bw, bh, 8)
            if key == 'join':
                rgba(cr, self.c['blue'], 1.0 if p.password else .45)
                cr.fill()
                text(cr, label, x0, by + bh / 2 - 8, 10.5, (255, 255, 255),
                     .98, 'bold', align='center', width=bw)
            else:
                rgba(cr, self.c['fg'], .10 if self.hit == key else .06)
                cr.fill_preserve()
                rgba(cr, self.c['tile_edge'])
                cr.set_line_width(1)
                cr.stroke()
                text(cr, label, x0, by + bh / 2 - 8, 10.5, self.c['fg'],
                     .85, align='center', width=bw)

    def buttons(self, w):
        bw = 84
        return [('cancel', 'Cancel', w - 15 - 2 * bw - 8, bw),
                ('join', 'Join', w - 15 - bw, bw)]

    def test(self, x, y):
        if y < self.h - 40:
            return None
        for key, _l, x0, bw in self.buttons(WIDTH):
            if x0 <= x <= x0 + bw:
                return key
        return None

    def release(self, x, y):
        key = self.test(x, y)
        if key == 'cancel':
            self.panel.cancel_join()
        elif key == 'join' and self.panel.password:
            self.panel.connect(self.panel.joining, self.panel.password)


class FooterRow(Row):
    h = 44
    interactive = True

    def draw(self, cr, w):
        self.card(cr, w, self.h)
        if self.hit is not None:
            self.lit(cr, w, 0, self.h)
        text(cr, 'Network Settings…', 15, self.h / 2 - 8, 10.5,
             self.c['fg'], .92)
        chevron(cr, w - 19, self.h / 2, self.c['fg'],
                .55 if self.hit else .3)

    def test(self, x, y):
        return 'settings'

    def release(self, x, y):
        subprocess.Popen([EDITOR], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.panel.close()


# --------------------------------------------------------------------- panel

class Menu:
    def __init__(self):
        self.mode = 'dark' if read_file(APPLIED, 'light') == 'dark' else 'light'
        self.colors = DARK if self.mode == 'dark' else LIGHT
        self.closing = False
        self.press_row = None
        self.scanning = False
        self.again = False
        self.retried = False
        self.connecting = None
        self.joining = None
        self.password = ''
        self.error = ''
        self.caret = True
        self.phase = 0
        self.rate = 0
        self.trouble = ''
        self.keyboard = None      # None, not False: place() grabs the
        self.gdk_win = None       # pointer through grab_keyboard(False)
        self.geo = None
        self.x = self.y = 0

        self.radio = reap(RADIO_P) == 'enabled'
        self.saved = parse_saved(reap(SAVED_P))
        self.nets = parse_scan(reap(SCAN_P))
        self.link = parse_link(reap(LINK_P)) if LINK_P else {
            'conn': '', 'state': '', 'ip': '', 'gw': ''}
        self.trouble = parse_conn(reap(CONN_P))

        self.win = win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
        win.set_decorated(False)
        win.set_skip_taskbar_hint(True)
        win.set_skip_pager_hint(True)
        win.set_keep_above(True)
        win.set_resizable(False)
        win.set_app_paintable(True)
        win.set_type_hint(Gdk.WindowTypeHint.POPUP_MENU)
        visual = Gdk.Screen.get_default().get_rgba_visual()
        if visual:
            win.set_visual(visual)
        win.connect('draw', self.draw_background)
        win.connect('key-press-event', self.on_key)
        win.connect('destroy', lambda *_a: self.close())

        self.area = Gtk.DrawingArea()
        self.area.add_events(Gdk.EventMask.BUTTON_PRESS_MASK
                             | Gdk.EventMask.BUTTON_RELEASE_MASK
                             | Gdk.EventMask.POINTER_MOTION_MASK
                             | Gdk.EventMask.SCROLL_MASK
                             | Gdk.EventMask.LEAVE_NOTIFY_MASK)
        self.area.connect('draw', self.on_draw)
        self.area.connect('button-press-event', self.on_press)
        self.area.connect('button-release-event', self.on_release)
        self.area.connect('motion-notify-event', self.on_motion)
        self.area.connect('scroll-event', self.on_scroll)
        self.area.connect('leave-notify-event', self.on_leave)

        box = Gtk.Box()
        for setter in (box.set_margin_top, box.set_margin_bottom,
                       box.set_margin_start, box.set_margin_end):
            setter(round((SHADOW + PAD) * SC))
        box.pack_start(self.area, False, False, 0)
        win.add(box)

        self.rows = []
        self.rebuild()
        win.show_all()

    # ---- derived readings

    @property
    def current(self):
        return self.nets.get(self.link['conn'])

    @property
    def level(self):
        net = self.current
        if net:
            return bars(net['signal'])
        return 3 if self.link['conn'] else 0

    @property
    def status(self):
        if not IFACE:
            return 'No adapter'
        if not self.radio:
            return 'Off'
        if self.connecting:
            return f'Joining {self.connecting}…'
        if self.link['conn']:
            return self.trouble or 'Connected'
        return 'Not connected'

    @property
    def link_where(self):
        net = self.current
        bits = [self.trouble or self.link['ip'] or 'no address']
        if net:
            bits.append(band(net['mhz']))
            bits.append(net['security'] or 'Open')
        return ' · '.join(b for b in bits if b)

    @property
    def link_quality(self):
        bits = []
        net = self.current
        if DBM is not None and DBM > -200:
            bits.append(f'{DBM} dBm')
        elif net:
            bits.append(f"{net['signal']}%")
        if self.rate:
            bits.append(f'{self.rate} Mbit/s')
        if self.link['gw']:
            bits.append(f"router {self.link['gw']}")
        return ' · '.join(bits)

    @property
    def others(self):
        """Everything but the one we are on, known first then loudest."""
        rows = [n for n in self.nets.values() if n['ssid'] != self.link['conn']]
        rows.sort(key=lambda n: (n['ssid'] not in self.saved, -n['signal'],
                                 n['ssid'].lower()))
        return rows

    # ---- layout

    def build_rows(self):
        rows = [HeaderRow(self)]
        if self.joining:
            rows.append(JoinRow(self))
        elif not IFACE or not self.radio:
            rows.append(OffRow(self))
        else:
            if self.link['conn']:
                rows.append(LinkRow(self))
            rows.append(NetworkRow(self))
        rows.append(FooterRow(self))
        return rows

    def rebuild(self):
        """The row set changes under the pointer — a rescan lands, a join pane
        opens — so the window is re-sized rather than built once. It hangs off
        the top bar, so it only ever grows downward and the placement holds."""
        keep = {type(r).__name__: r for r in self.rows}
        self.rows = self.build_rows()
        old = keep.get('NetworkRow')
        for row in self.rows:                 # carry the scroll position over
            if isinstance(row, NetworkRow) and old is not None:
                row.top = min(old.top, max(0, len(self.others) - row.MAX))
        self.height = (sum(r.h for r in self.rows) + GAP * (len(self.rows) - 1)
                       + 2 * PAD)
        self.area.set_size_request(round(WIDTH * SC),
                                   round((self.height - 2 * PAD) * SC))
        self.reposition()
        self.area.queue_draw()

    # ---- drawing

    def on_draw(self, _w, cr):
        cr.set_antialias(cairo.ANTIALIAS_BEST)
        cr.scale(SC, SC)
        y = 0
        for row in self.rows:
            cr.save()
            cr.translate(0, y)
            cr.rectangle(0, 0, WIDTH, row.h)
            cr.clip()
            row.draw(cr, WIDTH)
            cr.restore()
            y += row.h + GAP
        return False

    def draw_background(self, _w, cr):
        a = self.win.get_allocation()
        cr.save()
        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.set_source_rgba(0, 0, 0, 0)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)
        cr.scale(SC, SC)
        x = y = SHADOW
        w, h = a.width / SC - 2 * SHADOW, a.height / SC - 2 * SHADOW
        for i in range(SHADOW, 0, -1):     # a soft edge, without a blur pass
            rrect(cr, x - i, y - i + 2, w + 2 * i, h + 2 * i, RADIUS + i)
            cr.set_line_width(1.4)
            cr.set_source_rgba(0, 0, 0, .055 * (1 - i / SHADOW) ** 2)
            cr.stroke()
        grad = cairo.LinearGradient(0, y, 0, y + h)
        top, bot = self.colors['top'], self.colors['bottom']
        grad.add_color_stop_rgba(0, top[0] / 255, top[1] / 255, top[2] / 255, top[3])
        grad.add_color_stop_rgba(1, bot[0] / 255, bot[1] / 255, bot[2] / 255, bot[3])
        rrect(cr, x, y, w, h, RADIUS)
        cr.set_source(grad)
        cr.fill_preserve()
        rgba(cr, self.colors['rim'])
        cr.set_line_width(1)
        cr.stroke()
        rrect(cr, x + .75, y + .75, w - 1.5, h - 1.5, RADIUS - .75)
        rgba(cr, self.colors['edge'])
        cr.set_line_width(1)
        cr.stroke()
        cr.restore()
        return False

    # ---- input

    def locate(self, ex, ey):
        x, y = ex / SC, ey / SC
        for row in self.rows:
            if y < row.h:
                return row, x, y
            y -= row.h + GAP
        return None, x, y

    def on_motion(self, _w, e):
        for row in self.rows:
            row.hit = None
        row, x, y = self.locate(e.x, e.y)
        if row is not None and row.interactive:
            row.hit = row.test(x, y)
        self.area.queue_draw()
        return True

    def on_leave(self, *_a):
        for row in self.rows:
            row.hit = None
        self.area.queue_draw()
        return True

    def on_scroll(self, _w, e):
        row = self.locate(e.x, e.y)[0]
        if not isinstance(row, NetworkRow):
            return False
        if e.direction == Gdk.ScrollDirection.SMOOTH:
            dy = e.get_scroll_deltas()[2]
        else:
            dy = 1 if e.direction == Gdk.ScrollDirection.DOWN else -1
        if dy and row.scroll(dy):
            self.area.queue_draw()
        return True

    def on_press(self, _w, e):
        # Left button only. Every row action here either joins a network or
        # turns the radio off, and a middle-click or a stray button 4/5 from
        # a synthetic event should not be able to reach one of those.
        if e.button != 1:
            return False
        self.press_row = self.locate(e.x, e.y)[0]
        return True

    def on_release(self, _w, e):
        if e.button != 1:
            return False
        row, x, y = self.locate(e.x, e.y)
        if row is not None and row is self.press_row and row.interactive:
            row.release(x, y)
        self.press_row = None
        return True

    def on_key(self, _w, e):
        if e.keyval == Gdk.KEY_Escape:
            if self.joining:
                self.cancel_join()
            else:
                self.close()
            return True
        if not self.joining:
            if e.keyval == Gdk.KEY_q:
                self.close()
                return True
            return False

        ctrl = bool(e.state & Gdk.ModifierType.CONTROL_MASK)
        if e.keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            if self.password:
                self.connect(self.joining, self.password)
            return True
        if e.keyval == Gdk.KEY_BackSpace:
            self.password = '' if ctrl else self.password[:-1]
        elif ctrl and e.keyval in (Gdk.KEY_u, Gdk.KEY_U):
            self.password = ''
        elif ctrl and e.keyval in (Gdk.KEY_v, Gdk.KEY_V):
            clip = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).wait_for_text()
            if clip:
                self.password += clip.strip().replace('\n', '')
        elif not ctrl:
            ch = Gdk.keyval_to_unicode(e.keyval)
            if ch >= 32:
                self.password += chr(ch)
        self.error = ''
        self.area.queue_draw()
        return True

    # ---- actions

    def toggle_radio(self):
        want = not self.radio
        self.radio = want                    # optimistic; the refresh confirms
        self.joining = None
        self.rebuild()

        def work():
            set_radio(want)
            GLib.idle_add(self.refresh, want)
        threading.Thread(target=work, daemon=True).start()

    def choose(self, net):
        """A known network, or an open one, joins straight away. An unknown
        secured one needs the password pane first."""
        if net['ssid'] in self.saved or not net['security']:
            self.connect(net['ssid'])
        else:
            self.joining = net['ssid']
            self.password = ''
            self.error = ''
            self.grab_keyboard(True)
            self.rebuild()

    def cancel_join(self):
        self.joining = None
        self.password = ''
        self.error = ''
        self.grab_keyboard(False)
        self.rebuild()

    def connect(self, ssid, password=None):
        self.connecting = ssid
        self.joining = None
        self.password = ''
        self.error = ''
        self.grab_keyboard(False)
        self.rebuild()
        self.tick_spinner()

        def work():
            # The secret goes on stdin, never on argv. `nmcli --ask` prompts
            # for it through nmc_readline, which is GNU readline, which reads
            # a pipe as happily as a terminal — verified by driving every
            # prompt of `nmcli --ask connection add` from a pipe. nmcli has no
            # /dev/tty anywhere in it, so there is no other stream it could be
            # reading. What this buys is that `ps` never sees the password;
            # `nmcli … password <pw>` put it in argv for the length of the
            # join. `--ask` is passed only when there is something to answer
            # with, and subprocess closes stdin after writing, so a prompt we
            # did not expect gets EOF and an error rather than a hang.
            cmd = ['nmcli']
            if password:
                cmd.append('--ask')
            cmd += ['device', 'wifi', 'connect', ssid]
            if IFACE:
                cmd += ['ifname', IFACE]
            try:
                p = subprocess.run(cmd, input=(password or '') + '\n',
                                   capture_output=True, text=True, timeout=75)
                ok = p.returncode == 0
                err = (p.stderr or p.stdout or '').strip().splitlines()
                err = err[-1] if err else 'Could not join'
            except Exception as exc:
                ok, err = False, str(exc)
            GLib.idle_add(self.joined, ssid, ok, err, password is not None)
        threading.Thread(target=work, daemon=True).start()

    def joined(self, ssid, ok, err, had_password):
        self.connecting = None
        if ok:
            self.saved.add(ssid)
        else:
            # Back to the field with the message on it, so a typo is one
            # correction rather than a second trip through the list. A known
            # network that failed *without* a password gets the field too when
            # the failure was about secrets — a stored profile can lose its
            # psk, and the answer to that is the same field.
            self.error = err.replace('Error: ', '')[:96]
            secrets = 'secret' in err.lower() or 'password' in err.lower()
            net = self.nets.get(ssid)
            if had_password or (secrets and net and net['security']):
                self.joining = ssid
                self.grab_keyboard(True)
        self.refresh(self.radio)
        return False

    def refresh(self, radio=None):
        """Re-read everything, in a thread, and redraw when it lands."""
        if self.scanning:
            self.again = True         # a toggle landed mid-scan; go round again
            return False
        self.again = False
        self.scanning = bool(radio if radio is not None else self.radio)
        self.rebuild()
        self.tick_spinner()

        def work():
            out = {}
            try:
                out['radio'] = subprocess.run(
                    ['nmcli', '-t', 'radio', 'wifi'], capture_output=True,
                    text=True, timeout=8).stdout.strip() == 'enabled'
            except Exception:
                out['radio'] = self.radio
            if out['radio']:
                try:
                    subprocess.run(['nmcli', 'device', 'wifi', 'rescan'],
                                   capture_output=True, timeout=25)
                except Exception:
                    pass
            for key, args in (
                    ('scan', ['nmcli', '-t', '-f',
                              'IN-USE,SSID,SIGNAL,SECURITY,FREQ',
                              'device', 'wifi', 'list', '--rescan', 'no']),
                    ('saved', ['nmcli', '-t', '-f', 'NAME,TYPE',
                               'connection', 'show']),
                    ('link', ['nmcli', '-t', '-f',
                              'GENERAL.CONNECTION,GENERAL.STATE,'
                              'IP4.ADDRESS,IP4.GATEWAY',
                              'device', 'show', IFACE])):
                if key == 'link' and not IFACE:
                    continue
                try:
                    out[key] = subprocess.run(args, capture_output=True,
                                              text=True, timeout=20).stdout
                except Exception:
                    out[key] = ''
            out['rate'] = bitrate()
            out['dbm'] = wireless()[1]
            try:
                out['conn'] = subprocess.run(
                    ['busctl', '--system', 'get-property',
                     'org.freedesktop.NetworkManager',
                     '/org/freedesktop/NetworkManager',
                     'org.freedesktop.NetworkManager', 'Connectivity'],
                    capture_output=True, text=True, timeout=6).stdout
            except Exception:
                out['conn'] = ''
            GLib.idle_add(self.landed, out)
        threading.Thread(target=work, daemon=True).start()
        return False

    def landed(self, out):
        global DBM
        self.scanning = False
        self.radio = out.get('radio', self.radio)
        if 'scan' in out:
            fresh = parse_scan(out['scan'])
            self.nets = fresh or self.nets
            # `nmcli device wifi rescan` is rate limited, and a rescan refused
            # right after another one leaves the list read hitting an empty
            # cache. Once — an empty list can also just be the truth.
            if not fresh and self.radio and not self.retried:
                self.retried = True
                self.again = True
        if out.get('saved'):
            self.saved = parse_saved(out['saved'])
        if out.get('link'):
            self.link = parse_link(out['link'])
        self.rate = out.get('rate', 0)
        self.trouble = parse_conn(out.get('conn', ''))
        if out.get('dbm') is not None:
            DBM = out['dbm']
        self.rebuild()
        if self.again:
            self.again = False
            GLib.idle_add(self.refresh)
        return False

    def tick_spinner(self):
        if getattr(self, '_spinning', False):
            return
        self._spinning = True

        def step():
            if self.closing or not (self.scanning or self.connecting):
                self._spinning = False
                return False
            self.phase = (self.phase + 1) % 8
            self.area.queue_draw()
            return True
        GLib.timeout_add(90, step)

    def tick_caret(self):
        def step():
            if self.closing:
                return False
            self.caret = (not self.caret) if self.joining else True
            if self.joining:
                self.area.queue_draw()
            return True
        GLib.timeout_add(530, step)

    # ---- window

    def place(self, px, py):
        win = self.win
        win.realize()
        self.gdk_win = gdk_win = win.get_window()
        if gdk_win is not None:
            gdk_win.set_override_redirect(True)
        w = self.pixel_width
        display = Gdk.Display.get_default()
        monitor = (display.get_monitor_at_point(px, py)
                   or display.get_primary_monitor())
        self.geo = geo = monitor.get_geometry()
        edge = round(SHADOW * SC)
        x = int(px - w + edge + round(24 * SC))
        self.x = max(geo.x + 2, min(x, geo.x + geo.width - w + edge - 4))
        self.y = 52 - edge + 4 if py < 64 else int(py) - edge + 8
        self.reposition()
        # Gtk.Widget.set_opacity, not win.set_opacity: Gtk.Window overrides it
        # with a deprecated variant, and PyGObject picks the override, so every
        # popup open wrote a DeprecationWarning to stderr. genmon discards that
        # stream; a terminal does not.
        Gtk.Widget.set_opacity(win, 0.0)
        win.present()
        self.grab_keyboard(False)
        self.t0 = time.monotonic()

        def step():
            if self.closing:
                return False
            f = min(1.0, (time.monotonic() - self.t0) / 0.11)
            Gtk.Widget.set_opacity(win, f * f * (3 - 2 * f))
            return f < 1.0
        GLib.timeout_add(16, step)
        self.tick_caret()
        GLib.timeout_add(120, lambda: self.refresh())

    @property
    def pixel_width(self):
        return round(WIDTH * SC) + 2 * round((SHADOW + PAD) * SC)

    @property
    def pixel_height(self):
        return (round((self.height - 2 * PAD) * SC)
                + 2 * round((SHADOW + PAD) * SC))

    def reposition(self):
        """Run again after every rebuild. The popup hangs off the top bar and
        grows downward when a scan lands, and this screen is 1440 tall — a
        long network list would otherwise walk off the bottom edge."""
        if self.geo is None:
            return
        y, bottom = self.y, self.geo.y + self.geo.height
        h = self.pixel_height
        if y + h > bottom:
            y = max(self.geo.y, bottom - h)
        self.win.move(self.x, y)

    def grab_keyboard(self, want):
        """ALL_POINTING normally; ALL while the password field is up. An
        override-redirect window is never given focus by xfwm4, so without the
        keyboard in the grab the field would take no keys at all."""
        if self.gdk_win is None or want == self.keyboard:
            return
        seat = Gdk.Display.get_default().get_default_seat()
        caps = (Gdk.SeatCapabilities.ALL if want
                else Gdk.SeatCapabilities.ALL_POINTING)
        try:
            seat.ungrab()
        except Exception:
            pass
        try:
            seat.grab(self.gdk_win, caps, True, None, None, None)
            self.keyboard = want
        except Exception:
            pass
        if want:
            self.win.set_can_focus(True)
            self.win.grab_focus()

    def outside(self, e):
        alloc = self.win.get_allocation()
        edge = round(SHADOW * SC)
        return not (edge < e.x < alloc.width - edge
                    and edge < e.y < alloc.height - edge)

    def close(self):
        if self.closing:
            return
        self.closing = True
        try:
            Gdk.Display.get_default().get_default_seat().ungrab()
        except Exception:
            pass
        Gtk.main_quit()


def single_instance():
    """A second click on the bar icon closes the open menu, like macOS."""
    os.makedirs(os.path.dirname(PIDFILE), exist_ok=True)
    try:
        pid = int(read_file(PIDFILE, '0'))
    except ValueError:
        pid = 0
    # A stale pidfile must not make the bar icon unclickable, and the pid in it
    # may since have been recycled by something else entirely — so check what
    # is actually running under it before signalling anything.
    if pid and pid != os.getpid():
        try:
            with open(f'/proc/{pid}/cmdline', 'rb') as f:
                ours = b'wifi-menu' in f.read()
        except OSError:
            ours = False
        if ours:
            try:
                os.kill(pid, signal.SIGTERM)
                return False        # it was up; this click was the dismiss
            except OSError:
                pass
    with open(PIDFILE, 'w') as f:
        f.write(str(os.getpid()))
    return True


def pointer_xy():
    """The anchor this popup hangs off: MINTBOOK_ANCHOR if the Control
    Center handed one over, else where the pointer was at startup — not where
    it is now. See PTR_XY.

    Falls back to asking Gdk, which is the old behaviour, drift and all, and is
    where this lands if xdotool is not installed.
    """
    if PTR_XY is not None:
        return PTR_XY
    _s, x, y = (Gdk.Display.get_default().get_default_seat()
                .get_pointer().get_position())
    return int(x), int(y)


def main():
    if not single_instance():
        return
    px, py = pointer_xy()
    menu = Menu()
    signal.signal(signal.SIGTERM, lambda *_a: menu.close())
    menu.win.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
    menu.win.connect(
        'button-press-event',
        lambda _w, e: menu.close() or True if menu.outside(e) else False)
    menu.place(int(px), int(py))
    if os.environ.get('MINTBOOK_WIFI_TIME'):
        print(f'{(time.monotonic() - T0) * 1000:.0f} ms to on screen',
              file=sys.stderr)
    Gtk.main()


if __name__ == '__main__':
    Gdk.set_program_class('mintbook-wifi-menu')
    try:
        main()
    finally:
        try:
            if read_file(PIDFILE) == str(os.getpid()):
                os.remove(PIDFILE)
        except OSError:
            pass
    sys.exit(0)
