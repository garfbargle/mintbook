#!/usr/bin/env bash
# input-check - is the Apple SPI keyboard/trackpad on the working PIO path,
# and does it survive sleep? Read-only, no sudo. See docs/input.md.
#   --history   survey every boot recorded in the journal
set -uo pipefail

# There are two ways to lose input, and they look identical to the user.
# The DMA boot race never reaches PIO or the touchpad. The resume failure
# probes cleanly and only starts timing out after a wake — so a boot that
# has PIO, a touchpad AND timeouts was killed by sleep, not by DMA.
verdict() { # $1=pio $2=timeouts $3=touchpad $4=suspends
  if [ "$1" -eq 0 ] && [ "$2" -eq 0 ] && [ "$3" -eq 0 ]; then echo "no data"
  elif [ "$1" -gt 0 ] && [ "$3" -gt 0 ] && [ "$2" -eq 0 ]; then echo "OK (PIO)"
  elif [ "$1" -gt 0 ] && [ "$3" -gt 0 ] && [ "${4:-0}" -gt 0 ]; then echo "DEAD (resume)"
  elif [ "$2" -gt 0 ] || [ "$3" -eq 0 ];                  then echo "DEAD (DMA)"
  else                                                         echo "unclear"; fi
}

scan() { # $1 = boot id or offset
  local b=$1
  local log pio to tp su
  log=$(journalctl -b "$b" -k --no-pager 2>/dev/null)
  pio=$(printf '%s\n' "$log" | grep -c "using PIO")
  to=$(printf '%s\n' "$log" | grep -c "SPI transfer timed out")
  tp=$(printf '%s\n' "$log" | grep -c "Apple SPI Touchpad")
  su=$(printf '%s\n' "$log" | grep -c "PM: suspend entry")
  echo "$pio $to $tp $su"
}

if [ "${1:-}" = "--history" ]; then
  printf '%-4s %-10s %-5s %-9s %-9s %-6s %s\n' IDX KERNEL PIO TIMEOUTS TOUCHPAD SLEPT RESULT
  journalctl --list-boots --no-pager 2>/dev/null | awk 'NF>2 {print $1, $2}' | \
  while read -r off id; do
    case "$off" in ''|*[!0-9-]*) [ "${off#-}" = "$off" ] && [ "$off" != "0" ] && continue ;; esac
    k=$(journalctl -b "$id" -k --no-pager 2>/dev/null \
          | grep -m1 -oE 'Linux version [0-9]+\.[0-9]+\.[0-9]+-[0-9]+' | sed 's/Linux version //')
    read -r pio to tp su <<<"$(scan "$id")"
    printf '%-4s %-10s %-5s %-9s %-9s %-6s %s\n' "$off" "${k:-?}" "$pio" "$to" "$tp" "$su" "$(verdict "$pio" "$to" "$tp" "$su")"
  done
  exit 0
fi

echo "kernel: $(uname -r)"
read -r pio to tp su <<<"$(scan 0)"
echo "  'using PIO' lines ....... $pio   (want >0)"
echo "  SPI transfer timeouts ... $to   (want 0)"
echo "  Apple SPI Touchpad ...... $tp   (want >0)"
echo "  suspends this boot ...... $su"
echo "  verdict ................. $(verdict "$pio" "$to" "$tp" "$su")"
echo
echo "live input devices:"
grep -E '^N: Name="Apple SPI' /proc/bus/input/devices 2>/dev/null | sed 's/^/  /' \
  || echo "  (no Apple SPI devices present)"
echo
if [ -f /etc/modprobe.d/blacklist-dw-dmac.conf ]; then
  echo "fix: /etc/modprobe.d/blacklist-dw-dmac.conf is INSTALLED"
else
  echo "fix: NOT installed - boots are a coin flip. See docs/input.md"
fi
lsmod | grep -q '^dw_dmac_pci' && echo "     (dw_dmac_pci is currently loaded)" \
                               || echo "     (dw_dmac_pci not loaded - good)"
echo
if [ -f /etc/libinput/local-overrides.quirks ]; then
  echo "dwt quirk: /etc/libinput/local-overrides.quirks is INSTALLED"
else
  echo "dwt quirk: NOT installed - disable-while-typing is a no-op. See docs/input.md"
fi
if command -v libinput >/dev/null 2>&1; then
  kbd=$(libinput quirks list /dev/input/event4 2>/dev/null | grep -F AttrKeyboardIntegration || true)
  pad=$(libinput quirks list /dev/input/event5 2>/dev/null | grep -F AttrSizeHint || true)
  echo "     keyboard: ${kbd:-<no AttrKeyboardIntegration>}"
  echo "     touchpad: ${pad:-<no AttrSizeHint>}"
  echo "     (Xorg only reloads this on logout)"
fi

echo
mode=$(sed -n 's/.*\[\([^]]*\)\].*/\1/p' /sys/power/mem_sleep 2>/dev/null)
echo "sleep mode: ${mode:-unknown}"
if [ "$mode" = s2idle ]; then
  echo "     (good - deep S3 kills MacBook8,1 Apple SPI input)"
else
  echo "     (unsafe - select s2idle before suspending. See docs/input.md)"
fi
if systemctl is-enabled mintbook-s2idle.service >/dev/null 2>&1; then
  echo "sleep fix: INSTALLED and enabled"
else
  echo "sleep fix: NOT enabled - the safe mode will not survive a reboot"
fi

# What happened on this boot's most recent sleep cycle. S3 emits an ACPI
# "Waking up" marker; s2idle does not, so PM: suspend exit is the common marker.
wakes=$(journalctl -b -k --no-pager 2>/dev/null | grep -c 'PM: suspend exit')
if [ "$wakes" -eq 0 ]; then
  echo "     (no resume yet this boot - nothing to judge)"
else
  post=$(journalctl -b -k --no-pager 2>/dev/null \
           | awk '/PM: suspend entry/{cycle=""; found=1} found {cycle=cycle $0 ORS} END {printf "%s", cycle}')
  to=$(printf '%s\n' "$post" | grep -c 'SPI transfer timed out')
  ms=$(printf '%s\n' "$post" | grep -c 'modeswitch done')
  echo "     resumes this boot ...... $wakes"
  echo "     timeouts since wake .... $to   (want 0)"
  echo "     modeswitch since wake .. $ms"
  if grep -qF 'Name="Apple SPI Touchpad"' /proc/bus/input/devices 2>/dev/null; then
    echo "     touchpad now ........... present - input survived"
  else
    echo "     touchpad now ........... MISSING - input is dead"
  fi
fi
