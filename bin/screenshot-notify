#!/usr/bin/env python3
"""Offer Open / Copy after the PNG exists; clipboard ownership uses GTK."""
from pathlib import Path
import subprocess
import sys


def copy_image(path, selection='CLIPBOARD', notify=True):
    import gi
    gi.require_version('Gtk', '3.0')
    from gi.repository import Gtk, Gdk, GdkPixbuf, GLib
    atom = Gdk.Atom.intern(selection, False)
    clipboard = Gtk.Clipboard.get(atom)
    clipboard.set_image(GdkPixbuf.Pixbuf.new_from_file(str(path)))
    owner = Gdk.selection_owner_get(atom)
    if selection == 'CLIPBOARD':
        clipboard.set_can_store(None)
        clipboard.store()
    # Ignore the queued event for our own initial claim. Quit only when
    # another owner replaces it, including a clipboard manager after save.
    def changed(*_):
        if Gdk.selection_owner_get(atom) != owner:
            Gtk.main_quit()
    clipboard.connect('owner-change', changed)
    GLib.timeout_add_seconds(600, lambda: (Gtk.main_quit(), False)[1])
    if notify:
        subprocess.run(['notify-send', 'Screenshot copied', 'Ready to paste'], timeout=5)
    Gtk.main()


def main():
    path = Path(sys.argv[1]).resolve(strict=True)
    result = subprocess.run(['notify-send', '-a', 'Mintbook', '-i', str(path), '-t', '10000',
                             '-A', 'copy=Copy', '-A', 'open=Open',
                             'Screenshot saved', path.name], capture_output=True, text=True, timeout=90)
    if result.stdout.strip() == 'open':
        subprocess.Popen(['xdg-open', str(path)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    elif result.stdout.strip() == 'copy':
        copy_image(path)


if __name__ == '__main__':
    try:
        main()
    except (OSError, subprocess.TimeoutExpired) as error:
        print(error, file=sys.stderr)
