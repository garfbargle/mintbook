#!/usr/bin/env python3
"""Floating glass screenshot thumbnail toast with Open / Copy actions."""
import math
import os
from pathlib import Path
import signal
import subprocess
import sys
import time

HOME = os.path.expanduser('~')
APPLIED = f'{HOME}/.config/mintbook/appearance.applied'
PIDFILE = f'{HOME}/.cache/mintbook/screenshot-notify.pid'
WIDTH, HEIGHT, SHADOW, RADIUS = 324, 96, 16, 18

LIGHT = {  # generated by bin/palette-generate
    'top': (229, 231, 234, 0.980392),
    'bottom': (202, 205, 210, 0.968627),
    'edge': (255, 255, 255, 0.74902),
    'rim': (65, 68, 74, 0.180392),
    'fg': (45, 48, 54),
    'tile': (255, 255, 255, 0.54902),
    'tile_hi': (255, 255, 255, 0.780392),
    'tile_edge': (255, 255, 255, 0.65098),
    'blue': (0, 122, 255),
    'green': (52, 199, 89),
}
DARK = {  # generated by bin/palette-generate
    'top': (104, 109, 119, 0.976471),
    'bottom': (74, 78, 86, 0.968627),
    'edge': (255, 255, 255, 0.180392),
    'rim': (0, 0, 0, 0.34902),
    'fg': (255, 255, 255),
    'tile': (255, 255, 255, 0.129412),
    'tile_hi': (255, 255, 255, 0.2),
    'tile_edge': (255, 255, 255, 0.101961),
    'blue': (10, 132, 255),
    'green': (48, 209, 88),
}


def read_file(path, default=''):
    try:
        with open(path) as f:
            return f.read().strip() or default
    except OSError:
        return default


def copy_image(path, selection='CLIPBOARD', notify=True):
    os.environ.setdefault('GTK_THEME', 'Adwaita')
    import gi
    gi.require_version('Gtk', '3.0')
    from gi.repository import Gtk, Gdk, GdkPixbuf, GLib
    atom = Gdk.Atom.intern(selection, False)
    clipboard = Gtk.Clipboard.get(atom)
    clipboard.set_image(GdkPixbuf.Pixbuf.new_from_file(str(path)))
    owner = Gdk.selection_owner_get(atom)
    if selection == 'CLIPBOARD':
        clipboard.set_can_store(None)
        clipboard.store()
    # Ignore the queued event for our own initial claim. Quit only when
    # another owner replaces it, including a clipboard manager after save.
    def changed(*_):
        if Gdk.selection_owner_get(atom) != owner:
            Gtk.main_quit()
    clipboard.connect('owner-change', changed)
    GLib.timeout_add_seconds(600, lambda: (Gtk.main_quit(), False)[1])
    if notify:
        subprocess.run(['notify-send', 'Screenshot copied', 'Ready to paste'], timeout=5)
    Gtk.main()


def show_toast(path):
    os.environ.setdefault('GTK_THEME', 'Adwaita')
    import cairo
    import gi
    gi.require_version('Gtk', '3.0')
    gi.require_version('PangoCairo', '1.0')
    from gi.repository import Gtk, Gdk, GdkPixbuf, GLib, Pango, PangoCairo

    screen = Gdk.Screen.get_default()
    if screen is None:
        return False

    sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
    from mintbook_instance import claim
    for _ in range(15):
        if claim(PIDFILE, 'screenshot-notify', signal.SIGTERM):
            break
        time.sleep(0.02)

    sc = float(os.environ.get('MINTBOOK_SCALE', 0)) or round((screen.get_resolution() or 96) / 96.0, 3) or 1.0
    appearance = os.environ.get('MINTBOOK_PREVIEW_APPEARANCE') or read_file(APPLIED, 'light')
    colors = DARK if appearance == 'dark' else LIGHT

    def rrect(cr, x, y, w, h, r):
        r = max(0, min(r, w / 2, h / 2))
        cr.new_sub_path()
        cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
        cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
        cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
        cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
        cr.close_path()

    def rgba(cr, c, a=None):
        cr.set_source_rgba(c[0] / 255, c[1] / 255, c[2] / 255,
                           c[3] if a is None and len(c) > 3 else (1.0 if a is None else a))

    def draw_text(cr, s, x, y, size, color, alpha=1.0, weight='normal', align='left', width=None):
        layout = PangoCairo.create_layout(cr)
        desc = Pango.FontDescription(f'Inter {size}')
        desc.set_weight(Pango.Weight.BOLD if weight == 'bold' else Pango.Weight.MEDIUM if weight == 'medium' else Pango.Weight.NORMAL)
        layout.set_font_description(desc)
        if width:
            layout.set_width(int(width * Pango.SCALE))
            layout.set_ellipsize(Pango.EllipsizeMode.MIDDLE)
        if align == 'center' and width:
            layout.set_alignment(Pango.Alignment.CENTER)
        layout.set_text(str(s), -1)
        cr.move_to(x, y)
        rgba(cr, color, alpha)
        PangoCairo.show_layout(cr, layout)

    thumb_surface = None
    tw_px, th_px = round(92 * sc), round(68 * sc)
    try:
        pix = GdkPixbuf.Pixbuf.new_from_file(str(path))
        pw, ph = pix.get_width(), pix.get_height()
        scale = max(tw_px / max(1, pw), th_px / max(1, ph))
        sw, sh = max(1, round(pw * scale)), max(1, round(ph * scale))
        scaled = pix.scale_simple(sw, sh, GdkPixbuf.InterpType.BILINEAR)
        cropped = GdkPixbuf.Pixbuf.new(GdkPixbuf.Colorspace.RGB, scaled.get_has_alpha(), 8, tw_px, th_px)
        scaled.copy_area(max(0, (sw - tw_px) // 2), max(0, (sh - th_px) // 2), tw_px, th_px, cropped, 0, 0)
        thumb_surface = Gdk.cairo_surface_create_from_pixbuf(cropped, 1, None)
    except Exception:
        thumb_surface = None

    state = {
        'hover': None,
        'pointer_inside': False,
        'copied': False,
        'closing': False,
        'holding_clipboard': False,
        'elapsed': 0.0,
        'last_tick': time.monotonic(),
    }

    rects = {
        'thumb': (14, 14, 92, 68),
        'copy': (118, 54, 90, 28),
        'open': (216, 54, 94, 28),
        'close': (WIDTH - 28, 10, 18, 18),
    }

    win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
    win.set_title('Screenshot saved')
    win.set_decorated(False)
    win.set_skip_taskbar_hint(True)
    win.set_skip_pager_hint(True)
    win.set_keep_above(True)
    win.set_resizable(False)
    win.set_app_paintable(True)
    win.set_type_hint(Gdk.WindowTypeHint.NOTIFICATION)
    visual = screen.get_rgba_visual()
    if visual:
        win.set_visual(visual)

    area = Gtk.DrawingArea()
    area.set_size_request(round((WIDTH + 2 * SHADOW) * sc), round((HEIGHT + 2 * SHADOW) * sc))
    area.add_events(Gdk.EventMask.BUTTON_PRESS_MASK
                    | Gdk.EventMask.BUTTON_RELEASE_MASK
                    | Gdk.EventMask.POINTER_MOTION_MASK
                    | Gdk.EventMask.ENTER_NOTIFY_MASK
                    | Gdk.EventMask.LEAVE_NOTIFY_MASK)
    win.add(area)

    def dismiss():
        if state['closing']:
            return
        state['closing'] = True
        t0 = time.monotonic()

        def step():
            f = min(1.0, (time.monotonic() - t0) / 0.14)
            Gtk.Widget.set_opacity(win, max(0.0, 1.0 - f * f))
            if f < 1.0:
                return True
            win.hide()
            if not state['holding_clipboard']:
                Gtk.main_quit()
            return False

        GLib.timeout_add(16, step)

    def do_open():
        subprocess.Popen(['xdg-open', str(path)], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        dismiss()

    def do_copy():
        if state['copied']:
            return
        try:
            atom = Gdk.Atom.intern('CLIPBOARD', False)
            clipboard = Gtk.Clipboard.get(atom)
            clipboard.set_image(GdkPixbuf.Pixbuf.new_from_file(str(path)))
            owner = Gdk.selection_owner_get(atom)
            clipboard.set_can_store(None)
            clipboard.store()
            state['holding_clipboard'] = True

            def changed(*_):
                if Gdk.selection_owner_get(atom) != owner:
                    state['holding_clipboard'] = False
                    if state['closing']:
                        Gtk.main_quit()

            clipboard.connect('owner-change', changed)
            GLib.timeout_add_seconds(600, lambda: (Gtk.main_quit(), False)[1])
        except Exception:
            pass
        state['copied'] = True
        area.queue_draw()
        GLib.timeout_add(650, lambda: (dismiss(), False)[1])

    def clear_win(_w, cr):
        cr.save()
        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.set_source_rgba(0, 0, 0, 0)
        cr.paint()
        cr.restore()
        return False

    def on_draw(_w, cr):
        cr.set_antialias(cairo.ANTIALIAS_BEST)
        cr.scale(sc, sc)
        ox, oy = SHADOW, SHADOW
        for i in range(SHADOW, 0, -1):
            rrect(cr, ox - i, oy - i + 2, WIDTH + 2 * i, HEIGHT + 2 * i, RADIUS + i)
            cr.set_line_width(1.4)
            cr.set_source_rgba(0, 0, 0, 0.055 * (1 - i / SHADOW) ** 2)
            cr.stroke()
        grad = cairo.LinearGradient(0, oy, 0, oy + HEIGHT)
        top, bot = colors['top'], colors['bottom']
        grad.add_color_stop_rgba(0, top[0] / 255, top[1] / 255, top[2] / 255, top[3])
        grad.add_color_stop_rgba(1, bot[0] / 255, bot[1] / 255, bot[2] / 255, bot[3])
        rrect(cr, ox, oy, WIDTH, HEIGHT, RADIUS)
        cr.set_source(grad)
        cr.fill_preserve()
        rgba(cr, colors['rim'])
        cr.set_line_width(1)
        cr.stroke()
        rrect(cr, ox + 0.75, oy + 0.75, WIDTH - 1.5, HEIGHT - 1.5, RADIUS - 0.75)
        rgba(cr, colors['edge'])
        cr.set_line_width(1)
        cr.stroke()

        cr.translate(ox, oy)
        tx, ty, tw, th = rects['thumb']
        cr.save()
        rrect(cr, tx, ty, tw, th, 10)
        cr.clip()
        if thumb_surface is not None:
            cr.save()
            cr.scale(1.0 / sc, 1.0 / sc)
            cr.set_source_surface(thumb_surface, round(tx * sc), round(ty * sc))
            cr.paint()
            cr.restore()
        else:
            rgba(cr, colors['tile'])
            cr.paint()
        if state['hover'] == 'thumb':
            cr.set_source_rgba(1, 1, 1, 0.10)
            cr.paint()
        cr.restore()
        rrect(cr, tx + 0.5, ty + 0.5, tw - 1, th - 1, 9.5)
        rgba(cr, colors['tile_edge'])
        cr.set_line_width(1)
        cr.stroke()

        if state['copied']:
            draw_text(cr, 'Copied to clipboard', 118, 13, 10.5, colors['green'], 0.98, 'bold')
        else:
            draw_text(cr, 'Screenshot saved', 118, 13, 10.5, colors['fg'], 0.94, 'bold')
        draw_text(cr, path.name, 118, 31, 8.6, colors['fg'], 0.52, width=WIDTH - 132)

        cx, cy, cw, ch = rects['close']
        if state['hover'] == 'close':
            rrect(cr, cx, cy, cw, ch, 9)
            rgba(cr, colors['fg'], 0.10)
            cr.fill()
        rgba(cr, colors['fg'], 0.65 if state['hover'] == 'close' else 0.36)
        cr.set_line_width(1.5)
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.move_to(cx + 5.5, cy + 5.5)
        cr.line_to(cx + cw - 5.5, cy + ch - 5.5)
        cr.move_to(cx + cw - 5.5, cy + 5.5)
        cr.line_to(cx + 5.5, cy + ch - 5.5)
        cr.stroke()

        for key, label in (('copy', 'Copied' if state['copied'] else 'Copy'), ('open', 'Open')):
            bx, by, bw, bh = rects[key]
            hot = state['hover'] == key
            rrect(cr, bx, by, bw, bh, 8)
            if key == 'copy' and state['copied']:
                rgba(cr, colors['green'], 0.22)
                cr.fill_preserve()
                rgba(cr, colors['green'], 0.55)
                cr.set_line_width(1)
                cr.stroke()
                draw_text(cr, '✓ Copied', bx, by + 6, 9.3, colors['green'], 0.98, 'bold', 'center', bw)
            elif key == 'copy':
                rgba(cr, colors['blue'], 0.96 if hot else 0.86)
                cr.fill()
                draw_text(cr, label, bx, by + 6, 9.3, (255, 255, 255), 0.98, 'bold', 'center', bw)
            else:
                rgba(cr, colors['tile_hi'] if hot else colors['tile'])
                cr.fill_preserve()
                rgba(cr, colors['tile_edge'])
                cr.set_line_width(1)
                cr.stroke()
                draw_text(cr, label, bx, by + 6, 9.3, colors['fg'], 0.92, 'medium', 'center', bw)
        return False

    def hit_test(ex, ey):
        x, y = ex / sc - SHADOW, ey / sc - SHADOW
        for name, (rx, ry, rw, rh) in rects.items():
            if rx <= x <= rx + rw and ry <= y <= ry + rh:
                return name
        return None

    def on_motion(_w, e):
        state['pointer_inside'] = True
        h = hit_test(e.x, e.y)
        if h != state['hover']:
            state['hover'] = h
            area.queue_draw()
        return True

    def on_leave(_w, _e):
        state['pointer_inside'] = False
        if state['hover'] is not None:
            state['hover'] = None
            area.queue_draw()
        return True

    def on_release(_w, e):
        if e.button != 1:
            return False
        h = hit_test(e.x, e.y)
        if h == 'copy':
            do_copy()
        elif h in ('open', 'thumb'):
            do_open()
        elif h == 'close':
            dismiss()
        return True

    def on_key(_w, e):
        if e.keyval in (Gdk.KEY_Escape, Gdk.KEY_q):
            dismiss()
            return True
        if e.keyval in (Gdk.KEY_c, Gdk.KEY_C):
            do_copy()
            return True
        if e.keyval in (Gdk.KEY_o, Gdk.KEY_O, Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            do_open()
            return True
        return False

    win.connect('draw', clear_win)
    area.connect('draw', on_draw)
    area.connect('motion-notify-event', on_motion)
    area.connect('leave-notify-event', on_leave)
    area.connect('button-release-event', on_release)
    win.connect('key-press-event', on_key)

    w_px = round((WIDTH + 2 * SHADOW) * sc)
    h_px = round((HEIGHT + 2 * SHADOW) * sc)
    win.set_size_request(w_px, h_px)
    win.resize(w_px, h_px)
    win.realize()
    gdk_win = win.get_window()
    if gdk_win is not None:
        gdk_win.set_override_redirect(True)
    display = Gdk.Display.get_default()
    monitor = display.get_primary_monitor() or display.get_monitor(0)
    work = monitor.get_workarea()
    edge = round(SHADOW * sc)
    x = work.x + work.width - w_px + edge - round(16 * sc)
    y = work.y + work.height - h_px + edge - round(16 * sc)
    win.move(x, y)
    Gtk.Widget.set_opacity(win, 0.0)
    win.show_all()
    t0 = time.monotonic()

    def fade_in():
        if state['closing']:
            return False
        f = min(1.0, (time.monotonic() - t0) / 0.11)
        Gtk.Widget.set_opacity(win, f * f * (3 - 2 * f))
        return f < 1.0

    def tick_timer():
        if state['closing']:
            return False
        now = time.monotonic()
        dt = now - state['last_tick']
        state['last_tick'] = now
        if not state['pointer_inside'] and not state['copied']:
            state['elapsed'] += dt
            if state['elapsed'] >= 5.5:
                dismiss()
                return False
        return True

    GLib.timeout_add(16, fade_in)
    GLib.timeout_add(100, tick_timer)
    signal.signal(signal.SIGTERM, lambda *_: GLib.idle_add(Gtk.main_quit))
    try:
        Gtk.main()
    finally:
        try:
            if read_file(PIDFILE) == str(os.getpid()):
                os.unlink(PIDFILE)
        except OSError:
            pass
    return True


def main():
    path = Path(sys.argv[1]).resolve(strict=True)
    if os.environ.get('MINTBOOK_NOTIFY_BACKEND') != 'notify-send':
        try:
            if show_toast(path):
                return
        except Exception:
            pass
    result = subprocess.run(['notify-send', '-a', 'Mintbook', '-i', str(path), '-t', '10000',
                             '-A', 'copy=Copy', '-A', 'open=Open',
                             'Screenshot saved', path.name], capture_output=True, text=True, timeout=90)
    if result.stdout.strip() == 'open':
        subprocess.Popen(['xdg-open', str(path)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    elif result.stdout.strip() == 'copy':
        copy_image(path)


if __name__ == '__main__':
    try:
        main()
    except (OSError, subprocess.TimeoutExpired) as error:
        print(error, file=sys.stderr)
